#!/bin/sh
# Refuses a push that would publish personal data (the repository is public).
# Enabled per clone with: git config core.hooksPath .githooks
# stdin: <local ref> <local sha> <remote ref> <remote sha>
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then
    sh tools/privacy-check.sh "$local_sha" || status=1
  else
    sh tools/privacy-check.sh "$local_sha" "$remote_sha" || status=1
  fi
done
exit $status
