// Barbican design tokens (design/mockups, design/README.md): palette, tints, shape and type
// per style, the line-icon set and the stroke icon. Imported by app.slint and dashboard.slint.

export global Theme {
    in-out property <bool> dark: true;
    // Settings > Accessibility > Contrast "More" (Bulwark data-contrast="more")
    in-out property <bool> more-contrast: false;
    // Settings > Appearance > Style: 0 Bento (every panel its own tile), 1 Nordic (one surface, pills and circles),
    // 2 Bulwark (the default: a native clone of Bulwark 1.21.2; its palette is the `Bulwark` global below, its shape is read here)
    in-out property <int> style: 0;
    out property <bool> bento: style == 0;
    out property <bool> nordic: style == 1;
    out property <bool> bulwark: style == 2;

    // ---- palette (design/mockups BNTokens: one palette, dark first) ----
    out property <color> ground: dark ? #0a0a0a : #f4f4f5;
    out property <color> tile: dark ? #141414 : #ffffff;
    out property <color> tile2: dark ? #1a1a1a : (nordic ? #f7f7f8 : #fafafa);
    out property <color> line: more-contrast ? (dark ? #9ca3af : #4b5563) : (dark ? #262626 : #e5e5e5);
    out property <color> track: dark ? #2e2e2e : #ececec;
    out property <color> text: more-contrast ? (dark ? #ffffff : #000000) : (dark ? #fafafa : #0a0a0a);
    out property <color> body: more-contrast ? (dark ? #ffffff : #000000) : (dark ? #d4d4d4 : #2b2b2b);
    out property <color> dim: more-contrast ? (dark ? #e5e7eb : #1f2937) : (dark ? #a3a3a3 : #6b6b6b);
    out property <color> faint: more-contrast ? (dark ? #d1d5db : #374151) : (dark ? #737373 : #8a8a8a);
    out property <color> accent: more-contrast ? (dark ? #93c5fd : #1d4ed8) : (dark ? #f0577a : #c8234a);
    out property <color> on-accent: more-contrast ? (dark ? #000000 : #ffffff) : (dark ? #16070c : #ffffff);
    out property <color> sel: more-contrast ? (dark ? #1e3a8a : #dbeafe) : (dark ? #4a1424 : #fde4ea);
    out property <color> sel-text: more-contrast ? (dark ? #ffffff : #000000) : (dark ? #ffd5df : #8c1733);
    out property <color> popup: dark ? #1c1c1c : #ffffff;
    // meaning tints (bg/fg pairs): rose today, mint waiting/done, sky travel/work, amber attention
    out property <color> rose-bg: dark ? #f0577a24 : #fde4ea;
    out property <color> rose-fg: dark ? #ffb3c4 : #8c1733;
    out property <color> mint-bg: dark ? #34d39921 : #dcf5e8;
    out property <color> mint-fg: dark ? #86efc4 : #17603f;
    out property <color> sky-bg: dark ? #60a5fa24 : #dfeafd;
    out property <color> sky-fg: dark ? #a8cbff : #1e3f8a;
    out property <color> amber-bg: dark ? #fbbf2421 : #fdf1d3;
    out property <color> amber-fg: dark ? #fcd679 : #7a4a06;
    // tint-bg / tint-fg turn a colour into a tile pair: the four tint hues (what mail::tint hands
    // out per sender: rose, sky, mint, amber) map exactly, any other colour (tags) gets the same treatment
    public pure function tint-bg(c: color) -> color {
        if c == #f0577a { return rose-bg; }
        if c == #34d399 { return mint-bg; }
        if c == #60a5fa { return sky-bg; }
        if c == #fbbf24 { return amber-bg; }
        return dark ? c.with-alpha(0.15) : c.mix(#ffffff, 0.16);
    }
    public pure function tint-fg(c: color) -> color {
        if c == #f0577a { return rose-fg; }
        if c == #34d399 { return mint-fg; }
        if c == #60a5fa { return sky-fg; }
        if c == #fbbf24 { return amber-fg; }
        return dark ? c.mix(#ffffff, 0.5) : c.mix(#000000, 0.55);
    }

    // ---- older names, mapped onto the palette so screens not yet restyled keep working ----
    out property <color> bg: ground;
    out property <color> rail: ground;
    out property <color> side: tile;
    out property <color> hover: dark ? #1f1f1f : #f2f2f3;
    // pressed row or button (the WinUI prototype's Pressed, prototype/winui/Palette.cs; approved by the user over the mockups)
    out property <color> pressed: dark ? #282828 : #e9e9eb;
    out property <color> chip: dark ? #262626 : #ececec;
    out property <color> raised: dark ? #1a1a1a : #f4f4f5;
    out property <color> zebra: dark ? #111111 : #fafafa;
    out property <color> bubble: tile2;
    out property <color> reader: tile;
    out property <color> muted-day: dark ? #5a5a5a : #a3a3a3;
    // keyboard focus outline (Bulwark --focus-ring-color)
    out property <color> ring: more-contrast ? (dark ? #ffffff : #000000) : accent;
    out property <string> icons: "Segoe Fluent Icons";

    // ---- semantic colours (Bulwark app/globals.css:31-125). The legacy styles keep their own palette, so they only
    // get the Bulwark status colours; accent-fill is the legacy selection pair. ----
    out property <color> destructive: dark ? #ef4444 : #dc2626;
    out property <color> destructive-fg: dark ? #0a0a0a : #ffffff;
    out property <color> success: dark ? #16a34a : #22c55e;
    out property <color> success-fg: #ffffff;
    out property <color> warning: dark ? #ca8a04 : #eab308;
    out property <color> warning-fg: #ffffff;
    out property <color> info: dark ? #60a5fa : #3b82f6;
    out property <color> info-fg: #ffffff;
    out property <color> secondary: dark ? #262626 : #f8fafc;
    out property <color> secondary-fg: dark ? #fafafa : #0f172a;
    out property <color> input: dark ? #262626 : #e2e8f0;
    out property <color> popover-fg: text;
    // Bulwark --accent / --accent-foreground (not the primary colour, which is `accent` here)
    out property <color> accent-fill: sel;
    out property <color> accent-fill-fg: sel-text;
    out property <color> unread: accent;
    out property <color> chart-1: dark ? #60a5fa : #3b82f6;
    out property <color> chart-2: dark ? #4ade80 : #22c55e;
    out property <color> chart-3: dark ? #fbbf24 : #f59e0b;
    out property <color> chart-4: dark ? #f87171 : #ef4444;
    out property <color> chart-5: dark ? #a78bfa : #8b5cf6;

    // ---- feedback states: the one set every control state reads (Styles/Feedback.xaml) ----
    // neutral hover and pressed: list rows, menu items, buttons without a fill
    out property <color> feedback-hover: hover;
    out property <color> feedback-pressed: pressed;
    // icon buttons and ghost buttons: Bulwark tints them with --accent; the legacy styles keep the grey hover
    out property <color> feedback-icon-hover: hover;
    out property <color> feedback-icon-pressed: pressed;
    out property <color> feedback-icon-hover-fg: text;
    // a toggle that is on (toolbar.tsx TOOLBAR_ACTIVE: primary/10, hover primary/15) and its pressed state
    out property <color> feedback-active: sel;
    out property <color> feedback-active-hover: sel;
    out property <color> feedback-active-pressed: pressed;
    out property <color> feedback-active-fg: sel-text;
    // selected list row (thread-list-item.tsx: bg-accent, still bg-accent on hover)
    out property <color> feedback-selected: tile2;
    out property <color> feedback-selected-fg: text;
    // the filled (primary) button: Bulwark primary/90 on hover, primary/80 pressed; legacy keeps its colour and dims on press
    out property <color> feedback-primary-hover: accent;
    out property <color> feedback-primary-pressed: more-contrast ? (dark ? #93c5fde0 : #1d4ed8e0) : (dark ? #f0577ae0 : #c8234ae0);
    // a destructive menu row on hover (context-menu.tsx: bg-destructive/10)
    out property <color> feedback-destructive-hover: dark ? #ef44441a : #dc26261a;
    // the one keyboard focus ring colour (Bulwark --focus-ring-color)
    out property <color> feedback-focus: ring;

    // ---- shape and spacing (style dependent) ----
    // window ground padding and the gap between tiles (Nordic: rail and folders sit on the ground)
    out property <length> pad: nordic || bulwark ? 0px : 14px;
    out property <length> gap: nordic || bulwark ? 0px : 12px;
    // rail column width, and where an app's content starts (x of everything right of the rail)
    out property <length> rail-w: bulwark ? 56px : (nordic ? 76px : 64px);
    out property <length> shell-x: bulwark ? 56px : (nordic ? 76px : 14px + 64px + 12px);
    // tiles: side panels (rail, folders), panes (list, reader, context; the Nordic surface), summary tiles
    // Bulwark panes are flush (radius 0), cards are rounded-lg (8)
    out property <length> r-tile: bulwark ? 8px : 24px;
    out property <length> r-pane: bulwark ? 0px : (nordic ? 28px : 26px);
    out property <length> r-summary: bulwark ? 8px : 22px;
    // controls (Nordic: every control is a pill, so use min(height / 2, r-…)); Bulwark rounded-md = 6
    out property <length> r-button: bulwark ? 6px : (nordic ? 999px : 12px);
    out property <length> r-field: bulwark ? 6px : (nordic ? 999px : 14px);
    out property <length> r-row: bulwark ? 0px : (nordic ? 0px : 18px);
    out property <length> r-nav: bulwark ? 6px : (nordic ? 22px : 14px);
    out property <length> r-chip: 99px;
    // dialogs and popovers are rounded-lg (8) in Bulwark; the legacy popup radius is kept
    out property <length> r-popup: bulwark ? 8px : (nordic ? 16px : 14px);
    out property <length> r-dialog: bulwark ? 8px : 16px;
    // the context menu panel is rounded-md (6); its rows are square (context-menu.tsx:663-667)
    out property <length> r-menu: bulwark ? 6px : 12px;
    out property <length> r-menu-item: bulwark ? 0px : 8px;
    // toasts are rounded-md (toast.tsx:92)
    out property <length> r-toast: bulwark ? 6px : 12px;
    // squircle (Bento) or circle (Nordic) for an avatar or icon button of this size
    public pure function round(size: length) -> length {
        return nordic ? size / 2 : size * 0.37;
    }

    // ---- type scale (BNTokens): title 28/800, section 19/700, body 14.5/400 (line 1.7), meta 12/600 ----
    out property <length> fs-title: 28px;
    out property <length> fs-section: 19px;
    out property <length> fs-body: 14.5px;
    out property <length> fs-meta: 12px;
}

/// Motion tokens (design/MOTION.md). Animations only decorate: every state change applies at
/// once and a second input retargets a running animation. Every duration is multiplied by `k`,
/// which is 0 when motion is reduced (Settings › Accessibility › Reduce motion, or Windows
/// "Animation effects" off while that setting follows the system).
export global Motion {
    // set from Rust (motion::apply / motion::watch_system)
    in-out property <bool> reduce: false;
    // set from Rust while the list selection moves faster than an animation (key repeat)
    in-out property <bool> rapid: false;
    out property <float> k: reduce ? 0 : 1;
    // feedback: hover, press, focus ring, selection highlight (80–120 ms)
    out property <duration> fast: 100ms * k;
    // message-list row feedback: like fast, but snaps while the selection is moving quickly
    out property <duration> list: rapid ? 0ms : fast;
    // enter: menus, popups, flyouts, tooltips, dialogs, toasts (120–180 ms, ease-out)
    out property <duration> enter: 150ms * k;
    // late content (async panels) arriving while keys repeat: instant, so it never flashes per step
    out property <duration> late: rapid ? 0ms : enter;
    // exit, for the few things that animate out at all (≤ 100 ms, ease-in)
    out property <duration> exit: 90ms * k;
    // the incoming view after an app or view switch (content is there on the first frame)
    out property <duration> view: 110ms * k;
    // hover time before a tooltip shows: a wait, not motion, so it stays with reduce motion
    out property <duration> tip-delay: 350ms;
    // where an entering popup starts from, and how far a toast slides in
    out property <float> pop-scale: reduce ? 1 : 0.96;
    out property <length> rise: reduce ? 0px : 8px;
    // ---- feedback transitions: the colour of a state change eases over one of these (Styles/Feedback.xaml, Motion/FeedbackTransition.cs) ----
    // Bulwark `transition-colors` (150 ms, 371 uses): rows, icon buttons, toggles, anything that only recolours
    out property <duration> color: 150ms * k;
    // Bulwark `transition-all duration-200` on every Button (components/ui/button.tsx:42)
    out property <duration> button: 200ms * k;
    // Bulwark menu rows `transition-colors duration-150` (components/ui/context-menu.tsx:663)
    out property <duration> menu: 150ms * k;
    // non-motion feedback numbers kept with the durations: the opacity of a disabled control (Bulwark disabled:opacity-50)
    // and the keyboard focus ring (accessibility.css:115-136: 2 px outline, 2 px offset; the Accessibility setting widens it)
    out property <float> disabled-opacity: 0.5;
    out property <length> focus-width: 2px;
    out property <length> focus-offset: 2px;
}

/// Motion curves (kept out of `Motion`: easing properties cannot cross into Rust). `enter`
/// decelerates (ease-out: half way after ~20 % of the time) for things arriving and for
/// feedback; `exit` accelerates (ease-in) for the few things that animate out. No overshoot.
export global Ease {
    out property <easing> enter: cubic-bezier(0.2, 0, 0, 1);
    out property <easing> exit: cubic-bezier(0.4, 0, 1, 1);
}

/// The Bulwark palette: the default style's colours, authored once here (Bulwark 1.21.2 app/globals.css:46-93,127-187 and
/// app/accessibility.css:290-329). gen-tokens evaluates it for dark/light and normal/more contrast, and requires it to define
/// exactly the colour properties of `Theme`, so a token cannot exist for the legacy styles only. Derived names follow the
/// native brush names (ground = --background, tile = --card, tile2 = --muted/secondary, accent = --primary, sel = --selection ...).
export global Bulwark {
    in-out property <bool> dark: true;
    in-out property <bool> more-contrast: false;

    out property <color> ground: dark ? #0a0a0a : #ffffff;
    out property <color> tile: dark ? #141414 : #ffffff;
    out property <color> tile2: dark ? #262626 : #f8fafc;
    out property <color> line: more-contrast ? (dark ? #9ca3af : #4b5563) : (dark ? #8080804d : #e2e8f0);
    out property <color> track: dark ? #262626 : #f1f5f9;
    out property <color> text: more-contrast ? (dark ? #ffffff : #000000) : (dark ? #fafafa : #0f172a);
    out property <color> body: text;
    out property <color> dim: more-contrast ? (dark ? #e5e7eb : #1f2937) : (dark ? #adadad : #59687c);
    out property <color> faint: dim;
    out property <color> accent: more-contrast ? (dark ? #93c5fd : #1d4ed8) : (dark ? #fafafa : #185aea);
    out property <color> on-accent: more-contrast ? (dark ? #000000 : #ffffff) : (dark ? #171717 : #ffffff);
    out property <color> sel: dark ? #3b82f640 : #dbeafe;
    out property <color> sel-text: more-contrast ? (dark ? #dbeafe : #1e3a8a) : (dark ? #93c5fd : #1e40af);
    out property <color> popup: dark ? #1c1c1c : #ffffff;
    // the sender tint pairs stay the legacy ones until the avatars are redesigned
    out property <color> rose-bg: dark ? #f0577a24 : #fde4ea;
    out property <color> rose-fg: dark ? #ffb3c4 : #8c1733;
    out property <color> mint-bg: dark ? #34d39921 : #dcf5e8;
    out property <color> mint-fg: dark ? #86efc4 : #17603f;
    out property <color> sky-bg: dark ? #60a5fa24 : #dfeafd;
    out property <color> sky-fg: dark ? #a8cbff : #1e3f8a;
    out property <color> amber-bg: dark ? #fbbf2421 : #fdf1d3;
    out property <color> amber-fg: dark ? #fcd679 : #7a4a06;

    out property <color> bg: ground;
    out property <color> rail: dark ? #0a0a0a : #f8fafc;
    out property <color> side: rail;
    // hover:bg-muted (275 uses) is #262626 in dark, #f1f5f9 in light; pressed is one step stronger in both, so the order
    // is rest < hover < pressed in light and dark (Bulwark itself has no pressed state)
    out property <color> hover: dark ? #262626 : #f1f5f9;
    out property <color> pressed: dark ? #333333 : #e2e8f0;
    out property <color> chip: tile2;
    out property <color> raised: tile2;
    out property <color> zebra: ground;
    out property <color> bubble: tile2;
    out property <color> reader: ground;
    out property <color> muted-day: dim;
    out property <color> ring: more-contrast ? (dark ? #ffffff : #000000) : (dark ? #d4d4d4 : #2563eb);

    // semantic colours (globals.css:31-125)
    out property <color> destructive: more-contrast ? (dark ? #fca5a5 : #b91c1c) : (dark ? #ef4444 : #dc2626);
    out property <color> destructive-fg: dark ? #0a0a0a : #ffffff;
    out property <color> success: dark ? #16a34a : #22c55e;
    out property <color> success-fg: #ffffff;
    out property <color> warning: dark ? #ca8a04 : #eab308;
    out property <color> warning-fg: #ffffff;
    out property <color> info: dark ? #60a5fa : #3b82f6;
    out property <color> info-fg: #ffffff;
    out property <color> secondary: dark ? #262626 : #f8fafc;
    out property <color> secondary-fg: dark ? #fafafa : #0f172a;
    out property <color> input: dark ? #262626 : #e2e8f0;
    out property <color> popover-fg: text;
    out property <color> accent-fill: dark ? #1e3a8a : #dbeafe;
    out property <color> accent-fill-fg: dark ? #dbeafe : #1e40af;
    out property <color> unread: more-contrast ? (dark ? #93c5fd : #1d4ed8) : (dark ? #60a5fa : #3b82f6);
    out property <color> chart-1: dark ? #60a5fa : #3b82f6;
    out property <color> chart-2: dark ? #4ade80 : #22c55e;
    out property <color> chart-3: dark ? #fbbf24 : #f59e0b;
    out property <color> chart-4: dark ? #f87171 : #ef4444;
    out property <color> chart-5: dark ? #a78bfa : #8b5cf6;

    // feedback states (see Theme for what each is for)
    // button.tsx:49 ghost / outline hover is bg-accent; the icon keeps --foreground (toolbar.tsx: hover:text-foreground)
    out property <color> feedback-hover: hover;
    out property <color> feedback-pressed: pressed;
    out property <color> feedback-icon-hover: accent-fill;
    out property <color> feedback-icon-pressed: dark ? #1e40af : #bfdbfe;
    out property <color> feedback-icon-hover-fg: text;
    // toolbar.tsx:16 bg-primary/10 text-primary hover:bg-primary/15 (the pressed step is primary/20)
    out property <color> feedback-active: more-contrast ? (dark ? #93c5fd1a : #1d4ed81a) : (dark ? #fafafa1a : #185aea1a);
    out property <color> feedback-active-hover: more-contrast ? (dark ? #93c5fd26 : #1d4ed826) : (dark ? #fafafa26 : #185aea26);
    out property <color> feedback-active-pressed: more-contrast ? (dark ? #93c5fd33 : #1d4ed833) : (dark ? #fafafa33 : #185aea33);
    out property <color> feedback-active-fg: accent;
    // thread-list-item.tsx:731: a selected row is bg-accent, and stays bg-accent on hover
    out property <color> feedback-selected: accent-fill;
    out property <color> feedback-selected-fg: accent-fill-fg;
    // button.tsx:48 hover:bg-primary/90 (e6); pressed primary/80 (cc)
    out property <color> feedback-primary-hover: more-contrast ? (dark ? #93c5fde6 : #1d4ed8e6) : (dark ? #fafafae6 : #185aeae6);
    out property <color> feedback-primary-pressed: more-contrast ? (dark ? #93c5fdcc : #1d4ed8cc) : (dark ? #fafafacc : #185aeacc);
    // context-menu.tsx:726 hover:bg-destructive/10
    out property <color> feedback-destructive-hover: more-contrast ? (dark ? #fca5a51a : #b91c1c1a) : (dark ? #ef44441a : #dc26261a);
    out property <color> feedback-focus: ring;
}

/// A surface that fades in and grows from `Motion.pop-scale` when it is created (menus, popups,
/// flyouts, dialog cards, previews). Removing it is instant. It takes input from the first frame.
/// Set `transform-origin` to the side it opens from (default: its centre).
export component PopIn inherits Rectangle {
    opacity: 0;
    transform-scale: Motion.pop-scale;
    animate opacity, transform-scale { duration: Motion.enter; easing: Ease.enter; }
    init => {
        self.opacity = 1;
        self.transform-scale = 1;
    }
}

/// An incoming view (calendar day/week/month): content is there on the first frame, it only
/// fades up from 55 % over `Motion.view`. Fill it with one child; removed instantly.
export component ViewIn inherits Rectangle {
    vertical-stretch: 1;
    opacity: Motion.reduce ? 1 : 0.55;
    animate opacity { duration: Motion.view; easing: Ease.enter; }
    init => { self.opacity = 1; }
}

/// The dimmed backdrop behind a dialog: its colour fades in; removed instantly with the dialog.
export component Scrim inherits Rectangle {
    in property <color> tint: #00000080;
    background: transparent;
    animate background { duration: Motion.enter; easing: Ease.enter; }
    init => {
        self.background = root.tint;
    }
}

/// An incoming view (settings, an admin page): content is on screen at once, only its opacity
/// settles from 0.45 to 1 over `Motion.view`. Input is live from the first frame.
export component PageIn inherits Rectangle {
    opacity: 0.45;
    animate opacity { duration: Motion.view; easing: Ease.enter; }
    init => {
        self.opacity = 1;
    }
}

/// A tooltip surface: waits `Motion.tip-delay` on hover, then fades in. Removed instantly.
export component Tip inherits Rectangle {
    opacity: 0;
    animate opacity { delay: Motion.tip-delay; duration: Motion.enter; easing: Ease.enter; }
    init => {
        self.opacity = 1;
    }
}

/// Line icons from the mockups (`I` in design/mockups/*.dc.html): SVG path data in a 24 x 24 box.
export global Icons {
    out property <string> mail: "M4 4h16v16H4z M22 6l-10 7L2 6";
    out property <string> cal: "M3 4h18v18H3z M16 2v4 M8 2v4 M3 10h18";
    out property <string> users: "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z";
    out property <string> folder: "M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z";
    out property <string> spark: "M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2z";
    out property <string> shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z";
    out property <string> inbox: "M22 12h-6l-2 3h-4l-2-3H2 M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z";
    out property <string> file: "M14 2H6v20h12V8z M14 2v6h6";
    out property <string> clock: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 6v6l4 2";
    out property <string> send: "M22 2 11 13 M22 2l-7 20-4-9-9-4 20-7z";
    out property <string> archive: "M21 8v13H3V8 M1 3h22v5H1z M10 12h4";
    out property <string> alert: "M12 9v4 M12 17h.01 M10.3 3.9 1.8 18h20.4L13.7 3.9a2 2 0 0 0-3.4 0z";
    out property <string> trash: "M3 6h18 M19 6l-1 14H6L5 6 M8 6V4h8v2";
