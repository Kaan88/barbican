    out property <string> info: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 16v-4 M12 8h.01";
    // the line icon for a Settings section id (settings-schema.json tab ids)
    public pure function for-tab(id: string) -> string {
        if id == "account" { return user; }
        if id == "security" { return key; }
        if id == "privacy" { return lock; }
        if id == "notifications" { return bell; }
        if id == "general" { return settings; }
        if id == "appearance" { return drop; }
        if id == "accessibility" { return eye; }
        if id == "message_list" { return list; }
        if id == "reading" { return file; }
        if id == "composing" { return pen; }
        if id == "organize" { return tag; }
        if id == "filters" { return filter; }
        if id == "vacation" { return sun; }
        if id == "recover" { return refresh; }
        if id == "calendar" { return cal; }
        if id == "calendars" { return list; }
        if id == "contacts" { return users; }
        if id == "addressbooks" { return book; }
        if id == "ai" { return spark; }
        if id == "spam" { return alert; }
        if id == "admin" { return shield; }
        if id == "files" { return folder; }
        if id == "addons" { return package; }
        if id == "backup" { return download; }
        if id == "troubleshooting" { return tool; }
        if id == "about" { return info; }
        return "";
    }
    // the folder icon for the Segoe glyph Rust gives each mailbox role (mail::role_icon)
    public pure function for-glyph(g: string) -> string {
        if g == "\u{E715}" { return inbox; }
        if g == "\u{E70B}" { return file; }
        if g == "\u{E724}" { return send; }
        if g == "\u{E7B8}" { return archive; }
        if g == "\u{E8F8}" { return alert; }
        if g == "\u{E74D}" { return trash; }
        if g == "\u{E787}" { return clock; }
        return folder;
    }
}

/// A line icon: `commands` takes one of the Icons paths (24 x 24 box), drawn at `size` with a
/// `weight` stroke as the mockups' SVGs do (stroke-width 1.6–2.2 in the 24 box, round caps).
export component SIcon inherits Path {
    in property <length> size: 20px;
    in property <color> tint: Theme.dim;
    in property <float> weight: 1.7;
    width: size;
    height: size;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    stroke-width: size * weight / 24;
    stroke-line-cap: round;
}

export global Prefs {
    in-out property <bool> toolbar-labels: true;
    in-out property <bool> tag-chips: true;
    in-out property <length> font-size: 13px;
    // the user's text scale, for the design's px sizes (13.5px * Prefs.fs)
    out property <float> fs: font-size / 13px;
    in-out property <bool> cal-tinted: false;
    // timeFormat 12h: the hour column reads "2:00 PM"
    in-out property <bool> cal-h12: false;
    // list hover actions, Barbican action names (delete, star, read, archive, spam)
    in-out property <[string]> hover-actions: ["delete", "star", "read", "archive"];
    // reader body gutter (messageSpacing)
    in-out property <length> reader-gutter: 20px;
    // Settings > Accessibility
    in-out property <bool> reduce-motion: false;
    in-out property <bool> large-targets: false;
    // focus outline width (0 = off, Bulwark's default)
    in-out property <length> focus-ring: 0px;
    // a button on each row that opens its actions (showRowActionButton)
    in-out property <bool> row-action: false;
    // hover actions as a floating group in a corner (hoverActionsMode) and which corner
    in-out property <bool> hover-floating: false;
    in-out property <bool> hover-left: false;
    in-out property <bool> hover-bottom: false;
}
