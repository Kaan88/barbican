<Window x:Class="S4.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv="using:Microsoft.UI.Xaml.Controls"
    Title="S4 automation spike">
  <Grid x:Name="Root" Background="#0a0a0a" RequestedTheme="Dark">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ListView x:Name="MailList" AutomationProperties.AutomationId="MailList" AutomationProperties.Name="Messages"
              SelectionChanged="MailList_SelectionChanged" Margin="8">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <StackPanel Padding="4,8">
            <StackPanel.ContextFlyout>
              <MenuFlyout ShouldConstrainToRootBounds="True">
                <MenuFlyoutItem Text="Mark read" AutomationProperties.AutomationId="CtxMarkRead" Click="Ctx_Click" />
                <MenuFlyoutItem Text="Delete" AutomationProperties.AutomationId="CtxDelete" Click="Ctx_Click" />
              </MenuFlyout>
            </StackPanel.ContextFlyout>
            <TextBlock Text="{x:Bind}" FontSize="14" />
            <TextBlock Text="Preview line of the message" FontSize="12" Opacity="0.6" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <Grid Grid.Column="1" Margin="8" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="BtnCompose" Content="Compose" AutomationProperties.AutomationId="BtnCompose" Click="Compose_Click" />
        <ToggleButton x:Name="TglStar" Content="Star" AutomationProperties.AutomationId="TglStar" />
        <CheckBox x:Name="ChkDark" Content="Dark" AutomationProperties.AutomationId="ChkDark" IsChecked="True" Click="Dark_Click" />
        <Button Content="Menu" AutomationProperties.AutomationId="BtnMenu">
          <Button.Flyout>
            <MenuFlyout ShouldConstrainToRootBounds="True">
              <MenuFlyoutItem Text="Reply" AutomationProperties.AutomationId="MenuReply" Click="Ctx_Click" />
              <MenuFlyoutItem Text="Forward" AutomationProperties.AutomationId="MenuForward" Click="Ctx_Click" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      <TextBox x:Name="Search" Grid.Row="1" PlaceholderText="Search" AutomationProperties.AutomationId="Search" />
      <Grid Grid.Row="2" Height="40">
        <Rectangle x:Name="Slider" Width="60" Height="30" Fill="#ff7a59" HorizontalAlignment="Left" RadiusX="6" RadiusY="6">
          <Rectangle.RenderTransform><TranslateTransform x:Name="SlideT" /></Rectangle.RenderTransform>
        </Rectangle>
        <TextBlock x:Name="Status" Text="ready" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.AutomationId="Status" />
      </Grid>
      <wv:WebView2 x:Name="Web" Grid.Row="3" AutomationProperties.AutomationId="Web" />
    </Grid>
  </Grid>
</Window>
