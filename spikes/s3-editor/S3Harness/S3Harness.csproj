<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike S3 harness (docs/adr/0006): the same paragraph in a XAML TextBlock and in the
       RichTextKit layout painted on an SKXamlCanvas, side by side in an off-screen, non-activated
       window; captured with RenderTargetBitmap, measured, written to an output folder. Also drives
       the hidden-TextBox text path into a Core/Editor Doc. Windows only; not in Barbican.slnx.
       Run: S3Harness.exe <outDir>. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Barbican.Spikes.S3</RootNamespace>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Spike code: no XML docs demanded, async void event handlers are the WinUI idiom here. -->
    <NoWarn>$(NoWarn);VSTHRD100;VSTHRD101;VSTHRD103;CA1861;CA1515;MA0048</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="SkiaSharp.Views.WinUI" />
    <ProjectReference Include="../../../src/Barbican.Editor.Layout/Barbican.Editor.Layout.csproj" />
  </ItemGroup>
</Project>
