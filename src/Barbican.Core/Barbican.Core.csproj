<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-agnostic logic: no UI types (PORT-PLAN.md §3.2, §3.3). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Barbican.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Verbatim copy of the Rust app's ui/settings-schema.json (Bulwark's settings keys). -->
    <EmbeddedResource Include="Settings/settings-schema.json" LogicalName="Barbican.Core.Settings.settings-schema.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native plugin API (M2 plan 3.2): Core hosts plugins, plugins reference only this. -->
    <ProjectReference Include="../Barbican.Plugins.Abstractions/Barbican.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each feature registers its services in its own Add<Feature>() file (docs/milestones/M1-plan.md §3.3). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="AngleSharp" />
    <!-- M2 (plan 3.2): MDN multipart/report, view source, forward as attachment, .eml/.mbox parsing, TNEF; BIMI and DMARC TXT lookups. -->
    <PackageReference Include="MimeKit" />
    <PackageReference Include="DnsClient" />
    <!-- M4 (D-M4-03): the .ics reader of the import -->
    <PackageReference Include="Ical.Net" />
    <!-- M4 cal-data: time zones (tzdb) for the recurrence engine and reminders. -->
    <PackageReference Include="NodaTime" />
    <!-- M5 con-data (D-M5-02): contact photos are decoded and shrunk with SkiaSharp (the App head already carries it; Linux assets: M9). -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Barbican.Core.Tests" />
    <InternalsVisibleTo Include="Barbican" Condition="'$(Configuration)' == 'Automation'" />
  </ItemGroup>
</Project>
