<Project Sdk="Microsoft.NET.Sdk">
  <!-- ViewModels, navigation state, menus as data, design tokens. No UI framework types
       (PORT-PLAN.md §3.2, §3.3); the App head turns these into XAML resources and controls. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Barbican.Presentation</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Barbican.Core/Barbican.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Barbican.Presentation.Tests" />
  </ItemGroup>
</Project>
