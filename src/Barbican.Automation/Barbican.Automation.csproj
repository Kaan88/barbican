<Project Sdk="Uno.Sdk">
  <!--
    Hidden in-app automation (PORT-PLAN.md §4.4 layer A, docs/adr/0007, spec/automation-protocol.md):
    the loopback line server, UIA-pattern input (Windows), WGC capture and frame probes (Windows),
    X11 capture (Linux, under the VM's private Xvfb), and the fail-closed popup guard.
    Port of spikes/s4-automation. Referenced by the App ONLY in the Automation configuration
    (src/Barbican.App/Barbican.App.csproj); FlaUI and Win2D are its dependencies, never the App's.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.26100.0;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(BarbicanHead)' == 'win'">net10.0-windows10.0.26100.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(BarbicanHead)' == 'desktop'">net10.0-desktop</TargetFrameworks>
    <OutputType>Library</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>Barbican.Automation</RootNamespace>
    <UnoFeatures>Skia;WebView</UnoFeatures>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <UnoDisableGenerateAssemblyInfoWorkaround>true</UnoDisableGenerateAssemblyInfoWorkaround>
    <WinAppSdkVersion>2.6.5</WinAppSdkVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.19041.0</TargetPlatformMinVersion>
    <!-- A library compiles against Win2D's managed projection only; the native
         Microsoft.Graphics.Canvas.dll is resolved by the App head, which has a runtime identifier. -->
    <!-- Uno.Sdk 7 / CsWinRT 2.x: the collection-expression AOT analyzer (CsWinRT1032) is irrelevant (no trimming or AOT here);
         CA1416: the WGC capture-session properties are set inside TrySet, which swallows the failure on older Windows. -->
    <NoWarn>$(NoWarn);CsWinRT1032;CA1416</NoWarn>
    <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Barbican.Automation.Tests" />
  </ItemGroup>
  <Import Project="../../eng/Uno.WebView2Name.targets" />
</Project>
