<?xml version="1.0" encoding="utf-8"?>
<!--
  Control styles of the design language (design/README.md, spec/layout/shell.md "Common controls"), matched to the WinUI prototype the user approved
  (prototype/winui/App.xaml: lightweight button styling, RowItem / NordRowItem / FolderItem / NordFolderItem; docs/milestones/M1-look-gap.md).
  Every colour is one of the shared palette brushes of Themes/Tokens.xaml (rewritten in place on a theme flip, so a style
  never re-resolves). Shapes that differ between Bento and Nordic are not here: views bind them to StyleState, and the list
  item styles come in a Bento and a Nordic variant that a list swaps once per style change.
  Rules (design/MOTION.md): no animation gates input; list rows snap (setters, no transitions); buttons, toggles and menu rows ease through Styles/Feedback.xaml.
  Every state colour here is a Feedback* brush (generated: Bulwark values for the Bulwark style, the legacy values for Bento and Nordic).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <!-- Buttons, menu rows, toggles, plain list rows, focus ring and the Fluent accent: the shared feedback system -->
    <ResourceDictionary Source="ms-appx:///Styles/Feedback.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The prototype's text face: Segoe UI (not the WinUI default Segoe UI Variable, whose wider, rounder cuts made M1 read differently). -->
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>

  <!-- Text -->
  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Body}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Text.Meta" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Text.Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- A text box without chrome: the surrounding view draws the field (search box, quick reply). -->
  <ControlTemplate x:Key="Template.BareTextBox" TargetType="TextBox">
    <Grid Background="Transparent">
      <ScrollViewer x:Name="ContentElement" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False" ZoomMode="Disabled" />
      <ContentControl x:Name="PlaceholderTextContentPresenter" Content="{TemplateBinding PlaceholderText}" Foreground="{StaticResource Faint}" IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center" />
    </Grid>
  </ControlTemplate>
  <Style x:Key="TextBox.Bare" TargetType="TextBox">
    <Setter Property="Template" Value="{StaticResource Template.BareTextBox}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="AcceptsReturn" Value="False" />
  </Style>

  <!-- Message rows, Bento (prototype RowItem): no frame at rest; hover fills, the selected row is a raised card (tile2 and a hairline). Instant states. -->
  <ControlTemplate x:Key="Template.ListItem.Bento" TargetType="ListViewItem">
    <Grid x:Name="Root" Background="Transparent" Margin="{TemplateBinding Padding}">
      <Border x:Name="Box" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
      <Border x:Name="SelLine" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackHover}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Selected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackSelected}" />
              <Setter Target="SelLine.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOverSelected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackSelected}" />
              <Setter Target="SelLine.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PressedSelected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
              <Setter Target="SelLine.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <!-- Message rows, Nordic (prototype NordRowItem): full-width rows; the selected one is tile2 with the accent bar down its whole left edge. -->
  <ControlTemplate x:Key="Template.ListItem.Nordic" TargetType="ListViewItem">
    <Grid x:Name="Root" Background="Transparent" Margin="{TemplateBinding Padding}">
      <Border x:Name="Box" Background="Transparent" />
      <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Fill="{StaticResource Accent}" Opacity="0" />
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackHover}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Selected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackSelected}" />
              <Setter Target="Bar.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOverSelected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackSelected}" />
              <Setter Target="Bar.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PressedSelected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
              <Setter Target="Bar.Opacity" Value="1" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <!-- Folder rows (prototype FolderItem / NordFolderItem): the selected one is the "sel" pill and its text turns sel-text (Bento radius 14, Nordic 22).
       The row's name, icon and count take the presenter's foreground, so the selected state recolours them without touching the rows. -->
  <ControlTemplate x:Key="Template.FolderItem" TargetType="ListViewItem">
    <Grid x:Name="Root" Background="Transparent" Margin="{TemplateBinding Padding}">
      <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{StaticResource Body}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackHover}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Selected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource Sel}" />
              <Setter Target="Box.BorderBrush" Value="{StaticResource Accent}" />
              <Setter Target="Content.Foreground" Value="{StaticResource SelText}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOverSelected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource Sel}" />
              <Setter Target="Box.BorderBrush" Value="{StaticResource Accent}" />
              <Setter Target="Content.Foreground" Value="{StaticResource SelText}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PressedSelected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
              <Setter Target="Box.BorderBrush" Value="{StaticResource Accent}" />
              <Setter Target="Content.Foreground" Value="{StaticResource SelText}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <Style x:Key="ListItem.Message.Bento" TargetType="ListViewItem">
    <Setter Property="Template" Value="{StaticResource Template.ListItem.Bento}" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="2" />
  </Style>
  <Style x:Key="ListItem.Message.Nordic" TargetType="ListViewItem">
    <Setter Property="Template" Value="{StaticResource Template.ListItem.Nordic}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="2" />
  </Style>
  <!-- Bulwark thread-list-item.tsx:733-746: edge-to-edge rows, a bottom rule and an accent selection fill. -->
  <Style x:Key="ListItem.Message.Bulwark" TargetType="ListViewItem" BasedOn="{StaticResource ListItem.Message.Nordic}">
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Grid Background="Transparent">
            <Border x:Name="Surface" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" />
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Background" Value="{StaticResource FeedbackHover}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Background" Value="{StaticResource FeedbackPressed}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="Surface.Background" Value="{StaticResource FeedbackSelected}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="Surface.Background" Value="{StaticResource FeedbackSelected}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="Surface.Background" Value="{StaticResource FeedbackPressed}" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ListItem.Folder.Bento" TargetType="ListViewItem">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template" Value="{StaticResource Template.FolderItem}" />
    <Setter Property="Padding" Value="0,1" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="2" />
  </Style>
  <Style x:Key="ListItem.Folder.Nordic" TargetType="ListViewItem">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template" Value="{StaticResource Template.FolderItem}" />
    <Setter Property="Padding" Value="0,1" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="2" />
  </Style>
  <Style x:Key="ListItem.Folder.Bulwark" TargetType="ListViewItem" BasedOn="{StaticResource ListItem.Folder.Bento}">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>
</ResourceDictionary>
