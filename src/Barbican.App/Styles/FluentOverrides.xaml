<?xml version="1.0" encoding="utf-8"?>
<!--
  The stock Fluent controls dressed as Bulwark 1.21.2's shadcn ones (docs/milestones/bulwark-parity-gaps.md FM-19, FM-20, FM-21, ST-03, TH-07), from the same
  palette and state brushes as every other control (Themes/Tokens.xaml, Styles/Feedback.xaml). No colour and no duration of its own: the palette brushes are
  live (a theme, contrast or style switch rewrites their colours in place), the motion lengths are the Control*AnimationDuration resources that
  Motion/FluentMotion.cs sets from the motion tokens and zeroes with reduce motion. Radii come from Theme/FluentShape.cs (Fluent.FieldRadius, Fluent.MenuRadius:
  a CornerRadius cannot bind to Shape.* in XAML), so Bento and Nordic keep their own shape on the same templates.

  Bulwark 1.21.2 sources matched (paths relative to <bulwark>):
    ToggleSwitch   components/settings/settings-section.tsx:374-410  h-6 w-11 rounded-full, 16 px knob, on = bg-primary with a bg-background knob, off = bg-muted +
                   ring-1 ring-inset ring-muted-foreground with a muted-foreground knob, transition-colors / transition-transform duration-150, disabled opacity-50.
                   No hover and no pressed change (the element has none), so none is drawn.
    TextBox        components/ui/input.tsx:13-18  rounded-md border border-input bg-background px-3 py-2 text-sm, placeholder:text-muted-foreground,
                   hover:border-muted-foreground, focus-visible:border-ring (no outline, no thicker line), disabled:opacity-50. No clear button.
    PasswordBox    the same field (input.tsx) through the shared TextControl* resources below.
    CheckBox       the browser's own check box, tinted with the page colour scheme (app/globals.css:234-255): neutral box, primary when checked.
    RadioButton    the same (components/admin/org/sections/phishing-report-section.tsx:110, native input).
    ScrollBar      app/globals.css:296-330  8 px wide, transparent track, border-colour thumb that turns muted-foreground on hover, rounded-full.
    ProgressBar    components/offline/account-storage.tsx:67 (h-1 rounded-full, bg-muted track, bg-primary fill), mail-transfer/transfer-progress.tsx:27-36.
    MenuFlyout     components/ui/context-menu.tsx:663-667  panel bg-background rounded-md border border-border, rows px-3 py-1.5 with hover:bg-muted.
    Expander       Bulwark's disclosure (settings/app-lock-settings.tsx:175-176, details/summary): no fill, border colour hairline, no hover tint but the muted row.

  Hover and pressed of the neutral controls use FeedbackHover / FeedbackPressed, the primary controls FeedbackPrimaryHover / FeedbackPrimaryPressed, the focus ring is the
  one ring of Styles/Feedback.xaml (SystemControlFocusVisualPrimaryBrush). Nothing scales, bounces or overshoots: the only motion is the 150 ms colour or travel of
  Bulwark's own duration-150, on the cubic-bezier(0.4, 0, 0.2, 1) curve of Tailwind's default ease.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Fluent.Transparent" Color="Transparent" />

  <!-- ===== Text fields (TextBox, PasswordBox, AutoSuggestBox, NumberBox ...): input.tsx:13-18 ===== -->
  <StaticResource x:Key="TextControlForeground" ResourceKey="Text" />
  <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="Text" />
  <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="Text" />
  <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="Dim" />
  <StaticResource x:Key="TextControlBackground" ResourceKey="Bg" />
  <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="Bg" />
  <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Bg" />
  <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="Bg" />
  <StaticResource x:Key="TextControlBorderBrush" ResourceKey="Input" />
  <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="Dim" />
  <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="FeedbackFocus" />
  <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="Input" />
  <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="Dim" />
  <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="Dim" />
  <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="Dim" />
  <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="Dim" />
  <StaticResource x:Key="TextControlHeaderForeground" ResourceKey="Text" />
  <StaticResource x:Key="TextControlHeaderForegroundDisabled" ResourceKey="Dim" />
  <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="Sel" />
  <StaticResource x:Key="TextControlButtonForeground" ResourceKey="Dim" />
  <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="Text" />
  <StaticResource x:Key="TextControlButtonForegroundPressed" ResourceKey="Text" />
  <StaticResource x:Key="TextControlButtonBackgroundPointerOver" ResourceKey="FeedbackHover" />
  <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="FeedbackPressed" />
  <!-- focus-visible:border-ring changes the colour only; the Fluent focus line (a 2 px accent underline) is a 1 px full border. -->
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

  <ControlTemplate x:Key="Template.FluentTextBox" TargetType="TextBox">
    <Grid x:Name="Root">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundPointerOver}" />
              <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushPointerOver}" />
              <Setter Target="ContentElement.Foreground" Value="{ThemeResource TextControlForegroundPointerOver}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Focused">
            <VisualState.Setters>
              <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundFocused}" />
              <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushFocused}" />
              <Setter Target="ContentElement.Foreground" Value="{ThemeResource TextControlForegroundFocused}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Root.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
              <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundDisabled}" />
              <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushDisabled}" />
              <Setter Target="ContentElement.Foreground" Value="{ThemeResource TextControlForegroundDisabled}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <ContentPresenter x:Name="HeaderContentPresenter" Grid.Row="0" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" FontWeight="Normal"
                        Foreground="{ThemeResource TextControlHeaderForeground}" Margin="0,0,0,6" TextWrapping="Wrap" Visibility="Collapsed" IsHitTestVisible="False"
                        AutomationProperties.AccessibilityView="Raw" />
      <Border x:Name="BorderElement" Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}" />
      <ScrollViewer x:Name="ContentElement" Grid.Row="1" HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                    IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                    Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" IsTabStop="False" ZoomMode="Disabled"
                    AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="PlaceholderTextContentPresenter" Grid.Row="1" Foreground="{ThemeResource TextControlPlaceholderForeground}" Margin="{TemplateBinding BorderThickness}"
                 Padding="{TemplateBinding Padding}" Text="{TemplateBinding PlaceholderText}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}"
                 IsHitTestVisible="False" />
    </Grid>
  </ControlTemplate>

  <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="Template" Value="{StaticResource Template.FluentTextBox}" />
    <Setter Property="CornerRadius" Value="{ThemeResource Fluent.FieldRadius}" />
    <Setter Property="Padding" Value="12,8,12,8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
  </Style>

  <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
    <Setter Property="CornerRadius" Value="{ThemeResource Fluent.FieldRadius}" />
    <Setter Property="Padding" Value="12,8,6,8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
  </Style>

  <!-- ===== ToggleSwitch: settings-section.tsx:374-410 (44 x 24 track, 16 px knob, travel 20 = translate-x-1 to translate-x-6) ===== -->
  <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleSwitch">
          <Grid x:Name="Root" Background="{TemplateBinding Background}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="ToggleStates">
                <VisualStateGroup.Transitions>
                  <VisualTransition x:Name="DraggingToOnTransition" From="Dragging" To="On" />
                  <VisualTransition x:Name="DraggingToOffTransition" From="Dragging" To="Off" />
                  <VisualTransition x:Name="OnToOffTransition" From="On" To="Off">
                    <Storyboard>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X">
                        <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="0.4,0 0.2,1" Value="0" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="0.4,0 0.2,1" Value="0" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="0.4,0 0.2,1" Value="0" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobOff" Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="0.4,0 0.2,1" Value="1" />
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualTransition>
                  <VisualTransition x:Name="OffToOnTransition" From="Off" To="On">
                    <Storyboard>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X">
                        <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="0.4,0 0.2,1" Value="20" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="0.4,0 0.2,1" Value="1" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="0.4,0 0.2,1" Value="1" />
                      </DoubleAnimationUsingKeyFrames>
                      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobOff" Storyboard.TargetProperty="Opacity">
                        <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="0.4,0 0.2,1" Value="0" />
                      </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Dragging" />
                <VisualState x:Name="Off" />
                <VisualState x:Name="On">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="20" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="KnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="ContentStates">
                <VisualState x:Name="OffContent">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="OffContentPresenter" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OffContentPresenter" Storyboard.TargetProperty="IsHitTestVisible">
                      <DiscreteObjectKeyFrame KeyTime="0"><DiscreteObjectKeyFrame.Value><x:Boolean>True</x:Boolean></DiscreteObjectKeyFrame.Value></DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="OnContent">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="OnContentPresenter" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OnContentPresenter" Storyboard.TargetProperty="IsHitTestVisible">
                      <DiscreteObjectKeyFrame KeyTime="0"><DiscreteObjectKeyFrame.Value><x:Boolean>True</x:Boolean></DiscreteObjectKeyFrame.Value></DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentPresenter x:Name="HeaderContentPresenter" Grid.Row="0" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{StaticResource Text}"
                              IsHitTestVisible="False" Margin="{ThemeResource ToggleSwitchTopHeaderMargin}" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="Collapsed"
                              AutomationProperties.AccessibilityView="Raw" />
            <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" MaxWidth="12" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid x:Name="SwitchAreaGrid" Grid.ColumnSpan="3" Background="Transparent" Control.IsTemplateFocusTarget="True" />
              <ContentPresenter x:Name="OffContentPresenter" Grid.Column="2" Opacity="0" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" Content="{TemplateBinding OffContent}"
                                ContentTemplate="{TemplateBinding OffContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" AutomationProperties.AccessibilityView="Raw" />
              <ContentPresenter x:Name="OnContentPresenter" Grid.Column="2" Opacity="0" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" Content="{TemplateBinding OnContent}"
                                ContentTemplate="{TemplateBinding OnContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" AutomationProperties.AccessibilityView="Raw" />
              <!-- off: bg-muted with the inset muted-foreground ring; on: bg-primary (laid over the off track and faded in) -->
              <Border x:Name="OffTrack" Width="44" Height="24" CornerRadius="12" Background="{StaticResource Track}" BorderBrush="{StaticResource Dim}" BorderThickness="1" />
              <Border x:Name="OnTrack" Width="44" Height="24" CornerRadius="12" Background="{StaticResource Accent}" Opacity="0" />
              <!-- the knob cell is 24 wide with the 16 px knob centred (4 px each side); it travels 20 px -->
              <Grid x:Name="SwitchKnob" HorizontalAlignment="Left" Width="24" Height="24">
                <Border x:Name="KnobOff" Width="16" Height="16" CornerRadius="8" Background="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="KnobOn" Width="16" Height="16" CornerRadius="8" Background="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="KnobTranslateTransform" />
                </Grid.RenderTransform>
              </Grid>
              <!-- the part the control drags and taps (SwitchKnobBounds is the part that names the travel) -->
              <Rectangle x:Name="SwitchKnobBounds" Width="44" Height="24" Fill="Transparent" IsHitTestVisible="False" />
              <Thumb x:Name="SwitchThumb" Grid.ColumnSpan="3" AutomationProperties.AccessibilityView="Raw">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Rectangle Fill="Transparent" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- the stock margins around the track pad the control to a 40 px touch row; Bulwark's switch is its drawn 24 px (the touch area is padding, TOUCH_HIT_AREA) -->
  <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
  <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>
  <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>

  <!-- ===== CheckBox: the native box with the page colour scheme (globals.css:234-255); primary when checked (FM-20) ===== -->
  <StaticResource x:Key="CheckBoxForegroundUnchecked" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxForegroundUncheckedPointerOver" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxForegroundUncheckedPressed" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxForegroundUncheckedDisabled" ResourceKey="Dim" />
  <StaticResource x:Key="CheckBoxForegroundChecked" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxForegroundCheckedPointerOver" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxForegroundCheckedPressed" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxForegroundCheckedDisabled" ResourceKey="Dim" />
  <StaticResource x:Key="CheckBoxForegroundIndeterminate" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxForegroundIndeterminatePointerOver" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxForegroundIndeterminatePressed" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxForegroundIndeterminateDisabled" ResourceKey="Dim" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="Bg" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="FeedbackHover" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="FeedbackPressed" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" ResourceKey="Bg" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="Dim" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" ResourceKey="Text" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" ResourceKey="Input" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="Accent" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="FeedbackPrimaryHover" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="FeedbackPrimaryPressed" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" ResourceKey="Input" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="Accent" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="FeedbackPrimaryHover" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="FeedbackPrimaryPressed" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" ResourceKey="Input" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminate" ResourceKey="Accent" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" ResourceKey="FeedbackPrimaryHover" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" ResourceKey="FeedbackPrimaryPressed" />
  <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled" ResourceKey="Input" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" ResourceKey="Accent" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" ResourceKey="FeedbackPrimaryHover" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" ResourceKey="FeedbackPrimaryPressed" />
  <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminateDisabled" ResourceKey="Input" />
  <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="OnAccent" />
  <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="OnAccent" />
  <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="OnAccent" />
  <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" ResourceKey="Dim" />
  <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="OnAccent" />
  <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" ResourceKey="OnAccent" />
  <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" ResourceKey="OnAccent" />
  <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled" ResourceKey="Dim" />
  <StaticResource x:Key="CheckBoxCheckGlyphForegroundUnchecked" ResourceKey="OnAccent" />
