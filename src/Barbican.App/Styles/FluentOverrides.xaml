  <!-- ===== RadioButton: same scheme, primary dot when selected ===== -->
  <StaticResource x:Key="RadioButtonForeground" ResourceKey="Text" />
  <StaticResource x:Key="RadioButtonForegroundPointerOver" ResourceKey="Text" />
  <StaticResource x:Key="RadioButtonForegroundPressed" ResourceKey="Text" />
