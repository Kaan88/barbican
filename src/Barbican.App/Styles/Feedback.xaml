<?xml version="1.0" encoding="utf-8"?>
<!--
  The one feedback system (design/MOTION.md "Feedback", docs/milestones/bulwark-parity-gaps.md section 3): every control of one kind
  gives the same hover, pressed, active, selected, focus and disabled feedback, from the shared state brushes of Themes/Tokens.xaml
  (Feedback* palette keys, generated by tools/Barbican.GenTokens from design/legacy-slint/theme.slint: Bulwark values for the Bulwark
  style, the legacy values for Bento and Nordic) and the generated durations (Motion.ColorMs / ButtonMs / MenuMs / FastMs).
  Nothing here names a colour or a duration of its own.

  Colour changes ease over one duration per kind (Motion/FeedbackTransition.cs, a WinUI BrushTransition on the template's Border):
    Button  = Bulwark transition-all duration-200 (button.tsx:42): Button.Icon / Action / Chip / Primary, ToggleButton.Icon
    Menu    = Bulwark menu rows transition-colors duration-150 (context-menu.tsx:663): Button.MenuItem
    Color   = Bulwark transition-colors 150 ms: anything that only recolours
    Fast    = hover actions on a row (email-hover-actions.tsx:271, duration-100)
  List rows snap (MOTION.md rule 3; thread-list-item.tsx animates only the shadow). Reduce motion removes the transition.
  Pressed is a state of its own, one step stronger than hover in dark and light (Bulwark has no press state, TH-03).
  Radii are not here: a CornerRadius cannot bind to a Shape.* x:Double, so the views take them from StyleState (Bulwark 6 / 8 from Shape.Bulwark.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fb="using:Barbican.App.Motion">

  <!-- One keyboard focus ring for every control (Bulwark accessibility.css:115-136: one outline in the focus-ring colour). The Fluent focus visual is
       a two-colour ring; its inner colour is transparent so only the ring colour shows. Its width is 2 (the WinUI default) and is widened by the
       Accessibility setting through Theme/FocusRing.cs. -->
  <SolidColorBrush x:Key="FeedbackFocusInner" Color="Transparent" />
  <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="FeedbackFocus" />
  <StaticResource x:Key="SystemControlFocusVisualSecondaryBrush" ResourceKey="FeedbackFocusInner" />

  <!-- Fluent controls that are not re-templated yet (toggle, check box, text box focus line, progress ...) draw with the accent fill: it is the
       Bulwark primary colour here, not the Windows accent colour (FM-20). The brush instances are the live palette ones. -->
  <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="Accent" />
  <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="FeedbackPrimaryHover" />
  <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="FeedbackPrimaryPressed" />
  <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="OnAccent" />
  <StaticResource x:Key="TextOnAccentFillColorSecondaryBrush" ResourceKey="OnAccent" />
  <StaticResource x:Key="AccentTextFillColorPrimaryBrush" ResourceKey="Accent" />

  <!-- Buttons without a fill (icon, action, chip): hover tints with the icon-button state, pressed is one step stronger. The content presenter
       carries the button's foreground, so a line icon inside (Controls/SIcon) strokes in the button's colour. -->
  <ControlTemplate x:Key="Template.Button" TargetType="Button">
    <Border x:Name="Box" fb:FeedbackTransition.Kind="Button" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackIconHover}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackIconHoverFg}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackIconPressed}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackIconHoverFg}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Box.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Border>
  </ControlTemplate>

  <!-- A toggle that is on (toolbar.tsx TOOLBAR_ACTIVE): a primary tint with primary text, one step stronger on hover and pressed. Off it is a plain icon button. -->
  <ControlTemplate x:Key="Template.ToggleButton" TargetType="ToggleButton">
    <Border x:Name="Box" fb:FeedbackTransition.Kind="Button" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackIconHover}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackIconHoverFg}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackIconPressed}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackIconHoverFg}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Box.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Checked">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackActive}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackActiveFg}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackActiveHover}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackActiveFg}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackActivePressed}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackActiveFg}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedDisabled">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackActive}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackActiveFg}" />
              <Setter Target="Box.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Border>
  </ControlTemplate>

  <!-- The filled (primary) button: hover and pressed are the primary colour at 90 % and 80 % in Bulwark (button.tsx:48), the legacy styles keep the colour
       on hover and dim on press (all in the tokens). -->
  <ControlTemplate x:Key="Template.AccentButton" TargetType="Button">
    <Border x:Name="Box" fb:FeedbackTransition.Kind="Button" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPrimaryHover}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPrimaryPressed}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Box.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Border>
  </ControlTemplate>

  <!-- A menu row (context-menu.tsx:663-667): the neutral hover on a transparent row, 150 ms; a destructive row hovers with the destructive tint. -->
  <ControlTemplate x:Key="Template.MenuItem" TargetType="Button">
    <Border x:Name="Box" fb:FeedbackTransition.Kind="Menu" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackHover}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Box.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Border>
  </ControlTemplate>
  <ControlTemplate x:Key="Template.MenuItem.Destructive" TargetType="Button">
    <Border x:Name="Box" fb:FeedbackTransition.Kind="Menu" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackDestructiveHover}" />
              <Setter Target="Content.Foreground" Value="{StaticResource Destructive}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackDestructiveHover}" />
              <Setter Target="Content.Foreground" Value="{StaticResource Destructive}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Box.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Border>
  </ControlTemplate>

  <!-- A list row of the plain kind (agenda, tasks, contacts, files): neutral hover, pressed, and the selected row is the Bulwark accent fill, still the
       accent fill on hover (thread-list-item.tsx:731). Instant states: rows snap. -->
  <ControlTemplate x:Key="Template.ListItem.Row" TargetType="ListViewItem">
    <Grid x:Name="Root" Background="Transparent">
      <Border x:Name="Box" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackHover}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Selected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackSelected}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOverSelected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackSelected}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PressedSelected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Root.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <!-- The styles. A button style carries no radius: the view sets it from StyleState (ButtonRadius), as before. -->
  <Style x:Key="Button.Icon" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Template.Button}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <!-- A toolbar toggle (a panel, a filter, a mode): an icon button that shows the active tint while IsChecked. -->
  <Style x:Key="ToggleButton.Icon" TargetType="ToggleButton">
    <Setter Property="Template" Value="{StaticResource Template.ToggleButton}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <!-- The prototype's default button: no fill, a hairline, body text (Reply / Forward / Archive pills, sender-panel buttons). -->
  <Style x:Key="Button.Action" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Template.Button}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Body}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,0,16,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Template.AccentButton}" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <Style x:Key="Button.Chip" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Template.Button}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <!-- A full-width menu row: left-aligned content, square in Bulwark (Shape.RMenuItem 0; StyleState gives the radius), body text. -->
  <Style x:Key="Button.MenuItem" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Template.MenuItem}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="2" />
  </Style>
  <Style x:Key="Button.MenuItem.Destructive" TargetType="Button" BasedOn="{StaticResource Button.MenuItem}">
    <Setter Property="Template" Value="{StaticResource Template.MenuItem.Destructive}" />
  </Style>

  <!-- A button that appears over a row on hover (email-hover-actions.tsx:271-274): the same neutral feedback, but a 100 ms ease. -->
  <ControlTemplate x:Key="Template.HoverAction" TargetType="Button">
    <Border x:Name="Box" fb:FeedbackTransition.Kind="Fast" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackHover}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Box.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Border>
  </ControlTemplate>
  <Style x:Key="Button.HoverAction" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Template.HoverAction}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <!-- The row style for agenda, tasks, contacts and files lists (the stock ListViewItem template has its own Windows hover, press and selection). -->
  <Style x:Key="ListItem.Row" TargetType="ListViewItem">
    <Setter Property="Template" Value="{StaticResource Template.ListItem.Row}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="2" />
  </Style>
</ResourceDictionary>
