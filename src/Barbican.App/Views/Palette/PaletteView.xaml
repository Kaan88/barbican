<UserControl
    x:Class="Barbican.App.Views.Palette.PaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="not_win">
  <!-- The command palette (Rust palette.rs, Bulwark components/command-palette): one in-window Popup constrained to the window. A click on the dimmed backdrop closes it; the card sits near the
       top. The rows are drawn by the code-behind from PaletteController. -->
  <Popup x:Name="PalettePopup" win:ShouldConstrainToRootBounds="True" AutomationProperties.AutomationId="palette.popup">
    <Grid x:Name="Backdrop" Background="#44000000" AutomationProperties.AutomationId="palette.backdrop">
      <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0" Width="560" MaxHeight="520"
              Background="{StaticResource Popup}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16"
              AutomationProperties.AutomationId="palette.card" AutomationProperties.Name="Command palette">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBox x:Name="Input" Grid.Row="0" Margin="12" PlaceholderText="Type a command" FontSize="14" TextChanged="OnTextChanged" KeyDown="OnInputKeyDown"
                   AutomationProperties.AutomationId="palette.input" AutomationProperties.Name="Command" />
          <StackPanel x:Name="Tabs" Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="12,0,12,8" Visibility="Collapsed" AutomationProperties.AutomationId="palette.scopes" />
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="palette.scroll">
            <StackPanel x:Name="Rows" Margin="6,0,6,8" AutomationProperties.AutomationId="palette.rows" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Popup>
</UserControl>
