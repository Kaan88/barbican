<UserControl
    x:Class="Barbican.App.Views.Glance.GlanceTilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Barbican.App.Views">
  <!-- WP-10: Bulwark has no summary strip (mail-app.tsx lays out rail, folders, list and reader only), so this view is shown in Bento only and stays hidden in the default style. The Bento summary tiles above the reader (spec/layout/shell.md "summary tiles shown"; BNMail main): Today, Flagged, To do. Each reads what the account has; the calendar and
       task tiles say so until M4 gives them data (Rust glance.rs). Hidden in Nordic and below the reader-width breakpoint by the shell. -->
  <Grid ColumnSpacing="{x:Bind Look.Gap, Mode=OneWay}" ColumnDefinitions="*,*,*" AutomationProperties.AutomationId="glance" AutomationProperties.Name="Summary tiles">
    <Border Grid.Column="0" Background="{StaticResource RoseBg}" CornerRadius="{x:Bind Look.SummaryRadius, Mode=OneWay}" Padding="16,14"
            AutomationProperties.AutomationId="glance.today" AutomationProperties.Name="Today">
      <StackPanel Spacing="2">
        <TextBlock Text="Today" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource RoseFg}" Opacity="0.85" />
        <TextBlock Text="{x:Bind views:Fmt.TodayValue(Glance.HasCalendar, Glance.TodayCount), Mode=OneWay}" FontSize="19" FontWeight="ExtraBold" Foreground="{StaticResource RoseFg}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind Glance.TodayNext, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RoseFg}" Opacity="0.85" TextTrimming="CharacterEllipsis" MinHeight="16" />
      </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="{StaticResource MintBg}" CornerRadius="{x:Bind Look.SummaryRadius, Mode=OneWay}" Padding="16,14"
            AutomationProperties.AutomationId="glance.flagged" AutomationProperties.Name="Flagged">
      <StackPanel Spacing="2">
        <TextBlock Text="Flagged" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MintFg}" Opacity="0.85" />
        <TextBlock Text="{x:Bind views:Fmt.FlaggedValue(Glance.HasFlagged, Glance.FlaggedCount), Mode=OneWay}" FontSize="19" FontWeight="ExtraBold" Foreground="{StaticResource MintFg}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind Glance.FlaggedWho, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MintFg}" Opacity="0.85" TextTrimming="CharacterEllipsis" MinHeight="16" />
      </StackPanel>
    </Border>
    <Border Grid.Column="2" Background="{StaticResource SkyBg}" CornerRadius="{x:Bind Look.SummaryRadius, Mode=OneWay}" Padding="16,14"
            AutomationProperties.AutomationId="glance.todo" AutomationProperties.Name="To do">
      <StackPanel Spacing="2">
        <TextBlock Text="To do" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SkyFg}" Opacity="0.85" />
        <TextBlock Text="{x:Bind views:Fmt.TasksValue(Glance.HasTasks, Glance.TaskCount), Mode=OneWay}" FontSize="19" FontWeight="ExtraBold" Foreground="{StaticResource SkyFg}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind Glance.TaskNext, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SkyFg}" Opacity="0.85" TextTrimming="CharacterEllipsis" MinHeight="16" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
