<UserControl
    x:Class="Barbican.App.Views.Sidebar.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="using:Barbican.App.Motion"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="not_win"
    xmlns:controls="using:Barbican.App.Controls"
    xmlns:theme="using:Barbican.App.Theme"
    xmlns:views="using:Barbican.App.Views"
    xmlns:mail="using:Barbican.Presentation.Mail"
    xmlns:shell="using:Barbican.Presentation.Shell">
  <!-- The folders column (spec/layout/shell.md "Folders sidebar"; BNMail aside, NordMail aside; prototype FolderTile): New message, the folders, the tags, storage.
       Bento: the whole column is one tile; Nordic: it sits on the ground. Folders and tags come from SidebarViewModel (every refresh is a ListSync, so unchanged rows are not touched).
       A folder row's name, icon and count take the row's foreground (Styles/Controls.xaml Template.FolderItem), so the selected row turns sel-text with no code.
       The expand chevron of a parent folder sits after its name, so every folder icon stays in one column as in the prototype. -->
  <Border x:Name="Pane" Background="{x:Bind Look.SidebarBrush, Mode=OneWay}" BorderBrush="{StaticResource Line}"
          BorderThickness="{x:Bind Look.SidebarBorder, Mode=OneWay}" CornerRadius="{x:Bind Look.SidebarRadius, Mode=OneWay}" Padding="{x:Bind Look.SidebarPadding, Mode=OneWay}">
  <Grid RowDefinitions="Auto,*,Auto" AutomationProperties.AutomationId="sidebar" AutomationProperties.Name="Folders">
    <Grid.Resources>
      <DataTemplate x:Key="FolderTemplate" x:DataType="mail:FolderRowViewModel">
        <Grid Height="{x:Bind theme:StyleState.Current.FolderRowHeight, Mode=OneWay}" Padding="{x:Bind theme:StyleState.Current.FolderRowPadding, Mode=OneWay}"
              Opacity="{x:Bind views:Fmt.MutedOpacity(Muted)}" ColumnSpacing="10" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="{x:Bind views:Fmt.IndentPx(Depth)}" />
            <controls:SIcon Kind="{x:Bind views:Fmt.FolderIcon(Role)}" Size="18" Opacity="0.8" VerticalAlignment="Center"
                            Visibility="{x:Bind theme:StyleState.Current.FolderIconVisibility, Mode=OneWay}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Name}" FontFamily="{x:Bind theme:StyleState.Current.AppFont, Mode=OneWay}" FontSize="{x:Bind theme:StyleState.Current.FolderNameSize, Mode=OneWay}" FontWeight="{x:Bind views:Fmt.FolderWeight(Unread)}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Style="{StaticResource Button.Icon}" Width="18" Height="18" CornerRadius="6" Foreground="{StaticResource Faint}" Click="OnChevronClick" Tag="{x:Bind Id}"
                    Visibility="{x:Bind views:Fmt.VisChevron(Chevron)}" AutomationProperties.AutomationId="{x:Bind views:Fmt.ChevronId(Id)}" AutomationProperties.Name="Expand or collapse"
                    IsTabStop="False" VerticalAlignment="Center">
              <controls:SIcon Kind="{x:Bind views:Fmt.Chevron(Chevron)}" Size="11" StrokeWidth="2" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <controls:SIcon Kind="Bell" Size="12" Opacity="0.6" VerticalAlignment="Center" Visibility="{x:Bind views:Fmt.Vis(Muted)}" AutomationProperties.Name="Not subscribed" />
            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Visibility="{x:Bind views:Fmt.Vis(ChildUnread)}" AutomationProperties.Name="Unread below" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind Count}" FontFamily="{x:Bind theme:StyleState.Current.AppFont, Mode=OneWay}" FontSize="{x:Bind theme:StyleState.Current.FolderCountSize, Mode=OneWay}" FontWeight="{x:Bind theme:StyleState.Current.FolderCountWeight, Mode=OneWay}"
                       Opacity="0.62" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </DataTemplate>
      <!-- A tag row (prototype labels): a squircle dot in the tag colour and the name. -->
      <DataTemplate x:Key="TagTemplate" x:DataType="shell:TagRowViewModel">
        <!-- a click filters the list to the tag; a second click on it goes back (Bulwark sidebar.tsx:1181); the chevron folds the tags inside (nested tags); the selected tag takes sel / sel-text like a folder; a drop target for dragged messages (M2 hotfix) -->
        <Grid Background="{x:Bind views:Fmt.TagBg(Selected)}" CornerRadius="{x:Bind theme:StyleState.Current.TagRowRadius, Mode=OneWay}" ColumnDefinitions="*,Auto" AllowDrop="True" DragEnter="OnTagDragOver" DragOver="OnTagDragOver" DragLeave="OnTagDragLeave" Drop="OnTagDrop"
              AutomationProperties.AutomationId="{x:Bind Id}" AutomationProperties.Name="{x:Bind Label}">
          <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{x:Bind Id}" Click="OnTagClick" CornerRadius="{x:Bind theme:StyleState.Current.TagRowRadius, Mode=OneWay}"
                  Foreground="{x:Bind views:Fmt.TagFg(Selected)}" AutomationProperties.AutomationId="{x:Bind views:Fmt.TagButtonId(Id)}" AutomationProperties.Name="{x:Bind Label}">
            <Grid Padding="{x:Bind theme:StyleState.Current.TagRowPadding, Mode=OneWay}" ColumnSpacing="{x:Bind theme:StyleState.Current.TagSpacing, Mode=OneWay}" ColumnDefinitions="Auto,*">
              <StackPanel Orientation="Horizontal">
                <Border Width="{x:Bind views:Fmt.IndentPx(Depth)}" />
                <Border Width="10" Height="10" CornerRadius="4" Background="{x:Bind views:Fmt.Rgb(ColorRgb)}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontFamily="{x:Bind theme:StyleState.Current.AppFont, Mode=OneWay}" FontSize="{x:Bind theme:StyleState.Current.TagNameSize, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0" Tag="{x:Bind Id}" Click="OnTagChevronClick" IsTabStop="False"
                  Foreground="{x:Bind views:Fmt.TagFg(Selected)}" Visibility="{x:Bind views:Fmt.VisChevron(Chevron)}" AutomationProperties.AutomationId="{x:Bind views:Fmt.ChevronId(Id)}"
                  AutomationProperties.Name="Expand or collapse">
            <controls:SIcon Kind="{x:Bind views:Fmt.Chevron(Chevron)}" Size="11" StrokeWidth="2" />
          </Button>
        </Grid>
      </DataTemplate>
    </Grid.Resources>

    <!-- M2 plan 3.3 slots: the account header (menus, I-037) above New message and the unified inbox section (unified, wave 2) below it; the shared accounts section (unified) ends the scrolling part. -->
    <StackPanel Grid.Row="0">
    <ContentPresenter x:Name="AccountHeaderSlot" />
    <!-- New message: runs the compose command (M3 composer-ui). -->
    <Button x:Name="ComposeButton" Visibility="{x:Bind Look.SidebarComposeVisibility, Mode=OneWay}" Style="{StaticResource Button.Primary}" FocusVisualPrimaryThickness="{x:Bind Look.FocusThickness, Mode=OneWay}" HorizontalAlignment="Stretch" Click="OnComposeClick"
            Height="{x:Bind Look.ComposeHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ComposeRadius, Mode=OneWay}" Margin="{x:Bind Look.ComposeMargin, Mode=OneWay}"
            FontFamily="{x:Bind Look.AppBoldFont, Mode=OneWay}" FontSize="{x:Bind Look.ComposeFontSize, Mode=OneWay}"
            AutomationProperties.AutomationId="sidebar.compose" AutomationProperties.Name="Compose">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <controls:SIcon Kind="Pen" Size="18" Visibility="{x:Bind Look.BentoOnly, Mode=OneWay}" />
        <TextBlock Text="{x:Bind Look.ComposeLabel, Mode=OneWay}" />
      </StackPanel>
    </Button>
    <ContentPresenter x:Name="UnifiedSectionSlot" />
    </StackPanel>

    <!-- Folders and tags scroll together (prototype: one ScrollViewer under New message). -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <StackPanel>
    <!-- Folders: the heading folds the list (I-019); the settings button is M2. -->
    <Grid ColumnDefinitions="*,Auto,Auto" Padding="{x:Bind Look.FirstSectionHeaderPadding, Mode=OneWay}" AutomationProperties.AutomationId="sidebar.folders.header">
      <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Left" Padding="0" Click="OnFoldersHeaderClick" Foreground="{x:Bind Look.SectionHeaderBrush, Mode=OneWay}"
              AutomationProperties.AutomationId="sidebar.folders.toggle" AutomationProperties.Name="Folders section">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{x:Bind views:Fmt.SectionTitle('Folders', Look.IsBento), Mode=OneWay}" FontSize="{x:Bind Look.SectionHeaderSize, Mode=OneWay}" FontWeight="Bold"
                     CharacterSpacing="{x:Bind Look.SectionHeaderSpacing, Mode=OneWay}" />
          <controls:SIcon Kind="{x:Bind views:Fmt.ChevronOf(Sidebar.FoldersExpanded), Mode=OneWay}" Size="10" StrokeWidth="2.2" VerticalAlignment="Center" Opacity="0.8" />
        </StackPanel>
      </Button>
      <!-- "+" creates a top-level folder (Bulwark sidebar.tsx:848): the name is asked for in the prompt dialog -->
      <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Width="22" Height="22" CornerRadius="8" Foreground="{StaticResource Faint}" Margin="0,-4,0,-4" Click="OnNewFolderClick"
              motion:Tip.Text="New folder" AutomationProperties.AutomationId="sidebar.folders.add" AutomationProperties.Name="New folder">
        <controls:SIcon Kind="Plus" Size="13" StrokeWidth="2" />
      </Button>
      <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="22" Height="22" CornerRadius="8" IsEnabled="False" Foreground="{StaticResource Faint}" Margin="0,-4,0,-4"
              AutomationProperties.AutomationId="sidebar.folders.settings" AutomationProperties.Name="Folder settings">
        <controls:SIcon Kind="Opt" Size="13" />
      </Button>
    </Grid>
    <!-- M2 hotfix: folders are drag sources (reorder, nest) and drop targets (messages move there, a folder lands before, after or inside); SidebarView.xaml.cs -->
    <ListView x:Name="FolderList" ContainerContentChanging="OnFolderContainerChanging" ItemsSource="{x:Bind Sidebar.Folders}" ItemTemplate="{StaticResource FolderTemplate}" SelectionMode="Single"
              CanDragItems="True" AllowDrop="True" DragItemsStarting="OnFolderDragStarting" DragItemsCompleted="OnFolderDragCompleted"
              Visibility="{x:Bind views:Fmt.Vis(Sidebar.FoldersExpanded), Mode=OneWay}" SelectionChanged="OnFolderSelectionChanged" KeyDown="OnFolderKeyDown" Padding="0"
              AutomationProperties.AutomationId="sidebar.folders" AutomationProperties.Name="Folder list">
      <win:ListView.ItemContainerTransitions>
        <TransitionCollection />
      </win:ListView.ItemContainerTransitions>
    </ListView>

    <!-- Tags (the prototype's labels). Creating one is M2. -->
    <StackPanel Visibility="{x:Bind views:Fmt.VisCount(Sidebar.Tags.Count), Mode=OneWay}">
      <Grid ColumnDefinitions="*,Auto" Padding="{x:Bind Look.SectionHeaderPadding, Mode=OneWay}">
        <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Left" Padding="0" Click="OnTagsHeaderClick" Foreground="{x:Bind Look.SectionHeaderBrush, Mode=OneWay}"
                AutomationProperties.AutomationId="sidebar.tags.toggle" AutomationProperties.Name="Tags section">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{x:Bind views:Fmt.SectionTitle('Tags', Look.IsBento), Mode=OneWay}" FontSize="{x:Bind Look.SectionHeaderSize, Mode=OneWay}" FontWeight="Bold"
                       CharacterSpacing="{x:Bind Look.SectionHeaderSpacing, Mode=OneWay}" />
            <controls:SIcon Kind="{x:Bind views:Fmt.ChevronOf(Sidebar.TagsExpanded), Mode=OneWay}" Size="10" StrokeWidth="2.2" VerticalAlignment="Center" Opacity="0.8" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Width="22" Height="22" CornerRadius="8" Foreground="{StaticResource Faint}" Margin="0,-4,0,-4" Click="OnNewTagClick"
                motion:Tip.Text="New tag" AutomationProperties.AutomationId="sidebar.tags.add" AutomationProperties.Name="New tag">
          <controls:SIcon Kind="Plus" Size="13" StrokeWidth="2" />
        </Button>
      </Grid>
      <ItemsRepeater x:Name="TagRepeater" ItemsSource="{x:Bind Sidebar.Tags}" ItemTemplate="{StaticResource TagTemplate}" Visibility="{x:Bind views:Fmt.Vis(Sidebar.TagsExpanded), Mode=OneWay}"
                     AutomationProperties.AutomationId="sidebar.tags" AutomationProperties.Name="Tag list">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Vertical" Spacing="2" />
        </ItemsRepeater.Layout>
      </ItemsRepeater>
    </StackPanel>
    <ContentPresenter x:Name="SharedSectionSlot" />
    </StackPanel>
    </ScrollViewer>

    <!-- Storage (spec I-030): the text and, in Bento, the meter; the ring on the rail shows the same fraction. -->
    <StackPanel Grid.Row="2" Spacing="8" Padding="{x:Bind Look.StoragePadding, Mode=OneWay}" Visibility="{x:Bind views:Fmt.VisText(Sidebar.StorageText), Mode=OneWay}"
                AutomationProperties.AutomationId="sidebar.storage" AutomationProperties.Name="Storage">
      <TextBlock Text="{x:Bind Sidebar.StorageText, Mode=OneWay}" Style="{StaticResource Text.Meta}" />
      <Grid x:Name="Meter" Height="5" Visibility="{x:Bind views:Fmt.VisStorageMeter(Sidebar.StorageFraction, Look.IsBento), Mode=OneWay}" SizeChanged="OnMeterSizeChanged">
        <Border CornerRadius="2.5" Background="{StaticResource Track}" />
        <Border x:Name="MeterFill" CornerRadius="2.5" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="0" />
      </Grid>
    </StackPanel>
  </Grid>
  </Border>
</UserControl>
