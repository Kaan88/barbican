<?xml version="1.0" encoding="utf-8"?>
<!--
  The sidebar's own row, tool-button and header styles (WP-4, docs/milestones/bulwark-parity-gaps.md SB-03, SB-05): every row of the folders column (a folder, a tag, the
  all-inboxes row, a shared account) and every small control in it (a section's plus and gear, the disclosure chevron) takes one hover, pressed and selected feedback.
  Bulwark components/layout/sidebar.tsx:518-535 (row: transition-colors duration-150, hover bg-muted/50, selected bg-accent text-accent-foreground font-semibold with a 2 px
  primary border at the start, a transparent one otherwise), :549-552 (disclosure chevron: hover bg-muted, rounded), :808 (header buttons: hover bg-muted hover:text-foreground).
  Only shared tokens: FeedbackHover / FeedbackPressed / FeedbackSelected(Fg) / FeedbackIconHoverFg, the Color transition kind (150 ms), no scale or overshoot.
  The legacy styles (Bento, Nordic) keep their own selected pair (Sel / SelText): the views pick it from StyleState (Theme/StyleState.Sidebar.cs).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fb="using:Barbican.App.Motion">

  <!-- A flat button whose only feedback is the neutral hover and pressed fill (a row's hit surface, a section header). -->
  <ControlTemplate x:Key="Template.Sidebar.Flat" TargetType="Button">
    <Border x:Name="Box" fb:FeedbackTransition.Kind="Color" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackHover}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Box.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Border>
  </ControlTemplate>

  <!-- The same, and the icon takes the text colour on hover (the plus and gear of a header, the disclosure chevron: muted at rest, foreground on hover). -->
  <ControlTemplate x:Key="Template.Sidebar.Tool" TargetType="Button">
    <Border x:Name="Box" fb:FeedbackTransition.Kind="Color" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackHover}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackIconHoverFg}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackIconHoverFg}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Box.Opacity" Value="{StaticResource Motion.DisabledOpacity}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Border>
  </ControlTemplate>

  <Style x:Key="Button.Sidebar.Row" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Template.Sidebar.Flat}" />
    <!-- a Button does not stretch by default: without these a content-less hit surface is 0 wide -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="2" />
  </Style>

  <Style x:Key="Button.Sidebar.Tool" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource Template.Sidebar.Tool}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <!-- A folder row of the Bulwark style (sidebar.tsx:518-535): square, the selection is the accent fill with accent text, semibold, and a 2 px primary bar at the start.
       The content starts after the bar (a transparent 2 px border on the others), so a selection moves nothing. -->
  <ControlTemplate x:Key="Template.Sidebar.FolderItem" TargetType="ListViewItem">
    <Grid x:Name="Root" Background="Transparent">
      <Border x:Name="Box" fb:FeedbackTransition.Kind="Color" Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
      <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{StaticResource Body}"
                        Margin="{TemplateBinding BorderThickness}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackHover}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Selected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackSelected}" />
              <Setter Target="Box.BorderBrush" Value="{StaticResource Accent}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackSelectedFg}" />
              <Setter Target="Content.FontWeight" Value="SemiBold" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOverSelected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackSelected}" />
              <Setter Target="Box.BorderBrush" Value="{StaticResource Accent}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackSelectedFg}" />
              <Setter Target="Content.FontWeight" Value="SemiBold" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PressedSelected">
            <VisualState.Setters>
              <Setter Target="Box.Background" Value="{StaticResource FeedbackPressed}" />
              <Setter Target="Box.BorderBrush" Value="{StaticResource Accent}" />
              <Setter Target="Content.Foreground" Value="{StaticResource FeedbackSelectedFg}" />
              <Setter Target="Content.FontWeight" Value="SemiBold" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <Style x:Key="ListItem.Sidebar.Bulwark" TargetType="ListViewItem">
    <Setter Property="Template" Value="{StaticResource Template.Sidebar.FolderItem}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="2" />
  </Style>
</ResourceDictionary>
