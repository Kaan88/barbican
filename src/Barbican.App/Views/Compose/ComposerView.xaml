<UserControl
    x:Class="Barbican.App.Views.Compose.ComposerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Barbican.App.Controls"
    xmlns:compose="using:Barbican.App.Views.Compose">
  <!-- The composer pane (M3 plan 6.4; Bulwark components/email/email-composer.tsx): it takes the reader's place, or sits under the reader when it answers a message (ComposerDock).
       Laid out as the reader pane (same tile, hairline and radius from StyleState): the title row (what it is, the discard and close buttons), the header (From, To with the Cc and Bcc toggles, Cc, Bcc, Subject, the
       attachments), the body (the editor control, or a plain text box while no editor is registered) beside the assistant slot (M6), and the footer (Send with its arrow, Templates, Attach, Options, the save status).
       Templates, From, Options and the Send menu are cards on the scrim of CardLayer, inside the pane. The questions (leave, discard, send warnings, external recipients, schedule) are dialogs of the shared dialog host (ComposerView.Questions.cs, CP-07). -->
  <Grid x:Name="Host" AllowDrop="True" AutomationProperties.AutomationId="composer.host">
    <Border x:Name="Pane" BorderBrush="{StaticResource Line}"
            MinWidth="320" MinHeight="260" AutomationProperties.AutomationId="composer" AutomationProperties.Name="New message">
      <Border x:Name="InnerBorder" BorderBrush="{StaticResource Line}">
        <Grid x:Name="Inner" RowSpacing="10" RowDefinitions="Auto,Auto,*,Auto">
          <!-- title row -->
          <Grid x:Name="TitleRow" Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="TitleText" Text="New message" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="composer.title" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <StackPanel x:Name="AddOnActions" Orientation="Horizontal" Spacing="4" Visibility="Collapsed" />
                <Button x:Name="AddOnMore" Content="&#x22EF;" Width="32" Height="32" Padding="0" Visibility="Collapsed"
                        AutomationProperties.AutomationId="composer.addons" AutomationProperties.Name="Add-on actions">
                  <Button.Flyout>
                    <MenuFlyout x:Name="AddOnMenu" win:ShouldConstrainToRootBounds="True" />
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </Grid>
            <Button x:Name="DiscardButton" Grid.Column="1" Style="{StaticResource Button.Icon}" Width="32" Height="32" CornerRadius="16" Click="OnDiscardClick" AutomationProperties.AutomationId="composer.discard" AutomationProperties.Name="Discard draft">
              <controls:SIcon Kind="Trash" Size="16" />
            </Button>
            <Button x:Name="MaximizeButton" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource Button.Icon}"
                    Width="32" Height="32" Padding="0" CornerRadius="6" Click="OnMaximizeClick"
                    AutomationProperties.AutomationId="composer.maximize" AutomationProperties.Name="Maximize composer">
              <FontIcon x:Name="MaximizeGlyph" Glyph="&#xE740;" FontSize="16" />
            </Button>
            <Button x:Name="WindowButton" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource Button.Icon}"
                    Width="32" Height="32" Padding="0" Click="OnWindowClick" AutomationProperties.AutomationId="composer.window" AutomationProperties.Name="Open in a new window">
              <FontIcon x:Name="WindowGlyph" Glyph="&#xE8A7;" FontSize="16" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource Button.Icon}" Width="32" Height="32" CornerRadius="16" Click="OnCloseClick" AutomationProperties.AutomationId="composer.close" AutomationProperties.Name="Close">
              <controls:SIcon Kind="Close" Size="16" />
            </Button>
          </Grid>

          <!-- header -->
          <StackPanel x:Name="Fields" Grid.Row="1" Spacing="0">
            <Grid x:Name="FromRow" MinHeight="34" ColumnSpacing="10" AutomationProperties.AutomationId="composer.from">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FromLabelColumn" Width="54" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FromLabel" Text="From" FontSize="12.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
              <TextBlock x:Name="FromText" Grid.Column="1" FontSize="13" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="composer.from.text" />
              <Button x:Name="FromButton" Grid.Column="2" Style="{StaticResource Button.Icon}" Width="28" Height="28" CornerRadius="14" Click="OnFromClick" AutomationProperties.AutomationId="composer.from.change" AutomationProperties.Name="Change sender">
                <controls:SIcon Kind="ChevronDown" Size="14" />
              </Button>
            </Grid>
            <Border Height="1" Background="{StaticResource Line}" />
            <compose:RecipientFieldView x:Name="ToField" Label="To" />
            <Border Height="1" Background="{StaticResource Line}" />
            <StackPanel x:Name="CcBox" Visibility="Collapsed">
              <compose:RecipientFieldView x:Name="CcField" Label="Cc" />
              <Border Height="1" Background="{StaticResource Line}" />
            </StackPanel>
            <StackPanel x:Name="BccBox" Visibility="Collapsed">
              <compose:RecipientFieldView x:Name="BccField" Label="Bcc" />
              <Border Height="1" Background="{StaticResource Line}" />
            </StackPanel>
            <Grid x:Name="SubjectRow" MinHeight="36" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SubjectLabelColumn" Width="54" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SubjectLabel" Text="Subject" FontSize="12.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextWrapping="NoWrap" />
              <TextBox x:Name="SubjectBox" Grid.Column="1" Style="{StaticResource TextBox.Bare}" FontSize="14" FontWeight="SemiBold" VerticalContentAlignment="Center" MinHeight="30" TextChanged="OnSubjectChanged"
                       AutomationProperties.AutomationId="composer.subject" AutomationProperties.Name="Subject" />
            </Grid>
            <Border Height="1" Background="{StaticResource Line}" />
            <Grid x:Name="ClassificationRow" Visibility="Collapsed" MinHeight="40" ColumnSpacing="10" Padding="0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="Classification" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
              <Button x:Name="ClassificationPicker" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      AutomationProperties.AutomationId="composer.classification" AutomationProperties.Name="Classification">
                <Button.Flyout><MenuFlyout x:Name="ClassificationMenu" win:ShouldConstrainToRootBounds="True" /></Button.Flyout>
              </Button>
            </Grid>
            <ItemsControl x:Name="AttachmentList" Margin="0,8,0,0" AutomationProperties.AutomationId="composer.attachments" AutomationProperties.Name="Attachments" Visibility="Collapsed">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <compose:ChipPanel MinLast="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <!-- body: the editor (or the stand-in text box) and the assistant slot -->
          <Grid x:Name="BodyRow" Grid.Row="2" ColumnSpacing="10" MinHeight="120">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentPresenter x:Name="BodyHost" AutomationProperties.AutomationId="composer.body.host" />
            <Border x:Name="AssistantSlot" Grid.Column="1" Visibility="Collapsed" AutomationProperties.AutomationId="composer.assistant" AutomationProperties.Name="Assistant" />
            <Button x:Name="ProofreadingButton" Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,0,4" MinHeight="32"
                    Style="{StaticResource Button.Action}" Visibility="Collapsed" AutomationProperties.AutomationId="composer.proofreading"
                    AutomationProperties.Name="Proofreading">
              <Button.Flyout><MenuFlyout x:Name="ProofreadingMenu" win:ShouldConstrainToRootBounds="True" /></Button.Flyout>
            </Button>
          </Grid>

          <!-- footer -->
          <Grid x:Name="Footer" Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AttachButton" Grid.Column="2" Style="{StaticResource Button.Action}" Height="36" CornerRadius="18" Click="OnAttachClick" AutomationProperties.AutomationId="composer.attach" AutomationProperties.Name="Attach files">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Clip" Size="15" /><TextBlock x:Name="AttachLabel" Text="Attach" /></StackPanel>
            </Button>
            <Button x:Name="TemplatesButton" Grid.Column="1" Style="{StaticResource Button.Action}" Height="36" CornerRadius="18" Click="OnTemplatesClick" AutomationProperties.AutomationId="composer.templates" AutomationProperties.Name="Templates">
              <Button.Flyout>
                <MenuFlyout x:Name="TemplatesMenu" win:ShouldConstrainToRootBounds="True" Placement="TopEdgeAlignedLeft">
                  <MenuFlyoutItem Text="Insert template" Click="OnTemplatesMenuItem" AutomationProperties.AutomationId="composer.templates.insert"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                  <MenuFlyoutItem Text="Save as template" Click="OnTemplatesMenuItem" AutomationProperties.AutomationId="composer.templates.save"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                </MenuFlyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Tpl" Size="15" /><TextBlock x:Name="TemplatesLabel" Text="Templates" /><controls:SIcon x:Name="TemplatesChevron" Kind="ChevronDown" Size="14" Foreground="{StaticResource Faint}" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <Button x:Name="OptionsButton" Grid.Column="3" Style="{StaticResource Button.Action}" Height="36" CornerRadius="18" Click="OnOptionsClick" AutomationProperties.AutomationId="composer.options" AutomationProperties.Name="Options">
              <Button.Flyout>
                <MenuFlyout x:Name="OptionsMenu" win:ShouldConstrainToRootBounds="True" Placement="TopEdgeAlignedLeft">
                  <ToggleMenuFlyoutItem x:Name="OptionsPlain" Text="Plain text" Click="OnOptionsPlain" AutomationProperties.AutomationId="composer.options.plain" />
                  <ToggleMenuFlyoutItem x:Name="OptionsReceipt" Text="Request a read receipt" Click="OnOptionsReceipt" AutomationProperties.AutomationId="composer.options.receipt" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Priority" IsEnabled="False" />
                  <RadioMenuFlyoutItem x:Name="OptionsHigh" Text="High" GroupName="composer.priority" Click="OnOptionsPriority" AutomationProperties.AutomationId="composer.options.priority.high" />
                  <RadioMenuFlyoutItem x:Name="OptionsNormal" Text="Normal" GroupName="composer.priority" Click="OnOptionsPriority" AutomationProperties.AutomationId="composer.options.priority.normal" />
                  <RadioMenuFlyoutItem x:Name="OptionsLow" Text="Low" GroupName="composer.priority" Click="OnOptionsPriority" AutomationProperties.AutomationId="composer.options.priority.low" />
                </MenuFlyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Opt" Size="15" /><TextBlock x:Name="OptionsLabel" Text="Options" />
                <Border x:Name="OptionsBadge" Visibility="Collapsed" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0" Background="{StaticResource Accent}" VerticalAlignment="Center" AutomationProperties.AutomationId="composer.options.count">
                  <TextBlock x:Name="OptionsBadgeText" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <controls:SIcon x:Name="OptionsChevron" Kind="ChevronDown" Size="14" Foreground="{StaticResource Faint}" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <StackPanel x:Name="SendGroup" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button x:Name="FooterDiscard" Style="{StaticResource Button.Icon}" Width="36" Height="36" CornerRadius="6" Visibility="Collapsed" PointerEntered="OnFooterDiscardEnter" PointerExited="OnFooterDiscardExit" Click="OnDiscardClick" AutomationProperties.AutomationId="composer.footer.discard" AutomationProperties.Name="Discard draft">
                <controls:SIcon Kind="Trash" Size="16" />
              </Button>
              <StackPanel x:Name="SendPair" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="SendButton" Style="{StaticResource Button.Primary}" Height="36" CornerRadius="18,0,0,18" Padding="18,0,14,0" Click="OnSendClick" AutomationProperties.AutomationId="composer.send" AutomationProperties.Name="Send">
                  <StackPanel Orientation="Horizontal" Spacing="7"><controls:SIcon Kind="Send" Size="15" Foreground="{StaticResource OnAccent}" /><TextBlock Text="Send" /></StackPanel>
                </Button>
                <Border x:Name="SendDivider" Width="1" Height="36" Background="{StaticResource Accent}" Visibility="Collapsed">
                  <Border Background="{StaticResource OnAccent}" Opacity="0.2" />
                </Border>
                <Button x:Name="SendArrow" Style="{StaticResource Button.Primary}" Height="36" Width="34" CornerRadius="0,18,18,0" Padding="0" Click="OnSendArrowClick" AutomationProperties.AutomationId="composer.send.arrow" AutomationProperties.Name="More send options">
                  <controls:SIcon Kind="ChevronDown" Size="14" Foreground="{StaticResource OnAccent}" />
                </Button>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="composer.status" AutomationProperties.Name="Save status" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <!-- dropping files: the overlay says what happens (I-242) -->
    <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="10" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource Accent}" Background="{StaticResource Sel}" Opacity="0.92"
            AutomationProperties.AutomationId="composer.drop">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <controls:SIcon Kind="Clip" Size="28" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
        <TextBlock Text="Drop files to attach them" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- the cards: templates, From, Options, the Send menu -->
    <Grid x:Name="CardLayer" Visibility="Collapsed" Background="#66000000" AutomationProperties.AutomationId="composer.cards" Tapped="OnScrimTapped">
      <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320" MaxWidth="460" Margin="12" Padding="20" CornerRadius="16" Background="{StaticResource Popup}"
              BorderBrush="{StaticResource Line}" BorderThickness="1" Tapped="OnCardTapped" />
    </Grid>
  </Grid>
</UserControl>
