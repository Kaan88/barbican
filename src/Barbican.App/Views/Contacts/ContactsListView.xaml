<UserControl
    x:Class="Barbican.App.Views.Contacts.ContactsListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Barbican.App.Views.Contacts"
    xmlns:controls="using:Barbican.App.Controls"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="not_win">
  <!-- The people list (Rust app.slint contacts list; Bulwark components/contacts/contact-list.tsx:408-440 toolbar h-14 with select, search + filter, print; :440-520 filter panel; :522-600 bulk bar; :600-700 rows and empty states, contact-list-item.tsx rows).
       Bulwark: one toolbar row, a filter panel, a bulk bar, full-width rows. Bento and Nordic keep the title row and the rounded rows. A ListView, so 600 contacts are virtualised. Every control is in the window (ADR 0007). -->
  <UserControl.Resources>
    <!-- Bento and Nordic: the rounded cards, spaced by a 2 px margin (the stock template draws no border of its own) -->
    <Style x:Key="ContactsLegacyRow" TargetType="ListViewItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" AutomationProperties.AutomationId="contacts.list" AutomationProperties.Name="Contacts list">
    <!-- Head: Bulwark (select toggle | search with filter | print); Bento and Nordic (title, count, import, export, select, then the search on its own row). ApplyLook places the parts. -->
    <Border x:Name="HeadBox" BorderBrush="{StaticResource Line}">
      <Grid x:Name="Head" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
        <StackPanel x:Name="LegacyTitle" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="4,0,0,0">
          <TextBlock x:Name="Title" Text="Contacts" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Text}" AutomationProperties.AutomationId="contacts.title" />
          <TextBlock x:Name="Count" FontSize="12.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" AutomationProperties.AutomationId="contacts.count" />
        </StackPanel>
        <Button Grid.Column="2" x:Name="ImportButton" Style="{StaticResource Button.Icon}" Width="30" Height="30" CornerRadius="10" Click="OnImport" AutomationProperties.AutomationId="contacts.import" AutomationProperties.Name="Import contacts" />
        <Button Grid.Column="3" x:Name="ExportButton" Style="{StaticResource Button.Icon}" Width="30" Height="30" CornerRadius="10" Click="OnExport" AutomationProperties.AutomationId="contacts.export" AutomationProperties.Name="Export contacts" />
        <!-- contact-list.tsx:411-430 the select toggle: tinted while anything is ticked (toolbar.tsx TOOLBAR_ACTIVE) -->
        <ToggleButton Grid.Column="4" x:Name="SelectButton" Style="{StaticResource ToggleButton.Icon}" Width="32" Height="32" CornerRadius="6" Click="OnSelectMode" AutomationProperties.AutomationId="contacts.select-mode" AutomationProperties.Name="Select contacts" />
        <!-- toolbar.tsx:60-141 the search field: a 32 px input with the glyph at the start, the clear button and the filter toggle at the end -->
        <Grid Grid.Row="1" Grid.ColumnSpan="5" x:Name="SearchField">
          <TextBox x:Name="Search" PlaceholderText="Search contacts..." VerticalAlignment="Center" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown"
                   AutomationProperties.AutomationId="contacts.search" AutomationProperties.Name="Search contacts" />
          <controls:SIcon x:Name="SearchGlyph" Kind="Search" Size="16" Foreground="{StaticResource Dim}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
            <Button x:Name="ClearSearch" Style="{StaticResource Button.Icon}" Width="24" Height="24" CornerRadius="6" Visibility="Collapsed" Click="OnClearSearch" AutomationProperties.AutomationId="contacts.search.clear" AutomationProperties.Name="Clear search" />
            <ToggleButton x:Name="FilterToggle" Style="{StaticResource ToggleButton.Icon}" Width="24" Height="24" CornerRadius="6" Click="OnFilterToggle" AutomationProperties.AutomationId="contacts.filters" AutomationProperties.Name="Filters">
              <Grid>
                <controls:SIcon x:Name="FilterGlyph" Kind="Filter" Size="16" />
                <Border x:Name="FilterBadge" Visibility="Collapsed" MinWidth="16" Height="16" CornerRadius="8" Background="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0" Padding="3,0">
                  <TextBlock x:Name="FilterBadgeText" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </ToggleButton>
          </StackPanel>
        </Grid>
        <Button Grid.Column="2" x:Name="PrintButton" Style="{StaticResource Button.Icon}" Width="32" Height="32" CornerRadius="6" Visibility="Collapsed" Click="OnPrint" AutomationProperties.AutomationId="contacts.print" AutomationProperties.Name="Print" />
      </Grid>
    </Border>
    <!-- contact-list.tsx:440-520 the filter panel: border-b, muted/30, px-4 py-3 -->
    <Border Grid.Row="1" x:Name="FilterPanel" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12" AutomationProperties.AutomationId="contacts.filter-panel">
      <StackPanel x:Name="FilterBody" Spacing="12" />
    </Border>
    <Border Grid.Row="2" x:Name="Notice" Visibility="Collapsed" CornerRadius="12" Padding="12,6,8,6" Margin="0,8,0,0" Background="{StaticResource RoseBg}" AutomationProperties.AutomationId="contacts.error">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock x:Name="NoticeText" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource RoseFg}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="contacts.error.text" />
        <Button Grid.Column="1" Content="Retry" Style="{StaticResource Button.Action}" Height="30" CornerRadius="10" FontSize="12.5" Click="OnRetry" AutomationProperties.AutomationId="contacts.error.retry" AutomationProperties.Name="Retry" />
      </Grid>
    </Border>
    <!-- Bento and Nordic bulk bar; Bulwark's is built in code (BulkBarBulwark) -->
    <Grid Grid.Row="3" x:Name="BulkBar" Visibility="Collapsed" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,8,0,0" AutomationProperties.AutomationId="contacts.bulk">
      <TextBlock x:Name="BulkCount" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}" VerticalAlignment="Center" AutomationProperties.AutomationId="contacts.bulk.count" />
      <Button Grid.Column="1" Content="Select all" Style="{StaticResource Button.Action}" Height="30" CornerRadius="10" FontSize="12.5" Click="OnSelectAll" AutomationProperties.AutomationId="contacts.bulk.all" AutomationProperties.Name="Select all" />
      <Button Grid.Column="2" x:Name="BulkDelete" Content="Delete" Style="{StaticResource Button.Action}" Height="30" CornerRadius="10" FontSize="12.5" Foreground="{StaticResource RoseFg}" Click="OnBulkDelete" AutomationProperties.AutomationId="contacts.bulk.delete" AutomationProperties.Name="Delete selected" />
      <Button Grid.Column="3" Content="Done" Style="{StaticResource Button.Primary}" Height="30" CornerRadius="10" FontSize="12.5" Click="OnSelectMode" AutomationProperties.AutomationId="contacts.bulk.done" AutomationProperties.Name="Done" />
    </Grid>
    <Border Grid.Row="3" x:Name="BulkBarBulwark" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,6" AutomationProperties.AutomationId="contacts.bulk.bulwark" />
    <ListView Grid.Row="4" x:Name="List" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick" RightTapped="OnRightTapped" DoubleTapped="OnDoubleTapped"
              AutomationProperties.AutomationId="contacts.rows" AutomationProperties.Name="Contacts" Padding="0,2,0,8">
      <win:ListView.ItemContainerTransitions>
        <TransitionCollection />
      </win:ListView.ItemContainerTransitions>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:ContactsListItem">
          <Grid>
            <Border Visibility="{x:Bind HeaderVisible}" Height="{x:Bind HeaderHeight}" Padding="{x:Bind HeaderPadding}" Background="{x:Bind HeaderBackground}">
              <TextBlock Text="{x:Bind Letter}" FontSize="{x:Bind HeaderSize}" FontWeight="{x:Bind HeaderWeight}" Foreground="{x:Bind HeaderBrush}" VerticalAlignment="Center" />
            </Border>
            <Grid Visibility="{x:Bind RowVisible}" Height="{x:Bind RowHeight}" Padding="{x:Bind RowPadding}" ColumnDefinitions="Auto,Auto,*" CornerRadius="{x:Bind RowCorner}" Background="{x:Bind RowBackground}"
                  BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind RowBorder}">
              <Grid Width="16" Height="16" Margin="0,0,12,0" Visibility="{x:Bind CheckVisible}" VerticalAlignment="Center">
                <Border BorderBrush="{x:Bind CheckBrush}" BorderThickness="1.5" CornerRadius="3" />
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{x:Bind CheckBrush}" Visibility="{x:Bind CheckMarkVisible}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <Border Grid.Column="1" Width="{x:Bind AvatarSize}" Height="{x:Bind AvatarSize}" Margin="0,0,12,0" CornerRadius="{x:Bind AvatarRadius}" Background="{x:Bind AvatarBackground}" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind InitialsVisible}" FontSize="{x:Bind AvatarFontSize}" FontWeight="{x:Bind AvatarWeight}" Foreground="{x:Bind AvatarForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Name}" FontSize="{x:Bind NameSize}" FontWeight="{x:Bind NameWeight}" Foreground="{x:Bind NameBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Email}" Visibility="{x:Bind EmailVisible}" FontSize="12" Foreground="{x:Bind SubBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <!-- ui/empty-state.tsx:28-45 (compact): a 56 px muted circle with a 28 px icon, a 16 px medium title, a 14 px description, the actions 20 px below -->
    <StackPanel Grid.Row="4" x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" Padding="24" AutomationProperties.AutomationId="contacts.empty">
      <Border x:Name="EmptyBadge" Width="56" Height="56" CornerRadius="28" Background="{StaticResource Track}" HorizontalAlignment="Center" Margin="0,0,0,16">
        <controls:SIcon x:Name="EmptyIcon" Kind="Users" Size="28" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock x:Name="Empty" FontSize="16" FontWeight="Medium" Foreground="{StaticResource Text}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="contacts.empty.title" />
      <TextBlock x:Name="EmptyHint" FontSize="14" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.AutomationId="contacts.empty.hint" />
      <StackPanel x:Name="EmptyActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,20,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
