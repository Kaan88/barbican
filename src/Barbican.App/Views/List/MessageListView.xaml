<UserControl
    x:Class="Barbican.App.Views.List.MessageListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="not_win"
    xmlns:controls="using:Barbican.App.Controls"
    xmlns:theme="using:Barbican.App.Theme"
    xmlns:views="using:Barbican.App.Views"
    xmlns:local="using:Barbican.App.Views.List"
    xmlns:mail="using:Barbican.Presentation.Mail">
  <!-- The message list (spec/layout/mail-list.md; BNMail section, NordMail section): header with title, unread pill, greeting and search; date-group headers and message rows;
       thread count, preview, attachment chips; unread first section; more on scroll. Rows come from MessageListViewModel.Rows (ListSync: only changed rows are touched).
       No item transitions, no selection animation (design/MOTION.md rules 1 and 3); a folder change lifts the rows once (Motion/Rise). -->
  <Border x:Name="Pane" Background="{x:Bind Look.PaneBrush, Mode=OneWay}" BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind Look.PaneBorder, Mode=OneWay}"
          CornerRadius="{x:Bind Look.ListRadius, Mode=OneWay}" AutomationProperties.AutomationId="list" AutomationProperties.Name="Messages">
    <Border BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind Look.ListHairline, Mode=OneWay}" CornerRadius="{x:Bind Look.ListRadius, Mode=OneWay}">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid.Resources>
          <DataTemplate x:Key="HeaderTemplate" x:DataType="mail:GroupHeaderViewModel">
            <Grid Height="30" Padding="{x:Bind theme:StyleState.Current.GroupHeaderPadding, Mode=OneWay}" AutomationProperties.Name="{x:Bind Title}">
              <TextBlock Text="{x:Bind Title}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
          <DataTemplate x:Key="MessageTemplate" x:DataType="mail:MessageRowViewModel">
            <!-- prototype rows: Bento avatar + sender 14 / subject 13.5 body / preview 12.5 faint; Nordic dot + sender 14 / subject 14 / preview 13 dim, indented 15 -->
            <Grid Padding="{x:Bind theme:StyleState.Current.MessageRowPadding, Mode=OneWay}" ColumnSpacing="{x:Bind theme:StyleState.Current.MessageRowSpacing, Mode=OneWay}"
                  ColumnDefinitions="Auto,*" PointerEntered="OnRowEntered" PointerExited="OnRowExited" GotFocus="OnRowFocused">
              <Border Width="38" Height="38" VerticalAlignment="Top" Visibility="{x:Bind theme:StyleState.Current.ShowAvatar, Mode=OneWay}"
                      CornerRadius="{x:Bind theme:StyleState.Current.AvatarRadius, Mode=OneWay}" Background="{x:Bind views:Fmt.TintBg(TintIndex)}" Tapped="OnAvatarTapped"
                      AutomationProperties.AutomationId="row.tick" AutomationProperties.Name="Select message">
                <Grid>
                  <TextBlock Text="{x:Bind Initials}" FontSize="13" FontWeight="Bold" Foreground="{x:Bind views:Fmt.TintFg(TintIndex)}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <!-- the selectable avatar (selectable-avatar.tsx): a ticked row shows the check in place of the initials -->
                  <Border Background="{StaticResource Accent}" CornerRadius="{x:Bind theme:StyleState.Current.AvatarRadius, Mode=OneWay}" Visibility="{x:Bind views:Fmt.Vis(IsChecked), Mode=OneWay}">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Spacing="1" MinWidth="0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                  <Ellipse Width="7" Height="7" Fill="{x:Bind views:Fmt.UnreadDot(Unread)}" Visibility="{x:Bind views:Fmt.DotVis(Unread, theme:StyleState.Current.IsNordic), Mode=OneWay}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Sender}" FontSize="{x:Bind theme:StyleState.Current.SenderSize, Mode=OneWay}" FontWeight="{x:Bind views:Fmt.SenderWeight(Unread, theme:StyleState.Current.IsNordic), Mode=OneWay}"
                             Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2" CornerRadius="8" Padding="6,0" Background="{StaticResource Track}" Visibility="{x:Bind views:Fmt.VisMany(ThreadCount)}" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind views:Fmt.Thread(ThreadCount)}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <controls:SIcon Grid.Column="3" Kind="Star" Size="12" Foreground="{StaticResource AmberFg}" Visibility="{x:Bind views:Fmt.Vis(Flagged)}" VerticalAlignment="Center" />
                  <controls:SIcon Grid.Column="4" Kind="Clip" Size="12" Foreground="{StaticResource Faint}" Visibility="{x:Bind views:Fmt.VisClip(HasAttachment, AttachmentNames.Count)}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="{x:Bind TimeLabel}" FontSize="12" FontWeight="{x:Bind views:Fmt.RowTimeWeight(theme:StyleState.Current.IsNordic), Mode=OneWay}"
                             Foreground="{x:Bind views:Fmt.RowTimeBrush(Unread, theme:StyleState.Current.IsNordic), Mode=OneWay}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock local:Snippet.Id="{x:Bind Id}" local:Snippet.Part="subject" local:Snippet.Plain="{x:Bind Subject}" FontSize="{x:Bind theme:StyleState.Current.SubjectSize, Mode=OneWay}" FontWeight="{x:Bind views:Fmt.SubjectWeight(Unread, theme:StyleState.Current.IsNordic), Mode=OneWay}"
                           Foreground="{x:Bind theme:StyleState.Current.SubjectBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" Margin="{x:Bind theme:StyleState.Current.SubjectMargin, Mode=OneWay}" />
                <TextBlock local:Snippet.Id="{x:Bind Id}" local:Snippet.Part="preview" local:Snippet.Plain="{x:Bind Preview}" FontSize="{x:Bind theme:StyleState.Current.PreviewSize, Mode=OneWay}" Foreground="{x:Bind theme:StyleState.Current.PreviewBrush, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" Margin="{x:Bind theme:StyleState.Current.PreviewMargin, Mode=OneWay}" />
                <ItemsRepeater ItemsSource="{x:Bind views:Fmt.Chips(AttachmentNames)}" Visibility="{x:Bind views:Fmt.VisChips(AttachmentNames.Count)}" Margin="0,4,0,0"
                               AutomationProperties.Name="Attachments">
                  <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Height="20" MaxWidth="140" CornerRadius="10" Padding="8,0" Background="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <controls:SIcon Kind="Clip" Size="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                          <TextBlock Text="{x:Bind}" FontSize="10.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>
              <!-- the hover strip (email-hover-actions.tsx): one frame in, no animation; real hover and keyboard focus show it, `hover-sim` drives it in automation -->
              <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0" Padding="4" CornerRadius="10" Background="{StaticResource Popup}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" Visibility="{x:Bind views:Fmt.Vis(IsHovered), Mode=OneWay}" AutomationProperties.AutomationId="row.strip" AutomationProperties.Name="Message actions">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Style="{StaticResource Button.Chip}" Content="Delete" Tag="mail.delete" Click="OnStripClick" AutomationProperties.AutomationId="strip.delete" AutomationProperties.Name="Delete" />
                  <Button Style="{StaticResource Button.Chip}" Content="Star" Tag="mail.toggle-star" Click="OnStripClick" AutomationProperties.AutomationId="strip.star" AutomationProperties.Name="Star" />
                  <Button Style="{StaticResource Button.Chip}" Content="Read" Tag="mail.toggle-read" Click="OnStripClick" AutomationProperties.AutomationId="strip.read" AutomationProperties.Name="Read" />
                  <Button Style="{StaticResource Button.Chip}" Content="Archive" Tag="mail.archive" Click="OnStripClick" AutomationProperties.AutomationId="strip.archive" AutomationProperties.Name="Archive" />
                </StackPanel>
              </Border>
            </Grid>
          </DataTemplate>
          <local:MessageRowTemplateSelector x:Key="RowSelector" MessageTemplate="{StaticResource MessageTemplate}" HeaderTemplate="{StaticResource HeaderTemplate}" />
        </Grid.Resources>

        <!-- Header (prototype ListHead): Bento title 24 bold with "N unread" on the right; Nordic title 28 extra bold, tight, and the greeting under it. Search stays (M1). -->
        <StackPanel Grid.Row="0" Padding="{x:Bind Look.ListHeaderPadding, Mode=OneWay}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Bind Glance.ListTitle, Mode=OneWay}" FontSize="{x:Bind Look.ListTitleSize, Mode=OneWay}" FontWeight="{x:Bind Look.ListTitleWeight, Mode=OneWay}"
                       CharacterSpacing="{x:Bind Look.ListTitleSpacing, Mode=OneWay}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="list.title" AutomationProperties.Name="Folder title" />
            <TextBlock Grid.Column="1" Text="{x:Bind views:Fmt.UnreadText(Glance.ListUnread), Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                       Visibility="{x:Bind Look.BentoOnly, Mode=OneWay}" AutomationProperties.AutomationId="list.unread" AutomationProperties.Name="Unread count" />
          </Grid>
          <TextBlock Text="{x:Bind Glance.ListSubtitle, Mode=OneWay}" FontSize="13" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,-8,0,0"
                     Visibility="{x:Bind Look.NordicOnly, Mode=OneWay}" />
          <ContentPresenter x:Name="SearchSlot" />
        </StackPanel>

        <!-- A load failure shows as a status line; the old rows stay. -->
        <StackPanel Grid.Row="1">
          <TextBlock Text="{x:Bind List.Error, Mode=OneWay}" Foreground="{StaticResource RoseFg}" FontSize="12" TextWrapping="Wrap" Margin="20,0,20,8"
                     Visibility="{x:Bind views:Fmt.VisText(List.Error), Mode=OneWay}" AutomationProperties.AutomationId="list.error" AutomationProperties.Name="List error" />
          <!-- M2 plan 3.3: the selection bar (stream actions) -->
          <ContentPresenter x:Name="SelectionBarSlot" />
        </StackPanel>

        <ListView Grid.Row="2" x:Name="Rows" RenderTransformOrigin="0,0" ItemsSource="{x:Bind List.Rows}" ItemTemplateSelector="{StaticResource RowSelector}" SelectionMode="Single" Padding="{x:Bind Look.ListPadding, Mode=OneWay}"
                  SelectionChanged="OnSelectionChanged" ContainerContentChanging="OnContainerContentChanging" win:ShowsScrollingPlaceholders="False"
                  AutomationProperties.AutomationId="list.rows" AutomationProperties.Name="Message list">
          <win:ListView.ItemContainerTransitions>
            <TransitionCollection />
          </win:ListView.ItemContainerTransitions>
        </ListView>
        <TextBlock Grid.Row="2" x:Name="EmptyText" Text="No messages" FontSize="13" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,44,0,0" Visibility="Collapsed"
                   IsHitTestVisible="False" AutomationProperties.AutomationId="list.empty" AutomationProperties.Name="No messages" />
      </Grid>
    </Border>
  </Border>
</UserControl>
