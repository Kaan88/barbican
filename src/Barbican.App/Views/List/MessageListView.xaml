<UserControl
    x:Class="Barbican.App.Views.List.MessageListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="using:Barbican.App.Motion"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="not_win"
    xmlns:controls="using:Barbican.App.Controls"
    xmlns:theme="using:Barbican.App.Theme"
    xmlns:views="using:Barbican.App.Views"
    xmlns:local="using:Barbican.App.Views.List"
    xmlns:mail="using:Barbican.Presentation.Mail">
  <!-- The message list (spec/layout/mail-list.md; BNMail section, NordMail section): header with title, unread pill, greeting and search; date-group headers and message rows;
       thread count, preview, attachment chips; unread first section; more on scroll. Rows come from MessageListViewModel.Rows (ListSync: only changed rows are touched).
       No item transitions, no selection animation (design/MOTION.md rules 1 and 3); a folder change lifts the rows once (Motion/Rise). -->
  <Border x:Name="Pane" Background="{x:Bind Look.ListBrush, Mode=OneWay}" BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind Look.ListBorder, Mode=OneWay}"
          CornerRadius="{x:Bind Look.ListRadius, Mode=OneWay}" AutomationProperties.AutomationId="list" AutomationProperties.Name="Messages">
    <Border BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind Look.ListHairline, Mode=OneWay}" CornerRadius="{x:Bind Look.ListRadius, Mode=OneWay}">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid.Resources>
          <DataTemplate x:Key="HeaderTemplate" x:DataType="mail:GroupHeaderViewModel">
            <!-- list-date-group-header.tsx:23-37: h-9 with a bottom rule, text-sm font-medium muted; the prototypes' 30 px bold 11.5 caption -->
            <Grid Height="{x:Bind theme:StyleState.Current.GroupHeaderHeight, Mode=OneWay}" Padding="{x:Bind theme:StyleState.Current.GroupHeaderBoxPadding, Mode=OneWay}"
                  BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind theme:StyleState.Current.GroupHeaderBorder, Mode=OneWay}" AutomationProperties.Name="{x:Bind Title}">
              <TextBlock Text="{x:Bind Title}" FontFamily="{x:Bind theme:StyleState.Current.AppFont, Mode=OneWay}" FontSize="{x:Bind theme:StyleState.Current.GroupHeaderSize, Mode=OneWay}"
                         FontWeight="{x:Bind theme:StyleState.Current.GroupHeaderWeight, Mode=OneWay}" Foreground="{x:Bind theme:StyleState.Current.GroupHeaderBrush, Mode=OneWay}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
          <DataTemplate x:Key="MessageTemplate" x:DataType="mail:MessageRowViewModel">
            <Grid>
              <Border Background="{StaticResource Sel}" Opacity="0.3" IsHitTestVisible="False"
                      Visibility="{x:Bind local:ListFmt.UnreadWash(Unread, IsSelected, theme:StyleState.Current.IsBulwark), Mode=OneWay}" />
              <!-- a ticked row (thread-list-item.tsx:743-744): the accent wash at 40 % and a 2 px primary ring at 20 % -->
              <Border Background="{StaticResource Sel}" Opacity="0.4" IsHitTestVisible="False" Visibility="{x:Bind local:ListFmt.CheckedWash(IsChecked, theme:StyleState.Current.IsBulwark), Mode=OneWay}" />
              <Border BorderBrush="{StaticResource Accent}" BorderThickness="2" Opacity="0.2" IsHitTestVisible="False" Visibility="{x:Bind local:ListFmt.CheckedWash(IsChecked, theme:StyleState.Current.IsBulwark), Mode=OneWay}" />
            <!-- prototype rows: Bento avatar + sender 14 / subject 13.5 body / preview 12.5 faint; Nordic dot + sender 14 / subject 14 / preview 13 dim, indented 15 -->
            <Grid Background="{x:Bind views:Fmt.TickedRowBackground(IsChecked, theme:StyleState.Current.IsNordic), Mode=OneWay}" Padding="{x:Bind theme:StyleState.Current.MessageRowPadding, Mode=OneWay}" ColumnSpacing="{x:Bind theme:StyleState.Current.ListRowSpacing, Mode=OneWay}"
                  ColumnDefinitions="Auto,*" AutomationProperties.Name="{x:Bind AccessibleName}" PointerEntered="OnRowEntered" PointerExited="OnRowExited" GotFocus="OnRowFocused">
              <Border Grid.ColumnSpan="2" Background="{x:Bind views:Fmt.TintBg(AccountColorIndex)}" Opacity="0.12" IsHitTestVisible="False" Visibility="{x:Bind views:Fmt.AccountTintVis(ShowAccountTint, IsChecked), Mode=OneWay}" />
              <Border Grid.ColumnSpan="2" Background="{x:Bind views:Fmt.TagFill(TagTintColor)}" IsHitTestVisible="False" Visibility="{x:Bind views:Fmt.AccountTintVis(ShowTagTint, IsChecked), Mode=OneWay}" />
              <!-- thread-list-item.tsx:822-840, selectable-avatar.tsx:38-58: a 40 px avatar that shows the check while hovered or ticked, the unread dot 10 px to its left -->
              <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,16,0,0" Fill="{StaticResource Unread}" IsHitTestVisible="False"
                       Visibility="{x:Bind local:ListFmt.AvatarDot(Unread, theme:StyleState.Current.IsBulwark), Mode=OneWay}" AutomationProperties.AutomationId="row.unread-dot" AutomationProperties.Name="Unread" />
              <Border Width="{x:Bind theme:StyleState.Current.ListAvatarSize, Mode=OneWay}" Height="{x:Bind theme:StyleState.Current.ListAvatarSize, Mode=OneWay}" VerticalAlignment="Top" Visibility="{x:Bind theme:StyleState.Current.ListAvatarVisibility, Mode=OneWay}"
                      CornerRadius="{x:Bind theme:StyleState.Current.AvatarRadius, Mode=OneWay}" Background="{x:Bind views:Fmt.TintBg(TintIndex)}" Tapped="OnAvatarTapped"
                      PointerEntered="OnAvatarEntered" PointerExited="OnAvatarExited"
                      AutomationProperties.AutomationId="row.tick" AutomationProperties.Name="Select message">
                <Grid>
                  <TextBlock Text="{x:Bind Initials}" FontSize="13" FontWeight="Bold" Foreground="{x:Bind views:Fmt.TintFg(TintIndex)}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <!-- the selectable avatar (selectable-avatar.tsx): a ticked row shows the check in place of the initials -->
                  <Border Background="{StaticResource Accent}" CornerRadius="{x:Bind theme:StyleState.Current.AvatarRadius, Mode=OneWay}" Visibility="{x:Bind views:Fmt.Vis(IsChecked), Mode=OneWay}">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <!-- the hover hint (Bulwark): the same check while the pointer is on the avatar; shown and hidden by the avatar's pointer events, one frame -->
                  <Border Tag="hover-check" Background="{StaticResource Accent}" CornerRadius="{x:Bind theme:StyleState.Current.AvatarRadius, Mode=OneWay}" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Spacing="{x:Bind theme:StyleState.Current.ListLineSpacing, Mode=OneWay}" MinWidth="0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                  <Ellipse Width="7" Height="7" Fill="{x:Bind views:Fmt.UnreadDot(Unread)}" Visibility="{x:Bind local:ListFmt.InlineDot(Unread, theme:StyleState.Current.IsNordic, theme:StyleState.Current.IsBulwark), Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <!-- Nordic has no avatar to turn into the check, so a ticked row shows the check where the unread dot sits (UI-SWEEP-1 L-02) -->
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Accent}" Margin="-2,0,2,0" VerticalAlignment="Center"
                             Visibility="{x:Bind views:Fmt.NordicTick(IsChecked, theme:StyleState.Current.IsNordic), Mode=OneWay}" />
                  <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                    <Ellipse Width="7" Height="7" Fill="{x:Bind views:Fmt.TintFg(AccountColorIndex)}" Visibility="{x:Bind views:Fmt.Vis(ShowAccountDot)}" VerticalAlignment="Center" Margin="0,0,5,0" AutomationProperties.Name="{x:Bind AccountDescription}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Sender}" FontFamily="{x:Bind theme:StyleState.Current.AppFont, Mode=OneWay}" FontSize="{x:Bind theme:StyleState.Current.SenderSize, Mode=OneWay}" FontWeight="{x:Bind local:ListFmt.SenderWeight(Unread, theme:StyleState.Current.IsNordic, theme:StyleState.Current.IsBulwark), Mode=OneWay}"
                               Foreground="{x:Bind local:ListFmt.SenderBrush(Unread, theme:StyleState.Current.IsBulwark), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <Border Grid.Column="2" CornerRadius="8" Padding="6,0" Margin="6,0,0,0" Background="{StaticResource Track}" Visibility="{x:Bind views:Fmt.VisMany(ThreadCount)}" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind views:Fmt.Thread(ThreadCount)}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <!-- status icons (thread-list-item.tsx:978-997): starred (filled amber), replied, forwarded, paperclip; w-3.5 and gap-1.5 in Bulwark -->
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{x:Bind theme:StyleState.Current.StatusIconSpacing, Mode=OneWay}" Margin="6,0,0,0" VerticalAlignment="Center">
                    <Viewbox Width="{x:Bind theme:StyleState.Current.StatusIconSize, Mode=OneWay}" Height="{x:Bind theme:StyleState.Current.StatusIconSize, Mode=OneWay}" Visibility="{x:Bind views:Fmt.Vis(Flagged)}"
                             IsHitTestVisible="False" AutomationProperties.AutomationId="row.starred" AutomationProperties.Name="Starred">
                      <Canvas Width="24" Height="24">
                        <Path Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" Fill="{x:Bind local:ListFmt.StarBrush(theme:StyleState.Current.IsBulwark), Mode=OneWay}" Stroke="{x:Bind local:ListFmt.StarBrush(theme:StyleState.Current.IsBulwark), Mode=OneWay}" StrokeThickness="1.7" StrokeLineJoin="Round" />
                      </Canvas>
                    </Viewbox>
                    <controls:SIcon Kind="Reply" Size="{x:Bind theme:StyleState.Current.StatusIconSize, Mode=OneWay}" Foreground="{StaticResource Dim}" Visibility="{x:Bind local:ListFmt.Replied(Answered)}"
                                    AutomationProperties.AutomationId="row.replied" AutomationProperties.Name="Replied" />
                    <controls:SIcon Kind="Fwd" Size="{x:Bind theme:StyleState.Current.StatusIconSize, Mode=OneWay}" Foreground="{StaticResource Dim}" Visibility="{x:Bind local:ListFmt.ForwardedIcon(Forwarded)}"
                                    AutomationProperties.AutomationId="row.forwarded" AutomationProperties.Name="Forwarded" />
                    <controls:SIcon Kind="Clip" Size="{x:Bind theme:StyleState.Current.StatusIconSize, Mode=OneWay}" Foreground="{StaticResource Dim}" Visibility="{x:Bind local:ListFmt.Clip(HasAttachment, AttachmentNames.Count)}"
                                    AutomationProperties.AutomationId="row.clip" AutomationProperties.Name="Has attachment" />
                  </StackPanel>
                  <TextBlock Grid.Column="4" Text="{x:Bind TimeLabel}" FontSize="12" Margin="6,0,0,0" FontWeight="{x:Bind local:ListFmt.TimeWeight(Unread, theme:StyleState.Current.IsNordic, theme:StyleState.Current.IsBulwark), Mode=OneWay}"
                             Foreground="{x:Bind local:ListFmt.TimeBrush(Unread, theme:StyleState.Current.IsNordic, theme:StyleState.Current.IsBulwark), Mode=OneWay}" VerticalAlignment="Center" />
                </Grid>
                <!-- the subject, and at its end the message's tags (Bulwark thread-list-item.tsx:1044 subject placement, tag-badge.tsx; showTagChips; M2 hotfix 2) -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="{x:Bind theme:StyleState.Current.SubjectMargin, Mode=OneWay}">
                  <TextBlock local:Snippet.Id="{x:Bind Id}" local:Snippet.Part="subject" local:Snippet.Plain="{x:Bind Subject}" FontFamily="{x:Bind theme:StyleState.Current.AppFont, Mode=OneWay}" FontSize="{x:Bind theme:StyleState.Current.SubjectSize, Mode=OneWay}" FontWeight="{x:Bind local:ListFmt.SubjectWeight(Unread, theme:StyleState.Current.IsNordic, theme:StyleState.Current.IsBulwark), Mode=OneWay}"
                             Opacity="{x:Bind local:ListFmt.SubjectOpacity(Unread, theme:StyleState.Current.IsBulwark), Mode=OneWay}"
                             Foreground="{x:Bind theme:StyleState.Current.SubjectBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Tags}" Visibility="{x:Bind views:Fmt.Vis(ShowTags)}" MaxWidth="200" VerticalAlignment="Center"
                                 AutomationProperties.Name="Tags">
                    <ItemsRepeater.Layout>
                      <StackLayout Orientation="Horizontal" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate x:DataType="mail:RowTag">
                        <Border Height="16" MaxWidth="96" CornerRadius="8" Padding="6,0" BorderThickness="1" BorderBrush="{x:Bind views:Fmt.TagLine(Color)}" Background="{x:Bind views:Fmt.TagFill(Color)}"
                                AutomationProperties.Name="{x:Bind Name}">
                          <TextBlock Text="{x:Bind Name}" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </Grid>
                <TextBlock local:Snippet.Id="{x:Bind Id}" local:Snippet.Part="preview" local:Snippet.Plain="{x:Bind Preview}" FontFamily="{x:Bind theme:StyleState.Current.AppFont, Mode=OneWay}" FontSize="{x:Bind theme:StyleState.Current.PreviewSize, Mode=OneWay}" Foreground="{x:Bind theme:StyleState.Current.PreviewBrush, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" Margin="{x:Bind theme:StyleState.Current.PreviewMargin, Mode=OneWay}" />
                <Button Content="{x:Bind VerificationCode}" Visibility="{x:Bind views:Fmt.Vis(ShowVerificationCode)}" Click="OnCopyVerificationCode"
                        HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2" AutomationProperties.Name="Copy verification code" AutomationProperties.AutomationId="row.copy-code" />
                <ItemsRepeater ItemsSource="{x:Bind views:Fmt.Chips(AttachmentNames)}" Visibility="{x:Bind views:Fmt.VisChips(AttachmentNames.Count)}" Margin="0,4,0,0"
                               AutomationProperties.Name="Attachments">
                  <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Height="20" MaxWidth="140" CornerRadius="10" Padding="8,0" Background="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <controls:SIcon Kind="Clip" Size="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                          <TextBlock Text="{x:Bind}" FontSize="10.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>
              <!-- the hover strip (email-hover-actions.tsx:271-274,333-371): one frame in, no animation; real hover and keyboard focus show it, `hover-sim` drives it in automation.
                   Bulwark: flush with the row's end in the row's own colour (selected fill or hover), p-1.5 icon buttons with a 100 ms hover; the prototypes: a bordered card. -->
              <Border Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="{x:Bind theme:StyleState.Current.StripVertical, Mode=OneWay}" Margin="{x:Bind theme:StyleState.Current.StripMargin, Mode=OneWay}"
                      CornerRadius="{x:Bind theme:StyleState.Current.StripRadius, Mode=OneWay}" Background="{x:Bind local:ListFmt.StripBase(theme:StyleState.Current.IsBulwark), Mode=OneWay}"
                      BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind theme:StyleState.Current.StripBorder, Mode=OneWay}"
                      Visibility="{x:Bind views:Fmt.Vis(IsHovered), Mode=OneWay}" AutomationProperties.AutomationId="row.strip" AutomationProperties.Name="Message actions">
                <Grid Padding="{x:Bind theme:StyleState.Current.StripPadding, Mode=OneWay}" CornerRadius="{x:Bind theme:StyleState.Current.StripRadius, Mode=OneWay}" Background="{x:Bind local:ListFmt.StripFill(IsSelected, theme:StyleState.Current.IsBulwark), Mode=OneWay}">
                  <!-- the buttons come from MessageRowViewModel.Strip (HoverStrip: the hoverActions setting and the message state): icon buttons with a tooltip, as the prototype's row actions -->
                  <ItemsRepeater ItemsSource="{x:Bind Strip, Mode=OneWay}" VerticalAlignment="Center">
                    <ItemsRepeater.Layout>
                      <StackLayout Orientation="Horizontal" Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate x:DataType="mail:HoverButton">
                        <Button Style="{x:Bind theme:StyleState.Current.StripButtonStyle}" Width="{x:Bind theme:StyleState.Current.StripButtonWidth}" Height="28" CornerRadius="{x:Bind theme:StyleState.Current.StripButtonRadius}"
                                Foreground="{x:Bind views:Fmt.StripBrush(Active)}" Tag="{x:Bind CommandId}" Click="OnStripClick"
                                motion:Tip.Text="{x:Bind Tooltip}" AutomationProperties.AutomationId="{x:Bind views:Fmt.StripId(Id)}" AutomationProperties.Name="{x:Bind Tooltip}">
                          <controls:SIcon Kind="{x:Bind Icon}" Size="16" />
                        </Button>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </Grid>
              </Border>
            </Grid>
            </Grid>
          </DataTemplate>
          <local:MessageRowTemplateSelector x:Key="RowSelector" MessageTemplate="{StaticResource MessageTemplate}" HeaderTemplate="{StaticResource HeaderTemplate}" />
        </Grid.Resources>

        <!-- Header (prototype ListHead): Bento title 24 bold with "N unread" on the right; Nordic title 28 extra bold, tight, and the greeting under it. Search stays (M1). -->
        <StackPanel x:Name="ListHeader" Grid.Row="0" Padding="{x:Bind Look.ListHeaderPadding, Mode=OneWay}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto" Visibility="{x:Bind views:Fmt.VisNot(Look.IsBulwark), Mode=OneWay}">
            <TextBlock Text="{x:Bind Glance.ListTitle, Mode=OneWay}" FontFamily="{x:Bind Look.AppBoldFont, Mode=OneWay}" FontSize="{x:Bind Look.ListTitleSize, Mode=OneWay}" FontWeight="{x:Bind Look.ListTitleWeight, Mode=OneWay}"
                       CharacterSpacing="{x:Bind Look.ListTitleSpacing, Mode=OneWay}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="list.title" AutomationProperties.Name="Folder title" />
            <TextBlock Grid.Column="1" Text="{x:Bind views:Fmt.UnreadText(Glance.ListUnread), Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                       Visibility="{x:Bind Look.BentoOnly, Mode=OneWay}" AutomationProperties.AutomationId="list.unread" AutomationProperties.Name="Unread count" />
          </Grid>
          <TextBlock Text="{x:Bind Glance.ListSubtitle, Mode=OneWay}" FontSize="13" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,-8,0,0"
                     Visibility="{x:Bind Look.NordicOnly, Mode=OneWay}" />
          <!-- Bulwark mail-app.tsx:6633-6690: select, search and folder actions share the top row. -->
          <Grid x:Name="Toolbar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
            <!-- toolbar.tsx:16,29: a toolbar toggle, tinted while a selection exists (the shared ToggleButton.Icon active state), 32 px, rounded-md -->
            <ToggleButton x:Name="SelectAllToggle" VerticalAlignment="Top" Style="{StaticResource ToggleButton.Icon}" Width="{x:Bind Look.ListToolbarButtonSize, Mode=OneWay}" Height="{x:Bind Look.ListToolbarButtonSize, Mode=OneWay}" CornerRadius="{x:Bind Look.ButtonRadius, Mode=OneWay}" Click="OnToolbarSelectAll"
                    IsChecked="{x:Bind List.HasChecked, Mode=OneWay}"
                    Visibility="{x:Bind views:Fmt.Vis(Look.IsBulwark), Mode=OneWay}" AutomationProperties.AutomationId="list.select-all"
                    AutomationProperties.Name="Select all or clear selection" motion:Tip.Text="Select all or clear selection">
              <Grid Width="16" Height="16">
                <Border BorderBrush="{StaticResource Dim}" BorderThickness="1.5" CornerRadius="3" />
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Accent}"
                           Visibility="{x:Bind views:Fmt.Vis(List.HasChecked), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </ToggleButton>
            <ContentPresenter Grid.Column="1" x:Name="SearchSlot" VerticalAlignment="Top" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
            <Button Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource Button.Icon}" Width="{x:Bind Look.ListToolbarButtonSize, Mode=OneWay}" Height="{x:Bind Look.ListToolbarButtonSize, Mode=OneWay}" CornerRadius="{x:Bind Look.ButtonRadius, Mode=OneWay}" Click="OnFolderActions"
                    Visibility="{x:Bind views:Fmt.Vis(Look.IsBulwark), Mode=OneWay}" AutomationProperties.AutomationId="list.folder-actions"
                    AutomationProperties.Name="Folder actions" motion:Tip.Text="Folder actions">
              <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
            </Button>
          </Grid>
        </StackPanel>

        <!-- A load failure shows as a status line; the old rows stay. -->
        <StackPanel Grid.Row="1">
          <TextBlock Text="{x:Bind List.Error, Mode=OneWay}" Foreground="{StaticResource RoseFg}" FontSize="12" TextWrapping="Wrap" Margin="20,0,20,8"
                     Visibility="{x:Bind views:Fmt.VisText(List.Error), Mode=OneWay}" AutomationProperties.AutomationId="list.error" AutomationProperties.Name="List error" />
          <!-- M2 plan 3.3: the selection bar (stream actions) -->
          <ContentPresenter x:Name="SelectionBarSlot" />
        </StackPanel>

        <ListView Grid.Row="2" x:Name="Rows" Margin="{x:Bind Look.ListViewportMargin, Mode=OneWay}" RenderTransformOrigin="0,0" ItemsSource="{x:Bind List.Rows}" ItemTemplateSelector="{StaticResource RowSelector}" SelectionMode="Single" Padding="{x:Bind Look.ListPadding, Mode=OneWay}"
                  SelectionChanged="OnSelectionChanged" ContainerContentChanging="OnContainerContentChanging" win:ShowsScrollingPlaceholders="False"
                  CanDragItems="True" DragItemsStarting="OnDragItemsStarting" DragItemsCompleted="OnDragItemsCompleted"
                  AutomationProperties.AutomationId="list.rows" AutomationProperties.Name="Message list">
          <win:ListView.ItemContainerTransitions>
            <TransitionCollection />
          </win:ListView.ItemContainerTransitions>
        </ListView>
        <!-- email-list.tsx:1602-1610: while a first page loads over rows, the list is dimmed to half with a "Loading" pill; the old rows stay (snap, no fade) -->
        <Grid Grid.Row="2" x:Name="LoadingOverlay" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AutomationId="list.loading">
          <Border Background="{StaticResource Bg}" Opacity="0.5" />
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Padding="16,8" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ProgressRing IsActive="True" Width="16" Height="16" Foreground="{StaticResource Dim}" />
              <TextBlock Text="Loading emails..." FontSize="14" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
        <!-- email-list.tsx:1612-1618, boot-skeleton/mail-skeleton.tsx: the list's first load shows placeholder rows (a circle and three bars, static) -->
        <StackPanel Grid.Row="2" x:Name="LoadingSkeleton" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AutomationId="list.skeleton" AutomationProperties.Name="Loading">
          <ItemsRepeater x:Name="SkeletonRows">
            <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="x:Int32">
              <Grid Padding="12" ColumnSpacing="12" ColumnDefinitions="Auto,*" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Ellipse Width="40" Height="40" Fill="{StaticResource Track}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <Border Height="10" Width="120" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource Track}" />
                  <Border Height="10" HorizontalAlignment="Stretch" CornerRadius="4" Background="{StaticResource Track}" />
                  <Border Height="10" Width="200" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource Track}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>
        <!-- ui/empty-state.tsx:29-45: a 56 px muted circle with a 28 px icon, a 16 px medium title and a one-line 14 px description under it, centred -->
        <StackPanel Grid.Row="2" x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" Spacing="0" Visibility="Collapsed" IsHitTestVisible="False"
                    AutomationProperties.AutomationId="list.empty" AutomationProperties.Name="No messages">
          <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource Track}" HorizontalAlignment="Center" Margin="0,0,0,16" x:Name="EmptyBadge">
            <controls:SIcon Kind="Mail" Size="28" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="EmptyText" Text="No messages found" FontSize="16" FontWeight="Medium" Foreground="{StaticResource Text}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock x:Name="EmptyHint" Text="This mailbox is empty" FontSize="14" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Border>
</UserControl>
