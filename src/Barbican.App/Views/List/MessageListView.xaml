<UserControl
    x:Class="Barbican.App.Views.List.MessageListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Barbican.App.Controls"
    xmlns:theme="using:Barbican.App.Theme"
    xmlns:views="using:Barbican.App.Views"
    xmlns:local="using:Barbican.App.Views.List"
    xmlns:mail="using:Barbican.Presentation.Mail">
  <!-- The message list (spec/layout/mail-list.md; BNMail section, NordMail section): header with title, unread pill, greeting and search; date-group headers and message rows;
       thread count, preview, attachment chips; unread first section; more on scroll. Rows come from MessageListViewModel.Rows (ListSync: only changed rows are touched).
       No item transitions, no selection animation (design/MOTION.md rules 1 and 3). -->
  <Border x:Name="Pane" Background="{x:Bind Look.PaneBrush, Mode=OneWay}" BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind Look.PaneBorder, Mode=OneWay}"
          CornerRadius="{x:Bind Look.PaneRadius, Mode=OneWay}" Width="{x:Bind Look.ListWidth, Mode=OneWay}" AutomationProperties.AutomationId="list" AutomationProperties.Name="Messages">
    <Border BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind Look.ListHairline, Mode=OneWay}" CornerRadius="{x:Bind Look.PaneRadius, Mode=OneWay}">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid.Resources>
          <DataTemplate x:Key="HeaderTemplate" x:DataType="mail:GroupHeaderViewModel">
            <Grid Height="30" Padding="{x:Bind theme:StyleState.Current.GroupHeaderPadding, Mode=OneWay}" AutomationProperties.Name="{x:Bind Title}">
              <TextBlock Text="{x:Bind Title}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
          <DataTemplate x:Key="MessageTemplate" x:DataType="mail:MessageRowViewModel">
            <Grid Padding="{x:Bind theme:StyleState.Current.MessageRowPadding, Mode=OneWay}" ColumnSpacing="{x:Bind theme:StyleState.Current.MessageRowSpacing, Mode=OneWay}"
                  ColumnDefinitions="Auto,*">
              <Border Width="38" Height="38" VerticalAlignment="Top" Visibility="{x:Bind theme:StyleState.Current.ShowAvatar, Mode=OneWay}"
                      CornerRadius="{x:Bind theme:StyleState.Current.AvatarRadius, Mode=OneWay}" Background="{x:Bind views:Fmt.TintBg(TintIndex)}">
                <TextBlock Text="{x:Bind Initials}" FontSize="12.5" FontWeight="Bold" Foreground="{x:Bind views:Fmt.TintFg(TintIndex)}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="1" MinWidth="0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                  <Ellipse Width="7" Height="7" Fill="{x:Bind views:Fmt.UnreadDot(Unread)}" Visibility="{x:Bind theme:StyleState.Current.ShowUnreadDot, Mode=OneWay}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Sender}" FontSize="13.5" FontWeight="{x:Bind views:Fmt.Weight(Unread)}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2" Height="17" MinWidth="17" CornerRadius="8.5" Padding="6,0" Background="{StaticResource Chip}" Visibility="{x:Bind views:Fmt.VisMany(ThreadCount)}" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind views:Fmt.Thread(ThreadCount)}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <controls:SIcon Grid.Column="3" Kind="Star" Size="12" Foreground="{StaticResource AmberFg}" Visibility="{x:Bind views:Fmt.Vis(Flagged)}" VerticalAlignment="Center" />
                  <controls:SIcon Grid.Column="4" Kind="Clip" Size="12" Foreground="{StaticResource Faint}" Visibility="{x:Bind views:Fmt.VisClip(HasAttachment, AttachmentNames.Count)}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="{x:Bind TimeLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{x:Bind views:Fmt.TimeBrush(Unread)}" />
                </Grid>
                <TextBlock Text="{x:Bind Subject}" FontSize="13" FontWeight="{x:Bind views:Fmt.Weight(Unread)}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                           Margin="{x:Bind theme:StyleState.Current.MessageTextMargin, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Preview}" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" MaxLines="1"
                           Margin="{x:Bind theme:StyleState.Current.MessageTextMargin, Mode=OneWay}" />
                <ItemsRepeater ItemsSource="{x:Bind views:Fmt.Chips(AttachmentNames)}" Visibility="{x:Bind views:Fmt.VisChips(AttachmentNames.Count)}" Margin="0,4,0,0"
                               AutomationProperties.Name="Attachments">
                  <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Height="20" MaxWidth="140" CornerRadius="10" Padding="8,0" Background="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <controls:SIcon Kind="Clip" Size="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                          <TextBlock Text="{x:Bind}" FontSize="10.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>
            </Grid>
          </DataTemplate>
          <local:MessageRowTemplateSelector x:Key="RowSelector" MessageTemplate="{StaticResource MessageTemplate}" HeaderTemplate="{StaticResource HeaderTemplate}" />
        </Grid.Resources>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="{x:Bind Look.ListHeaderPadding, Mode=OneWay}" Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Bind Glance.ListTitle, Mode=OneWay}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="list.title" AutomationProperties.Name="Folder title" />
            <Border Grid.Column="1" Height="24" CornerRadius="12" Padding="10,0" Background="{StaticResource RoseBg}" VerticalAlignment="Center"
                    Visibility="{x:Bind views:Fmt.VisCount(Glance.ListUnread), Mode=OneWay}" AutomationProperties.AutomationId="list.unread" AutomationProperties.Name="Unread count">
              <TextBlock Text="{x:Bind views:Fmt.NewCount(Glance.ListUnread), Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource RoseFg}" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <TextBlock Text="{x:Bind Glance.ListSubtitle, Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
          <Border Height="38" CornerRadius="{x:Bind Look.FieldRadius, Mode=OneWay}" Background="{StaticResource Tile2}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,0,6,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <controls:SIcon Kind="Search" Size="15" StrokeWidth="2" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource TextBox.Bare}" PlaceholderText="Search mail" KeyDown="OnSearchKeyDown"
                       AutomationProperties.AutomationId="list.search" AutomationProperties.Name="Search mail" />
              <Border Grid.Column="2" Height="17" MinWidth="18" CornerRadius="5" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="5,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="/" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
        </StackPanel>

        <!-- A load failure shows as a status line; the old rows stay. -->
        <TextBlock Grid.Row="1" Text="{x:Bind List.Error, Mode=OneWay}" Foreground="{StaticResource RoseFg}" FontSize="12" TextWrapping="Wrap" Margin="20,0,20,8"
                   Visibility="{x:Bind views:Fmt.VisText(List.Error), Mode=OneWay}" AutomationProperties.AutomationId="list.error" AutomationProperties.Name="List error" />

        <ListView Grid.Row="2" x:Name="Rows" ItemsSource="{x:Bind List.Rows}" ItemTemplateSelector="{StaticResource RowSelector}" SelectionMode="Single" Padding="0"
                  SelectionChanged="OnSelectionChanged" ContainerContentChanging="OnContainerContentChanging" ShowsScrollingPlaceholders="False"
                  AutomationProperties.AutomationId="list.rows" AutomationProperties.Name="Message list">
          <ListView.ItemContainerTransitions>
            <TransitionCollection />
          </ListView.ItemContainerTransitions>
        </ListView>
        <TextBlock Grid.Row="2" x:Name="EmptyText" Text="No messages" FontSize="13" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,44,0,0" Visibility="Collapsed"
                   IsHitTestVisible="False" AutomationProperties.AutomationId="list.empty" AutomationProperties.Name="No messages" />
      </Grid>
    </Border>
  </Border>
</UserControl>
