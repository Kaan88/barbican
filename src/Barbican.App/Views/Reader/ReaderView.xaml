<UserControl
    x:Class="Barbican.App.Views.Reader.ReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reader="using:Barbican.App.Views.Reader"
    xmlns:body="using:Barbican.App.MailBody"
    xmlns:controls="using:Barbican.App.Controls"
    xmlns:motion="using:Barbican.App.Motion"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:theme="using:Barbican.App.Theme"
    xmlns:views="using:Barbican.App.Views"
    xmlns:mail="using:Barbican.Presentation.Mail">
  <!-- The reader chrome (spec/layout/reader.md; BNMail main, NordMail main): the toolbar (shown, disabled until M2/M3), the header with the details panel and the authentication chips,
       the conversation strip, the attachment cards, the body slot (MailBodyView, body stream), and the reply bar. Header, strip, cards and body come from ReaderViewModel.Apply in one
       call, so they change together. Laid out as the prototype (prototype/winui/MainWindow.xaml ReaderTile / NordReader). The only motion is the header rise on a switch
       (Motion/Rise, never while keys repeat); the body cross-fades in MailBodyView (design/MOTION.md). -->
  <Border Background="{x:Bind Look.ListBrush, Mode=OneWay}" BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind Look.PaneBorder, Mode=OneWay}"
          CornerRadius="{x:Bind Look.PaneRadius, Mode=OneWay}" MinWidth="240" MinHeight="200" AutomationProperties.AutomationId="reader" AutomationProperties.Name="Message">
    <Border BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind Look.ListHairline, Mode=OneWay}" CornerRadius="{x:Bind Look.PaneRadius, Mode=OneWay}">
      <Grid>
        <!-- nothing open -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{x:Bind views:Fmt.VisBody(Reader.BodyState, 'empty'), Mode=OneWay}"
                    AutomationProperties.AutomationId="reader.empty" AutomationProperties.Name="No message selected">
          <StackPanel Visibility="{x:Bind Look.BulwarkOnly, Mode=OneWay}" Padding="32" MaxWidth="384" HorizontalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Background="{StaticResource Tile2}">
              <controls:SIcon Kind="Mail" Size="28" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="No conversation selected" TextAlignment="Center" Margin="0,16,0,4" FontSize="16" FontWeight="Medium" Foreground="{StaticResource Text}" />
            <TextBlock Text="Choose a conversation from the list to read it here" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Dim}" />
          </StackPanel>
          <Border Visibility="{x:Bind Look.LegacyMarkVisibility, Mode=OneWay}" Width="68" Height="68" CornerRadius="25" Background="{StaticResource Tile2}" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center">
            <Canvas Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Rectangle Canvas.Left="3" Canvas.Top="12" Width="7" Height="19" RadiusX="3.5" RadiusY="3.5" Fill="{StaticResource Accent}" />
              <Rectangle Canvas.Left="13.5" Canvas.Top="3" Width="7" Height="28" RadiusX="3.5" RadiusY="3.5" Fill="{StaticResource Accent}" Opacity="0.7" />
              <Rectangle Canvas.Left="24" Canvas.Top="8" Width="7" Height="23" RadiusX="3.5" RadiusY="3.5" Fill="{StaticResource Accent}" Opacity="0.4" />
            </Canvas>
          </Border>
          <TextBlock Visibility="{x:Bind Look.LegacyMarkVisibility, Mode=OneWay}" Text="Select a message to read it" FontSize="13" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
        </StackPanel>

        <Grid x:Name="ContentGrid" SizeChanged="OnContentSizeChanged" Padding="{x:Bind Look.ReaderPadding, Mode=OneWay}" RowSpacing="{x:Bind Look.ReaderSpacing, Mode=OneWay}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
              Visibility="{x:Bind views:Fmt.VisBody(Reader.BodyState, 'content'), Mode=OneWay}">
           <!-- Bulwark order: actions, subject, collapsed conversation headers, and the open message. -->
          <!-- actions: Reply, Reply all, Forward, Archive and Delete run their commands on the open message; More opens MENU-READER. Bento: icon + label (Reply all, Delete, More icon-only); Nordic: text only. -->
           <Border Grid.Row="0" Margin="{x:Bind Look.ReaderBandMargin, Mode=OneWay}" Padding="{x:Bind Look.ReaderBandPadding, Mode=OneWay}" BorderThickness="{x:Bind Look.ReaderBandRule, Mode=OneWay}" BorderBrush="{StaticResource Line}">
           <controls:WrapRow x:Name="MessageToolbar" Spacing="4" AutomationProperties.AutomationId="reader.toolbar" AutomationProperties.Name="Message actions">
            <Button x:Name="ReaderBack" Visibility="Collapsed" Width="40" Height="40" Padding="0"
                    Style="{StaticResource Button.Icon}" Click="OnBackClick" motion:Tip.Text="Back to messages"
                    AutomationProperties.Name="Back to messages" AutomationProperties.AutomationId="reader.back-to-list">
              <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <Button x:Name="ActionReply" Style="{x:Bind Look.ReaderActionStyle, Mode=OneWay}" Height="{x:Bind Look.ReaderActionHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ReaderActionRadius, Mode=OneWay}"
                    Padding="{x:Bind Look.ReaderActionPadding, Mode=OneWay}" MinWidth="{x:Bind Look.MinimumTarget, Mode=OneWay}" Click="OnReplyClick" motion:Tip.Text="Reply" AutomationProperties.AutomationId="reader.reply" AutomationProperties.Name="Reply">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Reply" Size="16" Visibility="{x:Bind Look.ToolbarIconVisibility, Mode=OneWay}" /><TextBlock Text="Reply" Visibility="{x:Bind Look.ToolbarLabelVisibility, Mode=OneWay}" /></StackPanel>
            </Button>
            <Button x:Name="ActionReplyAll" Style="{x:Bind Look.ReaderActionStyle, Mode=OneWay}" Height="{x:Bind Look.ReaderActionHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ReaderActionRadius, Mode=OneWay}"
                    Padding="{x:Bind Look.ReaderActionPadding, Mode=OneWay}" MinWidth="{x:Bind Look.MinimumTarget, Mode=OneWay}" Click="OnReplyAllClick" motion:Tip.Text="Reply all" AutomationProperties.AutomationId="reader.replyall" AutomationProperties.Name="Reply all">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="ReplyAll" Size="16" Visibility="{x:Bind Look.ToolbarIconVisibility, Mode=OneWay}" /><TextBlock Text="Reply all" Visibility="{x:Bind Look.SecondaryLabelVisibility, Mode=OneWay}" /></StackPanel>
            </Button>
            <Button x:Name="ActionForward" Style="{x:Bind Look.ReaderActionStyle, Mode=OneWay}" Height="{x:Bind Look.ReaderActionHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ReaderActionRadius, Mode=OneWay}"
                    Padding="{x:Bind Look.ReaderActionPadding, Mode=OneWay}" MinWidth="{x:Bind Look.MinimumTarget, Mode=OneWay}" Click="OnForwardClick" motion:Tip.Text="Forward" AutomationProperties.AutomationId="reader.forward" AutomationProperties.Name="Forward">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Fwd" Size="16" Visibility="{x:Bind Look.ToolbarIconVisibility, Mode=OneWay}" /><TextBlock Text="Forward" Visibility="{x:Bind Look.ToolbarLabelVisibility, Mode=OneWay}" /></StackPanel>
            </Button>
            <Button Style="{x:Bind Look.ReaderActionStyle, Mode=OneWay}" Height="{x:Bind Look.ReaderActionHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ReaderActionRadius, Mode=OneWay}"
                    Padding="{x:Bind Look.ReaderActionPadding, Mode=OneWay}" MinWidth="{x:Bind Look.MinimumTarget, Mode=OneWay}" Click="OnArchiveClick" motion:Tip.Text="Archive" AutomationProperties.AutomationId="reader.archive" AutomationProperties.Name="Archive">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Archive" Size="16" Visibility="{x:Bind Look.ToolbarIconVisibility, Mode=OneWay}" /><TextBlock Text="Archive" Visibility="{x:Bind Look.ToolbarLabelVisibility, Mode=OneWay}" /></StackPanel>
            </Button>
            <Button Style="{x:Bind Look.ReaderActionStyle, Mode=OneWay}" Height="{x:Bind Look.ReaderActionHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ReaderActionRadius, Mode=OneWay}"
                    Padding="{x:Bind Look.ReaderActionPadding, Mode=OneWay}" MinWidth="{x:Bind Look.MinimumTarget, Mode=OneWay}" Click="OnDeleteClick" motion:Tip.Text="Delete" AutomationProperties.AutomationId="reader.delete" AutomationProperties.Name="Delete">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Trash" Size="16" Visibility="{x:Bind Look.ToolbarIconVisibility, Mode=OneWay}" /><TextBlock Text="Delete" Visibility="{x:Bind Look.SecondaryLabelVisibility, Mode=OneWay}" /></StackPanel>
             </Button>
              <StackPanel x:Name="ReaderAddOnButtons" Orientation="Horizontal" Spacing="4" Visibility="Collapsed" />
              <Button x:Name="ReaderAddOns" Visibility="Collapsed" Style="{StaticResource Button.Icon}" Width="32" Height="36" Padding="0"
                      AutomationProperties.AutomationId="reader.addons" AutomationProperties.Name="Add-on actions" motion:Tip.Text="Add-on actions">
                <Button.Flyout><MenuFlyout x:Name="ReaderAddOnsMenu" win:ShouldConstrainToRootBounds="True" /></Button.Flyout>
                <SymbolIcon Symbol="More" />
              </Button>
              <StackPanel x:Name="ExtraActions" Orientation="Horizontal" Spacing="2" Visibility="Collapsed" />
              <!-- Bulwark 1.21.2 email-viewer.tsx:5128-5142: ghost button with Maximize2 / Minimize2. -->
              <Button x:Name="ReaderFullscreenButton" Style="{StaticResource Button.Icon}" Visibility="{x:Bind views:Fmt.Vis(Look.IsBulwark), Mode=OneWay}" Click="OnFullscreenClick"
                            Width="32" Height="32" MinWidth="{x:Bind Look.MinimumTarget, Mode=OneWay}" MinHeight="{x:Bind Look.MinimumTarget, Mode=OneWay}"
                            CornerRadius="6" Padding="0" AutomationProperties.AutomationId="reader.fullscreen"
                            AutomationProperties.Name="Fullscreen" motion:Tip.Text="Fullscreen">
                <Viewbox Width="16" Height="16">
                  <Grid Width="24" Height="24">
                    <Path x:Name="ReaderMaximizeGlyph" Stroke="{StaticResource Text}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M15,3 L21,3 L21,9 M14,10 L21,3 M9,21 L3,21 L3,15 M3,21 L10,14" />
                    <Path x:Name="ReaderMinimizeGlyph" Visibility="Collapsed" Stroke="{StaticResource Text}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M4,14 L10,14 L10,20 M3,21 L10,14 M20,10 L14,10 L14,4 M14,10 L21,3" />
                  </Grid>
                </Viewbox>
              </Button>
             <Button Style="{x:Bind Look.ReaderActionStyle, Mode=OneWay}" Width="{x:Bind Look.ReaderActionHeight, Mode=OneWay}" Height="{x:Bind Look.ReaderActionHeight, Mode=OneWay}" Padding="0"
                    CornerRadius="{x:Bind Look.ReaderActionRadius, Mode=OneWay}" Click="OnMoreClick" motion:Tip.Text="More actions" AutomationProperties.AutomationId="reader.more" AutomationProperties.Name="More actions">
              <controls:SIcon Kind="More" Size="16" />
            </Button>
          </controls:WrapRow>
          </Border>

          <!-- header: the subject and the sender line rise a few pixels when another message opens (Motion/Rise; the prototype's header transition) -->
           <Border Grid.Row="1" Margin="{x:Bind Look.ReaderBandMargin, Mode=OneWay}" Padding="{x:Bind Look.ReaderBandPadding, Mode=OneWay}" BorderThickness="{x:Bind Look.ReaderBandRule, Mode=OneWay}" BorderBrush="{StaticResource Line}">
           <StackPanel>
          <TextBlock x:Name="SubjectText" Text="{x:Bind Reader.Header.Subject, Mode=OneWay}" FontSize="{x:Bind Look.ReaderSubjectSize, Mode=OneWay}"
                     FontWeight="{x:Bind Look.ReaderSubjectWeight, Mode=OneWay}" CharacterSpacing="{x:Bind Look.ReaderSubjectSpacing, Mode=OneWay}" LineHeight="{x:Bind Look.ReaderSubjectLineHeight, Mode=OneWay}"
                     Margin="{x:Bind Look.ReaderSubjectMargin, Mode=OneWay}" Foreground="{StaticResource Text}"
                     TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="reader.subject" AutomationProperties.Name="Subject">
            <TextBlock.RenderTransform>
              <TranslateTransform x:Name="SubjectShift" />
            </TextBlock.RenderTransform>
          </TextBlock>
          <!-- the message's tags under the subject, each with × to take it off (Bulwark email-viewer.tsx:5422 TagBadge onRemove; M2 hotfix 2) -->
          <ItemsRepeater ItemsSource="{x:Bind Reader.Header.Tags, Mode=OneWay}" Visibility="{x:Bind views:Fmt.VisChips(Reader.Header.Tags.Count), Mode=OneWay}" Margin="0,6,0,0"
                         AutomationProperties.AutomationId="reader.tags" AutomationProperties.Name="Tags">
            <ItemsRepeater.Layout>
              <StackLayout Orientation="Horizontal" Spacing="4" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="mail:RowTag">
                <Border Height="22" MaxWidth="192" CornerRadius="{x:Bind theme:StyleState.Current.TagRadius, Mode=OneWay}" Padding="8,0,2,0" BorderThickness="1" BorderBrush="{x:Bind views:Fmt.TagLine(Color)}" Background="{x:Bind views:Fmt.TagFill(Color)}"
                        AutomationProperties.Name="{x:Bind Name}">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="160" />
                    <Button Tag="{x:Bind Id}" Click="OnTagRemoveClick" Width="18" Height="18" Padding="0" CornerRadius="9" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="{x:Bind views:Fmt.TagRemoveId(Id)}" AutomationProperties.Name="Remove tag">
                      <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" Foreground="{StaticResource Dim}" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
          </StackPanel>
          </Border>
           <Border Grid.Row="3" Margin="{x:Bind Look.ReaderBandMargin, Mode=OneWay}" Padding="{x:Bind Look.ReaderBandPadding, Mode=OneWay}" BorderThickness="{x:Bind Look.ReaderBandRule, Mode=OneWay}" BorderBrush="{StaticResource Line}">
           <Grid x:Name="SenderLine" ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" SizeChanged="OnSenderLineSizeChanged" AutomationProperties.AutomationId="reader.header" AutomationProperties.Name="Message header">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="SenderShift" />
            </Grid.RenderTransform>
            <FlyoutBase.AttachedFlyout>
              <Flyout x:Name="SenderFlyout" win:ShouldConstrainToRootBounds="True" Placement="Bottom">
                <StackPanel x:Name="SenderCard" Spacing="8" MinWidth="240" MaxWidth="320" AutomationProperties.AutomationId="reader.sender.popover" />
              </Flyout>
            </FlyoutBase.AttachedFlyout>
            <Border Width="40" Height="40" CornerRadius="{x:Bind Look.AvatarRadius, Mode=OneWay}" Background="{x:Bind views:Fmt.TintBg(Reader.Header.TintIndex), Mode=OneWay}"
                    Visibility="{x:Bind Look.ShowAvatar, Mode=OneWay}" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Reader.Header.Initials, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{x:Bind views:Fmt.TintFg(Reader.Header.TintIndex), Mode=OneWay}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <!-- Bento: From 14 semibold over the address and date; Nordic: "From to you · date" in one dim line -->
            <StackPanel Grid.Column="1" MinWidth="90" VerticalAlignment="Center" Visibility="{x:Bind Look.BentoOnly, Mode=OneWay}">
              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind Reader.Header.From, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" Tapped="OnSenderTapped"
                           AutomationProperties.AutomationId="reader.sender" AutomationProperties.Name="Sender" />
                <!-- Bulwark external-sender-chip.tsx:85-145: "External" beside the sender, the tooltip naming the sender domain (G-051) -->
                <Border x:Name="ExternalSenderChip" Grid.Column="1" Height="20" Padding="5,0" CornerRadius="6" BorderThickness="1" VerticalAlignment="Center"
                        BorderBrush="{StaticResource Warning}" Background="{StaticResource AmberBg}"
                        Visibility="{x:Bind views:Fmt.VisText(Reader.Header.ExternalSenderTooltip), Mode=OneWay}"
                        AutomationProperties.AutomationId="reader.external" AutomationProperties.Name="External sender">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <controls:SIcon Kind="Building" Size="11" Foreground="{StaticResource AmberFg}" VerticalAlignment="Center" />
                    <TextBlock Text="External" FontSize="10" FontWeight="Medium" Foreground="{StaticResource AmberFg}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Text="{x:Bind views:Fmt.Angle(Reader.Header.Email), Mode=OneWay}" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind Look.BulwarkOnly, Mode=OneWay}" />
              <TextBlock Text="{x:Bind views:Fmt.ToLine(Reader.Header.To), Mode=OneWay}" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind Look.BulwarkOnly, Mode=OneWay}" />
              <TextBlock Visibility="{x:Bind views:Fmt.VisNot(Look.IsBulwark), Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis">
                <Run Text="{x:Bind Reader.Header.Email, Mode=OneWay}" /><Run Text="{x:Bind views:Fmt.ToLine(Reader.Header.To), Mode=OneWay}" Foreground="{StaticResource Faint}" />
                <Run Text="{x:Bind views:Fmt.DateLine(Reader.Header.Date), Mode=OneWay}" Foreground="{StaticResource Faint}" />
              </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="1" MinWidth="90" FontSize="{x:Bind Look.ReaderSenderSize, Mode=OneWay}" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Tapped="OnSenderTapped"
                       Visibility="{x:Bind Look.NordicOnly, Mode=OneWay}">
              <Run Text="{x:Bind Reader.Header.From, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
              <Run Text="{x:Bind views:Fmt.ToLine(Reader.Header.To), Mode=OneWay}" />
              <Run Text="{x:Bind views:Fmt.DateLine(Reader.Header.Date), Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Column="3" Text="{x:Bind Reader.Header.CompactDate, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource Dim}" Visibility="{x:Bind Look.BulwarkOnly, Mode=OneWay}" />
            <Border Visibility="{x:Bind views:Fmt.VerdictVisibility(Reader.AuthVerdict), Mode=OneWay}" x:Name="VerdictPill" Grid.Column="2" Height="22" CornerRadius="11" Padding="10,0" Background="{x:Bind views:Fmt.VerdictBackground(Reader.AuthVerdict), Mode=OneWay}" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="reader.verdict" AutomationProperties.Name="Authentication result">
              <TextBlock Text="{x:Bind views:Fmt.AuthLabel(Reader.AuthVerdict), Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind views:Fmt.VerdictForeground(Reader.AuthVerdict), Mode=OneWay}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Border>
            <Button Grid.Column="4" x:Name="DetailsButton" Style="{StaticResource Button.Icon}" Height="26" Padding="8,0" CornerRadius="9" Foreground="{StaticResource Dim}" Click="OnDetailsClick"
                    AutomationProperties.AutomationId="reader.details.toggle" AutomationProperties.Name="Details">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="DetailsLabel" Text="Details" FontSize="12" />
                <controls:SIcon x:Name="DetailsChevron" Kind="ChevronRight" Size="12" StrokeWidth="2" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          </Border>

          <!-- details panel: from, to, date and the check of each authentication method (spec I-206) -->
           <Border Grid.Row="4" x:Name="DetailsPanel" Visibility="Collapsed" CornerRadius="{x:Bind Look.AttachmentRadius, Mode=OneWay}" Padding="14,12" Background="{StaticResource Tile2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  AutomationProperties.AutomationId="reader.details" AutomationProperties.Name="Message details">
            <StackPanel Spacing="6">
              <TextBlock FontSize="12.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap" IsTextSelectionEnabled="True">
                <Run Text="From  " /><Run Text="{x:Bind Reader.Header.From, Mode=OneWay}" Foreground="{StaticResource Body}" /><Run Text="  " /><Run Text="{x:Bind views:Fmt.Angle(Reader.Header.Email), Mode=OneWay}" />
              </TextBlock>
              <TextBlock FontSize="12.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap" IsTextSelectionEnabled="True">
                <Run Text="To  " /><Run Text="{x:Bind Reader.Header.To, Mode=OneWay}" Foreground="{StaticResource Body}" />
              </TextBlock>
              <TextBlock FontSize="12.5" Foreground="{StaticResource Dim}">
                <Run Text="Date  " /><Run Text="{x:Bind Reader.Header.Date, Mode=OneWay}" Foreground="{StaticResource Body}" />
              </TextBlock>
              <TextBlock Text="{x:Bind views:Fmt.AuthLabel(Reader.AuthVerdict), Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource Dim}" />
              <ItemsRepeater ItemsSource="{x:Bind Reader.AuthChips, Mode=OneWay}" AutomationProperties.AutomationId="reader.auth" AutomationProperties.Name="Authentication checks">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="mail:AuthChip">
                    <Border Height="22" CornerRadius="11" Padding="10,0" Background="{x:Bind views:Fmt.AuthBackground(Result)}" AutomationProperties.Name="{x:Bind views:Fmt.AuthText(Method, Result)}">
                      <TextBlock Text="{x:Bind views:Fmt.AuthText(Method, Result)}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind views:Fmt.AuthForeground(Result)}" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </StackPanel>
          </Border>

           <!-- Independently expandable conversation messages, before the selected message. -->
           <Border Grid.Row="2" Visibility="{x:Bind views:Fmt.VisCount(Reader.ConversationHeaders.Count), Mode=OneWay}"
                   AutomationProperties.AutomationId="reader.conversation" AutomationProperties.Name="Conversation">
               <ScrollViewer x:Name="ConversationScroll" MaxHeight="204" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
                 <ItemsRepeater ItemsSource="{x:Bind Reader.ConversationHeaders}">
                  <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="2" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                     <DataTemplate x:DataType="mail:ConversationItem">
                       <StackPanel Spacing="4">
                         <Button Style="{StaticResource Button.Action}" Click="OnShowOlderClick" MinHeight="32" FontSize="14" FontWeight="Medium" CornerRadius="{x:Bind theme:StyleState.Current.ButtonRadius, Mode=OneWay}"
                                 Content="{x:Bind OlderMessageDisclosure}"
                                 Visibility="{x:Bind views:Fmt.VisText(OlderMessageDisclosure)}"
                                 AutomationProperties.Name="{x:Bind OlderMessageDisclosure}" AutomationProperties.AutomationId="{x:Bind views:Fmt.ConversationDisclosureId(OlderMessageDisclosure)}" />
                       <Button Style="{StaticResource Button.Action}" MinHeight="56" Padding="12,8" CornerRadius="{x:Bind theme:StyleState.Current.AttachmentRadius, Mode=OneWay}" FontWeight="Normal" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch" Tag="{x:Bind Id}" Click="OnConversationHeaderClick"
                               AutomationProperties.AutomationId="{x:Bind views:Fmt.ConversationHeaderId(Id)}" AutomationProperties.Name="{x:Bind Sender}">
                         <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                           <Border Width="32" Height="32" CornerRadius="16" Background="{x:Bind views:Fmt.TintBg(TintIndex)}">
                             <TextBlock Text="{x:Bind Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{x:Bind views:Fmt.TintFg(TintIndex)}" />
                           </Border>
                           <TextBlock Grid.Column="1" Text="{x:Bind Sender}" FontSize="14" FontWeight="{x:Bind views:Fmt.Weight(Unread)}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                           <TextBlock Grid.Column="2" Text="{x:Bind TimeLabel}" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                           <controls:SIcon Grid.Column="3" Kind="ChevronDown" Size="20" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                         </Grid>
                       </Button>
                       <reader:ConversationCardView DataContext="{x:Bind Expansion}" />
                       </StackPanel>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </ScrollViewer>
           </Border>

          <!-- attachment cards: a click or right-click opens MENU-ATT (save, download all, copy the name) -->
          <StackPanel Grid.Row="5" Spacing="6" Visibility="{x:Bind views:Fmt.VisCount(Reader.Attachments.Count), Mode=OneWay}" AutomationProperties.AutomationId="reader.attachments" AutomationProperties.Name="Attachments">
            <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="32">
              <controls:SIcon Kind="Clip" Size="16" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind reader:ReaderView.SummaryText(Reader.AttachmentSummary, Reader.Attachments.Count), Mode=OneWay}" FontSize="14" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ItemsRepeater ItemsSource="{x:Bind Reader.Attachments}">
              <ItemsRepeater.Layout>
                <StackLayout Orientation="Horizontal" Spacing="10" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="mail:AttachmentCard">
                  <Border MinWidth="190" Height="56" CornerRadius="{x:Bind theme:StyleState.Current.AttachmentRadius, Mode=OneWay}" Padding="8,6,4,6" Background="{x:Bind theme:StyleState.Current.AttachmentFill, Mode=OneWay}"
                          PointerEntered="OnAttachmentEnter" PointerExited="OnAttachmentLeave" BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind theme:StyleState.Current.AttachmentBorder, Mode=OneWay}"
                          Tapped="OnAttachmentTapped" RightTapped="OnAttachmentRightTapped" AutomationProperties.AutomationId="{x:Bind views:Fmt.AttachmentId(Index)}" AutomationProperties.Name="{x:Bind Stem}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Border Width="40" Height="40" CornerRadius="{x:Bind theme:StyleState.Current.AttachmentThumbRadius, Mode=OneWay}" Background="{StaticResource RoseBg}">
                        <TextBlock Text="{x:Bind views:Fmt.Badge(Kind)}" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource RoseFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock Text="{x:Bind Stem}" FontSize="14" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Size}" Style="{StaticResource Text.Meta}" FontSize="12" />
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="32" Height="32" CornerRadius="{x:Bind theme:StyleState.Current.ButtonRadius, Mode=OneWay}" Tag="{x:Bind Index}" Click="OnAttachmentDownloadClick"
                              VerticalAlignment="Center" motion:Tip.Text="Download" AutomationProperties.Name="Download" AutomationProperties.AutomationId="{x:Bind reader:ReaderView.DownloadId(Index)}">
                        <controls:SIcon Kind="Download" Size="16" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>

          <!-- banners: the server cut the body short, or the message could not be loaded (retry) -->
          <StackPanel Grid.Row="6" Spacing="8">
            <Border CornerRadius="{x:Bind Look.BannerRadius, Mode=OneWay}" Padding="14,10" Background="{StaticResource AmberBg}" Visibility="{x:Bind views:Fmt.VisBody(Reader.BodyState, 'truncated'), Mode=OneWay}"
                    AutomationProperties.AutomationId="reader.truncated" AutomationProperties.Name="Message cut short">
              <TextBlock Text="The server cut this message short." FontSize="12.5" Foreground="{StaticResource AmberFg}" />
            </Border>
            <Border CornerRadius="{x:Bind Look.BannerRadius, Mode=OneWay}" Padding="14,10" Background="{StaticResource RoseBg}" Visibility="{x:Bind views:Fmt.VisBody(Reader.BodyState, 'failed'), Mode=OneWay}"
                    AutomationProperties.AutomationId="reader.failed" AutomationProperties.Name="Message could not be loaded">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{x:Bind views:Fmt.FailedText(Reader.Error), Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource RoseFg}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource Button.Action}" Height="30" CornerRadius="{x:Bind Look.ButtonRadius, Mode=OneWay}" Click="OnRetryClick"
                        AutomationProperties.AutomationId="reader.retry" AutomationProperties.Name="Try again">
                  <TextBlock Text="Try again" />
                </Button>
              </Grid>
            </Border>
          </StackPanel>

          <!-- the body slot: the web view of the body stream -->
          <body:MailBodyView Grid.Row="7" x:Name="BodySlot" MinHeight="80" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.AutomationId="reader.body" AutomationProperties.Name="Message body" />

           <Border Grid.Row="8" x:Name="QuickReplyBar" Visibility="Collapsed" BorderBrush="{StaticResource Line}" LostFocus="OnQuickReplyBlur"
                   AutomationProperties.AutomationId="reader.reply-bar" AutomationProperties.Name="Quick reply">
             <Grid ColumnDefinitions="Auto,*">
               <Border Visibility="{x:Bind Look.BulwarkOnly, Mode=OneWay}" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0" VerticalAlignment="Top" Background="{StaticResource Sel}">
                 <TextBlock Text="{x:Bind Account.AccountInitials, Mode=OneWay}" Foreground="{StaticResource SelText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
               </Border>
             <StackPanel Grid.Column="1" x:Name="QuickReplyLayout">
               <TextBox x:Name="QuickReplyText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="144" ScrollViewer.VerticalScrollBarVisibility="Auto"
                        GotFocus="OnQuickReplyFocus" TextChanged="OnQuickReplyTextChanged"
                        PlaceholderText="Write a reply…" FontSize="14"
                        AutomationProperties.AutomationId="reader.reply-text" AutomationProperties.Name="Quick reply text" />
               <StackPanel x:Name="QuickReplyActions" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                 <Button Content="Cancel" Style="{x:Bind Look.QuickReplyGhostStyle, Mode=OneWay}" Height="32" Padding="12,0" CornerRadius="{x:Bind Look.ButtonRadius, Mode=OneWay}" Click="OnQuickReplyCancel" AutomationProperties.Name="Cancel quick reply" AutomationProperties.AutomationId="reader.reply.cancel" />
                 <Button Content="Open full editor" Style="{x:Bind Look.QuickReplyGhostStyle, Mode=OneWay}" Height="32" Padding="12,0" CornerRadius="{x:Bind Look.ButtonRadius, Mode=OneWay}" Click="OnQuickReplyOpenEditor" AutomationProperties.Name="Open full editor" AutomationProperties.AutomationId="reader.reply.full" />
                 <Button x:Name="QuickReplySend" Content="Send" Style="{StaticResource Button.Primary}" Height="32" Padding="16,0" FontSize="14" CornerRadius="{x:Bind Look.ButtonRadius, Mode=OneWay}" Click="OnQuickReplySend" AutomationProperties.Name="Send quick reply" AutomationProperties.AutomationId="reader.reply.send" />
               </StackPanel>
             </StackPanel>
             </Grid>
          </Border>
          <Grid x:Name="PhoneActions" Grid.Row="9" ColumnDefinitions="*,*,*,*,*" MinHeight="46" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Button Grid.Column="0" Style="{StaticResource Button.Icon}" HorizontalAlignment="Stretch" Padding="0" Click="OnPreviousClick"
                    AutomationProperties.Name="Previous" AutomationProperties.AutomationId="reader.mobile.previous">
              <StackPanel Spacing="2"><FontIcon Glyph="&#xE76B;" FontSize="16" /><TextBlock Text="Previous" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource Button.Icon}" HorizontalAlignment="Stretch" Padding="0" Click="OnReplyClick"
                    AutomationProperties.Name="Reply" AutomationProperties.AutomationId="reader.mobile.reply">
              <StackPanel Spacing="2"><FontIcon Glyph="&#xE97A;" FontSize="16" /><TextBlock Text="Reply" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" HorizontalAlignment="Stretch" Padding="0" Click="OnReplyAllClick"
                    AutomationProperties.Name="Reply all" AutomationProperties.AutomationId="reader.mobile.replyall">
              <StackPanel Spacing="2"><controls:SIcon Kind="ReplyAll" Size="16" HorizontalAlignment="Center" /><TextBlock Text="Reply all" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource Button.Icon}" HorizontalAlignment="Stretch" Padding="0" Click="OnForwardClick"
                    AutomationProperties.Name="Forward" AutomationProperties.AutomationId="reader.mobile.forward">
              <StackPanel Spacing="2"><FontIcon Glyph="&#xE72A;" FontSize="16" /><TextBlock Text="Forward" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource Button.Icon}" HorizontalAlignment="Stretch" Padding="0" Click="OnNextClick"
                    AutomationProperties.Name="Next" AutomationProperties.AutomationId="reader.mobile.next">
              <StackPanel Spacing="2"><FontIcon Glyph="&#xE76C;" FontSize="16" /><TextBlock Text="Next" HorizontalAlignment="Center" FontSize="11" /></StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
