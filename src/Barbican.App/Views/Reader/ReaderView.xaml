<UserControl
    x:Class="Barbican.App.Views.Reader.ReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:body="using:Barbican.App.MailBody"
    xmlns:controls="using:Barbican.App.Controls"
    xmlns:theme="using:Barbican.App.Theme"
    xmlns:views="using:Barbican.App.Views"
    xmlns:mail="using:Barbican.Presentation.Mail">
  <!-- The reader chrome (spec/layout/reader.md; BNMail main, NordMail main): the toolbar (shown, disabled until M2/M3), the header with the details panel and the authentication chips,
       the conversation strip, the attachment cards, the body slot (MailBodyView, body stream), and the reply bar. Header, strip, cards and body come from ReaderViewModel.Apply in one
       call, so they change together. Laid out as the prototype (prototype/winui/MainWindow.xaml ReaderTile / NordReader). The only motion is the header rise on a switch
       (Motion/Rise, never while keys repeat); the body cross-fades in MailBodyView (design/MOTION.md). -->
  <Border Background="{x:Bind Look.PaneBrush, Mode=OneWay}" BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind Look.PaneBorder, Mode=OneWay}"
          CornerRadius="{x:Bind Look.PaneRadius, Mode=OneWay}" MinWidth="240" MinHeight="200" AutomationProperties.AutomationId="reader" AutomationProperties.Name="Message">
    <Border BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind Look.ListHairline, Mode=OneWay}" CornerRadius="{x:Bind Look.PaneRadius, Mode=OneWay}">
      <Grid>
        <!-- nothing open -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{x:Bind views:Fmt.VisBody(Reader.BodyState, 'empty'), Mode=OneWay}"
                    AutomationProperties.AutomationId="reader.empty" AutomationProperties.Name="No message selected">
          <Border Width="68" Height="68" CornerRadius="25" Background="{StaticResource Tile2}" BorderBrush="{StaticResource Line}" BorderThickness="1" HorizontalAlignment="Center">
            <Canvas Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Rectangle Canvas.Left="3" Canvas.Top="12" Width="7" Height="19" RadiusX="3.5" RadiusY="3.5" Fill="{StaticResource Accent}" />
              <Rectangle Canvas.Left="13.5" Canvas.Top="3" Width="7" Height="28" RadiusX="3.5" RadiusY="3.5" Fill="{StaticResource Accent}" Opacity="0.7" />
              <Rectangle Canvas.Left="24" Canvas.Top="8" Width="7" Height="23" RadiusX="3.5" RadiusY="3.5" Fill="{StaticResource Accent}" Opacity="0.4" />
            </Canvas>
          </Border>
          <TextBlock Text="Select a message to read it" FontSize="13" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
        </StackPanel>

        <Grid x:Name="ContentGrid" Padding="{x:Bind Look.ReaderPadding, Mode=OneWay}" RowSpacing="{x:Bind Look.ReaderSpacing, Mode=OneWay}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
              Visibility="{x:Bind views:Fmt.VisBody(Reader.BodyState, 'content'), Mode=OneWay}">
          <!-- The order follows the prototype: Bento subject, sender line, actions; Nordic actions, subject, the "to you" line. The rows are bound (StyleState.Reader*Row). -->
          <!-- actions: Reply, Reply all, Forward, Archive and Delete are M2 or M3 and stay disabled; More opens MENU-READER. Bento: icon + label (Reply all, Delete, More icon-only); Nordic: text only. -->
          <StackPanel Grid.Row="{x:Bind Look.ReaderActionsRow, Mode=OneWay}" Orientation="Horizontal" Spacing="8" AutomationProperties.AutomationId="reader.toolbar" AutomationProperties.Name="Message actions">
            <Button Style="{StaticResource Button.Action}" Height="{x:Bind Look.ActionButtonHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ActionRadius, Mode=OneWay}"
                    Padding="{x:Bind Look.ActionPadding, Mode=OneWay}" IsEnabled="False" AutomationProperties.AutomationId="reader.reply" AutomationProperties.Name="Reply">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Reply" Size="16" Visibility="{x:Bind Look.BentoOnly, Mode=OneWay}" /><TextBlock Text="Reply" /></StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Action}" Height="{x:Bind Look.ActionButtonHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ActionRadius, Mode=OneWay}"
                    Padding="{x:Bind Look.ActionPadding, Mode=OneWay}" IsEnabled="False" AutomationProperties.AutomationId="reader.replyall" AutomationProperties.Name="Reply all">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="ReplyAll" Size="16" Visibility="{x:Bind Look.BentoOnly, Mode=OneWay}" /><TextBlock Text="Reply all" Visibility="{x:Bind Look.SecondaryLabelVisibility, Mode=OneWay}" /></StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Action}" Height="{x:Bind Look.ActionButtonHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ActionRadius, Mode=OneWay}"
                    Padding="{x:Bind Look.ActionPadding, Mode=OneWay}" IsEnabled="False" AutomationProperties.AutomationId="reader.forward" AutomationProperties.Name="Forward">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Fwd" Size="16" Visibility="{x:Bind Look.BentoOnly, Mode=OneWay}" /><TextBlock Text="Forward" /></StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Action}" Height="{x:Bind Look.ActionButtonHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ActionRadius, Mode=OneWay}"
                    Padding="{x:Bind Look.ActionPadding, Mode=OneWay}" IsEnabled="False" AutomationProperties.AutomationId="reader.archive" AutomationProperties.Name="Archive">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Archive" Size="16" Visibility="{x:Bind Look.BentoOnly, Mode=OneWay}" /><TextBlock Text="Archive" /></StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Action}" Height="{x:Bind Look.ActionButtonHeight, Mode=OneWay}" CornerRadius="{x:Bind Look.ActionRadius, Mode=OneWay}"
                    Padding="{x:Bind Look.ActionPadding, Mode=OneWay}" IsEnabled="False" AutomationProperties.AutomationId="reader.delete" AutomationProperties.Name="Delete">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:SIcon Kind="Trash" Size="16" Visibility="{x:Bind Look.BentoOnly, Mode=OneWay}" /><TextBlock Text="Delete" Visibility="{x:Bind Look.SecondaryLabelVisibility, Mode=OneWay}" /></StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Action}" Width="{x:Bind Look.ActionButtonHeight, Mode=OneWay}" Height="{x:Bind Look.ActionButtonHeight, Mode=OneWay}" Padding="0"
                    CornerRadius="{x:Bind Look.ActionRadius, Mode=OneWay}" Click="OnMoreClick" AutomationProperties.AutomationId="reader.more" AutomationProperties.Name="More actions">
              <controls:SIcon Kind="More" Size="16" />
            </Button>
          </StackPanel>

          <!-- header: the subject and the sender line rise a few pixels when another message opens (Motion/Rise; the prototype's header transition) -->
          <TextBlock Grid.Row="{x:Bind Look.ReaderSubjectRow, Mode=OneWay}" x:Name="SubjectText" Text="{x:Bind Reader.Header.Subject, Mode=OneWay}" FontSize="{x:Bind Look.ReaderSubjectSize, Mode=OneWay}"
                     FontWeight="{x:Bind Look.ReaderSubjectWeight, Mode=OneWay}" CharacterSpacing="{x:Bind Look.ReaderSubjectSpacing, Mode=OneWay}" LineHeight="{x:Bind Look.ReaderSubjectLineHeight, Mode=OneWay}"
                     Margin="{x:Bind Look.ReaderSubjectMargin, Mode=OneWay}" Foreground="{StaticResource Text}"
                     TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="reader.subject" AutomationProperties.Name="Subject">
            <TextBlock.RenderTransform>
              <TranslateTransform x:Name="SubjectShift" />
            </TextBlock.RenderTransform>
          </TextBlock>
          <Grid Grid.Row="{x:Bind Look.ReaderSenderRow, Mode=OneWay}" x:Name="SenderLine" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" AutomationProperties.AutomationId="reader.header" AutomationProperties.Name="Message header">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="SenderShift" />
            </Grid.RenderTransform>
            <Border Width="40" Height="40" CornerRadius="{x:Bind Look.AvatarRadius, Mode=OneWay}" Background="{x:Bind views:Fmt.TintBg(Reader.Header.TintIndex), Mode=OneWay}"
                    Visibility="{x:Bind Look.ShowAvatar, Mode=OneWay}" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Reader.Header.Initials, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{x:Bind views:Fmt.TintFg(Reader.Header.TintIndex), Mode=OneWay}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <!-- Bento: From 14 semibold over the address and date; Nordic: "From to you · date" in one dim line -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{x:Bind Look.BentoOnly, Mode=OneWay}">
              <TextBlock Text="{x:Bind Reader.Header.From, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                         AutomationProperties.AutomationId="reader.sender" AutomationProperties.Name="Sender" />
              <TextBlock FontSize="12.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis">
                <Run Text="{x:Bind Reader.Header.Email, Mode=OneWay}" /><Run Text="{x:Bind views:Fmt.ToLine(Reader.Header.To), Mode=OneWay}" Foreground="{StaticResource Faint}" />
                <Run Text="{x:Bind views:Fmt.DateLine(Reader.Header.Date), Mode=OneWay}" Foreground="{StaticResource Faint}" />
              </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="1" FontSize="{x:Bind Look.ReaderSenderSize, Mode=OneWay}" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Visibility="{x:Bind Look.NordicOnly, Mode=OneWay}">
              <Run Text="{x:Bind Reader.Header.From, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
              <Run Text="{x:Bind views:Fmt.ToLine(Reader.Header.To), Mode=OneWay}" />
              <Run Text="{x:Bind views:Fmt.DateLine(Reader.Header.Date), Mode=OneWay}" />
            </TextBlock>
            <Border Grid.Column="2" Height="22" CornerRadius="11" Padding="10,0" Background="{x:Bind views:Fmt.VerdictBackground(Reader.AuthVerdict), Mode=OneWay}" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="reader.verdict" AutomationProperties.Name="Authentication result">
              <TextBlock Text="{x:Bind views:Fmt.AuthLabel(Reader.AuthVerdict), Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind views:Fmt.VerdictForeground(Reader.AuthVerdict), Mode=OneWay}"
                         VerticalAlignment="Center" />
            </Border>
            <Button Grid.Column="3" x:Name="DetailsButton" Style="{StaticResource Button.Icon}" Height="26" Padding="8,0" CornerRadius="9" Foreground="{StaticResource Dim}" Click="OnDetailsClick"
                    AutomationProperties.AutomationId="reader.details.toggle" AutomationProperties.Name="Details">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="DetailsLabel" Text="Details" FontSize="12" />
                <controls:SIcon x:Name="DetailsChevron" Kind="ChevronRight" Size="12" StrokeWidth="2" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- details panel: from, to, date and the check of each authentication method (spec I-206) -->
          <Border Grid.Row="3" x:Name="DetailsPanel" Visibility="Collapsed" CornerRadius="16" Padding="14,12" Background="{StaticResource Tile2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  AutomationProperties.AutomationId="reader.details" AutomationProperties.Name="Message details">
            <StackPanel Spacing="6">
              <TextBlock FontSize="12.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap" IsTextSelectionEnabled="True">
                <Run Text="From  " /><Run Text="{x:Bind Reader.Header.From, Mode=OneWay}" Foreground="{StaticResource Body}" /><Run Text="  " /><Run Text="{x:Bind views:Fmt.Angle(Reader.Header.Email), Mode=OneWay}" />
              </TextBlock>
              <TextBlock FontSize="12.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap" IsTextSelectionEnabled="True">
                <Run Text="To  " /><Run Text="{x:Bind Reader.Header.To, Mode=OneWay}" Foreground="{StaticResource Body}" />
              </TextBlock>
              <TextBlock FontSize="12.5" Foreground="{StaticResource Dim}">
                <Run Text="Date  " /><Run Text="{x:Bind Reader.Header.Date, Mode=OneWay}" Foreground="{StaticResource Body}" />
              </TextBlock>
              <ItemsRepeater ItemsSource="{x:Bind Reader.AuthChips, Mode=OneWay}" AutomationProperties.AutomationId="reader.auth" AutomationProperties.Name="Authentication checks">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="mail:AuthChip">
                    <Border Height="22" CornerRadius="11" Padding="10,0" Background="{x:Bind views:Fmt.AuthBackground(Result)}" AutomationProperties.Name="{x:Bind views:Fmt.AuthText(Method, Result)}">
                      <TextBlock Text="{x:Bind views:Fmt.AuthText(Method, Result)}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind views:Fmt.AuthForeground(Result)}" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </StackPanel>
          </Border>

          <!-- conversation strip: up to 5 rows visible (spec/layout/reader.md) -->
          <Border Grid.Row="4" Visibility="{x:Bind views:Fmt.VisMany(Reader.Conversation.Count), Mode=OneWay}" CornerRadius="10" Padding="10" Background="{StaticResource Tile2}"
                  AutomationProperties.AutomationId="reader.conversation" AutomationProperties.Name="Conversation">
            <StackPanel Spacing="6">
              <TextBlock Text="{x:Bind views:Fmt.Conversation(Reader.Conversation.Count), Mode=OneWay}" Style="{StaticResource Text.Label}" />
              <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
                <ItemsRepeater ItemsSource="{x:Bind Reader.Conversation}">
                  <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="2" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="mail:ConversationItem">
                      <Grid Height="30" Padding="8,0" ColumnDefinitions="Auto,150,*,Auto" ColumnSpacing="10" CornerRadius="8" Background="{x:Bind views:Fmt.CurrentBackground(IsCurrent)}"
                            AutomationProperties.AutomationId="{x:Bind Id}" AutomationProperties.Name="{x:Bind Sender}">
                        <Ellipse Width="6" Height="6" Fill="{x:Bind views:Fmt.UnreadDot(Unread)}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Sender}" FontSize="12.5" FontWeight="{x:Bind views:Fmt.Weight(Unread)}" Foreground="{StaticResource Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind TimeLabel}" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- attachment cards: a click or right-click opens MENU-ATT (save, download all, copy the name) -->
          <StackPanel Grid.Row="5" Spacing="6" Visibility="{x:Bind views:Fmt.VisCount(Reader.Attachments.Count), Mode=OneWay}" AutomationProperties.AutomationId="reader.attachments" AutomationProperties.Name="Attachments">
            <TextBlock Text="{x:Bind Reader.AttachmentSummary, Mode=OneWay}" Style="{StaticResource Text.Label}" />
            <ItemsRepeater ItemsSource="{x:Bind Reader.Attachments}">
              <ItemsRepeater.Layout>
                <StackLayout Orientation="Horizontal" Spacing="10" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="mail:AttachmentCard">
                  <Border MinWidth="190" Height="56" CornerRadius="{x:Bind theme:StyleState.Current.CardRadius, Mode=OneWay}" Padding="10,6" Background="{StaticResource Tile2}"
                          BorderBrush="{StaticResource Line}" BorderThickness="{x:Bind theme:StyleState.Current.CardBorder, Mode=OneWay}"
                          Tapped="OnAttachmentTapped" RightTapped="OnAttachmentRightTapped" AutomationProperties.AutomationId="{x:Bind views:Fmt.AttachmentId(Index)}" AutomationProperties.Name="{x:Bind Stem}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource RoseBg}">
                        <TextBlock Text="{x:Bind views:Fmt.Badge(Kind)}" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource RoseFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock Text="{x:Bind Stem}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Size}" Style="{StaticResource Text.Meta}" FontSize="11.5" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>

          <!-- banners: the server cut the body short, or the message could not be loaded (retry) -->
          <StackPanel Grid.Row="6" Spacing="8">
            <Border CornerRadius="14" Padding="14,10" Background="{StaticResource AmberBg}" Visibility="{x:Bind views:Fmt.VisBody(Reader.BodyState, 'truncated'), Mode=OneWay}"
                    AutomationProperties.AutomationId="reader.truncated" AutomationProperties.Name="Message cut short">
              <TextBlock Text="The server cut this message short." FontSize="12.5" Foreground="{StaticResource AmberFg}" />
            </Border>
            <Border CornerRadius="14" Padding="14,10" Background="{StaticResource RoseBg}" Visibility="{x:Bind views:Fmt.VisBody(Reader.BodyState, 'failed'), Mode=OneWay}"
                    AutomationProperties.AutomationId="reader.failed" AutomationProperties.Name="Message could not be loaded">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{x:Bind views:Fmt.FailedText(Reader.Error), Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource RoseFg}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource Button.Action}" Height="30" CornerRadius="{x:Bind Look.ButtonRadius, Mode=OneWay}" Click="OnRetryClick"
                        AutomationProperties.AutomationId="reader.retry" AutomationProperties.Name="Try again">
                  <TextBlock Text="Try again" />
                </Button>
              </Grid>
            </Border>
          </StackPanel>

          <!-- the body slot: the web view of the body stream -->
          <body:MailBodyView Grid.Row="7" x:Name="BodySlot" MinHeight="80" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.AutomationId="reader.body" AutomationProperties.Name="Message body" />

          <!-- the reply bar: shown, disabled until M3 -->
          <Border Grid.Row="8" CornerRadius="{x:Bind Look.ReplyRadius, Mode=OneWay}" Padding="20,8,8,8" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  AutomationProperties.AutomationId="reader.reply-bar" AutomationProperties.Name="Quick reply">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Style="{StaticResource TextBox.Bare}" IsEnabled="False" PlaceholderText="{x:Bind views:Fmt.ReplyHint(Reader.Header.From), Mode=OneWay}" FontSize="14.5"
                       AutomationProperties.AutomationId="reader.reply-text" AutomationProperties.Name="Quick reply text" />
              <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Height="40" Padding="22,0" FontSize="13.5" CornerRadius="20" IsEnabled="False"
                      AutomationProperties.AutomationId="reader.send" AutomationProperties.Name="Send">
                <TextBlock Text="Send" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
