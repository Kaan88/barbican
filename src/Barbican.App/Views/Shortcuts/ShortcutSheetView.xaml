<UserControl
    x:Class="Barbican.App.Views.Shortcuts.ShortcutSheetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="not_win">
  <!-- The ? shortcuts sheet (Rust shortcuts.rs show_help, Bulwark components/keyboard-shortcuts-modal.tsx): one in-window Popup constrained to the window; the rows are drawn by the
       code-behind from ShortcutSheetController. -->
  <Popup x:Name="SheetPopup" win:ShouldConstrainToRootBounds="True" AutomationProperties.AutomationId="shortcuts.popup">
    <Grid x:Name="Backdrop" Background="#66000000" AutomationProperties.AutomationId="shortcuts.backdrop">
      <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" MaxHeight="620" Padding="0,16,0,8"
              Background="{StaticResource Popup}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16"
              AutomationProperties.AutomationId="shortcuts.card" AutomationProperties.Name="Keyboard shortcuts">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="Keyboard shortcuts" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="20,0,20,10" />
          <StackPanel x:Name="Tabs" Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="20,0,20,8" AutomationProperties.AutomationId="shortcuts.tabs" />
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="shortcuts.scroll">
            <StackPanel x:Name="Rows" Margin="20,0,20,0" AutomationProperties.AutomationId="shortcuts.rows" />
          </ScrollViewer>
          <TextBlock x:Name="Note" Grid.Row="3" Margin="20,8,20,4" FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Visibility="Collapsed"
                     Text="Single-key shortcuts are off (Settings, Accessibility); the greyed rows need them." AutomationProperties.AutomationId="shortcuts.note" />
        </Grid>
      </Border>
    </Grid>
  </Popup>
</UserControl>
