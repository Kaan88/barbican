<UserControl
    x:Class="Barbican.App.Views.Dialogs.DialogHeaderMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Barbican.App.Controls"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="not_win">
  <!-- The options button at the end of a dialog's title row with its one menu (Bulwark plugin-dialog-host.tsx:583-621: vertical ellipsis, one destructive entry). The flyout is declared
       here, constrained to the window (popup lint, ADR 0007); DialogHostView fills the texts and the action. -->
  <Button x:Name="MenuButton" Style="{StaticResource Button.Icon}" Width="32" Height="32" AutomationProperties.AutomationId="plugin.dialog.menu" AutomationProperties.Name="Options">
    <controls:SIcon Kind="More" Size="20" RenderTransformOrigin="0.5,0.5"><controls:SIcon.RenderTransform><RotateTransform Angle="90" /></controls:SIcon.RenderTransform></controls:SIcon>
    <Button.Flyout>
      <MenuFlyout win:ShouldConstrainToRootBounds="True" Placement="BottomEdgeAlignedRight">
        <MenuFlyoutItem x:Name="MenuItem" Foreground="{StaticResource Destructive}" Click="OnItemClick" AutomationProperties.AutomationId="plugin.dialog.turn-off" AutomationProperties.Name="Turn off" />
      </MenuFlyout>
    </Button.Flyout>
  </Button>
</UserControl>
