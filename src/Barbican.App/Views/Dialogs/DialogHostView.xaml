<UserControl
    x:Class="Barbican.App.Views.Dialogs.DialogHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="not_win">
  <!-- The dialog host (PORT-PLAN 3.7: Scrim + PopIn, focus trapped and restored, never ContentDialog). One in-window Popup constrained to the window; its child is the scrim
       (dims the window, a click on it does nothing: a dialog is modal) with the card centred above it. The card is filled by the code-behind for the built-in prompt and confirm
       dialogs; an owner's own dialog registers an IDialogContent and fills Content. -->
  <Popup x:Name="DialogPopup" win:ShouldConstrainToRootBounds="True" AutomationProperties.AutomationId="dialog.popup">
    <Grid x:Name="Backdrop" Background="#66000000" TabFocusNavigation="Cycle" AutomationProperties.AutomationId="dialog.scrim">
      <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320" MaxWidth="440" Padding="20"
              Background="{StaticResource Popup}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16"
              AutomationProperties.AutomationId="dialog.card" AutomationProperties.Name="Dialog">
        <StackPanel Spacing="12">
          <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap" AutomationProperties.AutomationId="dialog.title" />
          <TextBlock x:Name="MessageText" FontSize="13" Foreground="{StaticResource Body}" TextWrapping="Wrap" AutomationProperties.AutomationId="dialog.message" />
          <TextBox x:Name="Field" Visibility="Collapsed" KeyDown="OnFieldKeyDown" AutomationProperties.AutomationId="dialog.field" AutomationProperties.Name="Name" />
          <ContentControl x:Name="CustomContent" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="dialog.content" />
          <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Style="{StaticResource Button.Action}" Content="Cancel" CornerRadius="14" Height="32" Padding="16,0" Click="OnCancel"
                    AutomationProperties.AutomationId="dialog.cancel" AutomationProperties.Name="Cancel" />
            <Button x:Name="OkButton" Style="{StaticResource Button.Primary}" Content="OK" CornerRadius="14" Height="32" Padding="16,0" Click="OnOk"
                    AutomationProperties.AutomationId="dialog.ok" AutomationProperties.Name="OK" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Popup>
</UserControl>
