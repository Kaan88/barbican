<UserControl
    x:Class="Barbican.App.Views.Actions.ToastHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actions="using:Barbican.Presentation.Actions"
    xmlns:controls="using:Barbican.App.Controls"
    xmlns:views="using:Barbican.App.Views"
    xmlns:local="using:Barbican.App.Views.Actions"
    IsTabStop="False">
  <!-- The toasts (Bulwark components/ui/toast.tsx:243-261, 500-561, stores/toast-store.ts): in the overlay layer, never a popup (ADR 0007). Bulwark: bottom-right (bottom-5 end-5), 360 px
       wide, rounded-md, popover fill with a border, a status icon (neutral for info and success, red for an error, amber for a warning) beside the message, actions at the end, a close
       button, 10 px between toasts. Bento and Nordic keep the bottom-centre stack (the code-behind places it). The service holds them; Narrator hears each one through a notification event. -->
  <UserControl.Resources>
      <DataTemplate x:Key="ToastTemplate" x:DataType="actions:ToastItem">
        <Border Loaded="OnToastLoaded" Background="{StaticResource Popup}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,12,10,12" Margin="0,5,0,5"
                AutomationProperties.AutomationId="toast" AutomationProperties.Name="{x:Bind AccessibleName}">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
              <ProgressRing IsActive="{x:Bind IsProgress}" Visibility="{x:Bind views:Fmt.Vis(IsProgress)}" Width="18" Height="18" AutomationProperties.Name="In progress" />
              <controls:SIcon Kind="{x:Bind local:ActionFmt.ToastIcon(Severity)}" Size="18" Foreground="{x:Bind local:ActionFmt.ToastIconBrush(Severity)}" Visibility="{x:Bind local:ActionFmt.NotVis(IsProgress)}" />
            </Grid>
            <Grid Grid.Column="1" ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" MinWidth="96" Spacing="2">
                <TextBlock Text="{x:Bind Message}" Foreground="{StaticResource Text}" FontSize="13.5" FontWeight="Medium" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0" Visibility="{x:Bind views:Fmt.VisText(DisplaySource)}">
                  <Path Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Dim}" StrokeThickness="2" VerticalAlignment="Center"
                        Data="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z" />
                  <TextBlock Text="{x:Bind DisplaySource}" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                <Button Content="{x:Bind SecondaryLabel}" Style="{StaticResource Button.Chip}" Visibility="{x:Bind views:Fmt.VisText(SecondaryLabel)}" Tag="{x:Bind}" Click="OnSecondary"
                        AutomationProperties.AutomationId="toast.secondary" AutomationProperties.Name="{x:Bind SecondaryLabel}" />
                <Button Content="{x:Bind ActionLabel}" Style="{StaticResource Button.Chip}" Visibility="{x:Bind views:Fmt.VisText(ActionLabel)}" Tag="{x:Bind}" Click="OnAction"
                        AutomationProperties.AutomationId="toast.action" AutomationProperties.Name="{x:Bind ActionLabel}" />
              </StackPanel>
            </Grid>
            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="24" Height="24" CornerRadius="4" VerticalAlignment="Top" Tag="{x:Bind}" Click="OnClose"
                    AutomationProperties.AutomationId="toast.close" AutomationProperties.Name="Close notification">
              <controls:SIcon Kind="Close" Size="14" />
            </Button>
          </Grid>
        </Border>
      </DataTemplate>
  </UserControl.Resources>
  <StackPanel x:Name="Stack" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,15" Width="360" AutomationProperties.AutomationId="toast.host" AutomationProperties.Name="Notifications">
    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{x:Bind Toasts.ProgressToasts}" ItemTemplate="{StaticResource ToastTemplate}" IsTabStop="False" />
    </ScrollViewer>
    <ItemsControl ItemsSource="{x:Bind Toasts.OrdinaryToasts}" ItemTemplate="{StaticResource ToastTemplate}" IsTabStop="False" />
  </StackPanel>
</UserControl>
