<UserControl
    x:Class="Barbican.App.Views.Actions.ToastHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actions="using:Barbican.Presentation.Actions"
    xmlns:views="using:Barbican.App.Views"
    xmlns:local="using:Barbican.App.Views.Actions"
    IsTabStop="False">
  <!-- The toasts (Bulwark stores/toast-store.ts): in the overlay layer, bottom centre, never a popup (ADR 0007). A toast appears in one frame and leaves when the timer says so;
       nothing animates (design/MOTION.md). The service holds them; Narrator hears each one through a notification event. -->
  <UserControl.Resources>
      <DataTemplate x:Key="ToastTemplate" x:DataType="actions:ToastItem">
        <Border Background="{StaticResource Popup}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,8,8,8" Margin="0,4,0,0"
                AutomationProperties.AutomationId="toast" AutomationProperties.Name="{x:Bind AccessibleName}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ProgressRing IsActive="{x:Bind IsProgress}" Visibility="{x:Bind views:Fmt.Vis(IsProgress)}" Width="18" Height="18" VerticalAlignment="Center" AutomationProperties.Name="In progress" />
            <StackPanel VerticalAlignment="Center" MaxWidth="460" Spacing="2">
              <TextBlock Text="{x:Bind DisplaySource}" Visibility="{x:Bind views:Fmt.VisText(DisplaySource)}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{x:Bind Message}" Foreground="{x:Bind local:ActionFmt.ToastText(Severity)}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="{x:Bind ActionLabel}" Style="{StaticResource Button.Chip}" Visibility="{x:Bind views:Fmt.VisText(ActionLabel)}" Tag="{x:Bind}" Click="OnAction"
                    AutomationProperties.AutomationId="toast.action" AutomationProperties.Name="{x:Bind ActionLabel}" />
            <Button Content="{x:Bind SecondaryLabel}" Style="{StaticResource Button.Chip}" Visibility="{x:Bind views:Fmt.VisText(SecondaryLabel)}" Tag="{x:Bind}" Click="OnSecondary"
                    AutomationProperties.AutomationId="toast.secondary" AutomationProperties.Name="{x:Bind SecondaryLabel}" />
            <Button Content="Close" Style="{StaticResource Button.Chip}" Tag="{x:Bind}" Click="OnClose" AutomationProperties.AutomationId="toast.close" AutomationProperties.Name="Close notification" />
          </StackPanel>
        </Border>
      </DataTemplate>
  </UserControl.Resources>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" AutomationProperties.AutomationId="toast.host" AutomationProperties.Name="Notifications">
    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{x:Bind Toasts.ProgressToasts}" ItemTemplate="{StaticResource ToastTemplate}" IsTabStop="False" />
    </ScrollViewer>
    <ItemsControl ItemsSource="{x:Bind Toasts.OrdinaryToasts}" ItemTemplate="{StaticResource ToastTemplate}" IsTabStop="False" />
  </StackPanel>
</UserControl>
