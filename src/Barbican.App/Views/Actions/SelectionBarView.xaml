<UserControl
    x:Class="Barbican.App.Views.Actions.SelectionBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Barbican.App.Views"
    xmlns:local="using:Barbican.App.Views.Actions">
  <!-- The selection bar (Bulwark components/email/selection-view.tsx, spec I-138..I-142): in the list's SelectionBarSlot, shown while at least one message is ticked.
       It appears in one frame (no animation). First line: select all or none, the count text "N selected . M unread", clear. Second line: the actions; they are the same commands the keys
       and menus run (CommandSurface.SelectionBar). Then the "Select all N in this folder" banner. Move to and Tag open dialogs of the menus stream and are added with them. -->
  <StackPanel Spacing="6" Visibility="{x:Bind views:Fmt.Vis(List.HasChecked), Mode=OneWay}" AutomationProperties.AutomationId="selection.bar" AutomationProperties.Name="Selection">
    <Border Background="{StaticResource Track}" CornerRadius="10" Padding="10,6" Margin="12,0,12,0">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Button Style="{StaticResource Button.Chip}" Content="All" Click="OnToggleAll" AutomationProperties.AutomationId="selection.all" AutomationProperties.Name="Select all or none" />
          <TextBlock Grid.Column="1" Text="{x:Bind List.SelectionLabel, Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     AutomationProperties.AutomationId="selection.count" AutomationProperties.Name="Selection count" />
          <Button Grid.Column="2" Style="{StaticResource Button.Chip}" Content="Clear" Tag="list.clear" Click="OnCommand" AutomationProperties.AutomationId="selection.clear" AutomationProperties.Name="Clear selection" />
        </Grid>
        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
          <Button Style="{StaticResource Button.Chip}" Content="Archive" Tag="mail.archive" Click="OnCommand" HorizontalAlignment="Stretch" Padding="4,0" AutomationProperties.AutomationId="selection.archive" AutomationProperties.Name="Archive" />
          <Button Grid.Column="1" Style="{StaticResource Button.Chip}" Content="Delete" Tag="mail.delete" Click="OnCommand" HorizontalAlignment="Stretch" Padding="4,0" AutomationProperties.AutomationId="selection.delete" AutomationProperties.Name="Delete" />
          <Button Grid.Column="2" Style="{StaticResource Button.Chip}" Content="Read" Tag="mail.read" Click="OnCommand" HorizontalAlignment="Stretch" Padding="4,0" AutomationProperties.AutomationId="selection.read" AutomationProperties.Name="Read" />
          <Button Grid.Column="3" Style="{StaticResource Button.Chip}" Content="Unread" Tag="mail.unread" Click="OnCommand" HorizontalAlignment="Stretch" Padding="4,0" AutomationProperties.AutomationId="selection.unread" AutomationProperties.Name="Unread" />
          <Button Grid.Column="4" Style="{StaticResource Button.Chip}" Content="Spam" Tag="mail.spam" Click="OnCommand" HorizontalAlignment="Stretch" Padding="4,0" AutomationProperties.AutomationId="selection.spam" AutomationProperties.Name="Spam" />
        </Grid>
      </StackPanel>
    </Border>
    <Border Background="{StaticResource Track}" CornerRadius="10" Padding="10,4" Margin="12,0,12,0" Visibility="{x:Bind views:Fmt.Vis(List.CanSelectAllInFolder), Mode=OneWay}"
            AutomationProperties.AutomationId="selection.banner">
      <Button Style="{StaticResource Button.Chip}" Content="{x:Bind local:ActionFmt.SelectAllText(List.Total), Mode=OneWay}" Tag="list.select-all-folder" Click="OnCommand" AutomationProperties.AutomationId="selection.all-folder" AutomationProperties.Name="Select all messages in this folder" />
    </Border>
  </StackPanel>
</UserControl>
