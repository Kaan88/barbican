<UserControl
    x:Class="Barbican.App.Views.Search.SearchBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Barbican.App.Controls">
  <!-- The list's search box (moved out of MessageListView by stage F of M2 without a change in behaviour; stream search owns it from wave 2). The AutomationId list.search is unchanged. -->
  <Border Height="36" CornerRadius="{x:Bind Look.FieldRadius, Mode=OneWay}" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,0,6,0">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <controls:SIcon Kind="Search" Size="15" StrokeWidth="2" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource TextBox.Bare}" PlaceholderText="Search mail" KeyDown="OnSearchKeyDown"
               AutomationProperties.AutomationId="list.search" AutomationProperties.Name="Search mail" />
      <Border Grid.Column="2" Height="17" MinWidth="18" CornerRadius="5" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="5,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock Text="/" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>
  </Border>
</UserControl>
