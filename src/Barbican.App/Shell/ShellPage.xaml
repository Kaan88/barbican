<Page x:Class="Barbican.App.Shell.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Ground}">
  <!-- Placeholder shell (spike S1): proves the generated tokens compile and resolve on both heads.
       M1 replaces it with the rail, sidebar, list and reader regions (PORT-PLAN.md §3.2). -->
  <Grid Padding="{StaticResource Shape.Gap}" ColumnSpacing="{StaticResource Shape.Gap}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource Shape.RailW}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{StaticResource Tile}" CornerRadius="{StaticResource Shape.RTile}" />
    <Border Grid.Column="1" Background="{StaticResource Tile}" CornerRadius="{StaticResource Shape.RTile}" Padding="24">
      <StackPanel Spacing="8">
        <TextBlock Text="Barbican" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="Status" Text="Shell placeholder (spike S1)" Foreground="{StaticResource Dim}" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
