<Page x:Class="Barbican.App.Shell.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rail="using:Barbican.App.Views.Rail"
      xmlns:sidebar="using:Barbican.App.Views.Sidebar"
      xmlns:list="using:Barbican.App.Views.List"
      xmlns:reader="using:Barbican.App.Views.Reader"
      xmlns:glance="using:Barbican.App.Views.Glance"
      xmlns:context="using:Barbican.App.Views.Context"
      xmlns:signin="using:Barbican.App.Views.SignIn"
      xmlns:actions="using:Barbican.App.Views.Actions"
      xmlns:compose="using:Barbican.App.Views.Compose"
    xmlns:controls="using:Barbican.App.Controls"
      Background="{StaticResource Ground}">
  <!-- Regions only (PORT-PLAN.md §3.2): the title band the window's content is extended into;
       rail | sidebar | surface, where the surface holds message list | (summary tiles over) reader | sender panel.
       Bulwark's mail panes touch and use hairline seams (components/mail/mail-app.tsx); the legacy styles retain their tiles.
       The sign-in screen covers the regions when no account is active.
       The shape tokens are x:Double, which WinUI does not convert to Thickness, CornerRadius or GridLength, so the code-behind applies the typed values of StyleState. -->
  <Grid x:Name="Root" AutomationProperties.AutomationId="shell">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TitleRow" Height="38" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- The title band: the drag area of the window (Window.SetTitleBar) and the caption buttons' ground. -->
    <Grid x:Name="TitleBand" Background="Transparent" AutomationProperties.AutomationId="titlebar" AutomationProperties.Name="Title bar">
      <TextBlock x:Name="TitleText" Text="Barbican" Margin="22,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Faint}" IsHitTestVisible="False" />
    </Grid>
    <Grid x:Name="MailScreen" Grid.Row="1">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="MailShift" />
      </Grid.RenderTransform>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <rail:RailView x:Name="RailRegion" Grid.Column="0" />
      <sidebar:SidebarView x:Name="SidebarRegion" Grid.Column="1" />
      <!-- M2 plan 6.1: the pane handles sit on the edge of the sidebar and of the list (in this grid, so no layout changes); widths: PanesViewModel -->
      <actions:PaneHandle x:Name="SidebarHandle" Grid.Column="1" Column="sidebar" Target="{x:Bind SidebarRegion}" AutomationProperties.AutomationId="pane.sidebar" AutomationProperties.Name="Resize sidebar" />
      <Border x:Name="Surface" Grid.Column="2" AutomationProperties.AutomationId="surface" AutomationProperties.Name="Mail">
        <Grid x:Name="SurfaceGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid x:Name="ListColumn" Grid.Column="0" RowDefinitions="Auto,*">
            <Button x:Name="CompactFolders" Grid.Row="0" Visibility="Collapsed" HorizontalAlignment="Left" Padding="12,4" MinHeight="40"
                    Style="{StaticResource Button.Icon}" Click="OnCompactFolders" AutomationProperties.AutomationId="list.folders" AutomationProperties.Name="Show folders">
              <StackPanel Orientation="Horizontal" Spacing="8"><controls:SIcon Kind="Folder" Size="16" /><TextBlock Text="Folders" /></StackPanel>
            </Button>
            <list:MessageListView x:Name="ListRegion" Grid.Row="1" />
            <Button Grid.Row="1" x:Name="FloatingCompose" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                    Style="{StaticResource Button.Primary}" Padding="18,0" MinHeight="{x:Bind Look.QuickTarget, Mode=OneWay}"
                    FontFamily="{x:Bind Look.AppBoldFont, Mode=OneWay}" FontSize="{x:Bind Look.BodyTextSize, Mode=OneWay}"
                    FocusVisualPrimaryThickness="{x:Bind Look.FocusThickness, Mode=OneWay}" CornerRadius="22" Click="OnFloatingComposeClick"
                    Visibility="Collapsed" AutomationProperties.AutomationId="list.compose" AutomationProperties.Name="New message">
              <StackPanel Orientation="Horizontal" Spacing="8"><controls:SIcon Kind="Pen" Size="18" /><TextBlock Text="New message" /></StackPanel>
            </Button>
          </Grid>
          <actions:PaneHandle x:Name="ListHandle" Grid.Column="0" Column="email-list" Target="{x:Bind ListRegion}" AutomationProperties.AutomationId="pane.list" AutomationProperties.Name="Resize message list" />
          <Grid x:Name="ReaderColumn" Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <glance:GlanceTilesView x:Name="GlanceRegion" Grid.Row="0" />
            <reader:ReaderView x:Name="ReaderRegion" Grid.Row="1" />
            <!-- M3 composer-ui: the composer takes the reader's place (the folders column collapses and the list stays), or sits under the reader when it answers a message (ComposerDock) -->
            <Grid x:Name="ComposerDockHost" Grid.Row="0" Grid.RowSpan="3" RowDefinitions="Auto,*" Visibility="Collapsed" AutomationProperties.AutomationId="reply-dock.host">
              <ContentControl x:Name="DockResize" Grid.Row="0" Height="10" Background="Transparent" Visibility="Collapsed"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsTabStop="True" UseSystemFocusVisuals="True"
                              PointerPressed="OnDockPress" PointerMoved="OnDockMove" PointerReleased="OnDockRelease"
                              PointerCaptureLost="OnDockCaptureLost" DoubleTapped="OnDockReset" KeyDown="OnDockResizeKey"
                              AutomationProperties.AutomationId="reply-dock.resize" AutomationProperties.Name="Resize reply. Use Up or Down to resize, or Home to reset.">
                <Border Width="36" Height="2" CornerRadius="1" Background="{StaticResource Faint}" />
              </ContentControl>
              <Button x:Name="DockDisclosure" Grid.Row="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Padding="16,6" Click="OnDockDisclosureClick" Visibility="Collapsed"
                      AutomationProperties.Name="Show the message" AutomationProperties.AutomationId="reply-dock.disclosure" />
              <compose:ComposerView x:Name="ComposerRegion" Grid.Row="1" />
            </Grid>
          </Grid>
          <context:ContextView x:Name="ContextRegion" Grid.Column="2" />
        </Grid>
      </Border>
    </Grid>
    <!-- M4 cal-views: the Calendar app's screen (rail | calendar sidebar | surface | detail), built on the first visit and shown instead of the mail screen while the rail has Calendar open; the mail screen keeps its state while hidden. -->
    <Grid x:Name="CalendarHost" Grid.Row="1" Visibility="Collapsed" AutomationProperties.AutomationId="calendar.host" />
    <!-- M5 con-ui (S0, D-M5-07): the screens of the other rail apps (Contacts, Files), one child per registered IAppScreenFactory, built on the first visit and then only hidden. -->
    <Grid x:Name="AppHost" Grid.Row="1" Visibility="Collapsed" AutomationProperties.AutomationId="apps.host" />
    <!-- M2 plan 3.3: the in-window overlays (menus, dialogs, palette, toasts) are added here at start-up from the registered IShellOverlay, above the regions and below the sign-in screen. -->
    <Grid x:Name="OverlayLayer" Grid.Row="1" AutomationProperties.AutomationId="overlay.layer" />
    <signin:SignInView x:Name="SignInRegion" Grid.Row="1" Visibility="Collapsed" />
    <!-- in-window tooltips (motion:Tip) draw here; never a ToolTip popup (ADR 0007) -->
    <Canvas x:Name="Overlay" Grid.RowSpan="2" IsHitTestVisible="False" />
  </Grid>
</Page>
