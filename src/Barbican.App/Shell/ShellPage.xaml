<Page x:Class="Barbican.App.Shell.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Ground}">
  <!-- Placeholder shell (spike S1): proves the generated tokens compile and resolve on both heads.
       M1 replaces it with the rail, sidebar, list and reader regions (PORT-PLAN.md §3.2).
       The shape tokens are x:Double; WinUI does not convert a Double resource to Thickness,
       CornerRadius or GridLength, so the code-behind applies them (the M1 F1 smoke run found it). -->
  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="RailColumn" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border x:Name="Rail" Background="{StaticResource Tile}" />
    <Border x:Name="Main" Grid.Column="1" Background="{StaticResource Tile}" Padding="24">
      <StackPanel Spacing="8">
        <TextBlock Text="Barbican" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="Status" Text="Shell placeholder (spike S1)" Foreground="{StaticResource Dim}" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
