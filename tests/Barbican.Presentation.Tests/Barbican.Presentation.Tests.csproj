<Project Sdk="Microsoft.NET.Sdk">
  <!-- ViewModels and Presentation logic without UI (PORT-PLAN.md §4.2), plus the design-token
       equality tests (generated tokens == theme.slint values, PORT-PLAN.md §2.2).
       Shared test settings: tests/Directory.Build.props. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Barbican.Presentation/Barbican.Presentation.csproj" />
    <ProjectReference Include="../../tools/Barbican.GenTokens/Barbican.GenTokens.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- m1-shell-ui: the UI-free arithmetic of the App head (palette writer, layout, metrics, motion scale, key mapping) is compiled into this project, so it is tested without a window. -->
    <Compile Include="../../src/Barbican.App/Theme/PaletteWriter.cs" Link="ShellUi/Linked/PaletteWriter.cs" />
    <Compile Include="../../src/Barbican.App/Theme/ShellLayout.cs" Link="ShellUi/Linked/ShellLayout.cs" />
    <Compile Include="../../src/Barbican.App/Theme/StyleMetrics.cs" Link="ShellUi/Linked/StyleMetrics.cs" />
    <Compile Include="../../src/Barbican.App/Motion/MotionScale.cs" Link="ShellUi/Linked/MotionScale.cs" />
    <Compile Include="../../src/Barbican.App/Shell/KeyChordMapper.cs" Link="ShellUi/Linked/KeyChordMapper.cs" />
    <Compile Include="../../src/Barbican.App/Shell/KeyGate.cs" Link="ShellUi/Linked/KeyGate.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- M1 hotfix (sign-in): sign-in and restore end to end on FakeJmap with the fake OAuth provider, to prove the UI-thread rule. -->
    <ProjectReference Include="../Barbican.FakeJmap/Barbican.FakeJmap.csproj" />
    <Compile Include="../Barbican.Core.Tests/Auth/FakeOAuthProvider.cs" Link="Accounts/Linked/FakeOAuthProvider.cs" />
    <Compile Include="../Barbican.Core.Tests/Accounts/MemoryVault.cs" Link="Accounts/Linked/MemoryVault.cs" />
    <Compile Include="../Barbican.Core.Tests/Settings/Prefs/TestProfilePaths.cs" Link="Accounts/Linked/TestProfilePaths.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- m1-mailcore: FakeTimeProvider for the key repeat, g sequence and interval tests (version pinned in Directory.Packages.props). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- m1-mailcore: the registration test builds a real service provider. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
