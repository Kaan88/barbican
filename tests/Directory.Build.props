<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Every project under tests/: an xUnit v3 test app on Microsoft.Testing.Platform (global.json).
       A helper library (tests/Barbican.FakeJmap) sets BarbicanTestLibrary=true in its project file:
       it stays a plain class library without xUnit (item conditions are evaluated after all
       properties, so the project's own setting is seen here). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Red tests ([Red]) are excluded from the default run so the build stays green; BARBICAN_RED=1 runs only them
       (tools/red-check.py does that and verifies every one fails with PortPending). -->
  <PropertyGroup Condition="'$(BARBICAN_RED)' != '1'">
    <TestingPlatformCommandLineArguments>--filter-not-trait "Red=expected"</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BARBICAN_RED)' == '1'">
    <TestingPlatformCommandLineArguments>--filter-trait "Red=expected"</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup Condition="'$(BarbicanTestLibrary)' != 'true'">
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <Using Include="Barbican.Testing" />
    <!-- [RustTest("module::name")] for ported Rust tests (PORT-PLAN.md §2.4), one source for all test projects. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/RustTestAttribute.cs" Link="Shared/RustTestAttribute.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/TestRepo.cs" Link="Shared/TestRepo.cs" />
    <!-- [Red("stream")]: a test written before its feature, expected to fail with PortPending (M1-plan F2). -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/RedAttribute.cs" Link="Shared/RedAttribute.cs" />
    <Content Include="$(MSBuildThisFileDirectory)xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
