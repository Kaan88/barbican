root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,xaml,slnx,json,yml,yaml}]
indent_size = 2

[*.{ps1,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Style the build enforces (EnforceCodeStyleInBuild + TreatWarningsAsErrors).
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0044.severity = warning
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
dotnet_style_readonly_field = true:warning

# Private fields: _camelCase. Constants and static readonly fields: PascalCase.
dotnet_naming_symbols.private_consts.applicable_kinds = field
dotnet_naming_symbols.private_consts.applicable_accessibilities = private
dotnet_naming_symbols.private_consts.required_modifiers = const
dotnet_naming_rule.private_consts.symbols = private_consts
dotnet_naming_rule.private_consts.style = pascal
dotnet_naming_rule.private_consts.severity = warning

dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly
dotnet_naming_rule.private_static_readonly.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly.style = pascal
dotnet_naming_rule.private_static_readonly.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning

dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Generated files are checked by their generator's tests, not by style rules.
[**/*.g.cs]
generated_code = true

# Tests: descriptive names with underscores are fine; ConfigureAwait is noise in test code.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none

# The app head (src/Barbican.App). WinUI and Uno find the Application class by the file name
# App.xaml(.cs); its type cannot be called App inside namespace Barbican.App (MA0049), so the type
# is BarbicanApp in App.xaml.cs. UI code continues on the dispatcher thread: ConfigureAwait(false)
# there would be a bug, so CA2007/MA0004 are off for the head only. On Uno Skia every UIElement
# implements the non-generic IEnumerable (its children), so CA1010 fires on each page and control.
[src/Barbican.App/App.xaml.cs]
dotnet_diagnostic.MA0048.severity = none

[src/Barbican.App/**.cs]
dotnet_diagnostic.CA1010.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none

# Spikes (spikes/, docs/adr/0004, 0005): same reason as the App head for App.xaml.cs and the UI-thread rules.
[spikes/*/App.xaml.cs]
dotnet_diagnostic.MA0048.severity = none

[spikes/**.cs]
dotnet_diagnostic.CA1010.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
