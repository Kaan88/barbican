<Project>
  <!-- Central package management: every version lives here; projects reference packages without one. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Analyzers for every project (PORT-PLAN.md §4.1). -->
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.341" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- Editor text engine (spike S3, docs/adr/0006). SkiaSharp is pinned to Uno 7.0's version
         (Uno.WinUI.Graphics2DSK 7.0.65 -> SkiaSharp 4.156.0); the native assets must match the
         managed version exactly, so the Linux natives RichTextKit pulls in (4.153.1) are pinned too. -->
    <PackageVersion Include="Topten.RichTextKit" Version="0.6.173" />
    <PackageVersion Include="SkiaSharp" Version="4.156.0" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.156.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.156.0" />
    <PackageVersion Include="SkiaSharp.Views.WinUI" Version="4.156.0" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.4.0.100" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0.100" />
    <!-- Presentation -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
