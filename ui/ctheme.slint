import { Theme } from "theme.slint";

// Colours for the composer extras (recipient chips, schedule dialog, scheduled banner).
// Every token maps onto the app's Theme (ui/theme.slint), so these files never import app.slint. The four meaning tints follow the
// design language (design/README.md): rose = today/action, mint = waiting/done,
// sky = travel/work, amber = attention.
export global CTheme {
    out property <bool> dark: Theme.dark;
    out property <color> text: Theme.text;
    out property <color> dim: Theme.dim;
    out property <color> line: Theme.line;
    out property <color> popup: Theme.popup;
    out property <color> hover: Theme.hover;
    out property <color> raised: Theme.raised;
    out property <color> chip: Theme.chip;
    out property <color> accent: Theme.accent;
    out property <color> on-accent: Theme.on-accent;
    out property <color> sel: Theme.sel;
    out property <color> sel-text: Theme.sel-text;
    out property <color> ring: Theme.ring;
    out property <color> bg: Theme.bg;
    out property <string> icons: Theme.icons;
    // shadows and the dialog scrim
    out property <color> shadow: #00000059;
    out property <color> scrim: #00000073;
    out property <color> rose-bg: Theme.rose-bg;
    out property <color> rose-fg: Theme.rose-fg;
    out property <color> mint-bg: Theme.mint-bg;
    out property <color> mint-fg: Theme.mint-fg;
    out property <color> sky-bg: Theme.sky-bg;
    out property <color> sky-fg: Theme.sky-fg;
    out property <color> amber-bg: Theme.amber-bg;
    out property <color> amber-fg: Theme.amber-fg;
}
