    in property <[DashRow]> dash-rows;
    in property <string> dash-status;
    in-out property <int> dash-tab: 0;
    in-out property <int> dash-range: 1;
    callback admin-load(string);
    callback admin-delete(string);
    // sub-pages (Tasks: Scheduled/Failed/Index queue, Cluster: Nodes/Roles), a note under the header,
    // and the action dialog ("confirm" | "form" | "running" | "result")
    in property <[AdminRow]> admin-subs;
    in-out property <string> admin-sub;
