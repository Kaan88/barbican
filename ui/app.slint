    // rich-text editor (src/rte)
    in property <[RteText]> rte-texts;
    in property <[RteBox]> rte-back;
    in property <[RteBox]> rte-front;
    in property <[RteImage]> rte-imgs;
    in property <length> rte-height;
    in property <length> rte-caret-x;
    in property <length> rte-caret-y;
    in property <length> rte-caret-h: 20px;
    in property <length> rte-sel-x: -1px;
    in property <length> rte-sel-y;
    in property <bool> rte-empty: true;
    in property <RteState> rte-state;
    in-out property <bool> rte-blink: true;
    in-out property <length> rte-width: 600px;
    out property <length> rte-base-size: Prefs.font-size;
    in-out property <bool> rte-link-open;
    in-out property <string> rte-link-url;
    in-out property <string> rte-link-text;
    in-out property <int> rte-scroll-req;
    in-out property <int> rte-focus-req;
    in-out property <bool> rte-focus-on-open;
    // HTML source view of the composer (edit raw HTML, re-imported live)
    in-out property <bool> rte-source-open;
    in-out property <int> rte-source-focus-req;
