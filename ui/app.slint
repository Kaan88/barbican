import { LineEdit, Button, ListView, ScrollView, TextEdit, ComboBox, CheckBox, Palette } from "std-widgets.slint";

export struct Folder {
    id: string,
    name: string,
    icon: string,
    depth: int,
    unread: int,
    total: int,
    color: color,
    count: string,
    chevron: int,
    muted: bool,
}

export struct Tag {
    id: string,
    name: string,
    color: color,
    count: string,
}

export struct PRow {
    label: string,
    value: string,
    tone: string,
}

export struct CalEvent {
    id: string,
    title: string,
    time: string,
    location: string,
    color: color,
    col: int,
    top: float,
    height: float,
    lane: int,
    lanes: int,
    date: string,
}

export struct CalCell {
    day: int,
    date: string,
    in-month: bool,
    today: bool,
    events: [CalEvent],
    more: string,
}

export struct CalItem {
    id: string,
    name: string,
    color: color,
    visible: bool,
}

export struct MiniDay {
    day: int,
    in-month: bool,
    today: bool,
    selected: bool,
    date: string,
    busy: bool,
}

export struct ContactRow {
    id: string,
    name: string,
    email: string,
    initials: string,
    color: color,
    header: string,
}

export struct FileRow {
    id: string,
    name: string,
    folder: bool,
    size: string,
    modified: string,
    renaming: bool,
}

export struct AdminRow {
    id: string,
    c1: string,
    c2: string,
    c3: string,
    c4: string,
}

export struct ThreadMsg {
    id: string,
    sender: string,
    date: string,
    preview: string,
    current: bool,
    unread: bool,
}

export struct TaskRow {
    id: string,
    title: string,
    due: string,
    done: bool,
}

export struct Att {
    name: string,
    size: string,
    index: int,
}

export struct CtxItem {
    icon: string,
    label: string,
    hint: string,
    action: string,
    kind: int, // 0 item, 1 separator, 2 header
    sub: bool,
    danger: bool,
    enabled: bool,
    checked: bool,
}

export struct ChatMsg {
    role: string,
    text: string,
}

export struct Mail {
    id: string,
    sender: string,
    initials: string,
    color: color,
    subject: string,
    preview: string,
    time: string,
    unread: bool,
    attach: bool,
    header: string,
    threads: int,
    flagged: bool,
    answered: bool,
    checked: bool,
    draft: bool,
    tags: [color],
    account: string,
    account-color: color,
    code: string,
    row-tint: color,
    files: [string],
}

export global Theme {
    in-out property <bool> dark: true;
    // Bulwark tokens: dark (--color-*) and light (brand #c8234a, neutral greys)
    out property <color> bg: dark ? #0a0a0a : #ffffff;
    out property <color> rail: dark ? #0f0f0f : #f4f4f5;
    out property <color> side: dark ? #141414 : #fafafa;
    out property <color> line: dark ? #262626 : #e5e5e5;
    out property <color> text: dark ? #fafafa : #0a0a0a;
    out property <color> dim: dark ? #adadad : #6b6b6b;
    out property <color> accent: dark ? #f0577a : #c8234a;
    out property <color> on-accent: dark ? #16070c : #ffffff;
    out property <color> sel: dark ? #4a1424 : #fde4ea;
    out property <color> sel-text: dark ? #ffd5df : #8c1733;
    out property <color> hover: dark ? #1a1a1a : #f0f0f0;
    out property <color> popup: dark ? #1c1c1c : #ffffff;
    out property <color> chip: dark ? #262626 : #ececec;
    out property <color> raised: dark ? #181818 : #f4f4f5;
    out property <color> zebra: dark ? #111111 : #fafafa;
    out property <color> bubble: dark ? #1f1f22 : #f1f1f3;
    out property <color> reader: dark ? #0a0a0a : #ffffff;
    out property <color> muted-day: dark ? #5a5a5a : #a3a3a3;
    out property <color> track: dark ? #3a3a3a : #d4d4d4;
    out property <string> icons: "Segoe Fluent Icons";
}

export struct STab {
    id: string,
    label: string,
    icon: string,
    header: string,
    indent: int,
}

export struct SRow {
    kind: string,
    key: string,
    label: string,
    desc: string,
    options: [string],
    index: int,
    on: bool,
    text: string,
}

component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: on ? Theme.accent : Theme.track;
    TouchArea { clicked => { root.toggled(); } }
    Rectangle {
        x: on ? parent.width - 18px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: on ? Theme.on-accent : Theme.dim;
        animate x { duration: 120ms; }
    }
}

component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 15px;
    color: Theme.dim;
    vertical-alignment: center;
    horizontal-alignment: center;
}

component Avatar inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: tint;
    Text {
        text: label;
        color: white;
        font-size: 12px;
        font-weight: 600;
    }
}

component RailButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: active ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Icon {
        text: glyph;
        color: active ? Theme.accent : Theme.dim;
    }
}

component FolderRow inherits Rectangle {
    in property <Folder> f;
    in property <bool> selected;
    callback clicked;
    callback chevron-clicked;
    callback context(length, length);
    height: 24px;
    background: selected ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
    }
    Rectangle {
        x: 0;
        width: 3px;
        background: selected ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 8px + f.depth * 12px;
        padding-right: 8px;
        spacing: 6px;
        Rectangle {
            width: 12px;
            if f.chevron != 0: Icon {
                text: f.chevron == 1 ? "\u{E70D}" : "\u{E76C}";
                font-size: 8px;
            }
            TouchArea { enabled: f.chevron != 0; clicked => { root.chevron-clicked(); } }
        }
        Icon {
            text: f.icon;
            font-size: 13px;
            width: 16px;
            color: f.color;
        }
        Text {
            text: f.name;
            color: selected ? Theme.sel-text : Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            font-weight: selected ? 600 : 400;
        }
        if f.muted: Icon { text: "\u{E7ED}"; font-size: 10px; }
        Text {
            text: f.count;
            color: f.unread > 0 ? Theme.text : Theme.dim;
            font-size: 11px;
            font-weight: f.unread > 0 ? 700 : 400;
            vertical-alignment: center;
        }
    }
}

component TagIcon inherits Path {
    in property <color> tint;
    width: 14px;
    height: 14px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: tint;
    stroke: tint;
    stroke-width: 1px;
    commands: "M12.6 2.6 A2 2 0 0 0 11.2 2 H4 A2 2 0 0 0 2 4 V11.2 A2 2 0 0 0 2.6 12.6 L11.3 21.3 A2.4 2.4 0 0 0 14.7 21.3 L21.3 14.7 A2.4 2.4 0 0 0 21.3 11.3 Z";
}

component TagRow inherits Rectangle {
    in property <Tag> t;
    in property <bool> selected;
    callback clicked;
    callback context(length, length);
    height: 24px;
    background: selected ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
    HorizontalLayout {
        padding-left: 26px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout { alignment: center; width: 16px; TagIcon { tint: t.color; } }
        Text { text: t.name; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: t.count; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    min-width: pl.preferred-width + 28px;
    border-radius: 6px;
    background: !enabled ? #5a2a36 : (pta.pressed ? #d94a6b : (pta.has-hover ? #f46d8c : Theme.accent));
    pta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    pl := Text { text: root.text; color: Theme.on-accent; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}

component HoverAction inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    background: hta.has-hover ? Theme.hover : transparent;
    hta := TouchArea { clicked => { root.clicked(); } }
    Icon { text: glyph; font-size: 12px; color: active ? #facc15 : (hta.has-hover ? Theme.text : Theme.dim); }
}

export global Prefs {
    in-out property <bool> toolbar-labels: true;
    in-out property <bool> tag-chips: true;
    in-out property <length> font-size: 13px;
    in-out property <bool> cal-tinted: false;
    // list hover actions, Barbican action names (delete, star, read, archive, spam)
    in-out property <[string]> hover-actions: ["delete", "star", "read", "archive"];
    // reader body gutter (messageSpacing)
    in-out property <length> reader-gutter: 20px;
}

component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> show-label: Prefs.toolbar-labels;
    callback clicked;
    height: 28px;
    width: lay.preferred-width;
    border-radius: 6px;
    background: tta.has-hover ? Theme.hover : transparent;
    tta := TouchArea { clicked => { root.clicked(); } }
    lay := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Icon { text: glyph; font-size: 12px; color: Theme.text; }
        if show-label: Text { text: label; color: Theme.text; vertical-alignment: center; }
    }
}

component ContextMenuRow inherits Rectangle {
    in property <CtxItem> it;
    callback picked(string);
    height: it.kind == 1 ? 9px : it.kind == 2 ? 24px : 28px;
    border-radius: 4px;
    background: it.kind == 0 && it.enabled && cta.has-hover ? (it.danger ? #ef444433 : Theme.hover) : transparent;
    if it.kind == 1: Rectangle { x: 4px; width: parent.width - 8px; height: 1px; background: Theme.line; }
    if it.kind == 2: Text { x: 10px; text: it.label; color: Theme.dim; font-size: 11px; font-weight: 600; vertical-alignment: center; }
    cta := TouchArea { enabled: it.kind == 0 && it.enabled; clicked => { root.picked(it.action); } }
    if it.kind == 0: HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;
        Icon { text: it.checked ? "\u{E73E}" : it.icon; font-size: 13px; width: 16px; color: !it.enabled ? Theme.line : it.danger ? #ef4444 : Theme.text; }
        Text { text: it.label; color: !it.enabled ? Theme.dim : it.danger ? #ef4444 : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; font-size: 13px; }
        if it.hint != "": Text { text: it.hint; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        if it.sub: Icon { text: "\u{E76C}"; font-size: 9px; width: 10px; }
    }
}

/// Dark context menu body (Theme.popup, 1px Theme.line border, radius 8).
component ContextMenu inherits Rectangle {
    in property <[CtxItem]> items;
    callback picked(string);
    background: Theme.popup;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000066;
    VerticalLayout {
        padding: 4px;
        for it in root.items: ContextMenuRow { it: it; picked(a) => { root.picked(a); } }
    }
}

component MailRow inherits VerticalLayout {
    in property <Mail> m;
    in property <length> row-height: 82px;
    in property <bool> selected;
    callback clicked;
    callback ctrl-clicked;
    callback action(string);
    callback header-clicked;
    callback context(length, length);
    if m.header != "": Rectangle {
        height: 32px;
        TouchArea { clicked => { root.header-clicked(); } }
        HorizontalLayout {
            padding-left: 16px;
            spacing: 8px;
            Icon { text: "\u{E70D}"; font-size: 9px; width: 12px; }
            Text { text: m.header; color: Theme.text; font-weight: 600; vertical-alignment: center; }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    }
    Rectangle {
        height: root.row-height + ((m.code != "" || m.files.length > 0) ? 22px : 0px);
        background: selected || m.checked ? Theme.sel : ta.has-hover ? Theme.hover : m.row-tint;
        ta := TouchArea {
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left {
                    if ev.modifiers.control || ev.modifiers.shift { root.ctrl-clicked(); } else { root.clicked(); }
                }
                if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            }
        }
        if m.tags.length > 0: Rectangle {
            x: 0; width: 3px; background: m.tags[0];
        }
        HorizontalLayout {
            padding: 10px;
            padding-left: 10px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Avatar { label: m.initials; tint: m.color; }
            }
            VerticalLayout {
                spacing: 3px;
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    if m.account != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: m.account-color;
                        }
                    }
                    Text {
                        text: m.draft ? "Draft" : m.sender;
                        color: m.draft ? #ef4444 : (m.unread ? Theme.text : Theme.dim);
                        font-weight: m.unread ? 700 : 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if m.threads > 1: Rectangle {
                        width: tc.preferred-width + 22px;
                        height: 16px;
                        border-radius: 4px;
                        background: Theme.chip;
                        HorizontalLayout {
                            padding-left: 4px;
                            spacing: 3px;
                            Icon { text: "\u{E8BD}"; font-size: 9px; }
                            tc := Text { text: m.threads; color: Theme.dim; font-size: 10px; vertical-alignment: center; }
                        }
                    }
                    if m.answered: Icon { text: "\u{E97A}"; font-size: 11px; }
                    if m.attach: Icon { text: "\u{E723}"; font-size: 11px; }
                    if !ta.has-hover: Text { text: m.time; color: Theme.dim; font-size: 11px; }
                    if ta.has-hover: HorizontalLayout {
                        spacing: 0px;
                        for a in Prefs.hover-actions: HoverAction {
                            glyph: a == "delete" ? "\u{E74D}" : a == "star" ? (m.flagged ? "\u{E735}" : "\u{E734}") : a == "read" ? (m.unread ? "\u{E8C3}" : "\u{E715}") : a == "archive" ? "\u{E7B8}" : a == "spam" ? "\u{E8F8}" : "\u{E8EC}";
                            active: a == "star" && m.flagged;
                            clicked => { root.action(a); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: m.subject;
                        color: Theme.text;
                        font-weight: m.unread ? 700 : 400;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if m.flagged && !ta.has-hover: Icon { text: "\u{E735}"; font-size: 11px; color: #facc15; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: m.preview; color: Theme.dim; overflow: elide; horizontal-stretch: 1; }
                    for c in m.tags: Rectangle { visible: Prefs.tag-chips; width: Prefs.tag-chips ? 8px : 0px; height: 8px; border-radius: 4px; background: c; y: 4px; }
                }
                if m.code != "" || m.files.length > 0: HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    if m.code != "": Rectangle {
                        height: 18px;
                        width: codet.preferred-width + 30px;
                        border-radius: 4px;
                        background: codeta.has-hover ? Theme.hover : Theme.chip;
                        border-width: 1px;
                        border-color: Theme.accent;
                        codeta := TouchArea { clicked => { root.action("copy-code:" + m.code); } }
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 4px;
                            Icon { text: "\u{E8C8}"; font-size: 9px; }
                            codet := Text { text: m.code; color: Theme.text; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                        }
                    }
                    for f in m.files: Rectangle {
                        height: 18px;
                        width: min(ft.preferred-width + 26px, 160px);
                        border-radius: 4px;
                        background: Theme.chip;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            Icon { text: "\u{E723}"; font-size: 9px; }
                            ft := Text { text: f; color: Theme.dim; font-size: 10px; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    }
}

export struct FmtResult {
    text: string,
    anchor: int,
    cursor: int,
}

component FmtButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> bold;
    in property <bool> italic;
    in property <bool> underline;
    in property <bool> strike;
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: fta.pressed ? Theme.chip : fta.has-hover ? Theme.hover : transparent;
    fta := TouchArea { clicked => { root.clicked(); } }
    if glyph != "": Icon { text: glyph; font-size: 13px; color: fta.has-hover ? Theme.text : Theme.dim; }
    if glyph == "": Text {
        text: label;
        color: fta.has-hover ? Theme.text : Theme.dim;
        font-size: 12px;
        font-weight: bold ? 800 : 500;
        font-italic: italic;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if underline: Rectangle { x: 8px; y: 18px; width: 8px; height: 1px; background: fta.has-hover ? Theme.text : Theme.dim; }
    if strike: Rectangle { x: 7px; y: 12px; width: 10px; height: 1px; background: fta.has-hover ? Theme.text : Theme.dim; }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> checked;
    in property <bool> checkable;
    in property <bool> enabled: true;
    in property <color> swatch: transparent;
    callback clicked;
    height: 30px;
    border-radius: 4px;
    background: mta.has-hover && enabled ? Theme.hover : transparent;
    mta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;
        if checkable: Icon { text: checked ? "\u{E73E}" : ""; font-size: 11px; width: 14px; color: Theme.accent; }
        if glyph != "": Icon { text: glyph; font-size: 12px; width: 14px; }
        if swatch != transparent: VerticalLayout { alignment: center; Rectangle { width: 12px; height: 12px; border-radius: 6px; background: swatch; } }
        Text { text: root.text; color: enabled ? Theme.text : Theme.dim; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
}

component MenuPanel inherits Rectangle {
    background: Theme.popup;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000060;
}

component BarButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> chevron: true;
    callback clicked;
    height: 28px;
    width: bl.preferred-width;
    border-radius: 6px;
    background: bta.has-hover ? Theme.hover : transparent;
    bta := TouchArea { clicked => { root.clicked(); } }
    bl := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Icon { text: glyph; font-size: 12px; color: Theme.text; }
        Text { text: label; color: Theme.text; font-weight: 600; vertical-alignment: center; }
        if chevron: Icon { text: "\u{E70D}"; font-size: 8px; color: Theme.dim; }
    }
}

component BareField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    height: 20px;
    if text == "": Text { x: 0; text: placeholder; color: Theme.dim; vertical-alignment: center; height: parent.height; }
    TextInput {
        text <=> root.text;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
    }
}


export component AppWindow inherits Window {
    title: "Barbican";
    icon: @image-url("barbican.svg");
    background: Theme.bg;
    preferred-width: 1400px;
    preferred-height: 900px;
    default-font-size: Prefs.font-size;
    default-font-family: "Segoe UI";
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    changed theme-dark => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    property <bool> theme-dark: Theme.dark;

    in-out property <bool> logged-in: false;
    in property <bool> busy: false;
    in property <string> status;
    in property <string> account;
    in property <string> initials: "?";
    in property <[Folder]> folders;
    in property <[Mail]> mails;
    in-out property <string> current-folder;
    in-out property <string> current-mail;
    in property <string> r-subject;
    in property <string> r-from;
    in property <string> r-date;
    in property <string> r-body;
    in-out property <string> server;
    in-out property <string> user;
    in-out property <string> search;

    callback login(string, string, string, string, bool);
    callback sso-login(string, string, bool);
    callback sign-out();
    in-out property <string> client-id: "barbican";
    in-out property <bool> remember: true;
    in-out property <bool> show-advanced;
    callback select-folder(string);
    callback open-mail(string);
    callback do-search(string);
    callback refresh();
    callback compose-new();
    callback open-settings();
    callback save-settings();
    callback ai-reader(string);
    callback ai-compose(string);
    callback ai-undo();
