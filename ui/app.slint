    callback rte-key(string, bool, bool, bool) -> bool;
    callback rte-pointer(string, length, length, bool);
    callback rte-cmd(string);
    callback rte-scroll-to-caret();
    rte-scroll-to-caret => { self.rte-scroll-req += 1; }
