    callback chat-new();
    callback chat-reload();
    callback chat-stop();
    callback confirm-action(bool);
    public function scroll-chat() {
        chat-list.content-y = min(0px, chat-list.visible-height - chat-list.content-height);
    }
    // ---- context menus: Rust fills ctx-items for (kind, id), the popup shows them at (ctx-x, ctx-y)
    in-out property <[CtxItem]> ctx-items;
    in-out property <length> ctx-x;
    in-out property <length> ctx-y;
    in property <length> ctx-h: 100px;
    in-out property <int> ctx-body-cmd; // bumps: odd = copy selection, even = select all (plain-text body)
    callback ctx-request(string, string);
    callback ctx-pick(string);
    // flyout submenu (Bulwark ContextMenuSubMenu): Rust fills it when a "sub:" row is hovered
    in-out property <[CtxItem]> ctx-sub-items;
    in-out property <string> ctx-sub-action;
    in-out property <length> ctx-sub-y;
    in-out property <length> ctx-sub-h;
    callback ctx-hover(string, int);
    property <length> ctx-menu-x: max(0px, min(root.ctx-x, root.width - 252px));
    property <length> ctx-menu-y: max(0px, min(root.ctx-y, root.height - min(root.ctx-h, root.height - 8px) - 4px));
    property <length> ctx-sub-x: root.ctx-menu-x + 248px + 244px > root.width ? max(0px, root.ctx-menu-x - 244px) : root.ctx-menu-x + 244px;
    property <length> ctx-sub-top: max(0px, min(root.ctx-menu-y + root.ctx-sub-y - 4px, root.height - min(root.ctx-sub-h, root.height - 8px) - 4px));
    public function ctx-close() { ctx-popup.close(); root.ctx-open = false; root.ctx-sub-action = ""; CtxHl.id = ""; }
    public function ctx(kind: string, id: string, x: length, y: length) {
        root.ctx-x = x;
        root.ctx-y = y;
        root.ctx-request(kind, id);
        root.ctx-sub-action = "";
        if root.ctx-items.length > 0 { root.ctx-open = true; ctx-popup.show(); } else { CtxHl.id = ""; }
    }
    public function ctx-show() { root.ctx-sub-action = ""; root.ctx-open = true; ctx-popup.show(); }
    // the WebView2 body is a separate HWND above Slint: hide it while a menu is open
    in-out property <bool> ctx-open;
    public function copy-text(t: string) { clip-buf.text = t; clip-buf.select-all(); clip-buf.copy(); }
    in-out property <bool> prompt-open;
    in-out property <string> prompt-title;
    in-out property <string> prompt-text;
    callback prompt-ok(string);
    callback reply();
    callback delete-mail();
    callback send-mail(string, string, string);
    in-out property <bool> composing: false;
    changed composing => { if composing { app = 0; show-settings = false; } else { c-ai-closed = false; } }
    in property <bool> sending: false;
    in-out property <string> c-to;
    in-out property <string> c-subject;
    in property <string> c-status;
    out property <length> bx: body.absolute-position.x;
    out property <length> by: body.absolute-position.y;
    out property <length> bw: body.width;
    out property <length> bh: body.height;
    out property <bool> body-visible: logged-in && app == 0 && current-mail != "" && !composing && !show-settings && render-mode == 0 && !ev-open && !ctx-open;

    callback shortcut(string, bool, bool);
    public function focus-keys() { kbd.focus(); }
    public function focus-search() { search-box.focus(); }
    kbd := FocusScope {
    init => { self.focus(); }
    key-pressed(e) => {
        if (e.modifiers.control && e.text == "f") || (e.modifiers.control && e.text == "e") { search-box.focus(); return accept; }
        if e.text == Key.Escape && root.admin-dlg != "" && root.admin-dlg != "running" { root.admin-dlg = ""; return accept; }
        root.shortcut(e.text, e.modifiers.shift, e.modifiers.control);
        accept
    }
    // ---- sign in: one tile on the ground (Bento radius 26, Nordic 28 with pill fields)
    Rectangle {
        visible: !logged-in;
        background: Theme.ground;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 400px;
                    background: Theme.tile;
                    border-radius: Theme.r-pane;
                    border-width: 1px;
                    border-color: Theme.line;
                    drop-shadow-blur: 30px;
                    drop-shadow-color: Theme.dark ? #00000066 : #0000001a;
                    VerticalLayout {
                        padding: 32px;
                        spacing: 12px;
                        HorizontalLayout { alignment: start; Mark { size: 40px; } }
                        Text { text: "Barbican"; font-size: 28px; font-weight: 800; letter-spacing: -0.56px; color: Theme.text; }
                        Text { text: "Sign in to your Stalwart server"; color: Theme.dim; font-size: 13.5px; }
                        Rectangle { height: 4px; }
                        srv := LineEdit { placeholder-text: "https://mail.example.com"; text <=> root.server; }
                        usr := LineEdit { placeholder-text: "Username or email"; text <=> root.user; }
                        pwd := LineEdit {
                            placeholder-text: "Password or app password";
                            input-type: password;
                            accepted => { root.login(srv.text, usr.text, pwd.text, otp.text, root.remember); }
                        }
                        otp := LineEdit {
                            placeholder-text: "2FA code (only if enabled)";
                            accepted => { root.login(srv.text, usr.text, pwd.text, otp.text, root.remember); }
                        }
                        CheckBox { text: "Remember me on this computer"; checked <=> root.remember; }
                        PrimaryButton {
                            text: root.busy ? "Signing in…" : "Sign in";
                            enabled: !root.busy;
                            clicked => { root.login(srv.text, usr.text, pwd.text, otp.text, root.remember); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { height: 1px; background: Theme.line; y: parent.height / 2; }
                            Text { text: "or"; color: Theme.dim; horizontal-stretch: 0; }
                            Rectangle { height: 1px; background: Theme.line; y: parent.height / 2; }
                        }
                        ActionButton {
                            label: "Sign in with SSO";
                            clicked => { if !root.busy { root.sso-login(srv.text, usr.text, root.remember); } }
                        }
                        Text {
                            text: root.show-advanced ? "Hide advanced" : "Advanced";
                            color: Theme.dim;
                            font-size: 11px;
                            TouchArea { clicked => { root.show-advanced = !root.show-advanced; } }
                        }
                        if root.show-advanced: VerticalLayout {
                            spacing: 4px;
                            Text { text: "OAuth client ID (used when the server does not allow automatic registration). Register redirect URI http://127.0.0.1/callback for it."; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
                            LineEdit { text <=> root.client-id; }
                        }
                        Text { text: root.status; color: Theme.accent; wrap: word-wrap; }
                    }
                }
            }
        }
    }

    // ======== shell (design/mockups BNMail / NordMail) ========
    // Bento: rail, folders, list, reader and context are separate tiles on the ground (14px
    // padding, 12px gaps). Nordic: rail and folders sit on the ground; list, reader and context
    // share one rounded surface split by hairlines.
    Rectangle {
      visible: logged-in;
      background: Theme.ground;
      HorizontalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;
        // ---- rail ----
        Tile {
            flat: Theme.nordic;
            width: Theme.rail-w;
            VerticalLayout {
                padding-top: Theme.nordic ? 26px : 16px;
                padding-bottom: Theme.nordic ? 26px : 16px;
                spacing: Theme.nordic ? 12px : 8px;
                HorizontalLayout { alignment: center; Mark { size: Theme.nordic ? 34px : 32px; } }
                Rectangle { height: Theme.nordic ? 2px : 2px; }
                HorizontalLayout { alignment: center; RailButton { icon: Icons.mail; tip: "Mail"; active: root.app == 0 && !root.show-settings; clicked => { root.show-settings = false; root.app = 0; root.app-changed(0); } } }
                HorizontalLayout { alignment: center; RailButton { icon: Icons.cal; tip: "Calendar"; active: root.app == 1 && !root.show-settings; clicked => { root.show-settings = false; root.app = 1; root.app-changed(1); } } }
                HorizontalLayout { alignment: center; RailButton { icon: Icons.users; tip: "Contacts"; active: root.app == 2 && !root.show-settings; clicked => { root.show-settings = false; root.app = 2; root.app-changed(2); } } }
                HorizontalLayout { alignment: center; RailButton { icon: Icons.folder; tip: "Files"; active: root.app == 3 && !root.show-settings; clicked => { root.show-settings = false; root.app = 3; root.app-changed(3); } } }
                if !root.ai-hidden: HorizontalLayout { alignment: center; RailButton { icon: Icons.spark; tip: "Assistant"; active: root.chat-open; clicked => { root.show-settings = false; root.app = 0; root.chat-open = !root.chat-open; } } }
                if root.admin-enabled: HorizontalLayout { alignment: center; RailButton { icon: Icons.shield; tip: "Admin"; active: root.app == 4 && !root.show-settings; clicked => { root.show-settings = false; root.app = 4; root.app-changed(4); } } }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { alignment: center; RailButton { icon: Icons.settings; tip: "Settings"; active: root.show-settings; clicked => { root.open-settings(); } } }
                HorizontalLayout {
                    alignment: center;
                    me := Avatar {
                        label: root.initials;
                        tint: Theme.nordic ? Theme.accent : #f0577a;
                        width: Theme.nordic ? 40px : 38px;
                        height: self.width;
                        border-radius: Theme.nordic ? self.height / 2 : 14px;
                        background: Theme.nordic ? Theme.sel : Theme.rose-bg;
                        mea := TouchArea { clicked => { acct-popup.show(); } mouse-cursor: pointer; }
                        acct-popup := PopupWindow {
                            x: parent.width + 10px;
                            y: parent.height - (root.accounts.length * 32px + 32px + 58px);
                            width: 260px;
                            Rectangle {
                                background: Theme.popup; border-radius: Theme.r-popup; border-width: 1px; border-color: Theme.line;
                                drop-shadow-blur: 16px; drop-shadow-color: #00000055;
                                VerticalLayout {
                                    padding: 6px;
                                    Text { text: "Signed in as"; color: Theme.dim; font-size: 11px; font-weight: 700; height: 24px; vertical-alignment: center; x: 10px; }
                                    for a in root.accounts: Rectangle {
                                        height: 32px; border-radius: Theme.nordic ? 16px : 9px;
                                        background: aca.has-hover ? Theme.hover : transparent;
                                        aca := TouchArea { clicked => { if a != root.account { root.switch-account(a); } } }
                                        HorizontalLayout {
                                            padding-left: 10px; spacing: 8px;
                                            VerticalLayout { alignment: center; width: 14px; if a == root.account: SIcon { commands: Icons.check; size: 14px; weight: 2.2; tint: Theme.accent; } }
                                            Text { text: a; color: Theme.text; font-weight: a == root.account ? 600 : 400; vertical-alignment: center; overflow: elide; }
                                        }
                                    }
                                    Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.line; } }
                                    Rectangle {
                                        height: 32px; border-radius: Theme.nordic ? 16px : 9px;
                                        background: ada.has-hover ? Theme.hover : transparent;
                                        ada := TouchArea { clicked => { root.add-account(); } }
                                        HorizontalLayout {
                                            padding-left: 10px; spacing: 8px;
                                            VerticalLayout { alignment: center; SIcon { commands: Icons.plus; size: 14px; weight: 2; tint: Theme.text; } }
                                            Text { text: "Add account"; color: Theme.text; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- folder sidebar (hidden while composing: BNCompose has rail, list, composer, assistant) ----
        if root.side-shown: VerticalLayout {
            width: root.side-w;
            padding-top: Theme.nordic ? 30px : 0px;
            padding-bottom: Theme.nordic ? 22px : 0px;
            padding-left: Theme.nordic ? 14px : 0px;
            padding-right: Theme.nordic ? 14px : 0px;
            spacing: Theme.nordic ? 0px : 12px;
            // Compose: a 52px accent squircle (Bento) or a 50px pill (Nordic)
            Rectangle {
                height: Prefs.large-targets ? 54px : (Theme.nordic ? 50px : 52px);
                border-radius: Theme.nordic ? self.height / 2 : 20px;
                background: cta.pressed ? Theme.accent.darker(0.12) : cta.has-hover ? Theme.accent.brighter(0.1) : Theme.accent;
                cta := TouchArea { clicked => { root.compose-new(); } }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    if Theme.bento: VerticalLayout { alignment: center; SIcon { commands: Icons.pen; size: 16px; weight: 2.2; tint: Theme.on-accent; } }
                    Text { text: Theme.nordic ? "New message" : "Compose"; color: Theme.on-accent; font-weight: 700; font-size: 14.5px * Prefs.fs; vertical-alignment: center; }
                }
            }
            if Theme.nordic: Rectangle { height: 22px; }
            // folders
            Tile {
                flat: Theme.nordic;
                vertical-stretch: 1;
                max-height: fcol.preferred-height + (Theme.nordic ? 0px : 22px);
                min-height: 120px;
                VerticalLayout {
                    padding: Theme.nordic ? 0px : 10px;
                    padding-bottom: Theme.nordic ? 0px : 10px;
                    Flickable {
                        content-height: fcol.preferred-height;
                        fcol := VerticalLayout {
                            alignment: start;
                            spacing: Theme.nordic ? 4px : 2px;
                            Rectangle {
                                height: 26px;
                                fh := TouchArea { clicked => { root.folders-collapsed = !root.folders-collapsed; } }
                                HorizontalLayout {
                                    padding-left: Theme.nordic ? 16px : 11px;
                                    padding-right: Theme.nordic ? 12px : 6px;
                                    spacing: 6px;
                                    Text { text: "Folders"; color: Theme.dim; font-size: 12px * Prefs.fs; font-weight: 700; vertical-alignment: center; }
                                    VerticalLayout { alignment: center; SIcon { commands: root.folders-collapsed ? Icons.chevron-right : Icons.chevron-down; size: 11px; weight: 2.2; tint: Theme.faint; } }
                                    Rectangle { horizontal-stretch: 1; }
                                    IconBtn { icon: Icons.settings; icon-size: 13px; width: 22px; tint: Theme.faint; clicked => { root.settings-tab = "organize"; root.open-settings(); } }
                                }
                            }
                            if !root.folders-collapsed: VerticalLayout {
                                spacing: Theme.nordic ? 4px : 2px;
                                for f in root.folders: FolderRow {
                                    f: f;
                                    colorful: f.color != #a3a3a3;
                                    selected: f.id == root.current-folder && root.current-tag == "";
                                    clicked => {
                                        root.current-tag = "";
                                        root.current-folder = f.id;
                                        root.select-folder(f.id);
                                    }
                                    chevron-clicked => { root.toggle-folder(f.id); }
                                    hl-id: "folder:" + f.id;
                                    context(x, y) => { root.ctx("folder", f.id, x, y); }
                                }
                            }
                        }
                    }
                }
            }
            // tags: tint tiles in a 2-column grid (Bento) or coloured squircle rows (Nordic)
            if root.tags.length > 0: Tile {
                flat: Theme.nordic;
                VerticalLayout {
                    padding: Theme.nordic ? 0px : 12px;
                    padding-top: Theme.nordic ? 18px : 8px;
                    spacing: Theme.nordic ? 2px : 6px;
                    Rectangle {
                        height: 26px;
                        TouchArea { clicked => { root.tags-collapsed = !root.tags-collapsed; } }
                        HorizontalLayout {
                            padding-left: Theme.nordic ? 16px : 0px;
                            padding-right: Theme.nordic ? 12px : 0px;
                            spacing: 6px;
                            Text { text: "Tags"; color: Theme.dim; font-size: 12px * Prefs.fs; font-weight: 700; vertical-alignment: center; }
                            VerticalLayout { alignment: center; SIcon { commands: root.tags-collapsed ? Icons.chevron-right : Icons.chevron-down; size: 11px; weight: 2.2; tint: Theme.faint; } }
                            Rectangle { horizontal-stretch: 1; }
                            IconBtn { icon: Icons.settings; icon-size: 13px; width: 22px; tint: Theme.faint; clicked => { root.settings-tab = "organize"; root.open-settings(); } }
                        }
                    }
                    if !root.tags-collapsed && Theme.bento: Rectangle {
                        property <length> cw: (self.width - 8px) / 2;
                        property <length> ch: 58px * Prefs.fs;
                        height: ceil(root.tags.length / 2) * (self.ch + 8px) - 8px;
                        for t[i] in root.tags: TagTile {
                            x: mod(i, 2) * (parent.cw + 8px);
                            y: floor(i / 2) * (parent.ch + 8px);
                            width: parent.cw;
                            height: parent.ch;
                            t: t;
                            selected: t.id == root.current-tag;
                            clicked => { root.current-tag = t.id; root.select-tag(t.id); }
                            hl-id: "tag:" + t.id;
                            context(x, y) => { root.ctx("tag", t.id, x, y); }
                        }
                    }
                    if !root.tags-collapsed && Theme.nordic: VerticalLayout {
                        spacing: 2px;
                        for t in root.tags: TagRow {
                            t: t;
                            selected: t.id == root.current-tag;
                            clicked => { root.current-tag = t.id; root.select-tag(t.id); }
                            hl-id: "tag:" + t.id;
                            context(x, y) => { root.ctx("tag", t.id, x, y); }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 0.001; min-height: 0px; }
            // storage (JMAP quota): a meter tile (Bento) or one quiet line (Nordic)
            if root.quota-text != "" && Theme.bento: Tile {
                border-radius: 20px;
                VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: "Storage"; color: Theme.dim; font-size: 12px * Prefs.fs; horizontal-stretch: 1; }
                        Text { text: root.quota-text; color: Theme.dim; font-size: 12px * Prefs.fs; }
                    }
                    if root.quota-frac >= 0: Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.track;
                        Rectangle { x: 0; width: max(6px, parent.width * root.quota-frac); height: 6px; border-radius: 3px; background: Theme.accent; }
                    }
                }
            }
            if root.quota-text != "" && Theme.nordic: Text {
                x: 16px;
                text: root.quota-text + (root.quota-frac >= 0 ? " used" : "");
                color: Theme.dim;
                font-size: 12px * Prefs.fs;
            }
        }

        // ---- list, reader and context: tiles (Bento) or one surface (Nordic) ----
        HorizontalLayout {
            padding: Theme.nordic ? 14px : 0px;
            padding-left: 0px;
            horizontal-stretch: 1;
        surface := Rectangle {
            background: Theme.nordic ? Theme.tile : transparent;
            border-width: Theme.nordic ? 1px : 0px;
            border-color: Theme.line;
            border-radius: Theme.nordic ? 28px : 0px;
            clip: Theme.nordic;
        HorizontalLayout {
        padding: Theme.nordic ? 1px : 0px;
        spacing: 0px;

        // ---- message list ----
        Rectangle {
            width: root.list-w;
            background: Theme.nordic ? transparent : Theme.tile;
            border-width: Theme.nordic ? 0px : 1px;
            border-color: Theme.line;
            border-radius: Theme.nordic ? 0px : Theme.r-pane;
            clip: true;
            VerticalLayout {
                // header: title + new count, greeting line, search, quick filters
                VerticalLayout {
                    vertical-stretch: 0;
                    padding-top: Theme.nordic ? 28px : 20px;
                    padding-left: Theme.nordic ? 28px : 20px;
                    padding-right: Theme.nordic ? 24px : 16px;
                    padding-bottom: Theme.nordic ? 16px : 10px;
                    spacing: Theme.nordic ? 4px : 12px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.list-title;
                            color: Theme.text;
                            font-size: (Theme.nordic ? 28px : 25px) * Prefs.fs;
                            font-weight: Theme.nordic ? 800 : 700;
                            letter-spacing: Theme.nordic ? -0.56px : -0.5px;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if Theme.bento && root.list-unread > 0: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 24px;
                                width: npl.preferred-width + 20px;
                                border-radius: 12px;
                                background: Theme.rose-bg;
                                npl := Text { text: root.list-unread + " new"; color: Theme.rose-fg; font-size: 12px * Prefs.fs; font-weight: 700; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                icon: Icons.check;
                                active: root.checked-count > 0;
                                clicked => { root.select-all(); }
                            }
                        }
                        VerticalLayout { alignment: center; IconBtn { icon: Icons.refresh; clicked => { root.refresh(); } } }
                    }
                    Text {
                        text: root.search != "" ? "Results for “" + root.search + "”" : root.list-sub;
                        color: Theme.dim;
                        font-size: (Theme.nordic ? 13px : 12.5px) * Prefs.fs;
                        overflow: elide;
                    }
                    if Theme.nordic: Rectangle { height: 10px; vertical-stretch: 0; }
                    // search: tile-2 field with a "/" hint (Bento), hairline pill (Nordic)
                    Rectangle {
                        height: Prefs.large-targets ? 44px : (Theme.nordic ? 40px : 38px);
                        border-radius: Theme.nordic ? self.height / 2 : 14px;
                        background: Theme.nordic ? transparent : Theme.tile2;
                        border-width: search-box.has-focus ? max(1px, Prefs.focus-ring) : 1px;
                        border-color: search-box.has-focus ? Theme.ring : Theme.line;
                        HorizontalLayout {
                            padding-left: Theme.nordic ? 16px : 12px;
                            padding-right: 6px;
                            spacing: 8px;
                            VerticalLayout { alignment: center; SIcon { commands: Icons.search; size: 15px; weight: 2; tint: Theme.dim; } }
                            Rectangle {
                                horizontal-stretch: 1;
                                if root.search == "": Text { x: 0; width: parent.width; height: parent.height; text: "Search mail"; color: Theme.faint; font-size: 13px * Prefs.fs; vertical-alignment: center; }
                                search-box := TextInput {
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width;
                                    text <=> root.search;
                                    color: Theme.text;
                                    font-size: 13px * Prefs.fs;
                                    single-line: true;
                                    selection-background-color: Theme.sel;
                                    selection-foreground-color: Theme.sel-text;
                                    accepted => { root.do-search(self.text); }
                                }
                            }
                            if root.search == "": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px; height: 17px; border-radius: 5px; border-width: 1px; border-color: Theme.line;
                                    Text { text: "/"; color: Theme.faint; font-size: 11px; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    icon: Icons.opt;
                                    width: 28px;
                                    icon-size: 15px;
                                    active: root.sf-open || root.sf-active;
                                    clicked => { root.sf-open = !root.sf-open; }
                                }
                            }
                        }
                    }
                    // quick filters over the search filters (Bento chips)
                    if Theme.bento: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        QuickChip { label: "All"; on: !root.sf-active; clicked => { root.sf-clear(); } }
                        QuickChip { label: "Unread"; on: root.sf-active && root.sf-unread; clicked => { root.sf-unread = !root.sf-unread; root.sf-apply(); } }
                        QuickChip { label: "Starred"; on: root.sf-active && root.sf-starred; clicked => { root.sf-starred = !root.sf-starred; root.sf-apply(); } }
                        QuickChip { label: "Attachments"; on: root.sf-active && root.sf-attach; clicked => { root.sf-attach = !root.sf-attach; root.sf-apply(); } }
                    }
                }
                if root.sf-open: VerticalLayout {
                    padding-left: Theme.nordic ? 28px : 20px;
                    padding-right: Theme.nordic ? 24px : 16px;
                    padding-bottom: 10px;
                    spacing: 6px;
                    LineEdit { placeholder-text: "From"; text <=> root.sf-from; }
                    LineEdit { placeholder-text: "To"; text <=> root.sf-to; }
                    LineEdit { placeholder-text: "Subject"; text <=> root.sf-subject; }
                    LineEdit { placeholder-text: "Has the words"; text <=> root.sf-body; }
                    HorizontalLayout { spacing: 6px; LineEdit { placeholder-text: "After YYYY-MM-DD"; text <=> root.sf-after; } LineEdit { placeholder-text: "Before YYYY-MM-DD"; text <=> root.sf-before; } }
                    HorizontalLayout { spacing: 6px; LineEdit { placeholder-text: "Min KB"; text <=> root.sf-min; } LineEdit { placeholder-text: "Max KB"; text <=> root.sf-max; } }
                    CheckBox { text: "Unread"; checked <=> root.sf-unread; }
                    CheckBox { text: "Starred"; checked <=> root.sf-starred; }
                    CheckBox { text: "Has attachment"; checked <=> root.sf-attach; }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        Button { text: "Clear"; clicked => { root.sf-clear(); } }
                        PrimaryButton { text: "Search"; clicked => { root.sf-apply(); } }
                    }
                }
                if root.checked-count > 0: Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: Theme.nordic ? 28px : 20px;
                        padding-right: Theme.nordic ? 20px : 12px;
                        spacing: 2px;
                        Text { text: root.checked-count + " selected"; color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; HoverAction { icon: Icons.archive; clicked => { root.bulk("archive"); } } }
                        VerticalLayout { alignment: center; HoverAction { icon: Icons.trash; clicked => { root.bulk("delete"); } } }
                        VerticalLayout { alignment: center; HoverAction { glyph: "\u{E8C3}"; clicked => { root.bulk("read"); } } }
                        VerticalLayout { alignment: center; HoverAction { icon: Icons.mail; clicked => { root.bulk("unread"); } } }
                        VerticalLayout { alignment: center; HoverAction { icon: Icons.star; clicked => { root.bulk("star"); } } }
                        VerticalLayout { alignment: center; HoverAction { icon: Icons.alert; clicked => { root.bulk("spam"); } } }
                        VerticalLayout { alignment: center; HoverAction { icon: Icons.close; clicked => { root.bulk("clear"); } } }
                    }
                }
                if root.busy: Text { text: "Loading…"; color: Theme.dim; horizontal-alignment: center; height: 24px; vertical-alignment: center; }
                mail-list := ListView {
                    vertical-stretch: 1;
                    changed content-y => {
                        if root.has-more && !root.busy && (self.content-height + self.content-y - self.visible-height) < 300px { root.load-more(); }
                    }
                    for m in root.mails: MailRow {
                        m: m;
                        row-height: root.mail-row-height;
                        selected: m.id == root.current-mail;
                        clicked => {
                            root.current-mail = m.id;
                            root.open-mail(m.id);
                            kbd.focus();
                        }
                        ctrl-clicked => { root.toggle-check(m.id); }
                        action(a) => { root.row-action(m.id, a); }
                        context(x, y) => { root.ctx("mail", m.id, x, y); }
                    }
                }
                if !root.busy && root.mails.length > 0: Rectangle {
                    height: 44px;
                    Text {
                        text: root.has-more ? "Loading more…" : "No more emails to load";
                        TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("list", "", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                        color: Theme.faint;
                        font-size: 12px;
                    }
                }
                if !root.busy && root.mails.length == 0: Rectangle {
                    height: 80px;
                    Text { text: "No messages"; color: Theme.dim; }
                    TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("list", "", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                }
            }
        }
        Rectangle { width: Theme.nordic ? 1px : Theme.gap; background: Theme.nordic ? Theme.line : transparent; }

        // ---- reader column: summary tiles (Bento) above the reader ----
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.gap;
            if root.has-summary: HorizontalLayout {
                spacing: 12px;
                height: max(78px, sumt.preferred-height);
                sumt := SummaryTile {
                    label: "Today";
                    value: !root.sum-has-cal ? "No calendar" : root.sum-today == 0 ? "No events" : root.sum-today == 1 ? "1 event" : root.sum-today + " events";
                    sub: root.sum-today-next != "" ? root.sum-today-next : (root.sum-has-cal ? "Nothing else today" : "");
                    bg: Theme.rose-bg;
                    fg: Theme.rose-fg;
                    clicked => { root.show-settings = false; root.app = 1; root.app-changed(1); }
                }
                SummaryTile {
                    label: "Flagged";
                    value: root.sum-flagged == 1 ? "1 message" : root.sum-flagged + " messages";
                    sub: root.sum-flagged-who != "" ? root.sum-flagged-who : "Nothing flagged";
                    bg: Theme.amber-bg;
                    fg: Theme.amber-fg;
                    clicked => { root.sf-starred = true; root.sf-apply(); }
                }
                if root.sum-has-tasks: SummaryTile {
                    label: "To do";
                    value: root.sum-tasks == 1 ? "1 task" : root.sum-tasks + " tasks";
                    sub: root.sum-tasks-next != "" ? root.sum-tasks-next : "All done";
                    bg: Theme.mint-bg;
                    fg: Theme.mint-fg;
                    clicked => { root.show-settings = false; root.app = 1; root.app-changed(1); }
                }
            }
        // reader
        Rectangle {
            vertical-stretch: 1;
            // the action bar adapts to reader-w; the window minimum must not come from it
            min-width: 240px;
            min-height: 200px;
            background: Theme.nordic ? transparent : Theme.tile;
            border-width: Theme.nordic ? 0px : 1px;
            border-color: Theme.line;
            border-radius: Theme.nordic ? 0px : Theme.r-pane;
            VerticalLayout {
                visible: root.current-mail == "";
                alignment: center;
                spacing: 10px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 68px; height: 68px; border-radius: Theme.round(68px); background: Theme.tile2;
                        border-width: 1px; border-color: Theme.line;
                        SIcon { commands: Icons.inbox; size: 28px; weight: 1.6; tint: Theme.dim; }
                    }
                }
                Text { text: "No conversation selected"; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-alignment: center; }
                Text { text: "Choose a conversation from the list to read it here"; color: Theme.dim; horizontal-alignment: center; }
            }
            VerticalLayout {
                visible: root.current-mail != "";
                padding-top: Theme.nordic ? 30px : 22px;
                padding-bottom: Theme.nordic ? 24px : 18px;
                padding-left: Theme.nordic ? 44px : 26px;
                padding-right: Theme.nordic ? 44px : 26px;
                spacing: 0px;
                // actions: the main ones always, the rest inline when the reader is wide enough
                acts := HorizontalLayout {
                    property <bool> roomy: root.reader-w > (Theme.nordic ? 720px : 600px);
                    property <bool> labels: Prefs.toolbar-labels && root.reader-w > (Theme.nordic ? 345px : 385px);
                    // very narrow: Delete and Star move into More too
                    property <bool> tight: root.reader-w < 250px;
                    spacing: 6px;
                    ActionButton { icon: Icons.reply; label: "Reply"; icon-only: !acts.labels; clicked => { root.act("reply"); } }
                    if acts.roomy: ActionButton { icon: Icons.reply-all; label: "Reply all"; icon-only: Theme.bento || !acts.labels; clicked => { root.act("reply-all"); } }
                    ActionButton { icon: Icons.fwd; label: "Forward"; icon-only: !acts.labels; clicked => { root.act("forward"); } }
                    ActionButton { icon: Icons.archive; label: "Archive"; icon-only: !acts.labels; clicked => { root.act("archive"); } }
                    if acts.roomy || (Theme.bento && !acts.tight): ActionButton { icon: Icons.trash; label: "Delete"; icon-only: Theme.bento || !acts.labels; clicked => { root.act("delete"); } }
                    if acts.roomy: ActionButton { icon: Icons.move; label: "Move"; icon-only: Theme.bento || !acts.labels; clicked => { move-popup.show(); } }
                    if acts.roomy: ActionButton { icon: Icons.tag; label: "Tag"; icon-only: true; clicked => { tag-popup.show(); } }
                    Rectangle { horizontal-stretch: 1; }
                    if !acts.tight: ActionButton {
                        icon: Icons.star;
                        label: root.r-flagged ? "Starred" : "Star";
                        icon-only: true;
                        active: root.r-flagged;
                        clicked => { root.act("star"); }
                    }
                    ActionButton { icon: Icons.more; label: "More"; icon-only: true; clicked => { more-popup.show(); } }
                    move-popup := PopupWindow {
                        x: acts.width - 260px; y: 40px; width: 240px;
                        MenuPanel {
                            VerticalLayout {
                                padding: 6px;
                                for f in root.folders: Rectangle {
                                    visible: f.id != "__scheduled";
                                    height: f.id == "__scheduled" ? 0px : 30px; border-radius: Theme.nordic ? 15px : 9px;
                                    background: mta.has-hover ? Theme.hover : transparent;
                                    mta := TouchArea { clicked => { root.move-to(f.id); } }
                                    HorizontalLayout {
                                        padding-left: 10px + f.depth * 12px; spacing: 8px;
                                        VerticalLayout { alignment: center; SIcon { commands: Icons.for-glyph(f.icon); size: 15px; weight: 1.8; tint: Theme.dim; } }
                                        Text { text: f.name; color: Theme.text; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    tag-popup := PopupWindow {
                        x: acts.width - 220px; y: 40px; width: 200px;
                        MenuPanel {
                            VerticalLayout {
                                padding: 6px;
                                for t in root.tags: Rectangle {
                                    height: 30px; border-radius: Theme.nordic ? 15px : 9px;
                                    background: tgta.has-hover ? Theme.hover : transparent;
                                    tgta := TouchArea { clicked => { root.tag-toggle(t.id); } }
                                    HorizontalLayout {
                                        padding-left: 10px; spacing: 10px;
                                        VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 4px; background: t.color; } }
                                        Text { text: t.name; color: Theme.text; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    more-popup := PopupWindow {
                        x: acts.width - 220px; y: 40px; width: 220px;
                        MenuPanel {
                            VerticalLayout {
                                padding: 6px;
                                if !acts.roomy: MenuItem { text: "Reply all"; clicked => { root.act("reply-all"); } }
                                if !acts.roomy && (Theme.nordic || acts.tight): MenuItem { text: "Delete"; clicked => { root.act("delete"); } }
                                if acts.tight: MenuItem { text: root.r-flagged ? "Remove star" : "Star"; clicked => { root.act("star"); } }
                                if !acts.roomy: MenuItem { text: "Move to…"; clicked => { move-popup.show(); } }
                                if !acts.roomy: MenuItem { text: "Tag…"; clicked => { tag-popup.show(); } }
                                MenuItem { text: "Report spam"; clicked => { root.act("spam"); } }
                                MenuItem { text: "Mark as unread"; clicked => { root.act("unread"); } }
                                MenuItem { text: "Print"; clicked => { root.act("print"); } }
                            }
                        }
                    }
                }
                Rectangle { height: Theme.nordic ? 30px : 20px; }
                Text {
                    text: root.r-subject;
                    color: Theme.text;
                    font-size: (Theme.nordic ? 34px : 27px) * Prefs.fs;
                    font-weight: 700;
                    letter-spacing: Theme.nordic ? -0.85px : -0.54px;
                    wrap: word-wrap;
                    max-height: 3 * self.font-size * 1.25;
                    overflow: elide;
                }
                Rectangle { height: Theme.nordic ? 18px : 14px; }
                // "Mira Okafor to you and Jonas · Today 09:42" (right-click a name for its menu)
                HorizontalLayout {
                    spacing: 0px;
                    Text {
                        text: root.r-from;
                        color: Theme.dim;
                        font-size: (Theme.nordic ? 13.5px : 12.5px) * Prefs.fs;
                        font-weight: 600;
                        overflow: elide;
                        TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("addr", root.r-email, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                    }
                    Text {
                        text: (root.r-to != "" ? " to " + root.r-to : "") + (root.r-date != "" ? " · " + root.r-date : "");
                        color: Theme.dim;
                        font-size: (Theme.nordic ? 13.5px : 12.5px) * Prefs.fs;
                        overflow: elide;
                        horizontal-stretch: 1;
                        TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("addr-to", root.r-to, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                    }
                }
                if root.thread-msgs.length > 1: VerticalLayout {
                    vertical-stretch: 0;
                    padding-top: 12px;
                    spacing: 2px;
                    Text { text: "Conversation · " + root.thread-msgs.length + " messages"; color: Theme.dim; font-size: 11.5px; font-weight: 700; }
                    Flickable {
                    vertical-stretch: 0;
                    height: min(root.thread-msgs.length, 5) * 32px;
                    content-height: thl.preferred-height;
                    thl := VerticalLayout {
                    spacing: 2px;
                    for t in root.thread-msgs: Rectangle {
                        height: 30px;
                        border-radius: Theme.nordic ? 15px : 10px;
                        background: t.current ? Theme.sel : (tma.has-hover ? Theme.tile2 : transparent);
                        tma := TouchArea { clicked => { if !t.current { root.current-mail = t.id; root.open-mail(t.id); } } pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("thread", t.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px; background: t.unread ? Theme.accent : transparent; } }
                            Text { text: t.sender; color: t.current ? Theme.sel-text : Theme.text; font-weight: t.current ? 700 : 600; width: 150px; overflow: elide; vertical-alignment: center; font-size: 12px; }
                            Text { text: t.preview; color: t.current ? Theme.sel-text : Theme.dim; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; font-size: 12px; }
                            Text { text: t.date; color: t.current ? Theme.sel-text : Theme.dim; vertical-alignment: center; font-size: 11px; }
                        }
                    }
                    }
                    }
                }
                if root.plugin-rows.length > 0 || root.spam-verdict != "": Rectangle { height: 10px; }
                for pr in root.plugin-rows: HorizontalLayout {
                    padding-bottom: 6px;
                    spacing: 8px;
                    Rectangle {
                        width: pl.preferred-width + 18px;
                        height: 22px;
                        border-radius: 11px;
                        background: pr.tone == "danger" ? Theme.rose-bg : pr.tone == "warning" ? Theme.amber-bg : pr.tone == "success" ? Theme.mint-bg : Theme.track;
                        pl := Text {
                            text: pr.label;
                            font-size: 10.5px;
                            font-weight: 700;
                            color: pr.tone == "danger" ? Theme.rose-fg : pr.tone == "warning" ? Theme.amber-fg : pr.tone == "success" ? Theme.mint-fg : Theme.text;
                        }
                    }
                    Text { text: pr.value; color: Theme.dim; font-size: 11.5px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
                if root.spam-verdict != "": HorizontalLayout {
                    padding-bottom: 6px;
                    spacing: 10px;
                    Rectangle {
                        width: badge.preferred-width + 20px;
                        height: 22px;
                        border-radius: 11px;
                        background: root.spam-verdict == "spam" ? Theme.rose-bg : root.spam-verdict == "suspicious" ? Theme.amber-bg : Theme.mint-bg;
                        badge := Text {
                            text: root.spam-verdict == "spam" ? "Spam" : root.spam-verdict == "suspicious" ? "Suspicious" : "Clean";
                            color: root.spam-verdict == "spam" ? Theme.rose-fg : root.spam-verdict == "suspicious" ? Theme.amber-fg : Theme.mint-fg;
                            font-size: 11px;
                            font-weight: 700;
                        }
                    }
                    Text { text: root.spam-detail; color: Theme.dim; font-size: 11.5px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
                if root.images-blocked: Rectangle {
                    height: 44px;
                    border-radius: 14px;
                    background: Theme.tile2;
                    border-width: 1px;
                    border-color: Theme.line;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 6px;
                        spacing: 10px;
                        VerticalLayout { alignment: center; SIcon { commands: Icons.image; size: 16px; weight: 1.8; tint: Theme.accent; } }
                        Text { text: "Remote images were blocked to protect your privacy."; color: Theme.body; font-size: 12.5px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        VerticalLayout { alignment: center; ActionButton { label: "Load images"; clicked => { root.load-images(); } } }
                    }
                }
                Rectangle { height: Theme.nordic ? 18px : 14px; }
                body := Rectangle {
                    background: root.render-mode == 2 ? white : Theme.reader;
                    border-radius: 0px;
                    vertical-stretch: 1;
                    clip: true;
                    if root.render-mode == 1: ScrollView {
                        content-height: root.lite-height;
                        content-width: self.visible-width;
                        Image {
                            x: 0; y: 0;
                            source: root.lite-image;
                            width: parent.width;
                            height: root.lite-height;
                            image-fit: fill;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.lite-click(self.mouse-x, self.mouse-y); }
                                pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("body", "lite", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                            }
                        }
                    }
                    if root.render-mode == 2: ScrollView {
                        VerticalLayout {
                            padding: 16px;
                            TouchArea {
                                pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("body", "plain", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                TextInput {
                                    property <int> cmd: root.ctx-body-cmd;
                                    text: root.r-body; read-only: true; single-line: false; wrap: word-wrap; color: Theme.zebra; font-size: 14px;
                                    changed cmd => { if mod(self.cmd, 2) == 1 { self.copy(); } else { self.select-all(); } }
                                }
                            }
                        }
                    }
                }
                // attachments: tile-2 cards with a tinted type badge (BNMail) / quiet pills (NordMail)
                if root.attachments.length > 0: Flickable {
                    height: 66px;
                    content-width: attl.preferred-width;
                    attl := HorizontalLayout {
                        padding-top: 12px;
                        spacing: 8px;
                        alignment: start;
                        for a in root.attachments: Rectangle {
                            height: Theme.nordic ? 50px : 54px;
                            width: al.preferred-width;
                            border-radius: Theme.nordic ? 18px : 16px;
                            border-width: Theme.nordic ? 0px : 1px;
                            border-color: Theme.line;
                            background: ata.has-hover ? Theme.hover : Theme.tile2;
                            ata := TouchArea { clicked => { root.open-attachment(a.index); } pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("att", a.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                            al := HorizontalLayout {
                                padding-left: Theme.nordic ? 18px : 10px;
                                padding-right: 8px;
                                spacing: 10px;
                                if Theme.bento: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 10px; background: Theme.rose-bg;
                                        SIcon { commands: Icons.file; size: 16px; weight: 1.8; tint: Theme.rose-fg; }
                                    }
                                }
                                if Theme.nordic: Text { text: "FILE"; color: Theme.accent; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                if Theme.bento: VerticalLayout {
                                    alignment: center;
                                    Text { text: a.name; color: Theme.text; font-size: 13px * Prefs.fs; font-weight: 600; max-width: 200px; overflow: elide; }
                                    Text { text: a.size; color: Theme.dim; font-size: 11.5px * Prefs.fs; }
                                }
                                if Theme.nordic: Text { text: a.name; color: Theme.text; font-size: 13.5px * Prefs.fs; font-weight: 600; max-width: 200px; overflow: elide; vertical-alignment: center; }
                                if Theme.nordic: Text { text: a.size; color: Theme.dim; font-size: 12.5px * Prefs.fs; vertical-alignment: center; }
                                VerticalLayout { alignment: center; HoverAction { icon: Icons.download; clicked => { root.save-attachment(a.index); } } }
                            }
                        }
                    }
                }
                if root.pref-quick-reply: Rectangle { height: 14px; }
                // quick reply: tile-2 bar with an accent Send (BNMail) / hairline pill (NordMail)
                if root.pref-quick-reply: Rectangle {
                    height: Theme.nordic ? 58px : 54px;
                    border-radius: Theme.nordic ? 26px : 20px;
                    background: Theme.nordic ? transparent : Theme.tile2;
                    border-width: qr.has-focus ? max(1px, Prefs.focus-ring) : 1px;
                    border-color: qr.has-focus ? Theme.ring : Theme.line;
                    HorizontalLayout {
                        padding: Theme.nordic ? 8px : 6px;
                        padding-left: Theme.nordic ? 20px : 16px;
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            if root.quick-text == "": Text { x: 0; width: parent.width; height: parent.height; text: Theme.nordic ? "Write a reply…" : "Reply to " + (root.r-from != "" ? root.r-from : root.r-email) + "…"; color: Theme.faint; font-size: (Theme.nordic ? 14.5px : 14px) * Prefs.fs; vertical-alignment: center; overflow: elide; }
                            qr := TextInput {
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                text <=> root.quick-text;
                                color: Theme.text;
                                font-size: (Theme.nordic ? 14.5px : 14px) * Prefs.fs;
                                single-line: true;
                                selection-background-color: Theme.sel;
                                selection-foreground-color: Theme.sel-text;
                                accepted => { if self.text != "" { root.quick-reply(self.text); } }
                            }
                        }
                        Rectangle {
                            width: sendl.preferred-width + (Theme.nordic ? 44px : 40px);
                            border-radius: Theme.nordic ? 20px : 15px;
                            background: root.quick-text == "" ? Theme.accent.with-alpha(0.55) : qsa.pressed ? Theme.accent.darker(0.12) : qsa.has-hover ? Theme.accent.brighter(0.1) : Theme.accent;
                            qsa := TouchArea { clicked => { if root.quick-text != "" { root.quick-reply(root.quick-text); } } }
                            sendl := Text { text: "Send"; color: Theme.on-accent; font-size: 13.5px * Prefs.fs; font-weight: 700; }
                        }
                    }
                }
            }
            // ---- composer: replaces the reading pane (inset so the tile's rounded edge shows) ----
            Rectangle {
                x: Theme.nordic ? 0px : 1px;
                y: Theme.nordic ? 0px : 1px;
                width: parent.width - 2 * self.x;
                height: parent.height - 2 * self.y;
                border-radius: Theme.nordic ? 0px : Theme.r-pane - 1px;
                clip: true;
            // ---- composer: replaces the reading pane (Bulwark layout) ----
            if root.composing: cmp := Rectangle {
                background: Theme.reader;
                // narrow: the less used formatting moves into a "more" menu; tight: the bar shows icons only
                property <bool> narrow: self.width < (Prefs.large-targets ? 1000px : 800px);
                property <bool> tight: self.width < 600px;
                // room for the "Proofreading off" note beside the labelled buttons
                property <bool> roomy: self.width >= 780px;
                function fmt(k: string) {
                    root.rte-cmd(k);
                    self.focus-ed();
                }
                // the visible editing surface: the source text while the HTML view is open
                function focus-ed() {
                    if root.rte-source-open { root.rte-source-focus-req += 1; } else { ime-ti.focus(); }
                }
                property <int> sreq: root.rte-scroll-req;
                changed sreq => {
                    let top = root.rte-caret-y + 20px;
                    if top + root.rte-caret-h + 28px > -body-sv.content-y + body-sv.visible-height {
                        body-sv.content-y = -(top + root.rte-caret-h + 28px - body-sv.visible-height);
                    } else if top - 8px < -body-sv.content-y {
                        body-sv.content-y = -max(0px, top - 8px);
                    }
                }
                property <int> freq: root.rte-focus-req;
                changed freq => { self.focus-ed(); }
                init => { if root.rte-focus-on-open { ime-ti.focus(); } }
                rte-fs := FocusScope {
                    x: 0px; y: 0px; width: 1px; height: 1px;
                    // Alt+letter: the TextInput's `edited` for that key runs during the same
                    // key event; the flag is dropped right after so later IME commits pass.
                    property <bool> alt-key;
                    alt-clear := Timer {
                        interval: 1ms;
                        running: false;
                        triggered => { rte-fs.alt-key = false; self.running = false; }
                    }
                    capture-key-pressed(e) => {
                        if !ime-ti.has-focus { return reject; }
                        self.alt-key = e.modifiers.alt && !e.modifiers.control;
                        if self.alt-key { alt-clear.running = true; }
                        if root.rte-key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) { return accept; }
                        reject
                    }
                    // IME: composition (pre-edit) text is drawn by this TextInput at the caret;
                    // committed text arrives through `edited` and goes to the editor.
                    ime-bg := Rectangle {
                        x: ime-ti.x - 1px; y: ime-ti.y;
                        width: ime-ti.preferred-width > 2px ? ime-ti.preferred-width + 2px : 0px;
                        height: ime-ti.height;
                        background: Theme.reader;
                    }
                    ime-ti := TextInput {
                        x: rte-area.absolute-position.x - rte-fs.absolute-position.x + root.rte-caret-x;
                        y: rte-area.absolute-position.y - rte-fs.absolute-position.y + root.rte-caret-y;
                        width: max(2px, self.preferred-width);
                        height: root.rte-caret-h;
                        single-line: false;
                        font-size: root.rte-base-size;
                        color: Theme.text;
                        text-cursor-width: 0px;
                        edited => {
                            let t = self.text;
                            self.text = "";
                            if t != "" && !rte-fs.alt-key { root.rte-key(t, false, false, false); }
                        }
                    }
                }
                Timer {
                    interval: 530ms;
                    running: ime-ti.has-focus;
                    triggered => { root.rte-blink = !root.rte-blink; }
                }
                TouchArea { }
                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;
                    // header (BNCompose: 19px title, draft state, square pop-out / close buttons)
                    HorizontalLayout {
                        padding-top: 16px;
                        padding-bottom: 10px;
                        padding-left: Theme.nordic ? 28px : 24px;
                        padding-right: 18px;
                        spacing: 8px;
                        Text { text: root.c-subject == "" ? "New message" : root.c-subject; color: Theme.text; font-size: Theme.fs-section * Prefs.fs; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        if root.c-status == "Saving…" || root.c-saved-at != "": Text { text: root.c-status == "Saving…" ? "Saving…" : "Draft saved " + root.c-saved-at; color: Theme.dim; font-size: 12px * Prefs.fs; vertical-alignment: center; }
                        VerticalLayout { alignment: center; CmpHeadButton { icon: Icons.check; tip: "Save draft"; clicked => { root.save-draft(false); } } }
                        if !root.ai-hidden: VerticalLayout { alignment: center; CmpHeadButton { icon: Icons.spark; tip: "Assistant"; active: root.chat-shown; clicked => { if root.chat-shown { root.chat-open = false; root.c-ai-closed = true; } else { root.chat-open = true; root.c-ai-closed = false; } } } }
                        VerticalLayout { alignment: center; CmpHeadButton { icon: Icons.external; tip: "Pop out"; clicked => { root.toast = "Pop-out window is not available yet."; } } }
                        VerticalLayout { alignment: center; CmpHeadButton { icon: Icons.close; tip: "Close and keep draft"; clicked => { root.save-draft(true); } } }
                    }
                    // recipient rows: 56px labels, hairline under each row
                    VerticalLayout {
                        padding-left: Theme.nordic ? 28px : 24px;
                        padding-right: Theme.nordic ? 28px : 24px;
                        // From: the identity as a chip
                        Rectangle {
                            height: 44px;
                            frta := TouchArea { clicked => { from-pop.show(); } }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "From"; color: Theme.dim; font-size: 13.5px * Prefs.fs; width: 56px; vertical-alignment: center; }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        alignment: start;
                                        Rectangle {
                                            height: 28px;
                                            border-radius: 14px;
                                            background: frta.has-hover ? Theme.hover : Theme.tile2;
                                            border-width: 1px;
                                            border-color: Theme.line;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 8px;
                                                spacing: 6px;
                                                Text { text: root.c-identities.length > 0 ? root.c-identities[root.c-from-index] : root.account; color: Theme.text; font-size: 13.5px * Prefs.fs; vertical-alignment: center; overflow: elide; }
                                                VerticalLayout { alignment: center; SIcon { commands: Icons.chevron-down; size: 12px; weight: 2; tint: frta.has-hover ? Theme.text : Theme.dim; } }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                            from-pop := PopupWindow {
                                x: 68px; y: 38px;
                                width: 380px;
                                MenuPanel {
                                    VerticalLayout {
                                        padding: 4px;
                                        for id[i] in root.c-identities: MenuItem { text: id; checkable: true; checked: i == root.c-from-index; clicked => { root.c-from-index = i; } }
                                    }
                                }
                            }
                        }
                        // To
                        Rectangle {
                            height: 48px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "To"; color: Theme.dim; font-size: 13.5px * Prefs.fs; width: 60px; vertical-alignment: center; }
                                VerticalLayout { alignment: center; horizontal-stretch: 1; BareField { placeholder: "Recipient email addresses"; text <=> root.c-to; } }
                                VerticalLayout { alignment: center; FmtButton { label: "Cc"; active: root.c-show-cc; clicked => { root.c-show-cc = !root.c-show-cc; } } }
                                VerticalLayout { alignment: center; FmtButton { label: "Bcc"; active: root.c-show-bcc; clicked => { root.c-show-bcc = !root.c-show-bcc; } } }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                        if root.c-show-cc: Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Cc"; color: Theme.dim; font-size: 13.5px * Prefs.fs; width: 56px; vertical-alignment: center; }
                                VerticalLayout { alignment: center; BareField { placeholder: "Cc recipients"; text <=> root.c-cc; } }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                        if root.c-show-bcc: Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Bcc"; color: Theme.dim; font-size: 13.5px * Prefs.fs; width: 56px; vertical-alignment: center; }
                                VerticalLayout { alignment: center; BareField { placeholder: "Bcc recipients"; text <=> root.c-bcc; } }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Subject"; color: Theme.dim; font-size: 13.5px * Prefs.fs; width: 56px; vertical-alignment: center; }
                                VerticalLayout { alignment: center; BareField { placeholder: "Subject"; strong: true; text <=> root.c-subject; } }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                    }
                    // formatting toolbar: one inset tile-2 strip (BNCompose), driving the native rich-text editor
                    HorizontalLayout {
                        // plain text only: no formatting (Bulwark swaps the editor for a textarea)
                        visible: !root.c-plain;
                        height: root.c-plain ? 0px : (Prefs.large-targets ? 58px : 50px);
                        padding-top: 12px;
                        padding-left: Theme.nordic ? 28px : 24px;
                        padding-right: Theme.nordic ? 28px : 24px;
                        alignment: start;
                        Rectangle {
                            background: Theme.tile2;
                            border-width: 1px;
                            border-color: Theme.line;
                            border-radius: Theme.nordic ? self.height / 2 : 16px;
                            HorizontalLayout {
                                padding: 5px;
                                padding-left: Theme.nordic ? 10px : 5px;
                                padding-right: Theme.nordic ? 10px : 5px;
                                spacing: 2px;
                        VerticalLayout { alignment: center; FmtButton { label: "Aa"; tip: "Font size"; active: root.rte-state.size != 0; clicked => { size-pop.show(); }
                            size-pop := PopupWindow { y: 32px; width: 150px;
                                MenuPanel { VerticalLayout { padding: 4px;
                                    MenuItem { text: "Small"; checkable: true; checked: root.rte-state.size == 12; clicked => { cmp.fmt("size:12"); } }
                                    MenuItem { text: "Normal"; checkable: true; checked: root.rte-state.size == 0; clicked => { cmp.fmt("size:0"); } }
                                    MenuItem { text: "Large"; checkable: true; checked: root.rte-state.size == 18; clicked => { cmp.fmt("size:18"); } }
                                    MenuItem { text: "Huge"; checkable: true; checked: root.rte-state.size == 24; clicked => { cmp.fmt("size:24"); } }
                                } }
                            }
                        } }
                        VerticalLayout { alignment: center; FmtButton { label: "B"; bold: true; tip: "Bold (Ctrl+B)"; active: root.rte-state.bold; clicked => { cmp.fmt("bold"); } } }
                        VerticalLayout { alignment: center; FmtButton { label: "I"; italic: true; tip: "Italic (Ctrl+I)"; active: root.rte-state.italic; clicked => { cmp.fmt("italic"); } } }
                        VerticalLayout { alignment: center; FmtButton { label: "U"; underline: true; tip: "Underline (Ctrl+U)"; active: root.rte-state.underline; clicked => { cmp.fmt("underline"); } } }
                        VerticalLayout { alignment: center; FmtButton { label: "S"; strike: true; tip: "Strikethrough (Ctrl+Shift+S)"; active: root.rte-state.strike; clicked => { cmp.fmt("strike"); } } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { glyph: "\u{E8D3}"; tip: "Text colour"; active: root.rte-state.color != ""; clicked => { color-pop.show(); }
                            color-pop := PopupWindow { y: 32px; width: 150px;
                                MenuPanel { VerticalLayout { padding: 4px;
                                    MenuItem { text: "Default"; checkable: true; checked: root.rte-state.color == ""; clicked => { cmp.fmt("color:"); } }
                                    MenuItem { text: "Red"; swatch: #dc2626; clicked => { cmp.fmt("color:#dc2626"); } }
                                    MenuItem { text: "Orange"; swatch: #ea580c; clicked => { cmp.fmt("color:#ea580c"); } }
                                    MenuItem { text: "Green"; swatch: #16a34a; clicked => { cmp.fmt("color:#16a34a"); } }
                                    MenuItem { text: "Blue"; swatch: #2563eb; clicked => { cmp.fmt("color:#2563eb"); } }
                                    MenuItem { text: "Purple"; swatch: #9333ea; clicked => { cmp.fmt("color:#9333ea"); } }
                                    MenuItem { text: "Grey"; swatch: #6b7280; clicked => { cmp.fmt("color:#6b7280"); } }
                                } }
                            }
                        } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { glyph: "\u{E7E6}"; tip: "Highlight (Ctrl+Shift+H)"; active: root.rte-state.highlight; clicked => { cmp.fmt("highlight"); } } }
                        VerticalLayout { alignment: center; FmtButton { label: "H1"; tip: "Heading 1 (Ctrl+Alt+1)"; active: root.rte-state.block == "h1"; clicked => { cmp.fmt("h1"); } } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { label: "H2"; tip: "Heading 2 (Ctrl+Alt+2)"; active: root.rte-state.block == "h2"; clicked => { cmp.fmt("h2"); } } }
                        VerticalLayout { alignment: center; FmtButton { label: "\u{2022}"; bold: true; tip: "Bulleted list (Ctrl+Shift+8)"; active: root.rte-state.block == "bullet"; clicked => { cmp.fmt("bullet"); } } }
                        VerticalLayout { alignment: center; FmtButton { label: "1."; tip: "Numbered list (Ctrl+Shift+7)"; active: root.rte-state.block == "ordered"; clicked => { cmp.fmt("numbered"); } } }
                        VerticalLayout { alignment: center; FmtButton { label: "\u{201C}"; bold: true; tip: "Quote (Ctrl+Shift+B)"; active: root.rte-state.block == "quote"; clicked => { cmp.fmt("quote"); } } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { label: "</>"; tip: "Code block (Ctrl+Alt+C)"; active: root.rte-state.block == "code"; clicked => { cmp.fmt("code"); } } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { glyph: "\u{E8E4}"; tip: "Align left"; active: root.rte-state.align == "left"; clicked => { cmp.fmt("align:left"); } } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { glyph: "\u{E8E3}"; tip: "Center"; active: root.rte-state.align == "center"; clicked => { cmp.fmt("align:center"); } } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { glyph: "\u{E8E2}"; tip: "Align right"; active: root.rte-state.align == "right"; clicked => { cmp.fmt("align:right"); } } }
                        VerticalLayout { alignment: center; FmtButton { label: "Link"; tip: "Link (Ctrl+K)"; active: root.rte-state.link != ""; clicked => { cmp.fmt("link"); } } }
                        VerticalLayout { alignment: center; FmtButton { glyph: "\u{E80A}"; tip: "Table"; active: root.rte-state.in-table; clicked => { table-pop.show(); }
                            table-pop := PopupWindow { y: 32px; width: 200px;
                                MenuPanel { VerticalLayout { padding: 4px;
                                    if !root.rte-state.in-table: MenuItem { text: "Insert 2 \u{00D7} 2 table"; clicked => { cmp.fmt("table:2x2"); } }
                                    if !root.rte-state.in-table: MenuItem { text: "Insert 3 \u{00D7} 3 table"; clicked => { cmp.fmt("table:3x3"); } }
                                    if !root.rte-state.in-table: MenuItem { text: "Insert 4 \u{00D7} 4 table"; clicked => { cmp.fmt("table:4x4"); } }
                                    if root.rte-state.in-table: MenuItem { text: "Add row above"; clicked => { cmp.fmt("table-op:row-above"); } }
                                    if root.rte-state.in-table: MenuItem { text: "Add row below"; clicked => { cmp.fmt("table-op:row-below"); } }
                                    if root.rte-state.in-table: MenuItem { text: "Add column left"; clicked => { cmp.fmt("table-op:col-left"); } }
                                    if root.rte-state.in-table: MenuItem { text: "Add column right"; clicked => { cmp.fmt("table-op:col-right"); } }
                                    if root.rte-state.in-table: MenuItem { text: "Delete row"; clicked => { cmp.fmt("table-op:del-row"); } }
                                    if root.rte-state.in-table: MenuItem { text: "Delete column"; clicked => { cmp.fmt("table-op:del-col"); } }
                                    if root.rte-state.in-table: MenuItem { text: "Toggle header row"; clicked => { cmp.fmt("table-op:header"); } }
                                    if root.rte-state.in-table: MenuItem { text: "Delete table"; clicked => { cmp.fmt("table-op:del-table"); } }
                                } }
                            }
                        } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { glyph: "\u{E894}"; tip: "Clear formatting"; clicked => { cmp.fmt("clear"); } } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { label: "\u{21B6}"; tip: "Undo (Ctrl+Z)"; opacity: root.rte-state.can-undo ? 1 : 0.4; clicked => { cmp.fmt("undo"); } } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { label: "\u{21B7}"; tip: "Redo (Ctrl+Y)"; opacity: root.rte-state.can-redo ? 1 : 0.4; clicked => { cmp.fmt("redo"); } } }
                        if !cmp.narrow: VerticalLayout { alignment: center; FmtButton { label: "HTML"; tip: root.rte-source-open ? "Back to the editor" : "Edit HTML source"; active: root.rte-source-open; clicked => { root.rte-cmd("source-toggle"); } } }
                        if cmp.narrow: VerticalLayout { alignment: center; FmtButton { glyph: "\u{E712}"; tip: "More formatting"; clicked => { more-pop.show(); }
                            more-pop := PopupWindow { x: -160px; y: 32px; width: 210px;
                                MenuPanel { VerticalLayout { padding: 4px;
                                    MenuItem { text: "Heading 2"; checkable: true; checked: root.rte-state.block == "h2"; clicked => { cmp.fmt("h2"); } }
                                    MenuItem { text: "Code block"; checkable: true; checked: root.rte-state.block == "code"; clicked => { cmp.fmt("code"); } }
                                    MenuItem { text: "Highlight"; checkable: true; checked: root.rte-state.highlight; clicked => { cmp.fmt("highlight"); } }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    MenuItem { text: "Default colour"; checkable: true; checked: root.rte-state.color == ""; clicked => { cmp.fmt("color:"); } }
                                    MenuItem { text: "Red"; swatch: #dc2626; clicked => { cmp.fmt("color:#dc2626"); } }
                                    MenuItem { text: "Orange"; swatch: #ea580c; clicked => { cmp.fmt("color:#ea580c"); } }
                                    MenuItem { text: "Green"; swatch: #16a34a; clicked => { cmp.fmt("color:#16a34a"); } }
                                    MenuItem { text: "Blue"; swatch: #2563eb; clicked => { cmp.fmt("color:#2563eb"); } }
                                    MenuItem { text: "Purple"; swatch: #9333ea; clicked => { cmp.fmt("color:#9333ea"); } }
                                    MenuItem { text: "Grey"; swatch: #6b7280; clicked => { cmp.fmt("color:#6b7280"); } }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    MenuItem { text: "Align left"; checkable: true; checked: root.rte-state.align == "left"; clicked => { cmp.fmt("align:left"); } }
                                    MenuItem { text: "Center"; checkable: true; checked: root.rte-state.align == "center"; clicked => { cmp.fmt("align:center"); } }
                                    MenuItem { text: "Align right"; checkable: true; checked: root.rte-state.align == "right"; clicked => { cmp.fmt("align:right"); } }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    MenuItem { text: "Clear formatting"; checkable: true; clicked => { cmp.fmt("clear"); } }
                                    MenuItem { text: "Edit HTML source"; checkable: true; checked: root.rte-source-open; clicked => { root.rte-cmd("source-toggle"); } }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    MenuItem { text: "Undo"; checkable: true; enabled: root.rte-state.can-undo; clicked => { cmp.fmt("undo"); } }
                                    MenuItem { text: "Redo"; checkable: true; enabled: root.rte-state.can-redo; clicked => { cmp.fmt("redo"); } }
                                } }
                            }
                        } }
                            }
                        }
                    }
                    // body
                    if root.rte-source-open: Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text { text: "HTML source \u{2014} changes apply as you type. The quoted original is kept as it is."; color: Theme.dim; font-size: 11px; }
                            src-te := TextEdit {
                                vertical-stretch: 1;
                                text <=> root.rte-source;
                                font-size: 12px;
                                wrap: word-wrap;
                                edited(t) => { root.rte-cmd("source-edit:" + t); }
                                init => { self.focus(); }
                                property <int> freq: root.rte-source-focus-req;
                                changed freq => { self.focus(); }
                            }
                        }
                    }
                    body-sv := ScrollView {
                        visible: !root.rte-source-open;
                        vertical-stretch: root.rte-source-open ? 0 : 1;
                        max-height: root.rte-source-open ? 0px : 100000px;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, root.rte-height + 48px);
                        rte-area := Rectangle {
                            x: 28px;
                            y: 20px;
                            width: body-sv.visible-width - 56px;
                            height: max(root.rte-height + 20px, body-sv.visible-height - 40px);
                            init => { root.rte-width = self.width; root.rte-cmd("relayout"); }
                            changed width => { root.rte-width = self.width; root.rte-cmd("relayout"); }
                            rte-ta := TouchArea {
                                mouse-cursor: text;
                                pointer-event(ev) => {
                                    if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                        ime-ti.focus();
                                        root.rte-pointer("down", self.mouse-x, self.mouse-y, ev.modifiers.shift);
                                    } else if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                        ime-ti.focus();
                                        root.rte-pointer("rdown", self.mouse-x, self.mouse-y, false);
                                    } else if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up {
                                        root.ctx("rte", "", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    } else if ev.kind == PointerEventKind.up {
                                        root.rte-pointer("up", self.mouse-x, self.mouse-y, false);
                                    }
                                }
                                moved => { if self.pressed { root.rte-pointer("drag", self.mouse-x, self.mouse-y, false); } }
                            }
                            for b in root.rte-back: Rectangle {
                                x: b.x; y: b.y; width: b.w; height: b.h;
                                background: RteColors.of(b.role, b.color);
                                border-width: b.border;
                                border-color: RteColors.of(b.border-role, b.border-color);
                                border-radius: b.radius;
                            }
                            for t in root.rte-texts: Text {
                                x: t.x; y: t.y; width: t.w; height: t.h;
                                text: t.text;
                                color: RteColors.of(t.role, t.color);
                                font-size: t.size;
                                font-weight: t.weight;
                                font-italic: t.italic;
                                font-family: t.font == 1 ? "Consolas" : t.font == 2 ? Theme.icons : "Segoe UI";
                                horizontal-alignment: t.right ? right : left;
                                vertical-alignment: top;
                                wrap: no-wrap;
                            }
                            for im in root.rte-imgs: Rectangle {
                                x: im.x; y: im.y; width: im.w; height: im.h;
                                background: Theme.chip;
                                border-radius: 4px;
                                Image { width: parent.width; height: parent.height; source: im.img; image-fit: fill; }
                                if im.img.width == 0: Text { text: "\u{1F5BC}  " + (im.label == "" ? "Image" : im.label); color: Theme.dim; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; overflow: elide; }
                                Rectangle { border-width: im.selected ? 2px : 0px; border-color: Theme.accent; border-radius: 4px; }
                                if im.selected && !root.rte-state.has-sel: RteHandle { x: -5px; y: -5px; corner: "nw"; ox: im.x - 5px; oy: im.y - 5px; ev(k, x, y) => { root.rte-pointer(k, x, y, false); } }
                                if im.selected && !root.rte-state.has-sel: RteHandle { x: parent.width - 5px; y: -5px; corner: "ne"; ox: im.x + im.w - 5px; oy: im.y - 5px; ev(k, x, y) => { root.rte-pointer(k, x, y, false); } }
                                if im.selected && !root.rte-state.has-sel: RteHandle { x: -5px; y: parent.height - 5px; corner: "sw"; ox: im.x - 5px; oy: im.y + im.h - 5px; ev(k, x, y) => { root.rte-pointer(k, x, y, false); } }
                                if im.selected && !root.rte-state.has-sel: RteHandle { x: parent.width - 5px; y: parent.height - 5px; corner: "se"; ox: im.x + im.w - 5px; oy: im.y + im.h - 5px; ev(k, x, y) => { root.rte-pointer(k, x, y, false); } }
                                if im.selected && !root.rte-state.has-sel && im.w > 70px: Rectangle {
                                    x: parent.width - self.width - 6px; y: 6px; height: 18px; width: szt.preferred-width + 10px;
                                    border-radius: 4px; background: #000000a0;
                                    szt := Text { text: round(im.w / 1px) + " \u{00D7} " + round(im.h / 1px); color: white; font-size: 10px; }
                                }
                            }
                            for b in root.rte-front: Rectangle {
                                x: b.x; y: b.y; width: b.w; height: b.h;
                                background: RteColors.of(b.role, b.color);
                                border-radius: b.radius;
                            }
                            if root.rte-empty: Text { x: 0px; y: 0px; text: "Write your message\u{2026}"; color: Theme.dim; font-size: root.rte-base-size; }
                            // caret
                            Rectangle {
                                visible: ime-ti.has-focus && root.rte-blink && !root.rte-state.has-sel && !root.ai-busy;
                                x: root.rte-caret-x; y: root.rte-caret-y;
                                width: 1.5px; height: root.rte-caret-h;
                                background: Theme.text;
                            }
                            // floating selection toolbar
                            if root.rte-state.has-sel && root.rte-sel-x >= 0 && !rte-ta.pressed && !root.rte-link-open && !root.c-plain: Rectangle {
                                x: max(0px, min(parent.width - self.width, root.rte-sel-x - self.width / 2));
                                y: root.rte-sel-y >= 44px ? root.rte-sel-y - 42px : root.rte-sel-y + root.rte-caret-h + 8px;
                                width: selb.preferred-width; height: Prefs.large-targets ? 44px : 36px;
                                border-radius: Theme.nordic ? self.height / 2 : 13px;
                                background: Theme.popup;
                                border-width: 1px; border-color: Theme.line;
                                drop-shadow-blur: 30px; drop-shadow-offset-y: 12px; drop-shadow-color: Theme.dark ? #000000c0 : #0000001f;
                                TouchArea { }
                                selb := HorizontalLayout {
                                    padding: 4px; spacing: 2px;
                                    padding-left: Theme.nordic ? 8px : 4px; padding-right: Theme.nordic ? 8px : 4px;
                                    FmtButton { label: "B"; bold: true; active: root.rte-state.bold; clicked => { cmp.fmt("bold"); } }
                                    FmtButton { label: "I"; italic: true; active: root.rte-state.italic; clicked => { cmp.fmt("italic"); } }
                                    FmtButton { label: "U"; underline: true; active: root.rte-state.underline; clicked => { cmp.fmt("underline"); } }
                                    FmtButton { label: "S"; strike: true; active: root.rte-state.strike; clicked => { cmp.fmt("strike"); } }
                                    FmtButton { glyph: "\u{E943}"; active: root.rte-state.code; clicked => { cmp.fmt("code-inline"); } }
                                    FmtButton { glyph: "\u{E7E6}"; active: root.rte-state.highlight; clicked => { cmp.fmt("highlight"); } }
                                    FmtButton { glyph: "\u{E71B}"; active: root.rte-state.link != ""; clicked => { cmp.fmt("link"); } }
                                    FmtButton { glyph: "\u{E894}"; clicked => { cmp.fmt("clear"); } }
                                    if !root.ai-hidden: Rectangle {
                                        width: rwl.preferred-width;
                                        border-radius: Theme.nordic ? self.height / 2 : 9px;
                                        background: rwa.has-hover ? Theme.hover : transparent;
                                        rwa := TouchArea { enabled: !root.ai-busy; clicked => { root.ai-compose("Improve"); } }
                                        rwl := HorizontalLayout {
                                            padding-left: 9px; padding-right: 9px; spacing: 5px;
                                            Text { text: root.ai-busy ? "Rewriting\u{2026}" : "Rewrite"; color: Theme.accent; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                            VerticalLayout { alignment: center; SIcon { commands: Icons.spark; size: 12px; weight: 2; tint: Theme.accent; } }
                                        }
                                    }
                                }
                            }
                            // link bubble when the caret is in a link
                            if root.rte-state.link != "" && !root.rte-state.has-sel && !root.rte-link-open && ime-ti.has-focus: Rectangle {
                                x: max(0px, min(parent.width - 330px, root.rte-caret-x - 20px));
                                y: root.rte-caret-y + root.rte-caret-h + 6px;
                                width: 330px; height: Prefs.large-targets ? 44px : 36px;
                                border-radius: Theme.nordic ? self.height / 2 : 13px;
                                background: Theme.popup;
                                border-width: 1px; border-color: Theme.line;
                                drop-shadow-blur: 30px; drop-shadow-offset-y: 12px; drop-shadow-color: Theme.dark ? #000000c0 : #0000001f;
                                TouchArea { }
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 4px; spacing: 2px;
                                    Text { text: root.rte-state.link; color: RteColors.of(6, #000); font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    VerticalLayout { alignment: center; FmtButton { glyph: "\u{E8A7}"; tip: "Open"; clicked => { root.rte-cmd("link-open"); } } }
                                    VerticalLayout { alignment: center; FmtButton { glyph: "\u{E70F}"; tip: "Edit"; clicked => { root.rte-cmd("link"); } } }
                                    VerticalLayout { alignment: center; FmtButton { glyph: "\u{E8C8}"; tip: "Copy"; clicked => { root.rte-link-url = root.rte-state.link; root.rte-cmd("copy-link"); } } }
                                    VerticalLayout { alignment: center; FmtButton { glyph: "\u{E711}"; tip: "Remove link"; clicked => { cmp.fmt("link-remove"); } } }
                                }
                            }
                            // link editor popover
                            if root.rte-link-open: Rectangle {
                                x: max(0px, min(parent.width - 360px, root.rte-caret-x - 20px));
                                y: root.rte-caret-y + root.rte-caret-h + 6px;
                                width: 380px; height: lkv.preferred-height;
                                border-radius: Theme.r-popup;
                                background: Theme.popup;
                                border-width: 1px; border-color: Theme.line;
                                drop-shadow-blur: 30px; drop-shadow-offset-y: 12px; drop-shadow-color: Theme.dark ? #000000c0 : #0000001f;
                                TouchArea { }
                                lkv := VerticalLayout {
                                    padding: 14px; spacing: 8px;
                                    HorizontalLayout { spacing: 8px;
                                        VerticalLayout { alignment: center; SIcon { commands: Icons.external; size: 14px; weight: 2; tint: Theme.accent; } }
                                        Text { text: "Link"; color: Theme.text; font-size: 14px; font-weight: 700; }
                                    }
                                    HorizontalLayout { spacing: 8px;
                                        Text { text: "Text"; color: Theme.dim; width: 40px; vertical-alignment: center; font-size: 12.5px; }
                                        link-text := LineEdit { text <=> root.rte-link-text; placeholder-text: "Link text"; accepted => { root.rte-cmd("link-apply"); cmp.focus-ed(); } }
                                    }
                                    HorizontalLayout { spacing: 8px;
                                        Text { text: "URL"; color: Theme.dim; width: 40px; vertical-alignment: center; font-size: 12.5px; }
                                        link-url := LineEdit { text <=> root.rte-link-url; placeholder-text: "https://"; init => { self.focus(); } accepted => { root.rte-cmd("link-apply"); cmp.focus-ed(); } }
                                    }
                                    // actions sit in the popover itself (Bulwark), not in a bar at the bottom of the composer
                                    HorizontalLayout { spacing: 6px; alignment: end; padding-top: 4px;
                                        Text { text: "Enter applies, Esc cancels"; color: Theme.faint; font-size: 11.5px; vertical-alignment: center; horizontal-stretch: 1; }
                                        VerticalLayout { alignment: center; ActionButton { label: "Remove"; clicked => { root.rte-cmd("link-remove"); cmp.focus-ed(); } } }
                                        VerticalLayout { alignment: center; ActionButton { label: "Cancel"; clicked => { root.rte-link-open = false; cmp.focus-ed(); } } }
                                        VerticalLayout { alignment: center; PrimaryButton { text: "Apply"; clicked => { root.rte-cmd("link-apply"); cmp.focus-ed(); } } }
                                    }
                                }
                            }
                        }
                    }
                    // attachment chips (BNCompose: tile-2, radius 13, type badge)
                    if root.c-attachments.length > 0: HorizontalLayout {
                        padding-left: Theme.nordic ? 28px : 24px;
                        padding-right: Theme.nordic ? 28px : 24px;
                        padding-bottom: 12px;
                        spacing: 8px;
                        alignment: start;
                        for a in root.c-attachments: Rectangle {
                            height: 34px;
                            width: cal.preferred-width;
                            border-radius: Theme.nordic ? self.height / 2 : 13px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: Theme.nordic ? transparent : Theme.tile2;
                            cal := HorizontalLayout {
                                padding-left: 12px; padding-right: 4px; spacing: 8px;
                                Text { text: a.ext; color: a.ext == "PDF" ? Theme.accent : (a.ext == "PNG" || a.ext == "JPG" || a.ext == "JPEG" || a.ext == "GIF" || a.ext == "WEBP") ? Theme.mint-fg : (a.ext == "DOC" || a.ext == "DOCX" || a.ext == "TXT" || a.ext == "ODT") ? Theme.sky-fg : Theme.amber-fg; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                                Text { text: a.name + " \u{00B7} " + a.size; color: Theme.text; font-size: 12.5px * Prefs.fs; vertical-alignment: center; max-width: 260px; overflow: elide; }
                                VerticalLayout { alignment: center; HoverAction { icon: Icons.close; clicked => { root.remove-attachment(a.index); } } }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    // bottom bar: line-icon actions, proofreading state, split Send
                    HorizontalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 6px;
                        VerticalLayout { alignment: center; BarButton { icon: Icons.clip; label: "Attach"; compact: cmp.tight; clicked => { attach-pop.show(); }
                            attach-pop := PopupWindow { y: -84px; width: 200px;
                                MenuPanel { VerticalLayout { padding: 4px;
                                    MenuItem { glyph: "\u{E8E5}"; text: "Attach files…"; clicked => { root.attach-file(); } }
                                    MenuItem { glyph: "\u{EB9F}"; text: "Insert image…"; clicked => { root.rte-cmd("image"); } }
                                } }
                            }
                        } }
                        VerticalLayout { alignment: center; BarButton { icon: Icons.tpl; label: "Templates"; compact: cmp.tight; clicked => { root.tpl-refresh(); tpl-pop.show(); }
                            tpl-pop := PopupWindow { y: -(max(1, root.tpl-names.length - 1) * 30px + 24px); width: 240px;
                                MenuPanel { VerticalLayout { padding: 4px;
                                    if root.tpl-names.length <= 1: MenuItem { text: "No templates yet"; enabled: false; }
                                    for t[i] in root.tpl-names: MenuItem {
                                        visible: i > 0;
                                        height: i > 0 ? 30px : 0px;
                                        text: t;
                                        clicked => { root.tpl-index = i; root.tpl-insert(i); }
                                    }
                                } }
                            }
                        } }
                        VerticalLayout { alignment: center; BarButton { icon: Icons.opt; label: "Options"; compact: cmp.tight; active: root.c-read-receipt || root.c-plain; clicked => { opt-pop.show(); }
                            opt-pop := PopupWindow { y: -84px; width: 230px;
                                MenuPanel { VerticalLayout { padding: 4px;
                                    MenuItem { text: "Request read receipt"; checkable: true; checked: root.c-read-receipt; clicked => { root.c-read-receipt = !root.c-read-receipt; } }
                                    MenuItem { text: "Plain text only"; checkable: true; checked: root.c-plain; clicked => { root.c-plain = !root.c-plain; if root.c-plain { root.rte-cmd("plain-mode"); } } }
                                } }
                            }
                        } }
                        VerticalLayout { alignment: center; BarButton { icon: Icons.tag; label: "Tags"; compact: cmp.tight; clicked => { tag-pop.show(); }
                            tag-pop := PopupWindow { y: -(root.tags.length * 30px + 24px); width: 180px;
                                MenuPanel { VerticalLayout { padding: 4px;
                                    for t[i] in root.tags: MenuItem {
                                        text: t.name; swatch: t.color; checkable: true;
                                        checked: i < root.c-tag-on.length && root.c-tag-on[i];
                                        clicked => { root.c-toggle-tag(i); }
                                    }
                                } }
                            }
                        } }
                        // the assistant's actions live in its panel beside the composer; this menu
                        // stays for narrow windows where the panel does not fit
                        if !root.ai-hidden && !root.chat-shown: VerticalLayout { alignment: center; BarButton { icon: Icons.spark; label: root.ai-busy ? "Thinking…" : "Assistant"; compact: cmp.tight; clicked => { ai-pop.show(); }
                            ai-pop := PopupWindow { y: -(8 * 30px + 1px + 24px); width: 200px;
                                MenuPanel { VerticalLayout { padding: 4px;
                                    for a in ["Improve", "Shorten", "Formal", "Casual", "Fix spelling", "Translate"]: MenuItem { text: a; enabled: !root.ai-busy; clicked => { root.ai-compose(a); } }
                                    MenuItem { glyph: "\u{E7A7}"; text: "Undo AI change"; enabled: root.can-undo && !root.ai-busy; clicked => { root.ai-undo(); } }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    MenuItem { glyph: "\u{E8BD}"; text: "Open AI chat"; clicked => { root.chat-open = true; root.c-ai-closed = false; } }
                                } }
                            }
                        } }
                        Rectangle { horizontal-stretch: 1; }
                        if cmp.roomy && (root.c-status == "" || root.c-status == "Draft saved" || root.c-status == "Saving…"): Text { text: "Proofreading off"; color: Theme.dim; font-size: 12px * Prefs.fs; vertical-alignment: center; overflow: elide; }
                        if root.c-status != "" && root.c-status != "Draft saved" && root.c-status != "Saving…": Text { text: root.c-status; color: Theme.accent; font-size: 12px * Prefs.fs; font-weight: 600; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
                        VerticalLayout { alignment: center; IconBtn { icon: Icons.trash; clicked => { root.discard-draft(); } } }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: sndl.preferred-width + 40px + 36px;
                                height: Prefs.large-targets ? 46px : 42px;
                                border-radius: Theme.nordic ? self.height / 2 : 15px;
                                clip: true;
                                background: root.sending ? Theme.accent.with-alpha(0.55) : Theme.accent;
                                HorizontalLayout {
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: sbt.pressed ? #00000026 : sbt.has-hover && !root.sending ? #ffffff1f : transparent;
                                        sbt := TouchArea { enabled: !root.sending; clicked => { root.send-now(); } }
                                        sndl := Text { text: root.sending ? "Sending…" : "Send"; color: Theme.on-accent; font-size: 14px * Prefs.fs; font-weight: 700; vertical-alignment: center; }
                                    }
                                    Rectangle { width: 1px; background: #00000033; }
                                    Rectangle {
                                        width: 36px;
                                        background: sct.pressed ? #00000026 : sct.has-hover ? #ffffff1f : transparent;
                                        sct := TouchArea { clicked => { send-pop.show(); } }
                                        SIcon { commands: Icons.chevron-down; size: 13px; weight: 2.2; tint: Theme.on-accent; }
                                    }
                                }
                                send-pop := PopupWindow { x: parent.width - 220px; y: -84px; width: 220px;
                                    MenuPanel { VerticalLayout { padding: 4px;
                                        MenuItem { glyph: "\u{E823}"; text: "Schedule send (soon)"; enabled: false; }
                                        MenuItem { glyph: "\u{E74E}"; text: "Save draft"; clicked => { root.save-draft(false); } }
                                    } }
                                }
                            }
                        }
                    }
                }
            }
            }
        }
        }

        // ---- context beside the content: the assistant when open, else the sender ----
        if root.chat-shown || root.sender-shown: Rectangle { width: Theme.nordic ? 1px : Theme.gap; background: Theme.nordic ? Theme.line : transparent; }
        Rectangle {
            width: root.chat-shown ? root.chat-w : 0px;
            // hidden it is 0px wide: its wrapped text must not set the window's minimum height
            min-height: 0px;
            visible: root.chat-shown;
            VerticalLayout {
                spacing: Theme.gap;
                // header: a rose tile (Bento, BNCompose assistant) / a plain heading (Nordic)
                Rectangle {
                    background: Theme.nordic ? transparent : Theme.more-contrast ? Theme.sel : Theme.rose-bg;
                    border-radius: Theme.nordic ? 0px : Theme.r-tile;
                    VerticalLayout {
                        padding-top: Theme.nordic ? 28px : 14px;
                        padding-bottom: Theme.nordic ? 12px : 14px;
                        padding-left: Theme.nordic ? 22px : 18px;
                        padding-right: Theme.nordic ? 14px : 10px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout { alignment: center; SIcon { commands: Icons.spark; size: 16px; weight: 1.9; tint: Theme.nordic || Theme.more-contrast ? Theme.accent : Theme.rose-fg; } }
                            Text { text: "Assistant"; color: Theme.nordic || Theme.more-contrast ? Theme.text : Theme.rose-fg; font-weight: Theme.nordic ? 800 : 700; font-size: (Theme.nordic ? 17px : 14px) * Prefs.fs; vertical-alignment: center; horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; ActionButton { label: "New chat"; icon: Icons.plus; icon-only: root.composing; clicked => { if !root.chat-busy { root.chat-new(); } } } }
                            VerticalLayout { alignment: center; IconBtn { icon: Icons.close; tint: Theme.nordic || Theme.more-contrast ? Theme.dim : Theme.rose-fg; clicked => { root.chat-open = false; if root.composing { root.c-ai-closed = true; } } } }
                        }
                        Text { text: root.composing ? "Works on the selection, or on the whole draft when nothing is selected." : "Ask about your mail, calendar and contacts, or have me act on them."; color: Theme.nordic || Theme.more-contrast ? Theme.dim : Theme.rose-fg; font-size: 12.5px * Prefs.fs; wrap: word-wrap; }
                    }
                }
                if root.composing: Rectangle {
                    background: Theme.nordic ? transparent : Theme.tile;
                    border-width: Theme.nordic ? 0px : 1px;
                    border-color: Theme.line;
                    border-radius: Theme.nordic ? 0px : Theme.r-tile;
                    VerticalLayout {
                        padding: 14px;
                        padding-left: Theme.nordic ? 22px : 14px;
                        padding-right: Theme.nordic ? 22px : 14px;
                        spacing: 8px;
                        for row in [[0, 1], [2, 3], [4, 5]]: HorizontalLayout {
                            spacing: 8px;
                            for i in row: Rectangle {
                                property <[string]> names: ["Improve", "Shorten", "Formal", "Casual", "Fix spelling", "Translate"];
                                property <[string]> hints: ["Clearer, same length", "About half as long", "For clients", "For colleagues", "Keeps your wording", "Into your language"];
                                width: (root.chat-w - (Theme.nordic ? 44px : 30px) - 8px) / 2;
                                height: Prefs.large-targets ? 64px : 58px;
                                border-radius: Theme.nordic ? 18px : 16px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: aita.pressed ? Theme.track : aita.has-hover ? Theme.hover : (Theme.nordic ? transparent : Theme.tile2);
                                opacity: root.ai-busy ? 0.55 : 1;
                                aita := TouchArea { enabled: !root.ai-busy; clicked => { root.ai-compose(names[i]); } }
                                VerticalLayout {
                                    padding-left: 12px;
                                    padding-right: 8px;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: names[i]; color: Theme.text; font-size: 13px * Prefs.fs; font-weight: 600; overflow: elide; }
                                    Text { text: hints[i]; color: Theme.dim; font-size: 11.5px * Prefs.fs; overflow: elide; }
                                }
                            }
                        }
                        // the real state of the last rewrite: working, its error, or undo
                        if root.ai-busy || root.can-undo: HorizontalLayout {
                            spacing: 8px;
                            Text { text: root.ai-busy ? "Rewriting the draft\u{2026}" : "Draft rewritten."; color: Theme.dim; font-size: 12px * Prefs.fs; vertical-alignment: center; horizontal-stretch: 1; }
                            if !root.ai-busy: ActionButton { label: "Undo"; icon: Icons.back; clicked => { root.ai-undo(); } }
                        }
                    }
                }
                if root.composing && Theme.nordic: Rectangle { height: 1px; background: Theme.line; }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.nordic ? transparent : Theme.tile;
                    border-width: Theme.nordic ? 0px : 1px;
                    border-color: Theme.line;
                    border-radius: Theme.nordic ? 0px : Theme.r-tile;
                    clip: true;
                    VerticalLayout {
                        padding: Theme.nordic ? 0px : 4px;
                        if root.chat.length == 0: VerticalLayout {
                            padding: Theme.nordic ? 22px : 12px;
                            spacing: 8px;
                            vertical-stretch: 1;
                            alignment: start;
                            for c in root.chips: Rectangle {
                                height: chl.preferred-height + 18px;
                                border-radius: Theme.nordic ? self.height / 2 : 14px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: chta.has-hover ? Theme.hover : Theme.nordic ? transparent : Theme.tile2;
                                chta := TouchArea { clicked => { root.chat-send(c); } }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    chl := Text { text: c; color: Theme.text; font-size: 13px * Prefs.fs; vertical-alignment: center; wrap: word-wrap; }
                                }
                            }
                        }
                        chat-list := ListView {
                            vertical-stretch: root.chat.length == 0 ? 0 : 1;
                            for m in root.chat: HorizontalLayout {
                                padding-top: m.role == "tool" ? 1px : 5px;
                                padding-bottom: m.role == "tool" ? 1px : 5px;
                                padding-left: m.role == "user" ? 40px : 10px;
                                padding-right: m.role == "user" ? 10px : 22px;
                                Rectangle {
                                    background: m.role == "user" ? Theme.sel : m.role == "assistant" ? Theme.tile2 : transparent;
                                    border-width: m.role == "assistant" ? 1px : 0px;
                                    border-color: Theme.line;
                                    border-top-left-radius: 16px;
                                    border-top-right-radius: 16px;
                                    border-bottom-left-radius: m.role == "user" ? 16px : 4px;
                                    border-bottom-right-radius: m.role == "user" ? 4px : 16px;
                                    VerticalLayout {
                                        padding: m.role == "tool" ? 2px : 10px;
                                        padding-left: m.role == "tool" ? 2px : 12px;
                                        padding-right: m.role == "tool" ? 2px : 12px;
                                        TextInput {
                                            text: m.text;
                                            read-only: true;
                                            wrap: word-wrap;
                                            single-line: false;
                                            color: m.role == "user" ? Theme.sel-text : m.role == "tool" ? Theme.faint : m.role == "error" ? Theme.rose-fg : Theme.body;
                                            font-size: m.role == "tool" ? 11px : 13px;
                                        }
                                    }
                                }
                            }
                        }
                        if root.confirm-text != "": Rectangle {
                            background: Theme.amber-bg;
                            border-radius: 16px;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text { text: "The assistant wants to:"; color: Theme.amber-fg; font-size: 11.5px; font-weight: 700; }
                                Text { text: root.confirm-text; color: Theme.text; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    ActionButton { label: "Deny"; clicked => { root.confirm-action(false); } }
                                    PrimaryButton { text: "Allow";  clicked => { root.confirm-action(true); } }
                                }
                            }
                        }
                        HorizontalLayout {
                            padding: Theme.nordic ? 14px : 8px;
                            padding-top: 8px;
                            spacing: 6px;
                            if root.chat-busy: Text { text: "Working…"; color: Theme.dim; vertical-alignment: center; horizontal-stretch: 1; }
                            if root.chat-busy: ActionButton { label: "Stop"; clicked => { root.chat-stop(); } }
                            if !root.chat-busy: Rectangle {
                                height: 40px;
                                horizontal-stretch: 1;
                                border-radius: Theme.nordic ? 20px : 14px;
                                background: Theme.nordic ? transparent : Theme.tile2;
                                border-width: chi.has-focus ? max(1px, Prefs.focus-ring) : 1px;
                                border-color: chi.has-focus ? Theme.ring : Theme.line;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 4px;
                                    spacing: 6px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        if root.chat-input == "": Text { x: 0; width: parent.width; height: parent.height; text: "Ask anything — / for saved prompts"; color: Theme.faint; font-size: 13px * Prefs.fs; vertical-alignment: center; overflow: elide; }
                                        chi := TextInput {
                                            y: (parent.height - self.height) / 2;
                                            width: parent.width;
                                            text <=> root.chat-input;
                                            color: Theme.text;
                                            font-size: 13px * Prefs.fs;
                                            single-line: true;
                                            accepted => { root.chat-send(self.text); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 32px; height: 32px;
                                            border-radius: Theme.round(32px);
                                            background: csa.has-hover ? Theme.accent.brighter(0.1) : Theme.accent;
                                            csa := TouchArea { clicked => { root.chat-send(root.chat-input); } }
                                            SIcon { commands: Icons.send; size: 15px; weight: 2; tint: Theme.on-accent; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // the sender: avatar, name, organisation, address, then recent mail, files and the next event
        if root.sender-shown: Rectangle {
            width: root.ctx-w;
            background: Theme.nordic ? transparent : Theme.tile;
            border-width: Theme.nordic ? 0px : 1px;
            border-color: Theme.line;
            border-radius: Theme.nordic ? 0px : Theme.r-pane;
            clip: true;
            Flickable {
                content-height: max(self.height, sx.preferred-height);
                sx := VerticalLayout {
                    alignment: start;
                    padding-top: Theme.nordic ? 30px : 22px;
                    padding-bottom: Theme.nordic ? 30px : 22px;
                    padding-left: Theme.nordic ? 22px : 18px;
                    padding-right: Theme.nordic ? 22px : 18px;
                    spacing: Theme.nordic ? 16px : 14px;
                    HorizontalLayout {
                        alignment: start;
                        Avatar {
                            label: root.r-initials;
                            tint: root.r-color;
                            width: Theme.nordic ? 64px : 60px;
                            height: self.width;
                            border-radius: Theme.nordic ? self.height / 2 : 22px;
                            TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("addr", root.r-email, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                        }
                    }
                    VerticalLayout {
                        spacing: 1px;
                        Text { text: root.r-from; color: Theme.text; font-size: (Theme.nordic ? 17px : 16px) * Prefs.fs; font-weight: Theme.nordic ? 800 : 700; wrap: word-wrap; }
                        if root.sx-org != "": Text { text: root.sx-org; color: Theme.dim; font-size: (Theme.nordic ? 13px : 12.5px) * Prefs.fs; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        spacing: Theme.nordic ? 8px : 6px;
                        Text {
                            text: root.r-email;
                            color: Theme.body;
                            font-size: (Theme.nordic ? 13px : 12.5px) * Prefs.fs;
                            overflow: elide;
                            TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("addr", root.r-email, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                        }
                        if root.sx-phone != "": Text { text: root.sx-phone; color: Theme.body; font-size: (Theme.nordic ? 13px : 12.5px) * Prefs.fs; overflow: elide; }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: Prefs.large-targets ? 44px : 32px;
                            border-radius: Theme.nordic ? self.height / 2 : 11px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: mga.has-hover ? Theme.hover : Theme.nordic ? transparent : Theme.tile2;
                            mga := TouchArea { clicked => { root.compose-new(); root.c-to = root.r-email; } }
                            Text { text: "Message"; color: Theme.text; font-size: 12px * Prefs.fs; font-weight: 600; }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: Prefs.large-targets ? 44px : 32px;
                            border-radius: Theme.nordic ? self.height / 2 : 11px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: fma.has-hover ? Theme.hover : Theme.nordic ? transparent : Theme.tile2;
                            fma := TouchArea { clicked => { root.search = "from:" + root.r-email; root.do-search(root.search); } }
                            Text { text: "All mail"; color: Theme.text; font-size: 12px * Prefs.fs; font-weight: 600; }
                        }
                    }
                    if root.sx-recent.length > 0: Rectangle { height: 1px; background: Theme.line; }
                    if root.sx-recent.length > 0: Text { text: "Recent"; color: Theme.dim; font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs; font-weight: 700; }
                    if root.sx-recent.length > 0: VerticalLayout {
                        spacing: 2px;
                        for r in root.sx-recent: Rectangle {
                            height: srl.preferred-height + 8px;
                            border-radius: 8px;
                            background: rra.has-hover ? Theme.tile2 : transparent;
                            rra := TouchArea { clicked => { root.current-mail = r.tone; root.open-mail(r.tone); } mouse-cursor: pointer; }
                            srl := HorizontalLayout {
                                Text { text: r.label + " · " + r.value; color: Theme.body; font-size: (Theme.nordic ? 13px : 12.5px) * Prefs.fs; overflow: elide; vertical-alignment: center; }
                            }
                        }
                    }
                    if root.sx-files.length > 0: Rectangle { height: 1px; background: Theme.line; }
                    if root.sx-files.length > 0: Text { text: "Shared files"; color: Theme.dim; font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs; font-weight: 700; }
                    if root.sx-files.length > 0: VerticalLayout {
                        spacing: 6px;
                        for f in root.sx-files: Rectangle {
                            height: fl2.preferred-height + 16px;
                            border-radius: Theme.nordic ? self.height / 2 : 12px;
                            background: sfa.has-hover ? Theme.hover : Theme.tile2;
                            sfa := TouchArea { clicked => { root.current-mail = f.tone; root.open-mail(f.tone); } mouse-cursor: pointer; }
                            fl2 := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                Text { text: f.label; color: Theme.text; font-size: 12.5px * Prefs.fs; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: f.value; color: Theme.faint; font-size: 11px * Prefs.fs; vertical-alignment: center; }
                            }
                        }
                    }
                    if root.sx-next != "": Rectangle { height: 1px; background: Theme.line; }
                    if root.sx-next != "": Text { text: "Coming up"; color: Theme.dim; font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs; font-weight: 700; }
                    if root.sx-next != "": HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.sx-next; color: Theme.amber-fg; font-size: 13px * Prefs.fs; font-weight: 700; }
                        Text { text: root.sx-next-title; color: Theme.body; font-size: 13px * Prefs.fs; overflow: elide; horizontal-stretch: 1; }
                    }
                }
            }
        }
        }
        }
        }
      }
    }
  
    // ======== calendar (design/mockups BNCalendar / NordCalendar) ========
    // Bento: sidebar tiles (new event, mini month, calendars, tasks), summary tiles above the grid
    // tile, the event context panel as its own tile. Nordic: the sidebar sits on the ground; grid
    // and context share one rounded surface split by a hairline.
    if root.app == 1: Rectangle {
        x: Theme.shell-x;
        width: parent.width - Theme.shell-x;
        background: Theme.ground;
        HorizontalLayout {
            padding-top: Theme.pad;
            padding-bottom: Theme.pad;
            padding-right: Theme.nordic ? 14px : Theme.pad;
            spacing: Theme.gap;
            // ---- sidebar ----
            VerticalLayout {
                width: root.cal-side-w;
                padding-top: Theme.nordic ? 30px : 0px;
                padding-bottom: Theme.nordic ? 22px : 0px;
                padding-left: Theme.nordic ? 16px : 0px;
                padding-right: Theme.nordic ? 16px : 0px;
                spacing: Theme.nordic ? 18px : 12px;
                // New event: accent squircle (Bento) or pill (Nordic)
                Rectangle {
                    height: Prefs.large-targets ? 54px : (Theme.nordic ? 50px : 52px);
                    border-radius: Theme.nordic ? self.height / 2 : 20px;
                    background: neta.pressed ? Theme.accent.darker(0.12) : neta.has-hover ? Theme.accent.brighter(0.1) : Theme.accent;
                    accessible-role: button;
                    accessible-label: "New event";
                    accessible-action-default => { root.cal-edit("", "", -1); }
                    neta := TouchArea { clicked => { root.cal-edit("", "", -1); } }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        if Theme.bento: VerticalLayout { alignment: center; SIcon { commands: Icons.plus; size: 16px; weight: 2.2; tint: Theme.on-accent; } }
                        Text { text: "New event"; color: Theme.on-accent; font-weight: 700; font-size: 14.5px * Prefs.fs; vertical-alignment: center; }
                    }
                }
                // mini month
                Tile {
                    flat: Theme.nordic;
                    height: mml.preferred-height;
                    mml := VerticalLayout {
                        padding: Theme.nordic ? 0px : 14px;
                        spacing: 0px;
                        HorizontalLayout {
                            padding-left: Theme.nordic ? 6px : 0px;
                            padding-right: Theme.nordic ? 0px : 0px;
                            padding-bottom: Theme.nordic ? 6px : 4px;
                            spacing: 2px;
                            Text { text: root.mini-title; color: Theme.text; font-weight: 700; font-size: 14px * Prefs.fs; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            IconBtn { width: 26px; icon: "M15 18l-6-6 6-6"; icon-size: 14px; clicked => { root.cal-nav("mini-prev"); } }
                            IconBtn { width: 26px; icon: Icons.chevron-right; icon-size: 14px; clicked => { root.cal-nav("mini-next"); } }
                        }
                        HorizontalLayout {
                            if root.cal-show-weeknums: Rectangle { width: 22px; }
                            for d in root.cal-weekdays-short: Text {
                                text: d;
                                min-width: 0px;
                                preferred-width: 0px;
                                color: Theme.faint;
                                font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs;
                                horizontal-alignment: center;
                                height: Theme.nordic ? 26px : 24px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        mini := Rectangle {
                            property <length> wn-w: root.cal-show-weeknums ? 22px : 0px;
                            property <length> cw: (self.width - self.wn-w) / 7;
                            property <length> ch: Theme.nordic ? 28px : 26px;
                            height: 6 * self.ch;
                            if root.cal-show-weeknums: Rectangle {
                                x: 0; y: 0; width: 22px; height: parent.height;
                                for w[j] in root.cal-week-nums: Text { x: 0; y: j * mini.ch; width: 22px; height: mini.ch; text: w; color: Theme.faint; font-size: 9.5px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            for d[i] in root.mini-month: Rectangle {
                                x: mini.wn-w + mod(i, 7) * mini.cw;
                                y: floor(i / 7) * mini.ch;
                                width: mini.cw;
                                height: mini.ch;
                                Rectangle {
                                    x: 1px; y: 1px;
                                    width: parent.width - 2px; height: parent.height - 2px;
                                    border-radius: Theme.nordic ? 14px : 9px;
                                    background: d.today ? Theme.accent : d.selected ? (Theme.nordic ? Theme.sel : Theme.tile2) : mdta.has-hover ? Theme.hover : transparent;
                                }
                                Text {
                                    text: d.day;
                                    font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs;
                                    color: d.today ? Theme.on-accent : d.selected && Theme.nordic ? Theme.sel-text : d.selected ? Theme.text : (d.in-month ? Theme.body : Theme.faint);
                                    font-weight: d.today ? 800 : d.busy ? 700 : 400;
                                }
                                mdta := TouchArea { clicked => { root.cal-nav(d.date); } }
                            }
                        }
                    }
                }
                // calendars
                Tile {
                    flat: Theme.nordic;
                    height: cll.preferred-height;
                    cll := VerticalLayout {
                        padding: Theme.nordic ? 0px : 14px;
                        padding-left: Theme.nordic ? 6px : 14px;
                        padding-right: Theme.nordic ? 6px : 14px;
                        spacing: Theme.nordic ? 4px : 2px;
                        Text { text: "Calendars"; color: Theme.dim; font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs; font-weight: 700; height: 20px; vertical-alignment: center; }
                        for c in root.calendars: Rectangle {
                            height: Prefs.large-targets ? 36px : (Theme.nordic ? 28px : 26px);
                            border-radius: 8px;
                            background: CtxHl.id == "cal:" + c.id || ctta.has-hover ? Theme.hover : transparent;
                            accessible-role: checkbox;
                            accessible-checked: c.visible;
                            accessible-label: c.name;
                            accessible-action-default => { root.cal-toggle(c.id); }
                            ctta := TouchArea { clicked => { root.cal-toggle(c.id); } pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("cal", c.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                            HorizontalLayout {
                                spacing: Theme.nordic ? 12px : 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: Theme.nordic ? 12px : 14px; height: self.width;
                                        border-radius: Theme.nordic ? 6px : 5px;
                                        background: c.visible ? Theme.tint-fg(c.color) : transparent;
                                        border-width: c.visible ? 0px : 1.5px;
                                        border-color: Theme.tint-fg(c.color);
                                    }
                                }
                                Text { text: c.name; color: c.visible ? (Theme.nordic ? Theme.body : Theme.text) : Theme.faint; font-size: (Theme.nordic ? 14px : 13px) * Prefs.fs; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
                // tasks
                Tile {
                    flat: Theme.nordic;
                    vertical-stretch: 1;
                    min-height: 110px;
                    VerticalLayout {
                        padding: Theme.nordic ? 0px : 14px;
                        padding-left: Theme.nordic ? 6px : 14px;
                        padding-right: Theme.nordic ? 6px : 14px;
                        spacing: 6px;
                        Text {
                            property <int> open: root.cal-open-tasks;
                            text: "Tasks" + (open > 0 ? " · " + open + " open" : "");
                            color: Theme.dim; font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs; font-weight: 700;
                        }
                        Flickable {
                            vertical-stretch: 1;
                            content-height: tkl.preferred-height;
                            tkl := VerticalLayout {
                                width: parent.width;
                                spacing: 8px;
                                alignment: start;
                                for t in root.cal-tasks: Rectangle {
                                    height: tkr.preferred-height + 2px;
                                    border-radius: 8px;
                                    background: CtxHl.id == "task:" + t.id ? Theme.hover : transparent;
                                    TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("task", t.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                                    tkr := HorizontalLayout {
                                        spacing: 10px;
                                        VerticalLayout {
                                            padding-top: 1px;
                                            alignment: start;
                                            Rectangle {
                                                width: Prefs.large-targets ? 22px : 16px; height: self.width;
                                                border-radius: 6px;
                                                border-width: t.done ? 0px : 1.5px;
                                                border-color: tbta.has-hover ? Theme.accent : Theme.faint;
                                                background: t.done ? Theme.accent : transparent;
                                                accessible-role: checkbox;
                                                accessible-checked: t.done;
                                                accessible-label: t.title;
                                                accessible-action-default => { root.task-toggle(t.id); }
                                                tbta := TouchArea { clicked => { root.task-toggle(t.id); } }
                                                if t.done: SIcon { commands: Icons.check; size: 12px; weight: 2.6; tint: Theme.on-accent; }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 0px;
                                            Text { text: t.title; color: t.done ? Theme.faint : Theme.text; font-size: 13px * Prefs.fs; wrap: word-wrap; }
                                            if t.due != "" || t.done: Text { text: t.done ? "Done" : t.due; color: Theme.dim; font-size: 11.5px * Prefs.fs; }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: Prefs.large-targets ? 40px : 32px;
                            border-radius: Theme.nordic ? self.height / 2 : 12px;
                            background: Theme.tile2;
                            border-width: 1px;
                            border-color: tnew.has-focus ? Theme.accent : Theme.line;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                VerticalLayout { alignment: center; SIcon { commands: Icons.plus; size: 13px; weight: 2; tint: Theme.faint; } }
                                Rectangle {
                                    tnew := TextInput {
                                        width: parent.width;
                                        text <=> root.task-new;
                                        color: Theme.text;
                                        font-size: 12.5px * Prefs.fs;
                                        vertical-alignment: center;
                                        single-line: true;
                                        accepted => { root.task-add(self.text, root.task-due); root.task-new = ""; root.task-due = ""; }
                                    }
                                    if root.task-new == "": Text { x: 0; width: parent.width; height: parent.height; text: "Add a task"; color: Theme.faint; font-size: 12.5px * Prefs.fs; vertical-alignment: center; }
                                }
                            }
                        }
                        if root.task-new != "": LineEdit { placeholder-text: "Due YYYY-MM-DD (optional)"; text <=> root.task-due; accepted(t) => { root.task-add(root.task-new, t); root.task-new = ""; root.task-due = ""; } }
                    }
                }
                if Theme.nordic && root.cal-side-line != "": Text {
                    x: 6px;
                    text: root.cal-side-line;
                    color: Theme.dim;
                    font-size: 13px * Prefs.fs;
                    wrap: word-wrap;
                }
            }

            // ---- summary tiles (Bento) over the grid; grid and context (one surface in Nordic) ----
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.gap;
                padding-top: Theme.nordic ? 14px : 0px;
                padding-bottom: Theme.nordic ? 14px : 0px;
                if Theme.bento: HorizontalLayout {
                    spacing: 12px;
                    height: max(78px, cst.preferred-height);
                    cst := SummaryTile { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                        label: root.cal-sum-next.label; value: root.cal-sum-next.value; sub: root.cal-sum-next.sub;
                        bg: Theme.rose-bg; fg: Theme.rose-fg;
                        clicked => { if root.cal-sum-next.id != "" { root.cal-select(root.cal-sum-next.id); } }
                    }
                    SummaryTile { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                        label: root.cal-sum-range.label; value: root.cal-sum-range.value; sub: root.cal-sum-range.sub;
                        bg: Theme.mint-bg; fg: Theme.mint-fg;
                    }
                    SummaryTile { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                        label: root.cal-sum-inv.label; value: root.cal-sum-inv.value; sub: root.cal-sum-inv.sub;
                        bg: Theme.amber-bg; fg: Theme.amber-fg;
                        clicked => { if root.cal-sum-inv.id != "" { root.cal-select(root.cal-sum-inv.id); } }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.tile;
                    border-width: 1px;
                    border-color: Theme.line;
                    border-radius: Theme.r-pane;
                    clip: true;
                    HorizontalLayout {
                        padding: 1px;
                        // ---- the grid ----
                        VerticalLayout {
                            horizontal-stretch: 1;
                            padding-top: Theme.nordic ? 25px : 15px;
                            padding-bottom: Theme.nordic ? 19px : 15px;
                            padding-left: Theme.nordic ? 27px : 19px;
                            padding-right: Theme.nordic ? 27px : 19px;
                            spacing: 0px;
                            // header: range title, today / prev / next, search, view switch
                            HorizontalLayout {
                                spacing: Theme.nordic ? 10px : 8px;
                                padding-bottom: Theme.nordic ? 18px : 10px;
                                Text {
                                    text: root.cal-title;
                                    color: Theme.text;
                                    font-size: (Theme.nordic ? (root.cal-tight ? 22px : 28px) : 21px) * Prefs.fs;
                                    font-weight: Theme.nordic ? 800 : 700;
                                    letter-spacing: Theme.nordic ? -0.5px : 0px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    min-width: 120px;
                                }
                                VerticalLayout { alignment: center; ActionButton { label: "Today"; clicked => { root.cal-nav("today"); } } }
                                VerticalLayout { alignment: center; IconBtn { icon: "M15 18l-6-6 6-6"; clicked => { root.cal-nav("prev"); } } }
                                VerticalLayout { alignment: center; IconBtn { icon: Icons.chevron-right; clicked => { root.cal-nav("next"); } } }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: root.cal-narrow || root.cal-tight ? 112px : 180px;
                                        height: Prefs.large-targets ? 40px : (Theme.nordic ? 36px : 32px);
                                        border-radius: Theme.nordic ? self.height / 2 : 12px;
                                        background: Theme.tile2;
                                        border-width: 1px;
                                        border-color: csq.has-focus ? Theme.accent : Theme.line;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            VerticalLayout { alignment: center; SIcon { commands: Icons.search; size: 14px; weight: 1.9; tint: Theme.faint; } }
                                            Rectangle {
                                                csq := TextInput {
                                                    width: parent.width;
                                                    color: Theme.text;
                                                    font-size: 12.5px * Prefs.fs;
                                                    vertical-alignment: center;
                                                    single-line: true;
                                                    edited => { root.cal-q = self.text; root.cal-search(self.text); }
                                                }
                                                if root.cal-q == "": Text { x: 0; width: parent.width; height: parent.height; text: "Search events"; color: Theme.faint; font-size: 12.5px * Prefs.fs; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout { alignment: center; Segmented { items: ["Day", "Week", "Month"]; current: root.cal-view; selected(i) => { root.cal-set-view(i); } } }
                            }

                            // ---- month ----
                            if root.cal-view == 2: VerticalLayout {
                                vertical-stretch: 1;
                                HorizontalLayout {
                                    height: 26px;
                                    if root.cal-show-weeknums: Rectangle { width: 28px; }
                                    for d in root.cal-weekdays: Text { text: d; color: Theme.dim; font-size: 12px * Prefs.fs; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                grid := Rectangle {
                                    vertical-stretch: 1;
                                    property <length> wn-w: root.cal-show-weeknums ? 28px : 0px;
                                    if root.cal-show-weeknums: Rectangle {
                                        x: 0; y: 0; width: 28px; height: grid.height;
                                        for w[j] in root.cal-week-nums: Text { x: 0; y: j * grid.height / 6 + 6px; width: 28px; text: w; color: Theme.faint; font-size: 10.5px; horizontal-alignment: center; }
                                    }
                                    for c[i] in root.cal-cells: Rectangle {
                                        x: grid.wn-w + mod(i, 7) * (grid.width - grid.wn-w) / 7;
                                        y: floor(i / 7) * grid.height / 6;
                                        width: (grid.width - grid.wn-w) / 7;
                                        height: grid.height / 6;
                                        background: mcta.has-hover ? Theme.hover.with-alpha(0.5) : transparent;
                                        // hairlines between days and weeks
                                        if floor(i / 7) > 0: Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: Theme.line; }
                                        if mod(i, 7) > 0: Rectangle { x: 0; y: 0; width: 1px; height: parent.height; background: Theme.line; }
                                        mcta := TouchArea {
                                            double-clicked => { root.cal-edit("", c.date, -1); }
                                            pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("slot", c.date, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                            scroll-event(ev) => {
                                                if !root.cal-free-scroll || ev.delta-y == 0 { return reject; }
                                                root.cal-nav(ev.delta-y < 0 ? "next" : "prev");
                                                accept
                                            }
                                        }
                                        VerticalLayout {
                                            padding: 4px;
                                            padding-top: 5px;
                                            spacing: 2px;
                                            alignment: start;
                                            HorizontalLayout {
                                                alignment: start;
                                                Rectangle {
                                                    width: 24px; height: 22px; border-radius: Theme.nordic ? 11px : 8px;
                                                    background: c.today ? Theme.accent : transparent;
                                                    Text { text: c.day; font-size: 11.5px * Prefs.fs; font-weight: c.today ? 800 : 600; color: c.today ? Theme.on-accent : (c.in-month ? Theme.body : Theme.faint); }
                                                }
                                            }
                                            for e in c.events: Rectangle {
                                                height: 19px;
                                                // calendarMonthTimedEvents: 0 bar (tint chip), 1 coloured text, 2 dot and text
                                                if e.style == 0: chip := CalChip {
                                                    e: e; compact: true; selected: root.cal-ctx-on && e.id == root.cal-sel.id;
                                                    clicked => { if root.cal-ctx-on { root.cal-select(e.id); } else { root.cal-edit(e.id, "", -1); } }
                                                    double-clicked => { root.cal-edit(e.id, "", -1); }
                                                    context(x, y) => { root.ctx("event", e.id, x, y); }
                                                    changed hovered => { root.cal-hover(e, self.hovered, self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
                                                }
                                                if e.style != 0: Rectangle {
                                                    border-radius: 6px;
                                                    background: cmeta.has-hover || (root.cal-ctx-on && e.id == root.cal-sel.id) ? Theme.hover : transparent;
                                                    opacity: e.past ? 0.6 : 1.0;
                                                    cmeta := TouchArea {
                                                        clicked => { if root.cal-ctx-on { root.cal-select(e.id); } else { root.cal-edit(e.id, "", -1); } }
                                                        double-clicked => { root.cal-edit(e.id, "", -1); }
                                                        pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("event", e.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                                        changed has-hover => { root.cal-hover(e, self.has-hover, self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 5px;
                                                        spacing: 5px;
                                                        if e.style == 2: VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: e.invite ? Theme.amber-fg : Theme.tint-fg(e.color); } }
                                                        Text {
                                                            text: (e.time != "" ? e.time + " " : "") + e.title;
                                                            color: e.style == 1 ? (e.invite ? Theme.amber-fg : Theme.tint-fg(e.color)) : Theme.body;
                                                            font-weight: e.style == 1 ? 700 : 400;
                                                            font-size: 10.5px * Prefs.fs; vertical-alignment: center; overflow: elide;
                                                        }
                                                    }
                                                }
                                            }
                                            if c.more != "": Text { x: 5px; text: c.more; color: Theme.dim; font-size: 10.5px * Prefs.fs; font-weight: 600; }
                                        }
                                    }
                                }
                            }

                            // ---- day / week ----
                            if root.cal-view != 2: VerticalLayout {
                                vertical-stretch: 1;
                                // day heads: "Mon 16" (Bento) or weekday over a big date, today in an accent circle (Nordic)
                                HorizontalLayout {
                                    padding-left: root.cal-gutter;
                                    padding-bottom: Theme.nordic ? 10px : 6px;
                                    for d in root.cal-days: VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        if Theme.bento: Text { text: d.date + " " + d.day; color: d.today ? Theme.accent : Theme.dim; font-size: 12px * Prefs.fs; font-weight: 600; horizontal-alignment: center; }
                                        if Theme.nordic: Text { text: d.date; color: Theme.dim; font-size: 12px * Prefs.fs; horizontal-alignment: center; }
                                        if Theme.nordic: HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 34px; height: 34px; border-radius: 17px;
                                                background: d.today ? Theme.accent : transparent;
                                                Text { text: d.day; color: d.today ? Theme.on-accent : Theme.text; font-size: 18px * Prefs.fs; font-weight: 700; }
                                            }
                                        }
                                        for e in d.events: HorizontalLayout {
                                            padding-left: 3px;
                                            padding-right: 3px;
                                            height: 22px;
                                            CalChip {
                                                e: e; compact: true; selected: root.cal-ctx-on && e.id == root.cal-sel.id;
                                                clicked => { if root.cal-ctx-on { root.cal-select(e.id); } else { root.cal-edit(e.id, "", -1); } }
                                                double-clicked => { root.cal-edit(e.id, "", -1); }
                                                context(x, y) => { root.ctx("event", e.id, x, y); }
                                            }
                                        }
                                    }
                                }
                                if Theme.bento: Rectangle { height: 1px; background: Theme.line; }
                                tg := Flickable {
                                    vertical-stretch: 1;
                                    property <length> hh-px: root.cal-hour-h;
                                    content-height: (root.cal-hour-to - root.cal-hour-from) * self.hh-px + 10px;
                                    Rectangle {
                                        y: 8px;
                                        height: (root.cal-hour-to - root.cal-hour-from) * tg.hh-px;
                                        width: tg.width;
                                        property <length> colw: (tg.width - root.cal-gutter) / max(1, root.cal-days.length);
                                        for hh in (root.cal-hour-to - root.cal-hour-from): Rectangle {
                                            property <int> h: hh + root.cal-hour-from;
                                            y: hh * tg.hh-px;
                                            height: tg.hh-px;
                                            // hairline: under the label too in Bento, from the gutter in Nordic
                                            Rectangle { x: Theme.nordic ? root.cal-gutter : 0px; y: 0; height: 1px; width: parent.width - self.x; background: Theme.line; }
                                            Rectangle {
                                                x: 0; y: -8px; height: 16px;
                                                width: hlab.preferred-width + 6px;
                                                background: Theme.tile;
                                                hlab := Text {
                                                    x: 0;
                                                    text: Prefs.cal-h12 ? (Math.mod(h, 12) == 0 ? 12 : Math.mod(h, 12)) + ":00 " + (h < 12 ? "AM" : "PM") : (h < 10 ? "0" : "") + h + ":00";
                                                    color: Theme.faint;
                                                    font-size: (Theme.nordic ? 11.5px : 11px) * Prefs.fs;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                x: root.cal-gutter;
                                                width: parent.width - root.cal-gutter;
                                                double-clicked => { root.cal-edit("", "", h); }
                                                pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("slot", "@" + h, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                            }
                                        }
                                        for e in root.cal-events: CalChip {
                                            property <length> inset: Theme.nordic ? 4px : 3px;
                                            x: root.cal-gutter + e.col * parent.colw + e.lane * (parent.colw / e.lanes) + self.inset;
                                            y: e.top * tg.hh-px / 56 + 2px;
                                            width: parent.colw / e.lanes - 2 * self.inset;
                                            height: max(e.height * tg.hh-px / 56 - 4px, 18px);
                                            e: e;
                                            selected: root.cal-ctx-on && e.id == root.cal-sel.id;
                                            clicked => { if root.cal-ctx-on { root.cal-select(e.id); } else { root.cal-edit(e.id, "", -1); } }
                                            double-clicked => { root.cal-edit(e.id, "", -1); }
                                            context(x, y) => { root.ctx("event", e.id, x, y); }
                                            changed hovered => { root.cal-hover(e, self.hovered, self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
                                        }
                                        // now: a 2px accent line across the days shown, a dot on today's column (Bento)
                                        for d[i] in root.cal-days: Rectangle {
                                            visible: d.today && root.now-minutes >= root.cal-hour-from * 60 && root.now-minutes <= root.cal-hour-to * 60;
                                            x: root.cal-gutter - 5px;
                                            y: (root.now-minutes - root.cal-hour-from * 60) * tg.hh-px / 60 - 5px;
                                            width: parent.width - root.cal-gutter + 5px;
                                            height: 10px;
                                            Rectangle { x: 5px; y: 4px; width: parent.width - 5px; height: 2px; background: Theme.accent; }
                                            if Theme.bento: Rectangle { x: i * (tg.width - root.cal-gutter) / max(1, root.cal-days.length); y: 0; width: 10px; height: 10px; border-radius: 5px; background: Theme.accent; }
                                        }
                                    }
                                    init => { self.content-y = -max(0, root.pref-day-start - root.cal-hour-from) * self.hh-px; }
                                }
                            }
                        }
                        // Nordic: the context panel inside the surface, after a hairline
                        if Theme.nordic && root.cal-ctx-on: Rectangle { width: 1px; background: Theme.line; }
                        if Theme.nordic && root.cal-ctx-on: CalContext {
                            width: 272px;
                            ev: root.cal-sel; has-ev: root.cal-has-sel; guests: root.cal-guests;
                            edit(id) => { root.cal-edit(id, "", -1); }
                            rsvp(s) => { root.cal-rsvp(s); }
                        }
                    }
                }
            }
            // Bento: the context panel as its own tile
            if Theme.bento && root.cal-ctx-on: Tile {
                width: 280px;
                border-radius: Theme.r-pane;
                clip: true;
                CalContext {
                    ev: root.cal-sel; has-ev: root.cal-has-sel; guests: root.cal-guests;
                    edit(id) => { root.cal-edit(id, "", -1); }
                    rsvp(s) => { root.cal-rsvp(s); }
                }
            }
        }
    }

    // ======== contacts (design/mockups BNContacts) ========
    // Bento: sidebar tiles (books, groups as tint tiles, categories as chips), the people list
    // tile, then a header tile and a grid of detail tiles. Nordic: sidebar on the ground; list
    // and detail share one rounded surface; the detail has a context column (next event,
    // recent mail, shared files) behind a hairline.
    if root.app == 2: Rectangle {
        x: Theme.shell-x;
        width: parent.width - Theme.shell-x;
        background: Theme.ground;
        HorizontalLayout {
            padding-top: Theme.pad;
            padding-bottom: Theme.pad;
            padding-right: Theme.pad;
            spacing: Theme.gap;
            // ---- sidebar: new contact, address books, groups, categories ----
            VerticalLayout {
                width: Theme.nordic ? 228px : 220px;
                padding-top: Theme.nordic ? 30px : 0px;
                padding-left: Theme.nordic ? 14px : 0px;
                padding-right: Theme.nordic ? 14px : 0px;
                padding-bottom: Theme.nordic ? 22px : 0px;
                spacing: Theme.nordic ? 22px : 12px;
                PeopleCta { text: "New contact"; icon: Icons.plus; clicked => { root.ct-new(); } }
                Flickable {
                    vertical-stretch: 1;
                    content-height: max(self.height, csb.preferred-height);
                    csb := VerticalLayout {
                        alignment: start;
                        spacing: Theme.nordic ? 18px : 12px;
                        // address books (and everyone)
                        Tile {
                            flat: Theme.nordic;
                            VerticalLayout {
                                padding: Theme.nordic ? 0px : 10px;
                                spacing: 0px;
                                for n in root.ct-nav: VerticalLayout {
                                    padding-top: n.kind == "book" ? (Theme.nordic ? 4px : 2px) : 0px;
                                    if n.kind == "all" || n.kind == "book": PeopleNav {
                                        property <string> key: n.kind == "all" ? "" : n.kind + ":" + n.id;
                                        label: n.label;
                                        count: n.count;
                                        selected: root.ct-filter == key && root.ct-group == "";
                                        hl-id: "ctnav:" + n.kind + ":" + n.id;
                                        clicked => { root.ct-nav-select(n.kind, n.id); }
                                        context(x, y) => { if n.kind == "book" { root.ctx("ctnav", n.kind + ":" + n.id, x, y); } }
                                    }
                                }
                            }
                        }
                        // groups: tint tiles (Bento) or dot rows (Nordic)
                        Tile {
                            flat: Theme.nordic;
                            VerticalLayout {
                                padding: Theme.nordic ? 0px : 12px;
                                spacing: 0px;
                                HorizontalLayout {
                                    padding-left: Theme.nordic ? 16px : 0px;
                                    padding-right: Theme.nordic ? 8px : 0px;
                                    padding-bottom: Theme.nordic ? 2px : 6px;
                                    Text { text: "Groups"; color: Theme.dim; font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                    IconBtn { icon: Icons.plus; icon-size: 13px; width: Prefs.large-targets ? 40px : 22px; tint: Theme.dim; clicked => { root.ct-new-group(); } }
                                }
                                for n in root.ct-nav: VerticalLayout {
                                    padding-top: n.kind == "group" && n.depth > 0 ? (Theme.nordic ? 2px : 8px) : 0px;
                                    if n.kind == "group": PeopleNav {
                                        property <int> k: mod(n.depth, 4);
                                        label: n.label;
                                        count: n.count;
                                        selected: root.ct-filter == "group:" + n.id;
                                        tinted: Theme.bento;
                                        tint-bg: k == 0 ? Theme.rose-bg : k == 1 ? Theme.amber-bg : k == 2 ? Theme.mint-bg : Theme.sky-bg;
                                        tint-fg: k == 0 ? Theme.rose-fg : k == 1 ? Theme.amber-fg : k == 2 ? Theme.mint-fg : Theme.sky-fg;
                                        dotted: Theme.nordic;
                                        dot: self.tint-fg;
                                        hl-id: "ctnav:group:" + n.id;
                                        clicked => { root.ct-nav-select(n.kind, n.id); }
                                        context(x, y) => { root.ctx("ctnav", "group:" + n.id, x, y); }
                                    }
                                    if n.kind == "section" && n.id == "groups": HorizontalLayout {
                                        padding-left: Theme.nordic ? 16px : 0px;
                                        Text { text: "No groups yet"; color: Theme.faint; font-size: 12.5px * Prefs.fs; }
                                    }
                                }
                            }
                        }
                        // categories: a two-column chip grid (Bento) or dot rows (Nordic)
                        Tile {
                            flat: Theme.nordic;
                            VerticalLayout {
                                padding: Theme.nordic ? 0px : 12px;
                                spacing: Theme.nordic ? 2px : 8px;
                                HorizontalLayout { padding-left: Theme.nordic ? 16px : 0px; Text { text: "Categories"; color: Theme.dim; font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs; font-weight: 700; height: 22px; vertical-alignment: center; } }
                                if Theme.bento: Rectangle {
                                    property <length> cw: (self.width - 6px) / 2;
                                    property <length> ch: (Prefs.large-targets ? 40px : 28px) * Prefs.fs;
                                    height: ceil(root.ct-cats / 2) * (self.ch + 6px) - 6px;
                                    for n in root.ct-nav: Rectangle {
                                        property <string> key: n.kind == "uncat" ? "uncat" : "kw:" + n.id;
                                        property <bool> on: root.ct-filter == key;
                                        property <bool> hl: CtxHl.id == "ctnav:" + n.kind + ":" + n.id;
                                        visible: n.kind == "keyword" || n.kind == "uncat";
                                        x: mod(n.depth, 2) * (parent.cw + 6px);
                                        y: floor(n.depth / 2) * (parent.ch + 6px);
                                        // a lone last chip on its row takes the full width
                                        width: mod(root.ct-cats, 2) == 1 && n.depth == root.ct-cats - 1 ? parent.width : parent.cw;
                                        height: parent.ch;
                                        border-radius: self.height / 2;
                                        border-width: on ? 0px : 1px;
                                        border-color: hl ? Theme.accent : Theme.line;
                                        background: on ? Theme.sel : cca.has-hover ? Theme.hover : Theme.tile2;
                                        accessible-role: button;
                                        accessible-label: n.label;
                                        accessible-action-default => { root.ct-nav-select(n.kind, n.id); }
                                        cca := TouchArea {
                                            clicked => { root.ct-nav-select(n.kind, n.id); }
                                            pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up && n.kind == "keyword" { root.ctx("ctnav", "keyword:" + n.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                        }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 3px; background: n.kind == "uncat" ? Theme.track : Theme.faint; } }
                                            Text { text: n.label; color: on ? Theme.sel-text : Theme.body; font-size: 12px * Prefs.fs; font-weight: on ? 600 : 400; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: n.count; color: on ? Theme.sel-text : Theme.faint; font-size: 11px * Prefs.fs; vertical-alignment: center; }
                                        }
                                    }
                                }
                                if Theme.nordic: VerticalLayout {
                                    spacing: 0px;
                                    for n in root.ct-nav: VerticalLayout {
                                        padding-top: (n.kind == "keyword" || n.kind == "uncat") && n.depth > 0 ? 2px : 0px;
                                        if n.kind == "keyword" || n.kind == "uncat": PeopleNav {
                                            property <string> key: n.kind == "uncat" ? "uncat" : "kw:" + n.id;
                                            label: n.label;
                                            count: n.count;
                                            selected: root.ct-filter == key;
                                            dotted: true;
                                            dot: n.kind == "uncat" ? Theme.track : Theme.faint;
                                            hl-id: "ctnav:" + n.kind + ":" + n.id;
                                            clicked => { root.ct-nav-select(n.kind, n.id); }
                                            context(x, y) => { if n.kind == "keyword" { root.ctx("ctnav", "keyword:" + n.id, x, y); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ---- people list and detail: tiles (Bento) or one surface (Nordic) ----
            HorizontalLayout {
                padding: Theme.nordic ? 14px : 0px;
                padding-left: 0px;
                horizontal-stretch: 1;
            Rectangle {
                background: Theme.nordic ? Theme.tile : transparent;
                border-width: Theme.nordic ? 1px : 0px;
                border-color: Theme.line;
                border-radius: Theme.nordic ? 28px : 0px;
                clip: Theme.nordic;
            HorizontalLayout {
                padding: Theme.nordic ? 1px : 0px;
                spacing: Theme.gap;
                // ---- the people list ----
                Rectangle {
                    width: Theme.nordic ? 340px : 330px;
                    background: Theme.nordic ? transparent : Theme.tile;
                    border-width: Theme.nordic ? 0px : 1px;
                    border-color: Theme.line;
                    border-radius: Theme.nordic ? 0px : Theme.r-pane;
                    clip: true;
                    VerticalLayout {
                        padding-top: Theme.nordic ? 28px : 18px;
                        padding-left: Theme.nordic ? 14px : 10px;
                        padding-right: Theme.nordic ? 14px : 10px;
                        spacing: 0px;
                        HorizontalLayout {
                            padding-left: Theme.nordic ? 14px : 12px;
                            padding-right: 12px;
                            padding-bottom: Theme.nordic ? 14px : 10px;
                            Text { text: "Contacts"; color: Theme.text; font-size: (Theme.nordic ? 28px : 24px) * Prefs.fs; font-weight: Theme.nordic ? 800 : 700; letter-spacing: Theme.nordic ? -0.56px : -0.3px; horizontal-stretch: 1; vertical-alignment: bottom; }
                            VerticalLayout { alignment: end; padding-bottom: (Theme.nordic ? 5px : 4px) * Prefs.fs; Text { text: root.contacts.length; color: Theme.dim; font-size: 12px * Prefs.fs; } }
                        }
                        // search: tile-2 field (Bento), hairline pill (Nordic)
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            padding-bottom: 8px;
                            Rectangle {
                                height: Prefs.large-targets ? 44px : 38px;
                                border-radius: Theme.nordic ? self.height / 2 : 14px;
                                background: Theme.nordic ? transparent : Theme.tile2;
                                border-width: csi.has-focus ? max(1.5px, Prefs.focus-ring) : 1px;
                                border-color: csi.has-focus ? Theme.ring : Theme.line;
                                HorizontalLayout {
                                    padding-left: Theme.nordic ? 16px : 12px;
                                    padding-right: 6px;
                                    spacing: 8px;
                                    VerticalLayout { alignment: center; SIcon { commands: Icons.search; size: 15px; weight: 2; tint: Theme.dim; } }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        if root.ct-q == "": Text { x: 0; width: parent.width; height: parent.height; text: "Search people"; color: Theme.faint; font-size: 13px * Prefs.fs; vertical-alignment: center; }
                                        csi := TextInput {
                                            y: (parent.height - self.height) / 2;
                                            width: parent.width;
                                            text <=> root.ct-q;
                                            color: Theme.text;
                                            font-size: 13px * Prefs.fs;
                                            single-line: true;
                                            selection-background-color: Theme.sel;
                                            selection-foreground-color: Theme.sel-text;
                                            accessible-label: "Search contacts";
                                            edited => { root.ct-search(self.text); }
                                        }
                                    }
                                    if root.ct-q != "": VerticalLayout { alignment: center; IconBtn { icon: Icons.close; icon-size: 12px; width: Prefs.large-targets ? 40px : 24px; clicked => { root.ct-q = ""; root.ct-search(""); } } }
                                }
                            }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for c in root.contacts: VerticalLayout {
                                if c.header != "": Rectangle {
                                    height: 30px * Prefs.fs;
                                    Text { x: 14px; y: 10px * Prefs.fs; text: c.header; color: Theme.accent; font-weight: 800; font-size: 11.5px * Prefs.fs; }
                                }
                                HorizontalLayout {
                                    padding-left: Theme.nordic ? 0px : 2px;
                                    padding-right: Theme.nordic ? 0px : 2px;
                                    crow := Rectangle {
                                        property <bool> on: c.id == root.ct-id;
                                        height: (Prefs.large-targets ? 56px : 52px) * Prefs.fs;
                                        border-radius: Theme.nordic ? self.height / 2 : 16px;
                                        background: on ? Theme.sel : (cra.has-hover || CtxHl.id == "contact:" + c.id ? Theme.tile2 : transparent);
                                        accessible-role: list-item;
                                        accessible-label: c.name;
                                        accessible-action-default => { root.ct-group = ""; root.ct-select(c.id); }
                                        cra := TouchArea {
                                            clicked => { root.ct-group = ""; root.ct-select(c.id); }
                                            pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("contact", c.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                        }
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 11px;
                                            VerticalLayout { alignment: center; Avatar { label: c.initials; tint: c.color; width: 36px; height: 36px; } }
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: c.name; color: crow.on ? Theme.sel-text : Theme.text; font-size: 13.5px * Prefs.fs; font-weight: 600; overflow: elide; }
                                                Text { text: c.email; color: Theme.dim; font-size: 12px * Prefs.fs; overflow: elide; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.contacts.length == 0: Text {
                        y: 170px;
                        width: parent.width;
                        horizontal-alignment: center;
                        text: root.ct-q != "" ? "No one matches “" + root.ct-q + "”" : "No contacts here";
                        color: Theme.dim;
                        font-size: 13px * Prefs.fs;
                    }
                }
                if Theme.nordic: Rectangle { width: 1px; background: Theme.line; }

                // ---- detail ----
                Rectangle {
                    horizontal-stretch: 1;
                    // nothing chosen
                    if root.ct-id == "" && root.ct-group == "" && !root.ct-editing: Tile {
                        flat: Theme.nordic;
                        border-radius: Theme.nordic ? 0px : Theme.r-pane;
                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    border-radius: Theme.round(self.height);
                                    background: Theme.tile2;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    SIcon { commands: Icons.users; size: 26px; weight: 1.6; tint: Theme.faint; }
                                }
                            }
                            Text { text: "Select a contact"; color: Theme.text; font-size: 15px * Prefs.fs; font-weight: 600; horizontal-alignment: center; }
                            Text { text: root.contacts.length + (root.contacts.length == 1 ? " person" : " people") + " in this view"; color: Theme.dim; font-size: 12.5px * Prefs.fs; horizontal-alignment: center; }
                        }
                    }

                    // a contact (Bento): header tile, then 3 x 2 detail tiles
                    if root.ct-id != "" && !root.ct-editing && Theme.bento: VerticalLayout {
                        spacing: Theme.gap;
                        Tile {
                            border-radius: Theme.r-pane;
                            vertical-stretch: 0;
                            HorizontalLayout {
                                padding-top: 24px;
                                padding-bottom: 24px;
                                padding-left: 26px;
                                padding-right: 26px;
                                spacing: 20px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 88px;
                                        height: 88px;
                                        border-radius: 30px;
                                        background: Theme.rose-bg;
                                        TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("contact", root.ct-id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                                        Text { text: root.ct-initials; color: Theme.rose-fg; font-size: 30px; font-weight: 800; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text { text: root.ct-name == "" ? "(no name)" : root.ct-name; color: Theme.text; font-size: 28px * Prefs.fs; font-weight: 800; letter-spacing: -0.56px; overflow: elide; }
                                    Text {
                                        text: root.ct-title != "" || root.ct-company != "" ? root.ct-title + (root.ct-title != "" && root.ct-company != "" ? " · " : "") + root.ct-company : root.ct-emails;
                                        color: Theme.dim;
                                        font-size: 14px * Prefs.fs;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        PeopleBtn { text: "Email"; primary: true; enabled: root.ct-emails != ""; clicked => { root.ct-email(); } }
                                        PeopleBtn { text: "Edit"; clicked => { root.ct-editing = true; } }
                                        PeopleBtn { text: "Delete"; clicked => { root.ct-delete(); } }
                                    }
                                }
                            }
                        }
                        ctg := VerticalLayout {
                            spacing: Theme.gap;
                            vertical-stretch: 1;
                            property <length> cw: (self.width - 2 * Theme.gap) / 3;
                            HorizontalLayout {
                                spacing: Theme.gap;
                                vertical-stretch: 1;
                                preferred-height: 200px;
                                // contact details
                                Tile {
                                    width: ctg.cw;
                                    clip: true;
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 0px;
                                        alignment: start;
                                        Text { text: "Contact"; color: Theme.dim; font-size: 11.5px * Prefs.fs; font-weight: 700; }
                                        Rectangle { height: 10px; }
                                        for f in [{l: "Email", v: root.ct-emails}, {l: "Phone", v: root.ct-phones}, {l: "Address", v: root.ct-address}, {l: "Birthday", v: root.ct-birthday}]: VerticalLayout {
                                            if f.v != "": Text { text: f.l; color: Theme.dim; font-size: 11.5px * Prefs.fs; }
                                            if f.v != "": Text { text: f.v; color: Theme.text; font-size: 13.5px * Prefs.fs; wrap: word-wrap; }
                                            if f.v != "": Rectangle { height: 10px; }
                                        }
                                        if root.ct-emails == "" && root.ct-phones == "" && root.ct-address == "" && root.ct-birthday == "": Text { text: "No details yet"; color: Theme.faint; font-size: 13px * Prefs.fs; }
                                    }
                                }
                                // recent mail from them (two columns wide)
                                Tile {
                                    horizontal-stretch: 1;
                                    clip: true;
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "Recent mail"; color: Theme.dim; font-size: 11.5px * Prefs.fs; font-weight: 700; }
                                        for r in root.cx-recent: PeopleLine {
                                            label: r.label;
                                            value: r.value;
                                            clicked => { root.show-settings = false; root.app = 0; root.app-changed(0); root.current-mail = r.tone; root.open-mail(r.tone); }
                                        }
                                        if root.cx-recent.length == 0: Text { text: root.ct-emails == "" ? "No email address" : "No mail from this contact"; color: Theme.faint; font-size: 13px * Prefs.fs; }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.gap;
                                vertical-stretch: 1;
                                preferred-height: 200px;
                                // next event with them
                                nmt := Rectangle {
                                    width: ctg.cw;
                                    border-radius: Theme.r-tile;
                                    background: root.cx-next != "" ? Theme.amber-bg : Theme.tile;
                                    border-width: root.cx-next != "" ? 0px : 1px;
                                    border-color: Theme.line;
                                    clip: true;
                                    property <color> fg: root.cx-next != "" ? Theme.amber-fg : Theme.dim;
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 6px;
                                        Text { text: "Next meeting"; color: nmt.fg; font-size: 11.5px * Prefs.fs; font-weight: 700; }
                                        if root.cx-next != "": Text { text: root.cx-next-title; color: nmt.fg; font-size: 20px * Prefs.fs; font-weight: 800; wrap: word-wrap; }
                                        if root.cx-next != "": Text { text: root.cx-next; color: nmt.fg; font-size: 13px * Prefs.fs; }
                                        if root.cx-next == "": Text { text: "Nothing planned together"; color: Theme.faint; font-size: 13px * Prefs.fs; }
                                        Rectangle { vertical-stretch: 1; }
                                    }
                                }
                                // files they sent
                                Tile {
                                    width: ctg.cw;
                                    clip: true;
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "Shared files"; color: Theme.dim; font-size: 11.5px * Prefs.fs; font-weight: 700; }
                                        for r in root.cx-files: PeopleLine {
                                            label: r.label;
                                            clicked => { root.show-settings = false; root.app = 0; root.app-changed(0); root.current-mail = r.tone; root.open-mail(r.tone); }
                                        }
                                        if root.cx-files.length == 0: Text { text: "No attachments from them"; color: Theme.faint; font-size: 13px * Prefs.fs; }
                                    }
                                }
                                // notes
                                Tile {
                                    horizontal-stretch: 1;
                                    clip: true;
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "Notes"; color: Theme.dim; font-size: 11.5px * Prefs.fs; font-weight: 700; }
                                        Text { text: root.ct-notes == "" ? "No notes" : root.ct-notes; color: root.ct-notes == "" ? Theme.faint : Theme.body; font-size: 13.5px * Prefs.fs; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }

                    // a contact (Nordic): detail column and a context column split by a hairline
                    if root.ct-id != "" && !root.ct-editing && Theme.nordic: HorizontalLayout {
                        Flickable {
                            horizontal-stretch: 1;
                            content-height: max(self.height, ndl.preferred-height);
                            ndl := VerticalLayout {
                                alignment: start;
                                padding-top: 30px;
                                padding-bottom: 24px;
                                padding-left: 44px;
                                padding-right: 44px;
                                spacing: 0px;
                                HorizontalLayout {
                                    spacing: 20px;
                                    Avatar {
                                        label: root.ct-initials;
                                        tint: Theme.accent;
                                        width: 88px;
                                        height: 88px;
                                        background: Theme.sel;
                                        TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("contact", root.ct-id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: root.ct-name == "" ? "(no name)" : root.ct-name; color: Theme.text; font-size: 28px * Prefs.fs; font-weight: 800; letter-spacing: -0.56px; wrap: word-wrap; }
                                        if root.ct-title != "" || root.ct-company != "": Text { text: root.ct-title + (root.ct-title != "" && root.ct-company != "" ? " · " : "") + root.ct-company; color: Theme.dim; font-size: 14px * Prefs.fs; wrap: word-wrap; }
                                    }
                                }
                                Rectangle { height: 18px; }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    PeopleBtn { text: "Email"; primary: true; enabled: root.ct-emails != ""; clicked => { root.ct-email(); } }
                                    PeopleBtn { text: "Edit"; clicked => { root.ct-editing = true; } }
                                    PeopleBtn { text: "Delete"; clicked => { root.ct-delete(); } }
                                }
                                Rectangle { height: 18px; }
                                Rectangle { height: 1px; background: Theme.line; }
                                Rectangle { height: 18px; }
                                for f in [{l: "Email", v: root.ct-emails}, {l: "Phone", v: root.ct-phones}, {l: "Address", v: root.ct-address}, {l: "Birthday", v: root.ct-birthday}, {l: "Notes", v: root.ct-notes}]: VerticalLayout {
                                    if f.v != "": HorizontalLayout {
                                        spacing: 16px;
                                        padding-bottom: 14px;
                                        Text { text: f.l; color: Theme.dim; width: 96px; font-size: 13px * Prefs.fs; }
                                        Text { text: f.v; color: Theme.text; font-size: 14px * Prefs.fs; wrap: word-wrap; horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }
                        Rectangle { width: 1px; background: Theme.line; }
                        Flickable {
                            width: 260px;
                            content-height: max(self.height, nctx.preferred-height);
                            nctx := VerticalLayout {
                                alignment: start;
                                padding-top: 30px;
                                padding-bottom: 30px;
                                padding-left: 22px;
                                padding-right: 22px;
                                spacing: 10px;
                                Text { text: "Next meeting"; color: Theme.dim; font-size: 12px * Prefs.fs; font-weight: 700; }
                                if root.cx-next != "": VerticalLayout {
                                    spacing: 2px;
                                    Text { text: root.cx-next-title; color: Theme.text; font-size: 15px * Prefs.fs; font-weight: 700; wrap: word-wrap; }
                                    Text { text: root.cx-next; color: Theme.dim; font-size: 13px * Prefs.fs; }
                                }
                                if root.cx-next == "": Text { text: "Nothing planned together"; color: Theme.faint; font-size: 13px * Prefs.fs; }
                                Rectangle { height: 7px; Rectangle { y: 6px; height: 1px; background: Theme.line; } }
                                Text { text: "Recent mail"; color: Theme.dim; font-size: 12px * Prefs.fs; font-weight: 700; }
                                for r in root.cx-recent: PeopleLine {
                                    label: r.label;
                                    value: r.value;
                                    clicked => { root.show-settings = false; root.app = 0; root.app-changed(0); root.current-mail = r.tone; root.open-mail(r.tone); }
                                }
                                if root.cx-recent.length == 0: Text { text: root.ct-emails == "" ? "No email address" : "No mail from this contact"; color: Theme.faint; font-size: 13px * Prefs.fs; wrap: word-wrap; }
                                if root.cx-files.length > 0: Rectangle { height: 7px; Rectangle { y: 6px; height: 1px; background: Theme.line; } }
                                if root.cx-files.length > 0: Text { text: "Shared files"; color: Theme.dim; font-size: 12px * Prefs.fs; font-weight: 700; }
                                for r in root.cx-files: PeopleLine {
                                    label: r.label;
                                    icon: Icons.clip;
                                    clicked => { root.show-settings = false; root.app = 0; root.app-changed(0); root.current-mail = r.tone; root.open-mail(r.tone); }
                                }
                            }
                        }
                    }

                    // a group: name, member count, members
                    if root.ct-group != "" && root.ct-id == "" && !root.ct-editing: Tile {
                        flat: Theme.nordic;
                        border-radius: Theme.nordic ? 0px : Theme.r-pane;
                        Flickable {
                            content-height: max(self.height, gvl.preferred-height);
                            gvl := VerticalLayout {
                                alignment: start;
                                padding-top: Theme.nordic ? 30px : 24px;
                                padding-bottom: 24px;
                                padding-left: Theme.nordic ? 44px : 26px;
                                padding-right: Theme.nordic ? 44px : 26px;
                                spacing: 18px;
                                HorizontalLayout {
                                    spacing: 20px;
                                    Rectangle {
                                        width: 88px;
                                        height: 88px;
                                        border-radius: Theme.nordic ? self.height / 2 : 30px;
                                        background: Theme.nordic ? Theme.sel : Theme.mint-bg;
                                        SIcon { commands: Icons.users; size: 34px; weight: 1.6; tint: Theme.nordic ? Theme.sel-text : Theme.mint-fg; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text { text: root.ct-name; color: Theme.text; font-size: 28px * Prefs.fs; font-weight: 800; letter-spacing: -0.56px; overflow: elide; }
                                        Text { text: "Group"; color: Theme.dim; font-size: 14px * Prefs.fs; }
                                    }
                                    VerticalLayout { alignment: center; PeopleBtn { text: "Email group"; primary: true; enabled: root.ct-emails != ""; clicked => { root.ct-email(); } } }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                Text { text: "Members"; color: Theme.dim; font-size: 11.5px * Prefs.fs; font-weight: 700; }
                                Text { text: root.ct-notes == "" ? "No members" : root.ct-notes; color: root.ct-notes == "" ? Theme.faint : Theme.body; font-size: 14px * Prefs.fs; wrap: word-wrap; }
                            }
                        }
                    }

                    // the editor (new or existing contact)
                    if root.ct-editing: Tile {
                        flat: Theme.nordic;
                        border-radius: Theme.nordic ? 0px : Theme.r-pane;
                        Flickable {
                            content-height: max(self.height, edl.preferred-height);
                            edl := VerticalLayout {
                                alignment: start;
                                padding-top: Theme.nordic ? 30px : 24px;
                                padding-bottom: 24px;
                                padding-left: Theme.nordic ? 44px : 26px;
                                padding-right: Theme.nordic ? 44px : 26px;
                                spacing: 14px;
                                Text { text: root.ct-id == "" ? "New contact" : "Edit contact"; color: Theme.text; font-size: (Theme.nordic ? 28px : 24px) * Prefs.fs; font-weight: Theme.nordic ? 800 : 700; letter-spacing: -0.4px; }
                                PeopleField { label: "Full name"; placeholder: "Name"; text <=> root.ct-name; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    PeopleField { label: "Email"; placeholder: "Comma separated"; text <=> root.ct-emails; horizontal-stretch: 1; }
                                    PeopleField { label: "Phone"; placeholder: "Comma separated"; text <=> root.ct-phones; horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    PeopleField { label: "Company"; placeholder: "Organisation"; text <=> root.ct-company; }
                                    PeopleField { label: "Job title"; placeholder: "Title"; text <=> root.ct-title; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    PeopleField { label: "Address"; placeholder: "Street, city"; text <=> root.ct-address; horizontal-stretch: 2; }
                                    PeopleField { label: "Birthday"; placeholder: "YYYY-MM-DD"; text <=> root.ct-birthday; horizontal-stretch: 1; }
                                }
                                PeopleField { label: "Notes"; placeholder: "Anything worth remembering"; multi: true; text <=> root.ct-notes; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: root.ct-status; color: Theme.accent; font-size: 13px * Prefs.fs; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                    PeopleBtn { text: "Cancel"; clicked => { root.ct-editing = false; root.ct-select(root.ct-id); } }
                                    PeopleBtn { text: "Save"; primary: true; clicked => { root.ct-save(); } }
                                }
                            }
                        }
                    }
                }
            }
            }
            }
        }
    }

    // ======== files (no board of its own: derived from BNContacts + BNMail) ========
    // Bento: an Upload button and a places tile on the left, then the file list tile (title
    // with breadcrumbs, a toolbar, rows with squircle type tiles). Nordic: places on the ground,
    // the list in one rounded surface, pills and circles.
    if root.app == 3: fl-screen := Rectangle {
        x: Theme.shell-x;
        width: parent.width - Theme.shell-x;
        // the list tile width; columns and toolbar labels drop out as it narrows
        property <length> list-w: self.width - (Theme.nordic ? 228px : 220px) - Theme.gap - Theme.pad - (Theme.nordic ? 14px : 0px);
        property <bool> narrow: list-w < 820px;
        property <bool> tight: list-w < 640px;
        background: Theme.ground;
        HorizontalLayout {
            padding-top: Theme.pad;
            padding-bottom: Theme.pad;
            padding-right: Theme.pad;
            spacing: Theme.gap;
            // ---- sidebar: upload, then My files tree, Favorites, Recent, Shared with me, Trash ----
            VerticalLayout {
                width: Theme.nordic ? 228px : 220px;
                padding-top: Theme.nordic ? 30px : 0px;
                padding-left: Theme.nordic ? 14px : 0px;
                padding-right: Theme.nordic ? 14px : 0px;
                padding-bottom: Theme.nordic ? 22px : 0px;
                spacing: Theme.nordic ? 22px : 12px;
                PeopleCta {
                    text: "Upload";
                    icon: "M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M17 8l-5-5-5 5 M12 3v12";
                    enabled: !root.fl-in-trash;
                    clicked => { root.fl-upload(); }
                }
                Tile {
                    flat: Theme.nordic;
                    vertical-stretch: 1;
                    max-height: fsb.preferred-height;
                    visible: root.fl-nav.length > 0;
                    clip: true;
                    Flickable {
                        content-height: max(self.height, fsb.preferred-height);
                        fsb := VerticalLayout {
                            alignment: start;
                            padding: Theme.nordic ? 0px : 10px;
                            spacing: Theme.nordic ? 2px : 2px;
                            for n in root.fl-nav: VerticalLayout {
                                spacing: 2px;
                                if n.header != "": Rectangle {
                                    height: 34px * Prefs.fs;
                                    Text { x: Theme.nordic ? 6px : 1px; y: parent.height - self.height - 4px; text: n.header; color: Theme.dim; font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs; font-weight: 700; }
                                }
                                if n.kind == "trash": Rectangle { height: 9px; Rectangle { y: 4px; x: Theme.nordic ? 6px : 1px; width: parent.width - 2 * self.x; height: 1px; background: Theme.line; } }
                                FileNavRow {
                                    n: n;
                                    selected: (n.kind == "root" && root.fl-cwd == "") || (n.kind != "root" && n.id == root.fl-cwd);
                                    clicked => { if n.kind == "root" { root.fl-open(""); } else { root.fl-activate(n.id); } }
                                    chevron-clicked => { root.fl-toggle-folder(n.id); }
                                    context(x, y) => {
                                        if n.kind == "root" { root.fl-open(""); root.ctx("files-bg", "", x, y); }
                                        else if n.kind != "trash" { root.ctx(n.kind == "fav" ? "file-fav" : n.kind == "recent" ? "file-recent" : "file", n.id, x, y); }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }

            // ---- the file list ----
            HorizontalLayout {
                padding: Theme.nordic ? 14px : 0px;
                padding-left: 0px;
                horizontal-stretch: 1;
            Rectangle {
                background: Theme.tile;
                border-width: 1px;
                border-color: Theme.line;
                border-radius: Theme.r-pane;
                clip: true;
                VerticalLayout {
                    padding-top: Theme.nordic ? 28px : 20px;
                    spacing: 0px;
                    // title: breadcrumbs, item count
                    HorizontalLayout {
                        padding-left: Theme.nordic ? 32px : 22px;
                        padding-right: Theme.nordic ? 24px : 16px;
                        spacing: 6px;
                        if root.crumb-names.length == 0: Text { text: "My files"; color: Theme.text; font-size: (Theme.nordic ? 28px : 24px) * Prefs.fs; font-weight: Theme.nordic ? 800 : 700; letter-spacing: -0.4px; vertical-alignment: center; }
                        for n[i] in root.crumb-names: HorizontalLayout {
                            spacing: 6px;
                            if i > 0: VerticalLayout { alignment: center; SIcon { commands: Icons.chevron-right; size: 16px; weight: 2; tint: Theme.faint; } }
                            Text {
                                property <bool> last: i == root.crumb-names.length - 1;
                                text: n;
                                color: last ? Theme.text : (flcr.has-hover ? Theme.text : Theme.dim);
                                font-size: (last ? (Theme.nordic ? 28px : 24px) : (Theme.nordic ? 20px : 18px)) * Prefs.fs;
                                font-weight: last ? (Theme.nordic ? 800 : 700) : 600;
                                letter-spacing: last ? -0.4px : 0px;
                                vertical-alignment: center;
                                flcr := TouchArea { enabled: !parent.last; clicked => { root.fl-open(root.crumb-ids[i]); } mouse-cursor: pointer; }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.files.length + (root.files.length == 1 ? " item" : " items"); color: Theme.dim; font-size: 12px * Prefs.fs; vertical-alignment: center; }
                        VerticalLayout { alignment: center; IconBtn { icon: Icons.more; clicked => { root.ctx("files-bg", "", self.absolute-position.x + self.width - 260px, self.absolute-position.y + self.height + 4px); } } }
                    }
                    // toolbar: new folder, upload folder, upload; in the trash, empty it
                    HorizontalLayout {
                        padding-top: 14px;
                        padding-bottom: 12px;
                        padding-left: Theme.nordic ? 28px : 18px;
                        padding-right: Theme.nordic ? 24px : 16px;
                        spacing: 8px;
                        if !root.fl-in-trash: Rectangle {
                            min-width: 120px;
                            preferred-width: 220px;
                            max-width: 220px;
                            horizontal-stretch: 1;
                            height: Prefs.large-targets ? 44px : (Theme.nordic ? 38px : 34px);
                            border-radius: Theme.nordic ? self.height / 2 : 12px;
                            background: Theme.nordic ? transparent : Theme.tile2;
                            border-width: nfi.has-focus ? max(1.5px, Prefs.focus-ring) : 1px;
                            border-color: nfi.has-focus ? Theme.ring : Theme.line;
                            HorizontalLayout {
                                padding-left: Theme.nordic ? 14px : 11px;
                                padding-right: 10px;
                                spacing: 8px;
                                VerticalLayout { alignment: center; SIcon { commands: Icons.folder; size: 14px; weight: 1.9; tint: Theme.dim; } }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    if root.new-folder-name == "": Text { x: 0; width: parent.width; height: parent.height; text: "New folder name"; color: Theme.faint; font-size: 13px * Prefs.fs; vertical-alignment: center; }
                                    nfi := TextInput {
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        text <=> root.new-folder-name;
                                        color: Theme.text;
                                        font-size: 13px * Prefs.fs;
                                        single-line: true;
                                        selection-background-color: Theme.sel;
                                        selection-foreground-color: Theme.sel-text;
                                        accessible-label: "New folder name";
                                        accepted => { root.fl-new-folder(self.text); root.new-folder-name = ""; }
                                    }
                                }
                            }
                        }
                        if !root.fl-in-trash: ActionButton { icon: Icons.plus; label: "New folder"; clicked => { root.fl-new-folder(root.new-folder-name); root.new-folder-name = ""; } }
                        if !root.fl-in-trash && !fl-screen.tight: ActionButton { icon: Icons.folder; label: "Upload folder"; clicked => { root.fl-upload-folder(); } }
                        if root.fl-in-trash: Text { text: "Items in the trash can be restored to where they were."; color: Theme.dim; font-size: 12.5px * Prefs.fs; vertical-alignment: center; overflow: elide; }
                        Rectangle { horizontal-stretch: 1; }
                        if root.fl-in-trash && root.files.length > 0: ActionButton { icon: Icons.trash; label: "Empty trash"; clicked => { if root.files.length > 0 { root.ctx("files-empty", "", self.absolute-position.x - 140px, self.absolute-position.y + self.height + 4px); } } }
                        if !root.fl-in-trash: VerticalLayout { alignment: center; PrimaryButton { text: "Upload"; height: Prefs.large-targets ? 44px : (Theme.nordic ? 38px : 34px); clicked => { root.fl-upload(); } } }
                    }
                    // column heads
                    HorizontalLayout {
                        height: 30px * Prefs.fs;
                        // lines up with the rows: outer + row padding, type tile, gap / actions
                        padding-left: (Theme.nordic ? 16px : 8px) + 12px + 36px + 12px;
                        padding-right: (Theme.nordic ? 12px : 8px) + 12px + 3 * (Prefs.large-targets ? 32px : 24px) + 2 * 6px + 12px;
                        spacing: 12px;
                        Text { text: "Name"; color: Theme.dim; font-size: 11.5px * Prefs.fs; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        if !fl-screen.narrow: Text { text: "Size"; color: Theme.dim; font-size: 11.5px * Prefs.fs; font-weight: 700; vertical-alignment: center; width: 90px; }
                        if !fl-screen.tight: Text { text: root.fl-in-trash ? "Deleted" : "Modified"; color: Theme.dim; font-size: 11.5px * Prefs.fs; font-weight: 700; vertical-alignment: center; width: 140px; }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    Rectangle {
                        vertical-stretch: 1;
                        TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("files-bg", "", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                        ListView {
                            for f in root.files: HorizontalLayout {
                                padding-left: Theme.nordic ? 16px : 8px;
                                padding-right: Theme.nordic ? 12px : 8px;
                                padding-top: 2px;
                                Rectangle {
                                    height: (Prefs.large-targets ? 56px : 52px) * Prefs.fs;
                                    border-radius: Theme.nordic ? self.height / 2 : 16px;
                                    background: fra.has-hover || CtxHl.id == "file:" + f.id ? Theme.tile2 : transparent;
                                    border-width: CtxHl.id == "file:" + f.id ? 1px : 0px;
                                    border-color: Theme.accent;
                                    opacity: f.cut ? 0.5 : 1;
                                    accessible-role: list-item;
                                    accessible-label: f.name;
                                    accessible-action-default => { root.fl-activate(f.id); }
                                    fra := TouchArea {
                                        double-clicked => { root.fl-activate(f.id); }
                                        pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("file", f.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        // type tile: folders amber, files sky (squircle / circle)
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 36px;
                                                height: 36px;
                                                border-radius: Theme.round(self.height);
                                                background: f.folder ? Theme.amber-bg : Theme.sky-bg;
                                                SIcon { commands: f.folder ? Icons.folder : Icons.file; size: 17px; weight: 1.8; tint: f.folder ? Theme.amber-fg : Theme.sky-fg; }
                                            }
                                        }
                                        if !f.renaming: HorizontalLayout {
                                            horizontal-stretch: 1;
                                            alignment: start;
                                            spacing: 6px;
                                            Text { text: f.name; color: Theme.text; font-size: 13.5px * Prefs.fs; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                            if f.starred: VerticalLayout { alignment: center; SIcon { commands: Icons.star; size: 13px; weight: 1.8; tint: Theme.amber-fg; fill: Theme.amber-fg; } }
                                            if f.shared: VerticalLayout { alignment: center; SIcon { commands: Icons.users; size: 13px; weight: 1.9; tint: Theme.dim; } }
                                        }
                                        if f.renaming: VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Rectangle {
                                                height: 34px;
                                                border-radius: Theme.nordic ? self.height / 2 : 12px;
                                                background: Theme.tile2;
                                                border-width: 1.5px;
                                                border-color: Theme.ring;
                                                rfi := TextInput {
                                                    x: 12px;
                                                    y: (parent.height - self.height) / 2;
                                                    width: parent.width - 24px;
                                                    text: f.name;
                                                    color: Theme.text;
                                                    font-size: 13.5px * Prefs.fs;
                                                    single-line: true;
                                                    selection-background-color: Theme.sel;
                                                    selection-foreground-color: Theme.sel-text;
                                                    accessible-label: "New name";
                                                    init => { self.focus(); self.select-all(); }
                                                    accepted => { root.fl-rename(f.id, self.text); }
                                                }
                                            }
                                        }
                                        if !fl-screen.narrow: Text { text: f.size; color: Theme.dim; font-size: 12px * Prefs.fs; vertical-alignment: center; width: 90px; }
                                        if !fl-screen.tight: Text { text: f.modified; color: Theme.dim; font-size: 12px * Prefs.fs; vertical-alignment: center; width: 140px; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            if !f.trashed: VerticalLayout { alignment: center; HoverAction { icon: Icons.download; clicked => { root.fl-download(f.id); } } }
                                            if !f.trashed: VerticalLayout { alignment: center; HoverAction { icon: Icons.pen; clicked => { root.fl-start-rename(f.id); } } }
                                            // in the trash: restore, and delete for good
                                            if f.trashed: Rectangle { width: Prefs.large-targets ? 32px : 24px; }
                                            if f.trashed: VerticalLayout { alignment: center; HoverAction { icon: "M1 4v6h6 M3.51 15a9 9 0 1 0 2.13-9.36L1 10"; clicked => { root.fl-restore(f.id); } } }
                                            VerticalLayout { alignment: center; HoverAction { icon: Icons.trash; clicked => { root.fl-delete(f.id); } } }
                                        }
                                    }
                                }
                            }
                        }
                        if root.files.length == 0: VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    border-radius: Theme.round(self.height);
                                    background: Theme.tile2;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    SIcon { commands: root.fl-in-trash ? Icons.trash : Icons.folder; size: 26px; weight: 1.6; tint: Theme.faint; }
                                }
                            }
                            Text { text: root.fl-in-trash ? "The trash is empty" : "This folder is empty"; color: Theme.text; font-size: 15px * Prefs.fs; font-weight: 600; horizontal-alignment: center; }
                            if !root.fl-in-trash: Text { text: "Upload files or make a folder to start."; color: Theme.dim; font-size: 12.5px * Prefs.fs; horizontal-alignment: center; }
                        }
                    }
                }
            }
            }
        }
    }

    // ---- admin (BNDashboard): Server nav tile + content; Nordic: nav on the ground, content in one surface
    if root.app == 4: Rectangle {
        x: Theme.shell-x;
        width: parent.width - Theme.shell-x;
        background: Theme.ground;
        HorizontalLayout {
            padding-top: Theme.nordic ? 14px : Theme.pad;
            padding-bottom: Theme.nordic ? 14px : Theme.pad;
            padding-right: Theme.nordic ? 14px : Theme.pad;
            spacing: Theme.gap;
            Tile {
                flat: Theme.nordic;
                width: 210px;
                VerticalLayout {
                    padding-top: Theme.nordic ? 28px : 18px;
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-bottom: 14px;
                    spacing: 2px;
                    alignment: start;
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 14px;
                        Text { text: "Server"; color: Theme.text; font-size: (Theme.nordic ? 22px : 16px) * Prefs.fs; font-weight: 800; }
                        Text { text: root.server-host != "" ? root.server-host + " \u{B7} Stalwart" : "Stalwart administration"; color: Theme.dim; font-size: 12px * Prefs.fs; overflow: elide; }
                    }
                    for sec in [{id: "overview", l: "Dashboard"}, {id: "accounts", l: "Accounts"}, {id: "domains", l: "Domains"},
                                {id: "queue", l: "Queue"}, {id: "reports", l: "Reports"}, {id: "logs", l: "Logs"},
                                {id: "tasks", l: "Tasks"}, {id: "cluster", l: "Cluster"}, {id: "actions", l: "Actions"}]: Rectangle {
                        height: Prefs.large-targets ? 44px : (Theme.nordic ? 38px : 36px) * Prefs.fs;
                        border-radius: Theme.nordic ? self.height / 2 : 13px;
                        background: root.admin-section == sec.id ? Theme.sel : (asa.has-hover ? (Theme.nordic ? Theme.tile : Theme.tile2) : transparent);
                        accessible-role: button;
                        accessible-label: sec.l;
                        asa := TouchArea { clicked => { root.admin-section = sec.id; root.admin-sub = ""; root.admin-load(sec.id); } }
                        Text {
                            x: Theme.nordic ? 16px : 12px;
                            text: sec.l;
                            color: root.admin-section == sec.id ? Theme.sel-text : Theme.body;
                            font-size: 13.5px * Prefs.fs;
                            font-weight: root.admin-section == sec.id ? 600 : 400;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.nordic ? Theme.tile : transparent;
                border-width: Theme.nordic ? 1px : 0px;
                border-color: Theme.line;
                border-radius: Theme.nordic ? Theme.r-pane : 0px;
                clip: Theme.nordic;
            VerticalLayout {
                horizontal-stretch: 1;
                if root.admin-section == "overview": AdminDashboard {
                    vertical-stretch: 1;
                    dark: Theme.dark;
                    inset: Theme.nordic ? 18px : 0px;
                    rows: root.dash-rows;
                    status: root.dash-status;
                    tab <=> root.dash-tab;
                    range <=> root.dash-range;
                    load(t, r) => { root.admin-load("overview"); }
                }
                // list pages (Accounts, Domains, Queue, Reports, Logs, Tasks, Cluster, Actions): one tile
                if root.admin-section != "overview": Tile {
                    flat: Theme.nordic;
                    min-width: 500px;
                    vertical-stretch: 1;
                    clip: true;
                    VerticalLayout {
                        // header: section title, row count, status, refresh
                        HorizontalLayout {
                            padding-top: Theme.nordic ? 24px : 18px;
                            padding-left: Theme.nordic ? 28px : 20px;
                            padding-right: Theme.nordic ? 20px : 14px;
                            padding-bottom: 6px;
                            spacing: 10px;
                            height: (Theme.nordic ? 66px : 58px);
                            Text {
                                text: root.admin-section == "accounts" ? "Accounts" : root.admin-section == "domains" ? "Domains"
                                    : root.admin-section == "queue" ? "Delivery queue" : root.admin-section == "logs" ? "Logs"
                                    : root.admin-section == "tasks" ? "Tasks" : root.admin-section == "cluster" ? "Cluster" : root.admin-section == "actions" ? "Actions" : "Reports";
                                color: Theme.text;
                                font-size: (Theme.nordic ? 24px : 19px) * Prefs.fs;
                                font-weight: Theme.nordic ? 800 : 700;
                                letter-spacing: -0.3px;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: cnt.preferred-width + 16px; height: 22px; border-radius: 11px; background: Theme.tile2;
                                    border-width: 1px; border-color: Theme.line;
                                    cnt := Text { text: root.admin-rows.length; color: Theme.dim; font-size: 11.5px; font-weight: 600; }
                                }
                            }
                            Text { text: root.admin-status != "" || root.admin-subs.length > 0 ? root.admin-status : root.admin-note; color: root.admin-status == "Loading…" || root.admin-status == "" ? Theme.dim : Theme.accent; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; font-size: 12.5px * Prefs.fs; }
                            VerticalLayout { alignment: center; ActionButton { icon: Icons.refresh; label: "Refresh"; icon-only: !Prefs.toolbar-labels; clicked => { root.admin-load(root.admin-section); } } }
                        }
                        if root.admin-subs.length > 0: HorizontalLayout {
                            padding-left: Theme.nordic ? 24px : 16px;
                            padding-right: 16px;
                            padding-top: 6px;
                            padding-bottom: 10px;
                            spacing: 8px;
                            if root.admin-subs.length > 0: Rectangle {
                                width: subs.preferred-width;
                                height: 36px;
                                border-radius: Theme.nordic ? 18px : 14px;
                                background: Theme.tile2;
                                border-width: 1px;
                                border-color: Theme.line;
                                subs := HorizontalLayout {
                                    padding: 3px;
                                    spacing: 2px;
                                    for t in root.admin-subs: Rectangle {
                                        width: stt.preferred-width + 22px;
                                        border-radius: Theme.nordic ? self.height / 2 : 11px;
                                        background: root.admin-sub == t.id ? Theme.sel : (sta.has-hover ? Theme.hover : transparent);
                                        sta := TouchArea { clicked => { root.admin-sub = t.id; root.admin-load(root.admin-section); } }
                                        stt := Text { text: t.c1; color: root.admin-sub == t.id ? Theme.sel-text : Theme.dim; font-size: 12.5px * Prefs.fs; font-weight: 600; vertical-alignment: center; }
                                    }
                                }
                            }
                            Text { text: root.admin-note; color: Theme.dim; font-size: 12px * Prefs.fs; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                        // column heads: placed on the same grid as the cells (admin-cx / admin-cw)
                        Rectangle {
                            height: 34px;
                            for c[ci] in root.admin-cols: Text { x: root.admin-cx(ci, parent.width); width: root.admin-cw(parent.width) - 12px; height: parent.height; text: c; color: Theme.faint; font-size: 11.5px * Prefs.fs; font-weight: 700; letter-spacing: 0.3px; vertical-alignment: center; horizontal-alignment: left; overflow: elide; }
                            Rectangle { x: Theme.nordic ? 0px : 14px; width: parent.width - 2 * self.x; y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                        if root.admin-rows.length == 0 && root.admin-status == "": Text { text: "Nothing here."; color: Theme.dim; height: 80px; horizontal-alignment: center; vertical-alignment: center; }
                        ListView {
                            vertical-stretch: 1;
                            for r[i] in root.admin-rows: Rectangle {
                                height: (Prefs.large-targets ? 48px : 42px) * Prefs.fs;
                                Rectangle {
                                    x: Theme.nordic ? 0px : 8px;
                                    width: parent.width - 2 * self.x;
                                    border-radius: Theme.nordic ? 0px : 12px;
                                    background: ara.has-hover ? Theme.tile2 : transparent;
                                }
                                if Theme.nordic: Rectangle { x: 28px; width: parent.width - 56px; y: parent.height - 1px; height: 1px; background: Theme.line; }
                                ara := TouchArea { double-clicked => { if root.admin-section == "actions" { root.admin-action-open(r.id); } } }
                                property <length> cw: root.admin-cw(self.width) - 12px;
                                Text { x: root.admin-cx(0, parent.width); width: parent.cw; text: r.c1; color: Theme.text; font-size: 13px * Prefs.fs; font-weight: 600; overflow: elide; vertical-alignment: center; horizontal-alignment: left; }
                                Text { x: root.admin-cx(1, parent.width); width: parent.cw; text: r.c2; color: Theme.body; font-size: 13px * Prefs.fs; overflow: elide; vertical-alignment: center; horizontal-alignment: left; }
                                Text { x: root.admin-cx(2, parent.width); width: parent.cw; text: r.c3; color: r.c3 == "error" || r.c3 == "Failed" ? Theme.rose-fg : r.c3 == "warn" || r.c3 == "Stalled" ? Theme.amber-fg : Theme.dim; font-size: 13px * Prefs.fs; font-weight: r.c3 == "error" || r.c3 == "Failed" || r.c3 == "warn" || r.c3 == "Stalled" ? 600 : 400; overflow: elide; vertical-alignment: center; horizontal-alignment: left; }
                                // status as a tint chip (mint active, rose inactive, amber stale), flush with its head
                                property <int> st: r.c4 == "Active" ? 1 : r.c4 == "Inactive" ? 2 : r.c4 == "Stale" ? 3 : 0;
                                if st == 0: Text { x: root.admin-cx(3, parent.width); width: parent.cw; text: r.c4; color: Theme.dim; font-size: 13px * Prefs.fs; overflow: elide; vertical-alignment: center; horizontal-alignment: left; }
                                if st != 0: Rectangle {
                                    x: root.admin-cx(3, parent.width);
                                    width: min(parent.cw, stl.preferred-width + 18px);
                                    height: 22px;
                                    border-radius: 11px;
                                    background: st == 1 ? Theme.mint-bg : st == 2 ? Theme.rose-bg : Theme.amber-bg;
                                    stl := Text { text: r.c4; color: st == 1 ? Theme.mint-fg : st == 2 ? Theme.rose-fg : Theme.amber-fg; font-size: 11.5px * Prefs.fs; font-weight: 700; }
                                }
                                if root.admin-section == "queue": IconBtn { x: parent.width - (Theme.nordic ? 28px : 22px) - self.width; icon: Icons.trash; clicked => { root.admin-delete(r.id); } }
                                if root.admin-section == "actions": Rectangle {
                                    x: parent.width - (Theme.nordic ? 28px : 22px) - self.width;
                                    width: 74px; height: Prefs.large-targets ? 40px : 30px;
                                    border-radius: Theme.nordic ? self.height / 2 : 10px;
                                    background: rna.pressed ? Theme.track : rna.has-hover ? Theme.sel : Theme.tile2;
                                    border-width: 1px; border-color: rna.has-hover ? transparent : Theme.line;
                                    rna := TouchArea { clicked => { root.admin-action-open(r.id); } }
                                    Text { text: "Run\u{2026}"; color: rna.has-hover ? Theme.sel-text : Theme.text; font-size: 12.5px * Prefs.fs; font-weight: 600; }
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }

    // ---- admin action dialog: confirm / form / running / result (x:Action/set)
    if root.admin-dlg != "": Rectangle {
        background: #00000080;
        TouchArea { }
        Rectangle {
            width: min(560px, parent.width - 40px);
            height: min(adl.preferred-height, parent.height - 40px);
            background: Theme.popup;
            border-radius: Theme.nordic ? 28px : Theme.r-tile;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 30px;
            drop-shadow-color: #00000066;
            clip: true;
            adl := VerticalLayout {
                padding: Theme.nordic ? 28px : 22px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 40px; height: 40px;
                            border-radius: Theme.round(self.height);
                            background: root.admin-dlg == "result" ? Theme.mint-bg : Theme.amber-bg;
                            SIcon { commands: root.admin-dlg == "result" ? Icons.check : root.admin-dlg == "running" ? Icons.clock : Icons.shield; size: 19px; weight: 1.9; tint: root.admin-dlg == "result" ? Theme.mint-fg : Theme.amber-fg; }
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        Text { text: root.admin-dlg == "confirm" ? "Run this action?" : root.admin-dlg-title; color: Theme.text; font-size: 19px * Prefs.fs; font-weight: 700; wrap: word-wrap; }
                        if root.admin-dlg == "confirm": Text { text: root.admin-dlg-title; color: Theme.body; font-weight: 600; wrap: word-wrap; }
                    }
                }
                Text { text: root.admin-dlg == "running" ? "Executing " + root.admin-dlg-title + "\u{2026}" : root.admin-dlg-text; color: Theme.dim; wrap: word-wrap; font-size: 13.5px * Prefs.fs; }
                if root.admin-dlg == "form": ScrollView {
                    min-height: min(fl.preferred-height, 340px);
                    fl := VerticalLayout {
                        spacing: 10px;
                        for f in root.admin-dlg-fields: VerticalLayout {
                            spacing: 4px;
                            if f.c3 != "bool": Text { text: f.c1; color: Theme.dim; font-size: 12px * Prefs.fs; font-weight: 600; }
                            if f.c3 == "text" || f.c3 == "set": LineEdit { edited(t) => { root.admin-action-edit(f.id, t); } }
                            if f.c3 == "multiline": TextEdit { height: 110px; wrap: word-wrap; edited(t) => { root.admin-action-edit(f.id, t); } }
                            if f.c3 == "bool": CheckBox { text: f.c1; toggled => { root.admin-action-edit(f.id, self.checked ? "true" : "false"); } }
                        }
                    }
                }
                if root.admin-dlg == "result" && root.admin-dlg-result.length > 0: Rectangle {
                    background: Theme.tile2;
                    border-radius: Theme.nordic ? 18px : 16px;
                    border-width: 1px;
                    border-color: Theme.line;
                    min-height: min(rl.preferred-height + 20px, 380px);
                    ScrollView {
                        x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px;
                        rl := VerticalLayout {
                            spacing: 4px;
                            for r in root.admin-dlg-result: HorizontalLayout {
                                spacing: 10px;
                                Text { text: r.c1; color: Theme.dim; font-size: 12px * Prefs.fs; width: 180px; overflow: elide; }
                                TextInput { text: r.c2; color: Theme.text; font-size: 12px * Prefs.fs; read-only: true; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if root.admin-dlg == "confirm" || root.admin-dlg == "form": ActionButton { label: "Cancel"; clicked => { root.admin-dlg = ""; } }
                    if root.admin-dlg == "confirm": PrimaryButton { text: "Execute"; clicked => { root.admin-action-execute(); } }
                    if root.admin-dlg == "form": PrimaryButton { text: "Run"; clicked => { root.admin-action-execute(); } }
                    if root.admin-dlg == "result": PrimaryButton { text: "Done"; clicked => { root.admin-dlg = ""; } }
                }
            }
        }
    }

    // event editor: a tile-coloured dialog in the calendar's language (radius 24 Bento / 28 Nordic)
    if root.ev-open: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            width: min(520px, parent.width - 40px);
            height: evl.preferred-height;
            background: Theme.tile;
            border-radius: Theme.nordic ? 28px : 24px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            evl := VerticalLayout {
                padding: Theme.nordic ? 26px : 22px;
                spacing: 10px;
                Text { text: root.ev-id == "" ? "New event" : "Edit event"; color: Theme.text; font-size: (Theme.nordic ? 22px : 19px) * Prefs.fs; font-weight: Theme.nordic ? 800 : 700; }
                Rectangle { height: 2px; }
                LineEdit { placeholder-text: "Title"; text <=> root.ev-title; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: "YYYY-MM-DD"; text <=> root.ev-date; }
                    if !root.ev-all-day: LineEdit { placeholder-text: "Start HH:MM"; width: 100px; text <=> root.ev-start; }
                    if !root.ev-all-day: LineEdit { placeholder-text: "End HH:MM"; width: 100px; text <=> root.ev-end; }
                }
                CheckBox { text: "All day"; checked <=> root.ev-all-day; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Repeat"; color: Theme.dim; font-size: 12px * Prefs.fs; font-weight: 700; vertical-alignment: center; width: 76px; }
                    ComboBox { model: ["Does not repeat", "Every day", "Every week", "Every month", "Every year"]; current-index <=> root.ev-repeat; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Calendar"; color: Theme.dim; font-size: 12px * Prefs.fs; font-weight: 700; vertical-alignment: center; width: 76px; }
                    ComboBox { model: root.ev-calendars; current-index <=> root.ev-calendar; }
                }
                LineEdit { placeholder-text: "Location"; text <=> root.ev-location; }
                TextEdit { height: 90px; text <=> root.ev-description; wrap: word-wrap; }
                Rectangle { height: 4px; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.ev-status; color: Theme.accent; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    if root.ev-id != "": ActionButton { icon: Icons.trash; label: "Delete"; clicked => { root.ev-delete(); } }
                    ActionButton { label: "Cancel"; clicked => { root.ev-open = false; } }
                    VerticalLayout { alignment: center; PrimaryButton { text: "Save"; height: Prefs.large-targets ? 44px : (Theme.nordic ? 38px : 34px); clicked => { root.ev-save(); } } }
                }
            }
        }
    }

    // calendar event hover preview (Bulwark calendarHoverPreview), drawn as a popup with the event's tint
    if root.app == 1 && root.hov-on && root.hov-shown: Rectangle {
        x: min(root.hov-x, root.width - self.width - 8px);
        y: min(root.hov-y, root.height - self.height - 8px);
        width: 270px;
        height: hovl.preferred-height;
        border-radius: Theme.r-popup;
        background: Theme.popup;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000055;
        hovl := VerticalLayout {
            padding: 12px;
            spacing: 4px;
            if root.hov-ev.invite: Text { text: "Invitation · reply needed"; color: Theme.amber-fg; font-size: 11.5px * Prefs.fs; font-weight: 700; }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    padding-top: 4px;
                    alignment: start;
                    Rectangle {
                        width: 10px; height: 10px;
                        border-radius: Theme.nordic ? 5px : 3.5px;
                        background: root.hov-ev.invite ? Theme.amber-fg : Theme.tint-fg(root.hov-ev.color);
                    }
                }
                Text { text: root.hov-ev.title; color: Theme.text; font-size: 13.5px * Prefs.fs; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; }
            }
            Text { text: root.hov-ev.when; color: Theme.dim; font-size: 12px * Prefs.fs; }
            if root.hov-ev.location != "": Text { text: root.hov-ev.location; color: Theme.body; font-size: 12px * Prefs.fs; wrap: word-wrap; }
        }
    }

    if root.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 68px;
        width: tl.preferred-width;
        height: 44px;
        border-radius: Theme.nordic ? 22px : 16px;
        background: Theme.popup;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000055;
        tl := HorizontalLayout {
            padding-left: 18px;
            padding-right: 8px;
            spacing: 12px;
            Text { text: root.toast; color: Theme.text; font-size: 13px * Prefs.fs; font-weight: 600; vertical-alignment: center; }
            // undo send / undo move: a rose tint pill (BNTokens tint button)
            if root.toast-undo: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: utl.preferred-width + 24px;
                    height: Prefs.large-targets ? 36px : 28px;
                    border-radius: Theme.nordic ? self.height / 2 : 10px;
                    background: ut.pressed ? Theme.sel : ut.has-hover ? Theme.rose-bg.darker(0.1) : Theme.rose-bg;
                    ut := TouchArea { clicked => { root.undo-toast(); } }
                    utl := Text { text: "Undo"; color: Theme.rose-fg; font-size: 12.5px * Prefs.fs; font-weight: 700; vertical-alignment: center; }
                }
            }
            VerticalLayout { alignment: center; HoverAction { icon: Icons.close; clicked => { root.toast = ""; } } }
        }
    }

    if show-settings: Rectangle {
        x: Theme.shell-x;
        width: parent.width - Theme.shell-x;
        background: Theme.ground;
        TouchArea { }
        HorizontalLayout {
            padding-top: Theme.nordic ? 14px : Theme.pad;
            padding-bottom: Theme.nordic ? 14px : Theme.pad;
            padding-right: Theme.nordic ? 14px : Theme.pad;
            spacing: Theme.gap;
            // ---- settings navigation ----
            Tile {
                flat: Theme.nordic;
                width: 230px;
                clip: true;
                VerticalLayout {
                    padding-top: Theme.nordic ? 22px : 14px;
                    padding-bottom: 6px;
                    Rectangle {
                        height: 34px;
                        bta := TouchArea { clicked => { root.show-settings = false; if root.app != 0 { root.app = 0; root.app-changed(0); } } }
                        Rectangle {
                            x: 10px;
                            width: parent.width - 20px;
                            border-radius: Theme.nordic ? self.height / 2 : 12px;
                            background: bta.has-hover ? (Theme.nordic ? Theme.tile : Theme.tile2) : transparent;
                        }
                        HorizontalLayout {
                            padding-left: 20px;
                            spacing: 8px;
                            VerticalLayout { alignment: center; SIcon { commands: Icons.back; size: 15px; weight: 2; tint: Theme.dim; } }
                            Text { text: "Back to mail"; color: Theme.body; font-size: 13px * Prefs.fs; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                    Text {
                        x: 20px;
                        text: "Settings";
                        color: Theme.text;
                        font-size: (Theme.nordic ? 24px : 19px) * Prefs.fs;
                        font-weight: 800;
                        letter-spacing: -0.3px;
                    }
                    HorizontalLayout {
                        padding: 10px;
                        padding-top: 10px;
                        Rectangle {
                            height: Prefs.large-targets ? 44px : (Theme.nordic ? 40px : 38px);
                            border-radius: Theme.nordic ? self.height / 2 : 14px;
                            background: Theme.nordic ? transparent : Theme.tile2;
                            border-width: sq.has-focus ? max(1px, Prefs.focus-ring) : 1px;
                            border-color: sq.has-focus ? Theme.ring : Theme.line;
                            HorizontalLayout {
                                padding-left: Theme.nordic ? 16px : 12px;
                                padding-right: 10px;
                                spacing: 8px;
                                VerticalLayout { alignment: center; SIcon { commands: Icons.search; size: 15px; weight: 2; tint: Theme.dim; } }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    if root.settings-query == "": Text { x: 0; width: parent.width; height: parent.height; text: "Search settings"; color: Theme.faint; font-size: 13px * Prefs.fs; vertical-alignment: center; }
                                    sq := TextInput {
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        text <=> root.settings-query;
                                        color: Theme.text;
                                        font-size: 13px * Prefs.fs;
                                        single-line: true;
                                        selection-background-color: Theme.sel;
                                        selection-foreground-color: Theme.sel-text;
                                        accessible-label: "Search settings";
                                        edited => { root.settings-search(self.text); }
                                    }
                                }
                            }
                        }
                    }
                    ListView {
                        for t in root.settings-tabs: VerticalLayout {
                            if t.header != "": Rectangle {
                                height: t.header == "-" ? 13px : 32px;
                                if t.header == "-": Rectangle { y: 6px; x: 20px; width: parent.width - 40px; height: 1px; background: Theme.line; }
                                if t.header != "-": Text { x: 20px; y: 14px; text: t.header; color: Theme.faint; font-size: 11.5px * Prefs.fs; font-weight: 700; letter-spacing: 0.3px; }
                            }
                            Rectangle {
                                height: Prefs.large-targets ? 44px : (Theme.nordic ? 36px : 34px) * Prefs.fs;
                                x: 10px;
                                width: parent.width - 24px;
                                border-radius: Theme.nordic ? self.height / 2 : 13px;
                                background: t.id == root.settings-tab ? Theme.sel : nta.has-hover ? (Theme.nordic ? Theme.tile : Theme.tile2) : transparent;
                                nta := TouchArea { clicked => { root.settings-open-tab(t.id); } }
                                HorizontalLayout {
                                    padding-left: 10px + t.indent * 16px;
                                    spacing: 10px;
                                    Icon { text: t.icon; font-size: 13px; width: 16px; color: t.id == root.settings-tab ? Theme.sel-text : Theme.faint; }
                                    Text { text: t.label; color: t.id == root.settings-tab ? Theme.sel-text : Theme.body; font-size: 13.5px * Prefs.fs; vertical-alignment: center; overflow: elide; font-weight: t.id == root.settings-tab ? 600 : 400; }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        // soft fade so a cut-off last item reads as "more below"
                        Rectangle { y: -18px; height: 18px; background: @linear-gradient(180deg, (Theme.nordic ? Theme.ground : Theme.tile).transparentize(1) 0%, Theme.nordic ? Theme.ground : Theme.tile 100%); }
                        Rectangle { x: 14px; width: parent.width - 28px; background: Theme.line; }
                    }
                    HorizontalLayout {
                        padding: 12px;
                        padding-left: 20px;
                        padding-right: 16px;
                        Text { text: "Show advanced settings"; color: Theme.body; font-size: 12.5px * Prefs.fs; vertical-alignment: center; horizontal-stretch: 1; }
                        Switch {
                            on: root.show-advanced-settings;
                            toggled => { root.show-advanced-settings = !root.show-advanced-settings; root.settings-set-toggle("showAdvancedSettings", root.show-advanced-settings); }
                        }
                    }
                }
            }
            // ---- page ----
            Tile {
                horizontal-stretch: 1;
                border-radius: Theme.nordic ? Theme.r-pane : Theme.r-tile;
                clip: true;
            VerticalLayout {
                Rectangle {
                    height: Theme.nordic ? 72px : 64px;
                    Text {
                        x: Theme.nordic ? 28px : 24px;
                        text: root.settings-title;
                        color: Theme.text;
                        font-size: (Theme.nordic ? 24px : 22px) * Prefs.fs;
                        font-weight: 800;
                        letter-spacing: -0.4px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    Rectangle { x: Theme.nordic ? 0px : 14px; width: parent.width - 2 * self.x; y: parent.height - 1px; height: 1px; background: Theme.line; }
                }
                ScrollView {
                  VerticalLayout {
                    alignment: start;
                    padding-bottom: 40px;
                    for r[ri] in root.settings-rows: HorizontalLayout {
                        alignment: center;
                        property <bool> dup: ri == 0 && r.kind == "section" && r.label == root.settings-title;
                        if !dup: VerticalLayout {
                            width: min(560px, root.width - 300px);
                            padding-top: r.kind == "section" ? 26px : 12px;
                            padding-bottom: r.kind == "section" ? 4px : 0px;
                            spacing: r.kind == "section" ? 4px : 10px;
                            if r.kind == "section": Rectangle {
                                border-radius: 8px;
                                background: r.key != "" && CtxHl.id == "setting:" + r.key ? Theme.hover : transparent;
                                min-height: st.preferred-height;
                                st := Text { width: 100%; text: r.label; color: Theme.text; font-size: 19px * Prefs.fs; font-weight: 700; letter-spacing: -0.2px; wrap: word-wrap; }
                                if r.key != "": TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("setting", r.key, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                            }
                            if r.kind == "section" && r.desc != "": Text { text: r.desc; color: Theme.dim; font-size: 13px * Prefs.fs; wrap: word-wrap; }
                            if r.kind == "textarea": Text { text: r.label; color: Theme.text; font-weight: 600; }
                            if r.kind == "textarea": TextEdit {
                                height: 90px;
                                text: r.text;
                                wrap: word-wrap;
                                edited(t) => { root.settings-set-text(r.key, t); }
                            }
                            if r.kind == "textarea" && r.desc != "": Text { text: r.desc; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
                            if r.kind != "section" && r.kind != "textarea": HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    width: min(560px, root.width - 300px) - (r.kind == "toggle" ? 52px : r.kind == "value" ? 256px : 236px);
                                    Text { text: r.label; color: Theme.text; font-size: 13.5px * Prefs.fs; font-weight: 600; wrap: word-wrap; TouchArea { pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.ctx("setting", r.key, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } } }
                                    if r.desc != "": Text { text: r.desc; color: Theme.dim; font-size: 12px * Prefs.fs; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    if r.kind == "button": HorizontalLayout { alignment: end; width: 220px; ActionButton { label: r.text; clicked => { root.settings-button(r.key); } } }
                                    if r.kind == "toggle": Switch {
                                        on: r.on;
                                        toggled => { root.settings-set-toggle(r.key, !r.on); }
                                    }
                                    if r.kind == "select": ComboBox {
                                        width: 220px;
                                        model: r.options;
                                        current-index: r.index;
                                        selected => { root.settings-set-select(r.key, self.current-index); }
                                    }
                                    if r.kind == "text" || r.kind == "password": LineEdit {
                                        width: 220px;
                                        text: r.text;
                                        input-type: r.kind == "password" ? InputType.password : InputType.text;
                                        edited(t) => { root.settings-set-text(r.key, t); }
                                    }
                                    if r.kind == "value": Text { text: r.text; color: Theme.dim; horizontal-alignment: right; width: 240px; overflow: elide; }
                                }
                            }
                            if r.kind != "section": Rectangle { height: 1px; background: Theme.line; }
                        }
                    }
                  }
                }
            }
            }
        }
    }
    }
    clip-buf := TextInput { width: 0px; height: 0px; opacity: 0; read-only: true; }
    if root.prompt-open: Rectangle {
        background: #00000080;
        TouchArea { clicked => { root.prompt-open = false; } }
        Rectangle {
            width: 360px; height: 144px;
            background: Theme.popup; border-radius: Theme.r-tile; border-width: 1px; border-color: Theme.line;
            drop-shadow-blur: 24px; drop-shadow-color: #00000066;
            TouchArea {}
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: root.prompt-title; color: Theme.text; font-size: 15px; font-weight: 700; }
                LineEdit { text <=> root.prompt-text; accepted(t) => { root.prompt-open = false; root.prompt-ok(t); } init => { self.focus(); self.select-all(); } }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    ActionButton { label: "Cancel"; clicked => { root.prompt-open = false; } }
                    PrimaryButton { text: "OK"; clicked => { root.prompt-open = false; root.prompt-ok(root.prompt-text); } }
                }
            }
        }
    }
    ctx-popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        TouchArea {
            // only a press outside both menus closes (a flyout press can fall through to here)
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    if self.mouse-x >= cm.x && self.mouse-x < cm.x + cm.width && self.mouse-y >= cm.y && self.mouse-y < cm.y + cm.height { return; }
                    if root.ctx-sub-action != "" && self.mouse-x >= root.ctx-sub-x && self.mouse-x < root.ctx-sub-x + 248px && self.mouse-y >= root.ctx-sub-top && self.mouse-y < root.ctx-sub-top + min(root.ctx-sub-h, root.height - 8px) { return; }
                    root.ctx-close();
                }
            }
        }
        FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if ev.text == Key.Escape {
                    if root.ctx-sub-action != "" { root.ctx-sub-action = ""; } else { root.ctx-close(); }
                    return accept;
                }
                reject
            }
        }
        cm := ContextMenu {
            x: root.ctx-menu-x;
            y: root.ctx-menu-y;
            width: 248px;
            height: min(root.ctx-h, root.height - 8px);
            items: root.ctx-items;
            open-sub: root.ctx-sub-action;
            picked(a) => { root.ctx-close(); root.ctx-pick(a); }
            hovered(a, i) => { root.ctx-hover(a, i); }
        }
        if root.ctx-sub-action != "": ContextMenu {
            x: root.ctx-sub-x;
            y: root.ctx-sub-top;
            width: 248px;
            height: min(root.ctx-sub-h, root.height - 8px);
            items: root.ctx-sub-items;
            // pick before closing: closing removes this flyout (and would drop the rest of this handler)
            picked(a) => { root.ctx-pick(a); root.ctx-close(); }
        }
    }
}
