    in property <string> server-host;
    // admin list: four equal columns, the same for heads and cells (12px gutter inside each column)
    pure function admin-cw(w: length) -> length {
        max(0px, (w - 2 * (Theme.nordic ? 28px : 22px) + 12px - (root.admin-section == "queue" ? 48px : root.admin-section == "actions" ? 86px : 0px)) / 4)
    }
    pure function admin-cx(i: int, w: length) -> length {
        (Theme.nordic ? 28px : 22px) + i * root.admin-cw(w)
    }
    in property <[AdminRow]> admin-tiles;
    in property <string> admin-status;
    in property <[DashRow]> dash-rows;
