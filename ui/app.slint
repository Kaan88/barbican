import { AdminDashboard, DashRow, DashPanel, DashCol, DashBar } from "dashboard.slint";
export { DashRow, DashPanel, DashCol, DashBar }
import { LineEdit, Button, ListView, ScrollView, TextEdit, ComboBox, CheckBox, Palette } from "std-widgets.slint";
import { Theme, Icons, SIcon, Prefs } from "theme.slint";
export { Theme, Icons, Prefs }
// composer extras (p2-composer): recipient chips + autocomplete, palette
import { CTheme } from "ctheme.slint";
import { Rcpt, RChip, RSugg, RecipientField, RecipientSuggest } from "recipients.slint";
import { CompX, SaveState, SPreset, ScheduleDialog, ScheduledBar } from "compose-extras.slint";
export { CTheme, Rcpt, RChip, RSugg, CompX, SPreset }

export struct Folder {
    id: string,
    name: string,
    icon: string,
    depth: int,
    unread: int,
    total: int,
    color: color,
    count: string,
    chevron: int,
    muted: bool,
}

export struct Tag {
    id: string,
    name: string,
    color: color,
    count: string,
}

export struct PRow {
    label: string,
    value: string,
    tone: string,
}

export struct CalEvent {
    id: string,
    title: string,
    time: string,
    location: string,
    color: color,
    col: int,
    top: float,
    height: float,
    lane: int,
    lanes: int,
    date: string,
    // month view look of a timed event (calendarMonthTimedEvents): 0 bar, 1 coloured text, 2 dot and text
    style: int,
}

export struct CalCell {
    day: int,
    date: string,
    in-month: bool,
    today: bool,
    events: [CalEvent],
    more: string,
}

export struct CalItem {
    id: string,
    name: string,
    color: color,
    visible: bool,
}

export struct MiniDay {
    day: int,
    in-month: bool,
    today: bool,
    selected: bool,
    date: string,
    busy: bool,
}

export struct ContactRow {
    id: string,
    name: string,
    email: string,
    initials: string,
    color: color,
    header: string,
}

export struct FileRow {
    id: string,
    name: string,
    folder: bool,
    size: string,
    modified: string,
    renaming: bool,
    starred: bool,
    shared: bool,
    cut: bool,
    // an item listed in the Files trash
    trashed: bool,
}

export struct AdminRow {
    id: string,
    c1: string,
    c2: string,
    c3: string,
    c4: string,
}

export struct ThreadMsg {
    id: string,
    sender: string,
    date: string,
    preview: string,
    current: bool,
    unread: bool,
}

export struct TaskRow {
    id: string,
    title: string,
    due: string,
    done: bool,
}

export struct Att {
    name: string,
    size: string,
    index: int,
}

/// A sidebar row (contacts / files navigation). kind "section" is a header-only row.
export struct NavRow {
    kind: string,
    id: string,
    label: string,
    icon: string,
    count: string,
    color: color,
    depth: int,
    header: string, // section title shown above the row
}

export struct CtxItem {
    icon: string,
    label: string,
    hint: string,
    action: string,
    kind: int, // 0 item, 1 separator, 2 header
    sub: bool,
    danger: bool,
    enabled: bool,
    checked: bool,
    color: color, // tag swatch when set
}

/// Row a context menu was opened on (Bulwark highlights it while the menu is up).
export global CtxHl {
    in-out property <string> id;
}

export struct ChatMsg {
    role: string,
    text: string,
}

export struct Mail {
    id: string,
    sender: string,
    initials: string,
    color: color,
    subject: string,
    preview: string,
    time: string,
    unread: bool,
    attach: bool,
    header: string,
    threads: int,
    flagged: bool,
    answered: bool,
    checked: bool,
    draft: bool,
    tags: [color],
    account: string,
    account-color: color,
    code: string,
    row-tint: color,
    files: [string],
}

export struct STab {
    id: string,
    label: string,
    icon: string,
    header: string,
    indent: int,
}

export struct SRow {
    kind: string,
    key: string,
    label: string,
    desc: string,
    options: [string],
    index: int,
    on: bool,
    text: string,
}

component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: on ? Theme.accent : Theme.track;
    TouchArea { clicked => { root.toggled(); } }
    Rectangle {
        x: on ? parent.width - 18px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: on ? Theme.on-accent : Theme.dim;
        animate x { duration: Prefs.reduce-motion ? 0ms : 120ms; }
    }
}

component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 15px;
    color: Theme.dim;
    vertical-alignment: center;
    horizontal-alignment: center;
}

/// Initials on a tint tile: a squircle in Bento, a circle in Nordic (BNMail / NordMail avatars).
component Avatar inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    width: 34px;
    height: 34px;
    border-radius: Theme.round(self.height);
    background: Theme.tint-bg(root.tint);
    Text {
        text: root.label;
        color: Theme.tint-fg(root.tint);
        font-size: max(9px, root.height * 0.33);
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// The Barbican mark: three rounded bars in the accent (100 / 70 / 40 %), a 34 x 34 drawing.
component Mark inherits Rectangle {
    in property <length> size: 32px;
    width: size;
    height: size;
    property <float> k: self.size / 34px;
    Rectangle { x: 3px * k; y: 12px * k; width: 7px * k; height: 19px * k; border-radius: 3.5px * k; background: Theme.accent; }
    Rectangle { x: 13.5px * k; y: 3px * k; width: 7px * k; height: 28px * k; border-radius: 3.5px * k; background: Theme.accent; opacity: 0.7; }
    Rectangle { x: 24px * k; y: 8px * k; width: 7px * k; height: 23px * k; border-radius: 3.5px * k; background: Theme.accent; opacity: 0.4; }
}

/// A Bento tile (tile colour, 1px line, rounded). Nordic screens pass `flat` to drop the tile.
component Tile inherits Rectangle {
    in property <bool> flat: false;
    background: flat ? transparent : Theme.tile;
    border-width: flat ? 0px : 1px;
    border-color: Theme.line;
    border-radius: flat ? 0px : Theme.r-tile;
}

/// An app on the rail: line icon, selected = sel tint (squircle 42 in Bento, circle 46 in Nordic).
component RailButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <string> tip;
    callback clicked;
    width: Prefs.large-targets ? 48px : (Theme.nordic ? 46px : 42px);
    height: self.width;
    border-radius: Theme.nordic ? self.height / 2 : 14px;
    background: active ? Theme.sel : ta.has-hover ? Theme.tile2 : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea { clicked => { root.clicked(); } }
    SIcon {
        commands: root.icon;
        size: Theme.nordic ? 21px : 20px;
        weight: Theme.nordic ? 1.6 : 1.7;
        tint: root.active ? Theme.sel-text : ta.has-hover ? Theme.text : Theme.faint;
    }
}

/// A folder in the sidebar. Bento: 16px line icon, squircle selection (BNMail); Nordic: no icon,
/// pill selection (NordMail). Subfolders indent; a chevron on the right folds them.
component FolderRow inherits Rectangle {
    in property <Folder> f;
    in property <bool> selected;
    in property <bool> colorful;
    callback clicked;
    callback chevron-clicked;
    callback context(length, length);
    in property <string> hl-id;
    height: Prefs.large-targets ? 44px : (Theme.nordic ? 41px : 36px) * Prefs.fs;
    border-radius: Theme.nordic ? min(self.height / 2, Theme.r-nav) : Theme.r-nav;
    property <color> fg: selected ? Theme.sel-text : Theme.body;
    background: selected ? Theme.sel : ta.has-hover || (hl-id != "" && CtxHl.id == hl-id) ? Theme.tile2 : transparent;
    border-width: hl-id != "" && CtxHl.id == hl-id ? 1px : 0px;
    border-color: Theme.accent;
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
    }
    HorizontalLayout {
        padding-left: (Theme.nordic ? 16px : 11px) + f.depth * 14px;
        padding-right: Theme.nordic ? 12px : 9px;
        spacing: 10px;
        if Theme.bento: VerticalLayout {
            alignment: center;
            SIcon { commands: Icons.for-glyph(f.icon); size: 16px; weight: 1.8; tint: root.colorful && !root.selected ? f.color : root.fg; }
        }
        Text {
            text: f.name;
            color: root.fg;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            font-size: (Theme.nordic ? 14.5px : 13.5px) * Prefs.fs;
            font-weight: selected ? (Theme.nordic ? 700 : 600) : (Theme.nordic ? 500 : 400);
        }
        if f.muted: Icon { text: "\u{E7ED}"; font-size: 10px; color: Theme.faint; }
        Text {
            text: f.count;
            color: f.unread > 0 || root.selected ? root.fg : Theme.faint;
            font-size: (Theme.nordic ? 12.5px : 12px) * Prefs.fs;
            font-weight: Theme.nordic ? 500 : 700;
            vertical-alignment: center;
        }
        if f.chevron != 0: Rectangle {
            width: 18px;
            cta := TouchArea { clicked => { root.chevron-clicked(); } }
            SIcon { commands: f.chevron == 1 ? Icons.chevron-down : Icons.chevron-right; size: 12px; weight: 2; tint: cta.has-hover ? Theme.text : Theme.faint; }
        }
    }
}

component TagIcon inherits Path {
    in property <color> tint;
    width: 14px;
    height: 14px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: tint;
    stroke: tint;
    stroke-width: 1px;
    commands: "M12.6 2.6 A2 2 0 0 0 11.2 2 H4 A2 2 0 0 0 2 4 V11.2 A2 2 0 0 0 2.6 12.6 L11.3 21.3 A2.4 2.4 0 0 0 14.7 21.3 L21.3 14.7 A2.4 2.4 0 0 0 21.3 11.3 Z";
}

/// A tag in the Nordic sidebar: a small squircle in the tag colour, then the name (NordMail labels).
component TagRow inherits Rectangle {
    in property <Tag> t;
    in property <bool> selected;
    callback clicked;
    callback context(length, length);
    height: Prefs.large-targets ? 44px : 37px * Prefs.fs;
    in property <string> hl-id;
    border-radius: min(self.height / 2, Theme.r-nav);
    background: selected ? Theme.sel : ta.has-hover || (hl-id != "" && CtxHl.id == hl-id) ? Theme.tile2 : transparent;
    border-width: hl-id != "" && CtxHl.id == hl-id ? 1px : 0px;
    border-color: Theme.accent;
    ta := TouchArea { clicked => { root.clicked(); } pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 4px; background: t.color; } }
        Text { text: t.name; color: selected ? Theme.sel-text : Theme.body; font-size: 14px * Prefs.fs; font-weight: selected ? 700 : 400; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: t.count; color: Theme.faint; font-size: 12px * Prefs.fs; vertical-alignment: center; }
    }
}

/// A tag as a tint tile with its count (BNMail labels grid).
component TagTile inherits Rectangle {
    in property <Tag> t;
    in property <bool> selected;
    callback clicked;
    callback context(length, length);
    in property <string> hl-id;
    border-radius: 16px;
    background: Theme.tint-bg(t.color);
    border-width: selected || (hl-id != "" && CtxHl.id == hl-id) ? 1.5px : 0px;
    border-color: Theme.tint-fg(t.color);
    ta := TouchArea { clicked => { root.clicked(); } pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text { text: t.name; color: Theme.tint-fg(t.color); font-size: 12px * Prefs.fs; font-weight: 600; overflow: elide; }
        Text { text: t.count == "" ? "0" : t.count; color: Theme.tint-fg(t.color); font-size: 19px * Prefs.fs; font-weight: 800; }
    }
}

/// The accent button (radius 12–15 in Bento, a pill in Nordic).
component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: Prefs.large-targets ? 44px : 32px;
    min-width: pl.preferred-width + 28px;
    border-radius: min(self.height / 2, Theme.nordic ? 999px : 12px);
    background: !enabled ? Theme.accent.with-alpha(0.4) : (pta.pressed ? Theme.accent.darker(0.12) : (pta.has-hover ? Theme.accent.brighter(0.1) : Theme.accent));
    pta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    pl := Text { text: root.text; color: Theme.on-accent; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}

/// A secondary action: tile-2 squircle with a line icon and label (BNMail reader actions) or a
/// bordered pill with the label only (NordMail). `icon-only` drops the label.
component ActionButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> icon-only: false;
    in property <bool> active;
    callback clicked;
    property <bool> show-label: !icon-only && label != "";
    property <bool> show-icon: icon != "" && (Theme.bento || !show-label);
    height: Prefs.large-targets ? 44px : (Theme.nordic ? 38px : 34px);
    width: max(self.height, al.preferred-width);
    border-radius: Theme.nordic ? self.height / 2 : 12px;
    border-width: 1px;
    border-color: Theme.line;
    background: active ? Theme.sel : ata.pressed ? Theme.track : ata.has-hover ? (Theme.nordic ? Theme.tile2 : Theme.hover) : (Theme.nordic ? transparent : Theme.tile2);
    ata := TouchArea { clicked => { root.clicked(); } }
    al := HorizontalLayout {
        padding-left: root.show-label ? (Theme.nordic ? 16px : 12px) : 0px;
        padding-right: root.show-label ? (Theme.nordic ? 16px : 12px) : 0px;
        spacing: 6px;
        alignment: center;
        if root.show-icon: VerticalLayout {
            alignment: center;
            SIcon { commands: root.icon; size: root.show-label ? 14px : 16px; weight: 2; tint: root.active ? Theme.sel-text : Theme.text; }
        }
        if root.show-label: Text {
            text: root.label;
            color: root.active ? Theme.sel-text : (Theme.nordic ? Theme.body : Theme.text);
            font-size: (Theme.nordic ? 13px : 12.5px) * Prefs.fs;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

/// A quiet icon button (no border): squircle / circle hover.
component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.dim;
    in property <bool> active;
    in property <length> icon-size: 16px;
    callback clicked;
    width: Prefs.large-targets ? 40px : 30px;
    height: self.width;
    border-radius: Theme.round(self.height);
    background: active ? Theme.sel : ita.has-hover ? Theme.tile2 : transparent;
    ita := TouchArea { clicked => { root.clicked(); } }
    SIcon { commands: root.icon; size: root.icon-size; weight: 1.9; tint: root.active ? Theme.sel-text : ita.has-hover ? Theme.text : root.tint; }
}

/// A filter chip: on = text on ground colours, off = hairline (BNMail chips, BNTokens).
component QuickChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked;
    height: Prefs.large-targets ? 40px : 28px;
    width: ql.preferred-width + 24px;
    border-radius: self.height / 2;
    background: on ? Theme.text : qta.has-hover ? Theme.tile2 : transparent;
    border-width: on ? 0px : 1px;
    border-color: Theme.line;
    qta := TouchArea { clicked => { root.clicked(); } }
    ql := Text { text: root.label; color: root.on ? Theme.ground : Theme.dim; font-size: 12px * Prefs.fs; font-weight: 600; }
}

/// A tinted summary tile above the content (BNMail: Today / Waiting on / Travel).
component SummaryTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <color> bg;
    in property <color> fg;
    callback clicked;
    border-radius: Theme.r-summary;
    background: bg;
    sta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    VerticalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 0px;
        Text { text: root.label; color: root.fg; opacity: 0.85; font-size: 11.5px * Prefs.fs; font-weight: 600; overflow: elide; }
        Text { text: root.value; color: root.fg; font-size: 19px * Prefs.fs; font-weight: 800; overflow: elide; }
        Text { text: root.sub; color: root.fg; opacity: 0.85; font-size: 12px * Prefs.fs; overflow: elide; }
    }
}

component HoverAction inherits Rectangle {
    in property <string> glyph;
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    width: Prefs.large-targets ? 32px : 24px;
    height: Prefs.large-targets ? 32px : 24px;
    border-radius: Theme.round(self.height);
    background: hta.has-hover ? Theme.hover : transparent;
    hta := TouchArea { clicked => { root.clicked(); } }
    if root.icon == "": Icon { text: glyph; font-size: 12px; color: active ? #fbbf24 : (hta.has-hover ? Theme.text : Theme.dim); }
    if root.icon != "": SIcon {
        commands: root.icon;
        size: 15px;
        weight: 1.9;
        tint: root.active ? #fbbf24 : (hta.has-hover ? Theme.text : Theme.dim);
        fill: root.active ? #fbbf24 : transparent;
    }
}


component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> show-label: Prefs.toolbar-labels;
    callback clicked;
    height: Prefs.large-targets ? 44px : 28px;
    width: max(lay.preferred-width, Prefs.large-targets ? 44px : 0px);
    border-radius: 6px;
    background: tta.has-hover ? Theme.hover : transparent;
    tta := TouchArea { clicked => { root.clicked(); } }
    lay := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Icon { text: glyph; font-size: 12px; color: Theme.text; }
        if show-label: Text { text: label; color: Theme.text; vertical-alignment: center; }
    }
}

component ContextMenuRow inherits Rectangle {
    in property <CtxItem> it;
    in property <bool> open-sub;
    callback picked(string);
    callback hovered();
    height: it.kind == 1 ? 9px : it.kind == 2 ? 24px : 30px;
    border-radius: Theme.nordic ? 15px : 9px;
    background: it.kind == 0 && it.enabled && (cta.has-hover || open-sub) ? (it.danger ? #ef444433 : Theme.hover) : transparent;
    if it.kind == 1: Rectangle { x: 4px; width: parent.width - 8px; height: 1px; background: Theme.line; }
    if it.kind == 2: Text { x: 10px; width: parent.width - 20px; text: it.label; color: Theme.dim; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; }
    cta := TouchArea { enabled: it.kind == 0 && it.enabled; clicked => { if it.sub { root.hovered(); } else { root.picked(it.action); } } changed has-hover => { if self.has-hover { root.hovered(); } } }
    if it.kind == 0: HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;
        if it.color.alpha == 0: Icon { text: it.checked ? "\u{E73E}" : it.icon; font-size: 13px; width: 16px; color: !it.enabled ? Theme.line : it.danger ? #ef4444 : Theme.text; }
        if it.color.alpha > 0: VerticalLayout { alignment: center; width: 16px; TagIcon { tint: it.color; } }
        Text { text: it.label; color: !it.enabled ? Theme.dim : it.danger ? #ef4444 : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; font-size: 13px; }
        if it.hint != "": Text { text: it.hint; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        if it.checked && it.color.alpha > 0: Icon { text: "\u{E73E}"; font-size: 11px; width: 12px; color: Theme.accent; }
        if it.sub: Icon { text: "\u{E76C}"; font-size: 9px; width: 10px; }
    }
}

/// Dark context menu body (Theme.popup, 1px Theme.line border, radius 8).
component ContextMenu inherits Rectangle {
    in property <[CtxItem]> items;
    in property <string> open-sub;
    callback picked(string);
    callback hovered(string, int);
    background: Theme.popup;
    border-radius: Theme.r-popup;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000055;
    Flickable {
        content-height: col.preferred-height;
        col := VerticalLayout {
            padding: 4px;
            for it[i] in root.items: ContextMenuRow { it: it; open-sub: it.sub && it.action == root.open-sub; picked(a) => { root.picked(a); } hovered => { root.hovered(it.action, i); } }
        }
    }
}

/// A message in the list. Bento (BNMail): avatar squircle, rounded row inset 8px, selected =
/// tile-2 with a hairline. Nordic (NordMail): unread dot instead of an avatar, full-width row,
/// selected = tile-2 with an accent bar on the left.
component MailRow inherits VerticalLayout {
    in property <Mail> m;
    in property <length> row-height: 82px;
    in property <bool> selected;
    callback clicked;
    callback ctrl-clicked;
    callback action(string);
    callback header-clicked;
    callback context(length, length);
    property <bool> hl: CtxHl.id != "" && CtxHl.id == "mail:" + m.id;
    property <length> side: Theme.nordic ? 28px : 12px;
    if m.header != "": Rectangle {
        height: 30px;
        TouchArea { clicked => { root.header-clicked(); } }
        HorizontalLayout {
            padding-left: Theme.nordic ? 28px : 20px;
            padding-top: 6px;
            spacing: 6px;
            Text { text: m.header; color: Theme.faint; font-size: 11.5px * Prefs.fs; font-weight: 700; vertical-alignment: center; }
            VerticalLayout { alignment: center; SIcon { commands: Icons.chevron-down; size: 11px; weight: 2.2; tint: Theme.faint; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    Rectangle {
        height: root.row-height + ((m.code != "" || m.files.length > 0) ? 24px : 0px) + (Theme.nordic ? 6px : 0px);
        row := Rectangle {
            x: Theme.nordic ? 0px : 8px;
            width: parent.width - 2 * self.x;
            border-radius: Theme.r-row;
            background: root.selected ? Theme.tile2 : m.checked ? Theme.sel : ta.has-hover || root.hl ? Theme.tile2 : m.row-tint;
            border-width: root.hl ? 1px : (Theme.bento && root.selected ? 1px : 0px);
            border-color: root.hl ? Theme.accent : Theme.line;
            ta := TouchArea {
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left {
                        if ev.modifiers.control || ev.modifiers.shift { root.ctrl-clicked(); } else { root.clicked(); }
                    }
                    if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                }
            }
            // Nordic selection bar; a tag's colour otherwise
            if Theme.nordic && root.selected: Rectangle { x: 0; width: 3px; background: Theme.accent; }
            if m.tags.length > 0 && !(Theme.nordic && root.selected): Rectangle {
                x: Theme.nordic ? 0px : 3px;
                y: Theme.nordic ? 0px : 14px;
                width: 3px;
                height: Theme.nordic ? parent.height : parent.height - 28px;
                border-radius: Theme.nordic ? 0px : 1.5px;
                background: m.tags[0];
            }
            HorizontalLayout {
                padding-top: Theme.nordic ? 14px : 10px;
                padding-bottom: Theme.nordic ? 14px : 10px;
                padding-left: root.side;
                padding-right: Theme.nordic ? 24px : 12px;
                spacing: Theme.nordic ? 8px : 11px;
                if Theme.bento: VerticalLayout {
                    alignment: start;
                    Avatar { label: m.initials; tint: m.color; width: 38px; height: 38px; }
                }
                if Theme.nordic: VerticalLayout {
                    alignment: start;
                    padding-top: 7px * Prefs.fs;
                    Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: m.unread ? Theme.accent : transparent; }
                }
                VerticalLayout {
                    spacing: Theme.nordic ? 3px : 1px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 6px;
                        if m.account != "": VerticalLayout {
                            alignment: center;
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: m.account-color; }
                        }
                        Text {
                            text: m.draft ? "Draft" : m.sender;
                            color: m.draft ? Theme.accent : Theme.text;
                            font-size: (Theme.nordic ? 14px : 13.5px) * Prefs.fs;
                            font-weight: m.unread ? 700 : 500;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if m.threads > 1: Rectangle {
                            width: tc.preferred-width + 12px;
                            height: 17px;
                            border-radius: 8.5px;
                            background: Theme.track;
                            tc := Text { text: m.threads; color: Theme.dim; font-size: 10.5px; font-weight: 700; }
                        }
                        if m.answered: VerticalLayout { alignment: center; SIcon { commands: Icons.reply; size: 13px; weight: 2; tint: Theme.faint; } }
                        if m.attach: VerticalLayout { alignment: center; SIcon { commands: Icons.clip; size: 13px; weight: 2; tint: Theme.faint; } }
                        if !ta.has-hover || Prefs.hover-floating: Text {
                            text: m.time;
                            color: Theme.nordic ? Theme.dim : (m.unread ? Theme.accent : Theme.faint);
                            font-size: (Theme.nordic ? 12px : 11.5px) * Prefs.fs;
                            font-weight: Theme.nordic ? 400 : 600;
                            vertical-alignment: center;
                        }
                        if Prefs.row-action: HoverAction {
                            icon: Icons.more;
                            clicked => { root.context(self.absolute-position.x, self.absolute-position.y + self.height); }
                        }
                        if ta.has-hover && !Prefs.hover-floating: HorizontalLayout {
                            spacing: 0px;
                            for a in Prefs.hover-actions: HoverAction {
                                icon: a == "delete" ? Icons.trash : a == "star" ? Icons.star : a == "read" ? Icons.mail : a == "archive" ? Icons.archive : a == "spam" ? Icons.alert : Icons.tag;
                                active: a == "star" && m.flagged;
                                clicked => { root.action(a); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: m.subject;
                            color: Theme.text;
                            font-size: (Theme.nordic ? 14px : 13px) * Prefs.fs;
                            font-weight: m.unread ? 700 : 500;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if m.flagged && !ta.has-hover: VerticalLayout { alignment: center; SIcon { commands: Icons.star; size: 12px; weight: 1.8; tint: #fbbf24; fill: #fbbf24; } }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: m.preview; color: Theme.dim; font-size: (Theme.nordic ? 13px : 12px) * Prefs.fs; overflow: elide; horizontal-stretch: 1; }
                        for c in m.tags: VerticalLayout {
                            alignment: center;
                            Rectangle { visible: Prefs.tag-chips; width: Prefs.tag-chips ? 8px : 0px; height: 8px; border-radius: 4px; background: c; }
                        }
                    }
                    if m.code != "" || m.files.length > 0: HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        padding-top: 4px;
                        if m.code != "": Rectangle {
                            height: 20px;
                            width: codet.preferred-width + 30px;
                            border-radius: 10px;
                            background: codeta.has-hover ? Theme.sel : Theme.rose-bg;
                            codeta := TouchArea { clicked => { root.action("copy-code:" + m.code); } }
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 4px;
                                Icon { text: "\u{E8C8}"; font-size: 9px; color: Theme.rose-fg; }
                                codet := Text { text: m.code; color: Theme.rose-fg; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                            }
                        }
                        for f in m.files: Rectangle {
                            height: 20px;
                            width: min(ft.preferred-width + 30px, 160px);
                            border-radius: 10px;
                            background: Theme.track;
                            HorizontalLayout {
                                padding-left: 7px;
                                padding-right: 8px;
                                spacing: 4px;
                                VerticalLayout { alignment: center; SIcon { commands: Icons.clip; size: 11px; weight: 2; tint: Theme.dim; } }
                                ft := Text { text: f; color: Theme.dim; font-size: 10.5px; vertical-alignment: center; overflow: elide; }
                            }
                        }
                    }
                }
            }
            // Bulwark hoverActionsMode "floating": the actions float in a corner of the row
            if ta.has-hover && Prefs.hover-floating: Rectangle {
                x: Prefs.hover-left ? 8px : parent.width - self.width - 8px;
                y: Prefs.hover-bottom ? parent.height - self.height - 4px : 4px;
                width: fl.preferred-width + 4px;
                height: fl.preferred-height + 4px;
                border-radius: Theme.round(self.height);
                background: Theme.popup;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 6px;
                drop-shadow-color: #00000040;
                fl := HorizontalLayout {
                    x: 2px; y: 2px;
                    spacing: 0px;
                    for a in Prefs.hover-actions: HoverAction {
                        icon: a == "delete" ? Icons.trash : a == "star" ? Icons.star : a == "read" ? Icons.mail : a == "archive" ? Icons.archive : a == "spam" ? Icons.alert : Icons.tag;
                        active: a == "star" && m.flagged;
                        clicked => { root.action(a); }
                    }
                }
            }
        }
    }
}

// ---- rich-text composer: painted document pushed from Rust (src/rte)
export struct RteText { x: length, y: length, w: length, h: length, text: string, role: int, color: color, size: length, weight: int, italic: bool, font: int, right: bool }
export struct RteBox { x: length, y: length, w: length, h: length, role: int, color: color, border: length, border-role: int, border-color: color, radius: length }
export struct RteImage { x: length, y: length, w: length, h: length, img: image, selected: bool, label: string }
export struct RteState { bold: bool, italic: bool, underline: bool, strike: bool, code: bool, color: string, highlight: bool, size: int, block: string, align: string, in-table: bool, link: string, has-sel: bool, can-undo: bool, can-redo: bool }

// colour roles of painted runs and boxes (resolved here so the theme switches live)
global RteColors {
    public pure function of(role: int, c: color) -> color {
        if role == 1 { return Theme.text; }
        if role == 2 { return Theme.dim; }
        if role == 3 { return Theme.track; }
        if role == 4 { return Theme.dark ? #f0577a55 : #c8234a33; }
        if role == 5 { return Theme.chip; }
        if role == 6 { return Theme.dark ? #7cb1ff : #2563eb; }
        if role == 7 { return Theme.raised; }
        if role == 8 { return Theme.accent; }
        if role == 9 { return transparent; }
        return c;
    }
}

/// A corner handle of the selected image in the composer: drag to resize (aspect kept).
component RteHandle inherits Rectangle {
    in property <string> corner;
    // the handle's top-left in editor content coordinates
    in property <length> ox;
    in property <length> oy;
    callback ev(string, length, length);
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: white;
    border-width: 1.5px;
    border-color: Theme.accent;
    TouchArea {
        x: -3px; y: -3px; width: 16px; height: 16px;
        mouse-cursor: root.corner == "nw" || root.corner == "se" ? MouseCursor.nwse-resize : MouseCursor.nesw-resize;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { root.ev("rs-down-" + root.corner, root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y); }
            else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { root.ev("rs-up", root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y); }
        }
        moved => { if self.pressed { root.ev("rs-drag", root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y); } }
    }
}

component FmtButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    in property <string> tip;
    in property <bool> bold;
    in property <bool> italic;
    in property <bool> underline;
    in property <bool> strike;
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: fta.pressed ? Theme.chip : active ? Theme.sel : fta.has-hover ? Theme.hover : transparent;
    fta := TouchArea { clicked => { root.clicked(); } }
    if glyph != "": Icon { text: glyph; font-size: 13px; color: active ? Theme.sel-text : fta.has-hover ? Theme.text : Theme.dim; }
    if glyph == "": Text {
        text: label;
        color: active ? Theme.sel-text : fta.has-hover ? Theme.text : Theme.dim;
        font-size: 12px;
        font-weight: bold ? 800 : 500;
        font-italic: italic;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if underline: Rectangle { x: 8px; y: 18px; width: 8px; height: 1px; background: active ? Theme.sel-text : fta.has-hover ? Theme.text : Theme.dim; }
    if strike: Rectangle { x: 7px; y: 12px; width: 10px; height: 1px; background: active ? Theme.sel-text : fta.has-hover ? Theme.text : Theme.dim; }
    if tip != "" && fta.has-hover: Rectangle {
        y: parent.height + 4px;
        x: (parent.width - tipt.preferred-width - 12px) / 2;
        width: tipt.preferred-width + 12px;
        height: 22px;
        border-radius: 4px;
        background: Theme.text;
        tipt := Text { text: root.tip; color: Theme.bg; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> checked;
    in property <bool> checkable;
    in property <bool> enabled: true;
    in property <color> swatch: transparent;
    callback clicked;
    height: 30px;
    border-radius: Theme.nordic ? 15px : 9px;
    background: mta.has-hover && enabled ? Theme.hover : transparent;
    mta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;
        if checkable: Icon { text: checked ? "\u{E73E}" : ""; font-size: 11px; width: 14px; color: Theme.accent; }
        if glyph != "": Icon { text: glyph; font-size: 12px; width: 14px; }
        if swatch != transparent: VerticalLayout { alignment: center; Rectangle { width: 12px; height: 12px; border-radius: 6px; background: swatch; } }
        Text { text: root.text; color: enabled ? Theme.text : Theme.dim; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
}

component MenuPanel inherits Rectangle {
    background: Theme.popup;
    border-radius: Theme.r-popup;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000060;
}

component BarButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> chevron: true;
    callback clicked;
    height: Prefs.large-targets ? 44px : 28px;
    width: bl.preferred-width;
    border-radius: 6px;
    background: bta.has-hover ? Theme.hover : transparent;
    bta := TouchArea { clicked => { root.clicked(); } }
    bl := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Icon { text: glyph; font-size: 12px; color: Theme.text; }
        Text { text: label; color: Theme.text; font-weight: 600; vertical-alignment: center; }
        if chevron: Icon { text: "\u{E70D}"; font-size: 8px; color: Theme.dim; }
    }
}

component BareField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    height: 20px;
    border-width: ti.has-focus ? Prefs.focus-ring : 0px;
    border-color: Theme.ring;
    border-radius: 2px;
    if text == "": Text { x: 0; text: placeholder; color: Theme.dim; vertical-alignment: center; height: parent.height; }
    ti := TextInput {
        text <=> root.text;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
    }
}


export component AppWindow inherits Window {
    // "(3) Barbican" with faviconUnreadBadge
    in property <string> window-title: "Barbican";
    title: root.window-title;
    icon: @image-url("barbican.svg");
    background: Theme.bg;
    preferred-width: 1400px;
    preferred-height: 900px;
    default-font-size: Prefs.font-size;
    default-font-family: "Segoe UI";
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; root.win-w = self.width; }
    changed theme-dark => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    property <bool> theme-dark: Theme.dark;

    in-out property <bool> logged-in: false;
    in property <bool> busy: false;
    in property <string> status;
    in property <string> account;
    in property <string> initials: "?";
    in property <[Folder]> folders;
    in property <[Mail]> mails;
    in-out property <string> current-folder;
    in-out property <string> current-mail;
    in property <string> r-subject;
    in property <string> r-from;
    in property <string> r-date;
    in property <string> r-body;
    // ---- mail glance (src/glance.rs): list header, summary tiles, storage, sender panel ----
    in property <string> list-title: "Inbox";
    in property <int> list-unread;
    in property <string> list-sub;
    in property <bool> sum-has-cal;
    in property <int> sum-today;
    in property <string> sum-today-next;
    in property <int> sum-flagged;
    in property <string> sum-flagged-who;
    in property <bool> sum-has-tasks;
    in property <int> sum-tasks;
    in property <string> sum-tasks-next;
    in property <string> quota-text;
    in property <float> quota-frac: -1;
    in property <string> sx-org;
    in property <string> sx-phone;
    in property <[PRow]> sx-recent;
    in property <[PRow]> sx-files;
    in property <string> sx-next;
    in property <string> sx-next-title;
    // the context panel (sender details) beside the reader collapses first when space runs out
    // the window width, copied in a changed handler: a binding on `width` would loop through the layout
    property <length> win-w: 1400px;
    changed width => { root.win-w = self.width; }
    property <bool> list-narrow: root.win-w < (Theme.nordic ? 1180px : 1150px) || ((root.chat-shown || root.composing) && root.win-w < 1500px);
    property <length> list-w: Theme.nordic ? (root.list-narrow ? 330px : 390px) : (root.list-narrow ? 320px : 368px);
    property <length> side-w: Theme.nordic ? 228px : 204px;
    property <length> ctx-w: Theme.nordic ? 250px : 236px;
    property <length> chat-w: 300px;
    property <bool> chat-shown: root.chat-open && !root.ai-hidden;
    property <length> fixed-w: Theme.shell-x + root.side-w + root.list-w + (Theme.nordic ? 14px + 2px : 2 * Theme.gap + Theme.pad);
    property <bool> sender-shown: !root.chat-shown && root.current-mail != "" && !root.composing && root.win-w - root.fixed-w - root.ctx-w - Theme.gap >= 440px;
    // the reader's inner width (for the action bar), from the same arithmetic
    property <length> reader-w: root.win-w - root.fixed-w - (root.chat-shown ? root.chat-w + Theme.gap : root.sender-shown ? root.ctx-w + Theme.gap : 0px) - (Theme.nordic ? 88px : 54px);
    property <bool> has-summary: Theme.bento && !root.composing && root.reader-w >= 330px;
    in-out property <string> server;
    in-out property <string> user;
    in-out property <string> search;

    callback login(string, string, string, string, bool);
    callback sso-login(string, string, bool);
    callback sign-out();
    in-out property <string> client-id: "barbican";
    in-out property <bool> remember: true;
    in-out property <bool> show-advanced;
    callback select-folder(string);
    callback open-mail(string);
    callback do-search(string);
    callback refresh();
    callback compose-new();
    callback open-settings();
    callback save-settings();
    callback ai-reader(string);
    callback ai-compose(string);
    callback ai-undo();
    in property <string> spam-verdict;
    in property <string> spam-detail;
    in-out property <string> ai-result;
    in property <bool> ai-busy;
    in property <bool> can-undo;
    in-out property <bool> show-settings;
    in-out property <int> ai-provider;
    in-out property <string> ai-base;
    in-out property <string> ai-key;
    in-out property <string> ai-model;
    in-out property <string> ai-lang;
    in-out property <bool> spam-show-clean: true;
    in-out property <int> ai-actions: 1;
    in-out property <string> ai-instructions;
    in-out property <string> ai-prompts;
    in-out property <bool> ai-memory-on: true;
    in-out property <string> ai-memory;
    in-out property <bool> ai-hidden;
    // the assistant opens from the rail; the sender panel is the default context beside the reader
    in-out property <bool> chat-open: false;
    in property <[ChatMsg]> chat;
    in property <bool> chat-busy;
    in property <[string]> chips;
    in property <string> confirm-text;
    in-out property <string> chat-input;
    callback chat-send(string);
    in property <[Tag]> tags;
    in-out property <string> current-tag;
    in property <bool> has-more;
    in property <int> checked-count;
    in property <string> r-email;
    in property <string> r-to;
    in property <string> r-initials;
    in property <color> r-color: #6366f1;
    in property <bool> r-flagged;
    in property <[Att]> attachments;
    in-out property <string> toast;
    in property <bool> toast-undo;
    in-out property <bool> folders-collapsed;
    in-out property <bool> tags-collapsed;
    callback toggle-folder(string);
    callback select-tag(string);
    callback row-action(string, string);
    callback toggle-check(string);
    callback select-all();
    callback bulk(string);
    callback act(string);
    callback move-to(string);
    callback tag-toggle(string);
    callback load-more();
    callback quick-reply(string);
    callback open-attachment(int);
    callback save-attachment(int);
    callback undo-toast();
    in property <bool> pref-quick-reply: true;
    in property <bool> pref-toolbar-labels: true;
    in property <bool> pref-tag-chips: true;
    in property <int> pref-day-start: 8;
    in property <[string]> accounts;
    callback switch-account(string);
    callback add-account();
    in property <[string]> tpl-names: ["Insert template…"];
    in-out property <int> tpl-index;
    callback tpl-refresh();
    callback tpl-insert(int);
    in-out property <bool> sf-open;
    in-out property <string> sf-from;
    in-out property <string> sf-to;
    in-out property <string> sf-subject;
    in-out property <string> sf-body;
    in-out property <string> sf-after;
    in-out property <string> sf-before;
    in-out property <string> sf-min;
    in-out property <string> sf-max;
    in-out property <bool> sf-unread;
    in-out property <bool> sf-starred;
    in-out property <bool> sf-attach;
    in property <bool> sf-active;
    callback sf-apply();
    callback sf-clear();
    in property <length> mail-row-height: 82px;
    in-out property <string> quick-text;
    in-out property <int> app: 0;
    callback app-changed(int);
    in property <int> cal-view: 1;
    in property <[string]> cal-weekdays: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    in property <[string]> cal-week-nums;
    in property <bool> cal-show-weeknums: false;
    in property <int> cal-hour-from: 0;
    in property <int> cal-hour-to: 24;
    // minutes since local midnight, for the current-time line in the day and week views
    in property <int> now-minutes: -1;
    in property <string> cal-title;
    in property <string> mini-title;
    in property <[MiniDay]> mini-month;
    in property <[CalItem]> calendars;
    in property <[CalCell]> cal-cells;
    in property <[CalCell]> cal-days;
    in property <[CalEvent]> cal-events;
    callback cal-nav(string);
    callback cal-set-view(int);
    // event hover preview (calendarHoverPreview): delay in ms, -1 = off
    in property <int> cal-hover-delay: 500;
    // calendarFreeScroll: the wheel moves through months in the month view
    in property <bool> cal-free-scroll: true;
    // a calendar pane under 1000px wide (week view shows three days unless calendarNarrowWeekAllDays)
    out property <bool> cal-narrow: root.width - 266px < 1000px;
    changed cal-narrow => { if root.app == 1 { root.cal-nav("rerender"); } }
    property <CalEvent> hov-ev;
    property <bool> hov-on;
    property <bool> hov-shown;
    property <length> hov-x;
    property <length> hov-y;
    function cal-hover(e: CalEvent, on: bool, x: length, y: length) {
        if on && root.cal-hover-delay >= 0 {
            root.hov-ev = e; root.hov-x = x; root.hov-y = y;
            root.hov-shown = root.cal-hover-delay == 0;
            root.hov-on = true;
        } else if !on && root.hov-ev.id == e.id {
            root.hov-on = false; root.hov-shown = false;
        }
    }
    hov-timer := Timer {
        interval: max(1, root.cal-hover-delay) * 1ms;
        running: root.hov-on && !root.hov-shown;
        triggered => { root.hov-shown = true; }
    }
    callback cal-toggle(string);
    callback cal-search(string);
    callback cal-edit(string, string, int);
    in-out property <bool> ev-open;
    in-out property <string> ev-id;
    in-out property <string> ev-title;
    in-out property <string> ev-date;
    in-out property <string> ev-start;
    in-out property <string> ev-end;
    in-out property <bool> ev-all-day;
    in-out property <string> ev-location;
    in-out property <string> ev-description;
    in-out property <int> ev-repeat;
