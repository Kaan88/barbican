import { LineEdit, Button, ListView, ScrollView, TextEdit, ComboBox, CheckBox } from "std-widgets.slint";

export struct Folder {
    id: string,
    name: string,
    icon: string,
    depth: int,
    unread: int,
    total: int,
    color: color,
    count: string,
    chevron: int,
    muted: bool,
}

export struct Tag {
    id: string,
    name: string,
    color: color,
    count: string,
}

export struct PRow {
    label: string,
    value: string,
    tone: string,
}

export struct Att {
    name: string,
    size: string,
    index: int,
}

export struct ChatMsg {
    role: string,
    text: string,
}

export struct Mail {
    id: string,
    sender: string,
    initials: string,
    color: color,
    subject: string,
    preview: string,
    time: string,
    unread: bool,
    attach: bool,
    header: string,
    threads: int,
    flagged: bool,
    answered: bool,
    checked: bool,
    draft: bool,
    tags: [color],
}

global Theme {
    out property <color> bg: #0a0a0a;
    out property <color> rail: #0f0f0f;
    out property <color> side: #141414;
    out property <color> line: #262626;
    out property <color> text: #fafafa;
    out property <color> dim: #adadad;
    out property <color> accent: #f0577a;
    out property <color> sel: #4a1424;
    out property <color> hover: #1a1a1a;
    out property <string> icons: "Segoe Fluent Icons";
}

export struct STab {
    id: string,
    label: string,
    icon: string,
    header: string,
    indent: int,
}

export struct SRow {
    kind: string,
    key: string,
    label: string,
    desc: string,
    options: [string],
    index: int,
    on: bool,
    text: string,
}

component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: on ? Theme.accent : #3a3a3a;
    TouchArea { clicked => { root.toggled(); } }
    Rectangle {
        x: on ? parent.width - 18px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: on ? #16070c : #d4d4d4;
        animate x { duration: 120ms; }
    }
}

component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 15px;
    color: Theme.dim;
    vertical-alignment: center;
    horizontal-alignment: center;
}

component Avatar inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: tint;
    Text {
        text: label;
        color: white;
        font-size: 12px;
        font-weight: 600;
    }
}

component RailButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: active ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Icon {
        text: glyph;
        color: active ? Theme.accent : Theme.dim;
    }
}

component FolderRow inherits Rectangle {
    in property <Folder> f;
    in property <bool> selected;
    callback clicked;
    callback chevron-clicked;
    height: 24px;
    background: selected ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: 0;
        width: 3px;
        background: selected ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 8px + f.depth * 12px;
        padding-right: 8px;
        spacing: 6px;
        Rectangle {
            width: 12px;
            if f.chevron != 0: Icon {
                text: f.chevron == 1 ? "\u{E70D}" : "\u{E76C}";
                font-size: 8px;
            }
            TouchArea { enabled: f.chevron != 0; clicked => { root.chevron-clicked(); } }
        }
        Icon {
            text: f.icon;
            font-size: 13px;
            width: 16px;
            color: f.color;
        }
        Text {
            text: f.name;
            color: selected ? #ffd5df : Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            font-weight: selected ? 600 : 400;
        }
        if f.muted: Icon { text: "\u{E7ED}"; font-size: 10px; }
        Text {
            text: f.count;
            color: f.unread > 0 ? Theme.text : Theme.dim;
            font-size: 11px;
            font-weight: f.unread > 0 ? 700 : 400;
            vertical-alignment: center;
        }
    }
}

component TagRow inherits Rectangle {
    in property <Tag> t;
    in property <bool> selected;
    callback clicked;
    height: 24px;
    background: selected ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 26px;
        padding-right: 8px;
        spacing: 8px;
        Icon { text: "\u{E8EC}"; color: t.color; font-size: 13px; width: 16px; }
        Text { text: t.name; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: t.count; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
    }
}

component HoverAction inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    background: hta.has-hover ? #2a2a2a : transparent;
    hta := TouchArea { clicked => { root.clicked(); } }
    Icon { text: glyph; font-size: 12px; color: active ? #facc15 : (hta.has-hover ? Theme.text : Theme.dim); }
}

component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> show-label: true;
    callback clicked;
    height: 28px;
    width: lay.preferred-width;
    border-radius: 6px;
    background: tta.has-hover ? Theme.hover : transparent;
    tta := TouchArea { clicked => { root.clicked(); } }
    lay := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Icon { text: glyph; font-size: 12px; color: Theme.text; }
        if show-label: Text { text: label; color: Theme.text; vertical-alignment: center; }
    }
}

component MailRow inherits VerticalLayout {
    in property <Mail> m;
    in property <bool> selected;
    callback clicked;
    callback ctrl-clicked;
    callback action(string);
    callback header-clicked;
    if m.header != "": Rectangle {
        height: 32px;
        TouchArea { clicked => { root.header-clicked(); } }
        HorizontalLayout {
            padding-left: 16px;
            spacing: 8px;
            Icon { text: "\u{E70D}"; font-size: 9px; width: 12px; }
            Text { text: m.header; color: Theme.text; font-weight: 600; vertical-alignment: center; }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    }
    Rectangle {
        height: 82px;
        background: selected || m.checked ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
        ta := TouchArea {
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left {
                    if ev.modifiers.control || ev.modifiers.shift { root.ctrl-clicked(); } else { root.clicked(); }
                }
            }
        }
        if m.tags.length > 0: Rectangle {
            x: 0; width: 3px; background: m.tags[0];
        }
        HorizontalLayout {
            padding: 10px;
            padding-left: 10px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Avatar { label: m.initials; tint: m.color; }
            }
            VerticalLayout {
                spacing: 3px;
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: m.draft ? "Draft" : m.sender;
                        color: m.draft ? #ef4444 : (m.unread ? Theme.text : Theme.dim);
                        font-weight: m.unread ? 700 : 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if m.threads > 1: Rectangle {
                        width: tc.preferred-width + 22px;
                        height: 16px;
                        border-radius: 4px;
                        background: #262626;
                        HorizontalLayout {
                            padding-left: 4px;
                            spacing: 3px;
                            Icon { text: "\u{E8BD}"; font-size: 9px; }
                            tc := Text { text: m.threads; color: Theme.dim; font-size: 10px; vertical-alignment: center; }
                        }
                    }
                    if m.answered: Icon { text: "\u{E97A}"; font-size: 11px; }
                    if m.attach: Icon { text: "\u{E723}"; font-size: 11px; }
                    if !ta.has-hover: Text { text: m.time; color: Theme.dim; font-size: 11px; }
                    if ta.has-hover: HorizontalLayout {
                        spacing: 0px;
                        HoverAction { glyph: "\u{E74D}"; clicked => { root.action("delete"); } }
                        HoverAction { glyph: m.flagged ? "\u{E735}" : "\u{E734}"; active: m.flagged; clicked => { root.action("star"); } }
                        HoverAction { glyph: m.unread ? "\u{E8C3}" : "\u{E715}"; clicked => { root.action("read"); } }
                        HoverAction { glyph: "\u{E7B8}"; clicked => { root.action("archive"); } }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: m.subject;
                        color: Theme.text;
                        font-weight: m.unread ? 700 : 400;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if m.flagged && !ta.has-hover: Icon { text: "\u{E735}"; font-size: 11px; color: #facc15; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: m.preview; color: Theme.dim; overflow: elide; horizontal-stretch: 1; }
                    for c in m.tags: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: c; y: 4px; }
                }
            }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    }
}

export component AppWindow inherits Window {
    title: "Barbican";
    icon: @image-url("barbican.svg");
    background: Theme.bg;
    preferred-width: 1400px;
    preferred-height: 900px;
    default-font-size: 13px;

    in-out property <bool> logged-in: false;
    in property <bool> busy: false;
    in property <string> status;
    in property <string> account;
    in property <string> initials: "?";
    in property <[Folder]> folders;
    in property <[Mail]> mails;
    in-out property <string> current-folder;
    in-out property <string> current-mail;
    in property <string> r-subject;
    in property <string> r-from;
    in property <string> r-date;
    in property <string> r-body;
    in-out property <string> server;
    in-out property <string> user;
    in-out property <string> search;

    callback login(string, string, string, string, bool);
    callback sso-login(string, string, bool);
    callback sign-out();
    in-out property <string> client-id: "barbican";
    in-out property <bool> remember: true;
    in-out property <bool> show-advanced;
    callback select-folder(string);
    callback open-mail(string);
    callback do-search(string);
    callback refresh();
    callback compose-new();
    callback open-settings();
    callback save-settings();
    callback ai-reader(string);
    callback ai-compose(string);
    callback ai-undo();
    in property <string> spam-verdict;
    in property <string> spam-detail;
    in-out property <string> ai-result;
    in property <bool> ai-busy;
    in property <bool> can-undo;
    in-out property <bool> show-settings;
    in-out property <int> ai-provider;
    in-out property <string> ai-base;
    in-out property <string> ai-key;
    in-out property <string> ai-model;
    in-out property <string> ai-lang;
    in-out property <bool> spam-show-clean: true;
    in-out property <int> ai-actions: 1;
    in-out property <string> ai-instructions;
    in-out property <string> ai-prompts;
    in-out property <bool> ai-memory-on: true;
    in-out property <string> ai-memory;
    in-out property <bool> ai-hidden;
    in-out property <bool> chat-open;
    in property <[ChatMsg]> chat;
    in property <bool> chat-busy;
    in property <[string]> chips;
    in property <string> confirm-text;
    in-out property <string> chat-input;
    callback chat-send(string);
    in property <[Tag]> tags;
    in-out property <string> current-tag;
    in property <bool> has-more;
    in property <int> checked-count;
    in property <string> r-email;
    in property <string> r-to;
    in property <string> r-initials;
    in property <color> r-color: #6366f1;
    in property <bool> r-flagged;
    in property <[Att]> attachments;
    in-out property <string> toast;
    in property <bool> toast-undo;
    in-out property <bool> folders-collapsed;
    in-out property <bool> tags-collapsed;
    callback toggle-folder(string);
    callback select-tag(string);
    callback row-action(string, string);
    callback toggle-check(string);
    callback select-all();
    callback bulk(string);
    callback act(string);
    callback move-to(string);
    callback tag-toggle(string);
    callback load-more();
    callback quick-reply(string);
    callback open-attachment(int);
    callback save-attachment(int);
    callback undo-toast();
    in property <[PRow]> plugin-rows;
    in-out property <string> c-cc;
    in-out property <string> c-bcc;
    in-out property <bool> c-show-ccbcc;
    in property <[string]> c-identities;
    in-out property <int> c-from-index;
    in property <[Att]> c-attachments;
    callback attach-file();
    callback remove-attachment(int);
    callback save-draft(bool);
    callback discard-draft();
    callback send-now();
    in property <[STab]> settings-tabs;
    in property <[SRow]> settings-rows;
    in-out property <string> settings-tab: "account";
    in property <string> settings-title;
    in-out property <string> settings-query;
    in-out property <bool> show-advanced-settings;
    callback settings-open-tab(string);
    callback settings-search(string);
    callback settings-set-toggle(string, bool);
    callback settings-set-select(string, int);
    callback settings-set-text(string, string);
    callback settings-button(string);
    callback load-images();
    callback rerender();
    callback lite-click(length, length);
    in-out property <int> render-mode;
    in-out property <bool> auto-images;
    in property <bool> images-blocked;
    in property <image> lite-image;
    in property <length> lite-height;
    callback chat-new();
    callback chat-stop();
    callback confirm-action(bool);
    public function scroll-chat() {
        chat-list.content-y = min(0px, chat-list.visible-height - chat-list.content-height);
    }
    callback reply();
    callback delete-mail();
    callback send-mail(string, string, string);
    in-out property <bool> composing: false;
    in property <bool> sending: false;
    in-out property <string> c-to;
    in-out property <string> c-subject;
    in-out property <string> c-body;
    in property <string> c-status;
    out property <length> bx: body.absolute-position.x;
    out property <length> by: body.absolute-position.y;
    out property <length> bw: body.width;
    out property <length> bh: body.height;
    out property <bool> body-visible: logged-in && current-mail != "" && !composing && !show-settings && render-mode == 0;

    Rectangle {
        visible: !logged-in;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 360px;
                    background: Theme.side;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.line;
                    VerticalLayout {
                        padding: 28px;
                        spacing: 12px;
                        Image { source: @image-url("barbican.svg"); width: 48px; height: 48px; }
                        Text { text: "Barbican"; font-size: 24px; font-weight: 700; color: Theme.text; }
                        Text { text: "Sign in to your Stalwart server"; color: Theme.dim; }
                        srv := LineEdit { placeholder-text: "https://mail.example.com"; text <=> root.server; }
                        usr := LineEdit { placeholder-text: "Username or email"; text <=> root.user; }
                        pwd := LineEdit {
                            placeholder-text: "Password or app password";
                            input-type: password;
                            accepted => { root.login(srv.text, usr.text, pwd.text, otp.text, root.remember); }
                        }
                        otp := LineEdit {
                            placeholder-text: "2FA code (only if enabled)";
                            accepted => { root.login(srv.text, usr.text, pwd.text, otp.text, root.remember); }
                        }
                        CheckBox { text: "Remember me on this computer"; checked <=> root.remember; }
                        Button {
                            text: root.busy ? "Signing in…" : "Sign in";
                            primary: true;
                            enabled: !root.busy;
                            clicked => { root.login(srv.text, usr.text, pwd.text, otp.text, root.remember); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { height: 1px; background: Theme.line; y: parent.height / 2; }
                            Text { text: "or"; color: Theme.dim; horizontal-stretch: 0; }
                            Rectangle { height: 1px; background: Theme.line; y: parent.height / 2; }
                        }
                        Button {
                            text: "Sign in with SSO";
                            enabled: !root.busy;
                            clicked => { root.sso-login(srv.text, usr.text, root.remember); }
                        }
                        Text {
                            text: root.show-advanced ? "Hide advanced" : "Advanced";
                            color: Theme.dim;
                            font-size: 11px;
                            TouchArea { clicked => { root.show-advanced = !root.show-advanced; } }
                        }
                        if root.show-advanced: VerticalLayout {
                            spacing: 4px;
                            Text { text: "OAuth client ID (used when the server does not allow automatic registration). Register redirect URI http://127.0.0.1/callback for it."; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
                            LineEdit { text <=> root.client-id; }
                        }
                        Text { text: root.status; color: Theme.accent; wrap: word-wrap; }
                    }
                }
            }
        }
    }

    Rectangle {
      visible: logged-in;
      HorizontalLayout {
        // icon rail
        Rectangle {
            width: 44px;
            background: Theme.rail;
            VerticalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                alignment: start;
                HorizontalLayout {
                    alignment: center;
                    Image { source: @image-url("barbican.svg"); width: 30px; height: 30px; }
                }
                Rectangle { height: 14px; }
                HorizontalLayout { alignment: center; RailButton { glyph: "\u{E715}"; active: true; } }
                HorizontalLayout { alignment: center; RailButton { glyph: "\u{E787}"; } }
                HorizontalLayout { alignment: center; RailButton { glyph: "\u{E716}"; } }
                HorizontalLayout { alignment: center; RailButton { glyph: "\u{E8B7}"; } }
                if !root.ai-hidden: HorizontalLayout { alignment: center; RailButton { glyph: "\u{E945}"; active: root.chat-open; clicked => { root.chat-open = !root.chat-open; } } }
            }
            VerticalLayout {
                padding-bottom: 10px;
                spacing: 8px;
                alignment: end;
                HorizontalLayout { alignment: center; RailButton { glyph: "\u{E713}"; clicked => { root.open-settings(); } } }
                HorizontalLayout { alignment: center; Avatar { label: root.initials; tint: #e07a10; width: 28px; height: 28px; border-radius: 14px; } }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }

        // folder sidebar
        Rectangle {
            width: 220px;
            background: Theme.side;
            VerticalLayout {
                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Avatar { label: root.initials; tint: #e07a10; width: 30px; height: 30px; border-radius: 15px; }
                    Text { text: root.account; color: Theme.text; font-weight: 600; vertical-alignment: center; overflow: elide; }
                }
                Rectangle {
                    height: 50px;
                    Rectangle {
                        x: 8px; y: 6px; width: parent.width - 16px; height: 36px;
                        border-radius: 18px;
                        background: cta.has-hover ? #f46d8c : Theme.accent;
                        cta := TouchArea { clicked => { root.compose-new(); } }
                        HorizontalLayout {
                            padding-left: 16px;
                            spacing: 8px;
                            Icon { text: "\u{E70F}"; color: white; width: 16px; }
                            Text { text: "Compose"; color: white; font-weight: 600; font-size: 14px; vertical-alignment: center; }
                        }
                    }
                }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            height: 30px;
                            fh := TouchArea { clicked => { root.folders-collapsed = !root.folders-collapsed; } }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 6px;
                                Icon { text: root.folders-collapsed ? "\u{E76C}" : "\u{E70D}"; font-size: 8px; width: 12px; }
                                Text { text: "Folders"; color: Theme.text; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                Icon { text: "\u{E713}"; font-size: 11px; TouchArea { clicked => { root.settings-tab = "organize"; root.open-settings(); } } }
                            }
                        }
                        if !root.folders-collapsed: VerticalLayout {
                            for f in root.folders: FolderRow {
                                f: f;
                                selected: f.id == root.current-folder && root.current-tag == "";
                                clicked => {
                                    root.current-tag = "";
                                    root.current-folder = f.id;
                                    root.select-folder(f.id);
                                }
                                chevron-clicked => { root.toggle-folder(f.id); }
                            }
                        }
                        Rectangle { height: 10px; }
                        Rectangle {
                            height: 30px;
                            TouchArea { clicked => { root.tags-collapsed = !root.tags-collapsed; } }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 6px;
                                Icon { text: root.tags-collapsed ? "\u{E76C}" : "\u{E70D}"; font-size: 8px; width: 12px; }
                                Text { text: "Tags"; color: Theme.text; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                Icon { text: "\u{E713}"; font-size: 11px; TouchArea { clicked => { root.settings-tab = "organize"; root.open-settings(); } } }
                            }
                        }
                        if !root.tags-collapsed: VerticalLayout {
                            for t in root.tags: TagRow {
                                t: t;
                                selected: t.id == root.current-tag;
                                clicked => { root.current-tag = t.id; root.select-tag(t.id); }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }

        // message list
        Rectangle {
            width: 330px;
            background: Theme.bg;
            VerticalLayout {
                HorizontalLayout {
                    padding: 8px;
                    spacing: 6px;
                    height: 44px;
                    Rectangle {
                        width: 24px;
                        sa := TouchArea { clicked => { root.select-all(); } }
                        Rectangle {
                            width: 14px; height: 14px; border-radius: 3px;
                            border-width: 1px; border-color: Theme.dim;
                            background: root.checked-count > 0 ? Theme.accent : transparent;
                        }
                    }
                    LineEdit {
                        placeholder-text: "Search mail…";
                        text <=> root.search;
                        accepted(t) => { root.do-search(t); }
                    }
                    Rectangle {
                        width: 26px;
                        rta := TouchArea { clicked => { root.refresh(); } }
                        Icon { text: "\u{E72C}"; font-size: 12px; color: rta.has-hover ? Theme.text : Theme.dim; }
                    }
                }
                if root.checked-count > 0: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    height: 34px;
                    spacing: 2px;
                    Text { text: root.checked-count + " selected"; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    HoverAction { glyph: "\u{E7B8}"; clicked => { root.bulk("archive"); } }
                    HoverAction { glyph: "\u{E74D}"; clicked => { root.bulk("delete"); } }
                    HoverAction { glyph: "\u{E8C3}"; clicked => { root.bulk("read"); } }
                    HoverAction { glyph: "\u{E715}"; clicked => { root.bulk("unread"); } }
                    HoverAction { glyph: "\u{E734}"; clicked => { root.bulk("star"); } }
                    HoverAction { glyph: "\u{E8F8}"; clicked => { root.bulk("spam"); } }
                    HoverAction { glyph: "\u{E711}"; clicked => { root.bulk("clear"); } }
                }
                Rectangle { height: 1px; background: Theme.line; }
                if root.busy: Text { text: "Loading…"; color: Theme.dim; horizontal-alignment: center; height: 24px; vertical-alignment: center; }
                mail-list := ListView {
                    changed content-y => {
                        if root.has-more && !root.busy && (self.content-height + self.content-y - self.visible-height) < 300px { root.load-more(); }
                    }
                    for m in root.mails: MailRow {
                        m: m;
                        selected: m.id == root.current-mail;
                        clicked => {
                            root.current-mail = m.id;
                            root.open-mail(m.id);
                        }
                        ctrl-clicked => { root.toggle-check(m.id); }
                        action(a) => { root.row-action(m.id, a); }
                    }
                }
                if !root.busy && root.mails.length > 0: Rectangle {
                    height: 50px;
                    Text {
                        text: root.has-more ? "Loading more…" : "No more emails to load";
                        color: Theme.dim;
                        font-size: 12px;
                }
                }
                if !root.busy && root.mails.length == 0: Rectangle {
                    height: 80px;
                    Text { text: "No messages"; color: Theme.dim; }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }

        // reader
        Rectangle {
            horizontal-stretch: 1;
            background: #121213;
            VerticalLayout {
                visible: root.current-mail == "";
                alignment: center;
                spacing: 10px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 68px; height: 68px; border-radius: 34px; background: #1d1d1f;
                        Icon { text: "\u{E715}"; font-size: 28px; color: Theme.text; }
                    }
                }
                Text { text: "No conversation selected"; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-alignment: center; }
                Text { text: "Choose a conversation from the list to read it here"; color: Theme.dim; horizontal-alignment: center; }
            }
            VerticalLayout {
                visible: root.current-mail != "";
                padding: 0px;
                spacing: 0px;
                HorizontalLayout {
                    height: 40px;
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 2px;
                    ToolButton { glyph: "\u{E97A}"; label: "Reply"; clicked => { root.act("reply"); } }
                    ToolButton { glyph: "\u{EE35}"; label: "Reply all"; clicked => { root.act("reply-all"); } }
                    ToolButton { glyph: "\u{E72D}"; label: "Forward"; clicked => { root.act("forward"); } }
                    Rectangle { horizontal-stretch: 1; }
                    ToolButton { glyph: "\u{E7B8}"; label: "Archive"; clicked => { root.act("archive"); } }
                    ToolButton { glyph: "\u{E74D}"; label: "Delete"; clicked => { root.act("delete"); } }
                    ToolButton { glyph: "\u{E8DE}"; label: "Move"; clicked => { move-popup.show(); } }
                    ToolButton { glyph: "\u{E8EC}"; label: "Tag"; clicked => { tag-popup.show(); } }
                    ToolButton { glyph: "\u{E8F8}"; label: "Report spam"; clicked => { root.act("spam"); } }
                    ToolButton { glyph: "\u{E715}"; label: "Unread"; clicked => { root.act("unread"); } }
                    ToolButton { glyph: "\u{E749}"; label: "Print"; clicked => { root.act("print"); } }
                    move-popup := PopupWindow {
                        x: -300px; y: 32px; width: 240px;
                        Rectangle {
                            background: #1c1c1c; border-radius: 8px; border-width: 1px; border-color: Theme.line;
                            VerticalLayout {
                                padding: 6px;
                                for f in root.folders: Rectangle {
                                    height: 26px; border-radius: 4px;
                                    background: mta.has-hover ? Theme.hover : transparent;
                                    mta := TouchArea { clicked => { root.move-to(f.id); } }
                                    HorizontalLayout {
                                        padding-left: 8px + f.depth * 12px; spacing: 8px;
                                        Icon { text: f.icon; font-size: 12px; width: 16px; color: f.color; }
                                        Text { text: f.name; color: Theme.text; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    tag-popup := PopupWindow {
                        x: -200px; y: 32px; width: 200px;
                        Rectangle {
                            background: #1c1c1c; border-radius: 8px; border-width: 1px; border-color: Theme.line;
                            VerticalLayout {
                                padding: 6px;
                                for t in root.tags: Rectangle {
                                    height: 26px; border-radius: 4px;
                                    background: tgta.has-hover ? Theme.hover : transparent;
                                    tgta := TouchArea { clicked => { root.tag-toggle(t.id); } }
                                    HorizontalLayout {
                                        padding-left: 8px; spacing: 8px;
                                        Icon { text: "\u{E8EC}"; font-size: 12px; width: 16px; color: t.color; }
                                        Text { text: t.name; color: Theme.text; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    padding: 16px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    Text { text: root.r-subject; color: Theme.text; font-size: 18px; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; }
                    Icon {
                        text: root.r-flagged ? "\u{E735}" : "\u{E734}";
                        color: root.r-flagged ? #facc15 : Theme.dim;
                        TouchArea { clicked => { root.act("star"); } }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    padding: 16px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;
                    Avatar { label: root.r-initials; tint: root.r-color; }
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: root.r-from; color: Theme.text; font-weight: 700; overflow: elide; }
                            Text { text: "<" + root.r-email + ">"; color: Theme.dim; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                        Text { text: "To: " + root.r-to; color: Theme.dim; font-size: 11px; overflow: elide; }
                    }
                    Text { text: root.r-date; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                    HoverAction { glyph: "\u{E97A}"; clicked => { root.act("reply"); } }
                    HoverAction { glyph: "\u{EE35}"; clicked => { root.act("reply-all"); } }
                    HoverAction { glyph: "\u{E72D}"; clicked => { root.act("forward"); } }
                }
                for pr in root.plugin-rows: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    Rectangle {
                        width: pl.preferred-width + 16px;
                        height: 20px;
                        border-radius: 10px;
                        background: pr.tone == "danger" ? #5c1622 : pr.tone == "warning" ? #5a4210 : pr.tone == "success" ? #14462a : #262626;
                        pl := Text {
                            text: pr.label;
                            font-size: 10px;
                            font-weight: 700;
                            color: pr.tone == "danger" ? #ff8fa3 : pr.tone == "warning" ? #ffd27a : pr.tone == "success" ? #7ee2a8 : Theme.text;
                        }
                    }
                    Text { text: pr.value; color: Theme.dim; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
                if root.attachments.length > 0: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 8px;
                    spacing: 6px;
                    alignment: start;
                    for a in root.attachments: Rectangle {
                        height: 26px;
                        width: al.preferred-width;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: ata.has-hover ? Theme.hover : transparent;
                        ata := TouchArea { clicked => { root.open-attachment(a.index); } }
                        al := HorizontalLayout {
                            padding-left: 8px; padding-right: 4px; spacing: 6px;
                            Icon { text: "\u{E723}"; font-size: 11px; color: Theme.accent; }
                            Text { text: a.name; color: Theme.text; font-size: 11px; vertical-alignment: center; max-width: 180px; overflow: elide; }
                            Text { text: a.size; color: Theme.dim; font-size: 10px; vertical-alignment: center; }
                            HoverAction { glyph: "\u{E896}"; clicked => { root.save-attachment(a.index); } }
                        }
                    }
                }
                if root.spam-verdict != "": HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: badge.preferred-width + 18px;
                        height: 22px;
                        border-radius: 11px;
                        background: root.spam-verdict == "spam" ? #5c1622 : root.spam-verdict == "suspicious" ? #5a4210 : #14462a;
                        badge := Text {
                            text: root.spam-verdict == "spam" ? "Spam" : root.spam-verdict == "suspicious" ? "Suspicious" : "Clean";
                            color: root.spam-verdict == "spam" ? #ff8fa3 : root.spam-verdict == "suspicious" ? #ffd27a : #7ee2a8;
                            font-size: 11px;
                            font-weight: 700;
                        }
                    }
                    Text { text: root.spam-detail; color: Theme.dim; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
                Rectangle { height: 1px; background: Theme.line; }
                if root.images-blocked: HorizontalLayout {
                    spacing: 8px;
                    Icon { text: "\u{E91B}"; width: 16px; }
                    Text { text: "Remote images were blocked to protect your privacy."; color: Theme.dim; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Button { text: "Load images"; clicked => { root.load-images(); } }
                }
                body := Rectangle {
                    background: white;
                    border-radius: 0px;
                    vertical-stretch: 1;
                    clip: true;
                    if root.render-mode == 1: ScrollView {
                        content-height: root.lite-height;
                        content-width: self.visible-width;
                        Image {
                            x: 0; y: 0;
                            source: root.lite-image;
                            width: parent.width;
                            height: root.lite-height;
                            image-fit: fill;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.lite-click(self.mouse-x, self.mouse-y); }
                            }
                        }
                    }
                    if root.render-mode == 2: ScrollView {
                        VerticalLayout {
                            padding: 16px;
                            TextInput { text: root.r-body; read-only: true; single-line: false; wrap: word-wrap; color: #111111; font-size: 14px; }
                        }
                    }
                }
                }
            }

        Rectangle { width: root.chat-open && !root.ai-hidden ? 1px : 0px; background: Theme.line; }
        Rectangle {
            width: root.chat-open && !root.ai-hidden ? 400px : 0px;
            visible: root.chat-open && !root.ai-hidden;
            background: Theme.side;
            VerticalLayout {
                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    height: 48px;
                    Icon { text: "\u{E945}"; color: Theme.accent; width: 18px; }
                    Text { text: "Assistant"; color: Theme.text; font-weight: 700; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                    Button { text: "New chat"; enabled: !root.chat-busy; clicked => { root.chat-new(); } }
                    Rectangle {
                        width: 28px;
                        clx := TouchArea { clicked => { root.chat-open = false; } }
                        Icon { text: "\u{E711}"; font-size: 11px; color: clx.has-hover ? Theme.text : Theme.dim; }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                if root.chat.length == 0: VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    vertical-stretch: 1;
                    alignment: start;
                    Text { text: "Ask about your mail, calendar and contacts, or have me act on them."; color: Theme.dim; wrap: word-wrap; }
                    Rectangle { height: 4px; }
                    for c in root.chips: Rectangle {
                        height: 32px;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: chta.has-hover ? Theme.hover : transparent;
                        chta := TouchArea { clicked => { root.chat-send(c); } }
                        HorizontalLayout {
                            padding-left: 14px;
                            Text { text: c; color: Theme.text; vertical-alignment: center; }
                        }
                    }
                }
                chat-list := ListView {
                    vertical-stretch: root.chat.length == 0 ? 0 : 1;
                    for m in root.chat: HorizontalLayout {
                        padding-top: m.role == "tool" ? 1px : 6px;
                        padding-bottom: m.role == "tool" ? 1px : 6px;
                        padding-left: m.role == "user" ? 48px : 10px;
                        padding-right: m.role == "user" ? 10px : 24px;
                        Rectangle {
                            background: m.role == "user" ? Theme.sel : m.role == "assistant" ? #1f1f22 : transparent;
                            border-radius: 8px;
                            VerticalLayout {
                                padding: m.role == "tool" ? 2px : 10px;
                                TextInput {
                                    text: m.text;
                                    read-only: true;
                                    wrap: word-wrap;
                                    single-line: false;
                                    color: m.role == "tool" ? Theme.dim : m.role == "error" ? #ff8fa3 : Theme.text;
                                    font-size: m.role == "tool" ? 11px : 13px;
                                }
                            }
                        }
                    }
                }
                if root.confirm-text != "": Rectangle {
                    background: #2a1a1f;
                    border-width: 1px;
                    border-color: Theme.accent;
                    border-radius: 8px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text { text: "The assistant wants to:"; color: Theme.dim; font-size: 11px; }
                        Text { text: root.confirm-text; color: Theme.text; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Button { text: "Deny"; clicked => { root.confirm-action(false); } }
                            Button { text: "Allow"; primary: true; clicked => { root.confirm-action(true); } }
                        }
                    }
                }
                HorizontalLayout {
                    padding: 10px;
                    spacing: 6px;
                    if root.chat-busy: Text { text: "Working…"; color: Theme.dim; vertical-alignment: center; horizontal-stretch: 1; }
                    if root.chat-busy: Button { text: "Stop"; clicked => { root.chat-stop(); } }
                    if !root.chat-busy: LineEdit {
                        placeholder-text: "Ask anything — / for saved prompts";
                        text <=> root.chat-input;
                        accepted(t) => { root.chat-send(t); }
                    }
                    if !root.chat-busy: Button { text: "Send"; primary: true; clicked => { root.chat-send(root.chat-input); } }
                }
            }
        }
        }
    }
  
    if composing: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            width: min(760px, parent.width - 40px);
            height: min(640px, parent.height - 40px);
            background: Theme.side;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 0px;
                HorizontalLayout {
                    height: 44px;
                    padding-left: 16px;
                    padding-right: 8px;
                    Text { text: root.c-subject == "" ? "New message" : root.c-subject; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    HoverAction { glyph: "\u{E711}"; y: 11px; clicked => { root.save-draft(true); } }
                }
                Rectangle { height: 1px; background: Theme.line; }
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "From"; color: Theme.dim; width: 52px; vertical-alignment: center; }
                        ComboBox { model: root.c-identities; current-index <=> root.c-from-index; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "To"; color: Theme.dim; width: 52px; vertical-alignment: center; }
                        LineEdit { placeholder-text: "Recipients, separated by commas"; text <=> root.c-to; }
                        if !root.c-show-ccbcc: Text {
                            text: "Cc Bcc"; color: Theme.dim; vertical-alignment: center;
                            TouchArea { clicked => { root.c-show-ccbcc = true; } }
                        }
                    }
                    if root.c-show-ccbcc: HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Cc"; color: Theme.dim; width: 52px; vertical-alignment: center; }
                        LineEdit { text <=> root.c-cc; }
                    }
                    if root.c-show-ccbcc: HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Bcc"; color: Theme.dim; width: 52px; vertical-alignment: center; }
                        LineEdit { text <=> root.c-bcc; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Subject"; color: Theme.dim; width: 52px; vertical-alignment: center; }
                        LineEdit { text <=> root.c-subject; }
                    }
                    TextEdit { text <=> root.c-body; vertical-stretch: 1; wrap: word-wrap; enabled: !root.ai-busy; }
                    if root.c-attachments.length > 0: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for a in root.c-attachments: Rectangle {
                            height: 26px;
                            width: cal.preferred-width;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.line;
                            cal := HorizontalLayout {
                                padding-left: 8px; padding-right: 2px; spacing: 6px;
                                Icon { text: "\u{E723}"; font-size: 11px; color: Theme.accent; }
                                Text { text: a.name; color: Theme.text; font-size: 11px; vertical-alignment: center; max-width: 180px; overflow: elide; }
                                Text { text: a.size; color: Theme.dim; font-size: 10px; vertical-alignment: center; }
                                HoverAction { glyph: "\u{E711}"; clicked => { root.remove-attachment(a.index); } }
                            }
                        }
                    }
                    if !root.ai-hidden: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Icon { text: "\u{E945}"; color: Theme.accent; width: 18px; }
                        for a in ["Improve", "Shorten", "Formal", "Casual", "Fix spelling", "Translate"]: Button {
                            text: a;
                            enabled: !root.ai-busy;
                            clicked => { root.ai-compose(a); }
                        }
                        if root.can-undo: Button { text: "Undo"; enabled: !root.ai-busy; clicked => { root.ai-undo(); } }
                        if root.ai-busy: Text { text: "Thinking…"; color: Theme.dim; vertical-alignment: center; }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Rectangle {
                        width: 96px;
                        height: 32px;
                        border-radius: 16px;
                        background: root.sending ? #7a2c3e : (sbt.has-hover ? #f46d8c : Theme.accent);
                        sbt := TouchArea { enabled: !root.sending; clicked => { root.send-now(); } }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Icon { text: "\u{E724}"; color: #16070c; font-size: 12px; }
                            Text { text: root.sending ? "Sending…" : "Send"; color: #16070c; font-weight: 700; vertical-alignment: center; }
                        }
                    }
                    ToolButton { glyph: "\u{E723}"; label: "Attach"; y: 2px; clicked => { root.attach-file(); } }
                    Text { text: root.c-status; color: Theme.accent; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    ToolButton { glyph: "\u{E74E}"; label: "Save draft"; y: 2px; clicked => { root.save-draft(false); } }
                    ToolButton { glyph: "\u{E74D}"; label: "Discard"; y: 2px; clicked => { root.discard-draft(); } }
                }
            }
        }
    }

    if root.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 64px;
        width: tl.preferred-width;
        height: 40px;
        border-radius: 8px;
        background: #262626;
        border-width: 1px;
        border-color: #3a3a3a;
        tl := HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;
            spacing: 12px;
            Text { text: root.toast; color: Theme.text; vertical-alignment: center; }
            if root.toast-undo: Rectangle {
                width: 56px;
                ut := TouchArea { clicked => { root.undo-toast(); } }
                Text { text: "Undo"; color: Theme.accent; font-weight: 700; }
            }
            HoverAction { glyph: "\u{E711}"; y: 9px; clicked => { root.toast = ""; } }
        }
    }

    if show-settings: Rectangle {
        x: 45px;
        width: parent.width - 45px;
        background: Theme.bg;
        TouchArea { }
        HorizontalLayout {
            // ---- settings navigation ----
            Rectangle {
                width: 200px;
                background: Theme.side;
                VerticalLayout {
                    padding-top: 6px;
                    Rectangle {
                        height: 32px;
                        bta := TouchArea { clicked => { root.show-settings = false; } }
                        HorizontalLayout {
                            padding-left: 16px;
                            spacing: 8px;
                            Icon { text: "\u{E72B}"; font-size: 12px; width: 14px; color: Theme.text; }
                            Text { text: "Back to mail"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        padding: 10px;
                        padding-top: 4px;
                        LineEdit {
                            placeholder-text: "Search settings";
                            text <=> root.settings-query;
                            edited(t) => { root.settings-search(t); }
                        }
                    }
                    ListView {
                        for t in root.settings-tabs: VerticalLayout {
                            if t.header != "": Rectangle {
                                height: t.header == "-" ? 13px : 30px;
                                Rectangle { y: 6px; x: 12px; width: parent.width - 24px; height: 1px; background: Theme.line; }
                                if t.header != "-": Text { x: 16px; y: 14px; text: t.header; color: Theme.dim; font-size: 11px; }
                            }
                            Rectangle {
                                height: 28px;
                                x: 8px;
                                width: parent.width - 16px;
                                border-radius: 6px;
                                background: t.id == root.settings-tab ? Theme.sel : nta.has-hover ? Theme.hover : transparent;
                                nta := TouchArea { clicked => { root.settings-open-tab(t.id); } }
                                HorizontalLayout {
                                    padding-left: 10px + t.indent * 16px;
                                    spacing: 8px;
                                    Icon { text: t.icon; font-size: 13px; width: 16px; color: Theme.dim; }
                                    Text { text: t.label; color: Theme.text; vertical-alignment: center; overflow: elide; font-weight: t.id == root.settings-tab ? 600 : 400; }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        padding: 12px;
                        Text { text: "Show advanced settings"; color: Theme.text; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                        Switch {
                            on: root.show-advanced-settings;
                            toggled => { root.show-advanced-settings = !root.show-advanced-settings; root.settings-set-toggle("showAdvancedSettings", root.show-advanced-settings); }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }
            // ---- page ----
            VerticalLayout {
                Rectangle {
                    height: 44px;
                    Text { x: 18px; text: root.settings-title; color: Theme.text; font-weight: 600; vertical-alignment: center; height: parent.height; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                }
                ListView {
                    for r in root.settings-rows: HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            width: min(560px, root.width - 300px);
                            padding-top: r.kind == "section" ? 26px : 12px;
                            padding-bottom: r.kind == "section" ? 4px : 0px;
                            spacing: r.kind == "section" ? 4px : 10px;
                            if r.kind == "section": Text { text: r.label; color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
                            if r.kind == "section" && r.desc != "": Text { text: r.desc; color: Theme.dim; wrap: word-wrap; }
                            if r.kind == "textarea": Text { text: r.label; color: Theme.text; font-weight: 600; }
                            if r.kind == "textarea": TextEdit {
                                height: 90px;
                                text: r.text;
                                wrap: word-wrap;
                                edited(t) => { root.settings-set-text(r.key, t); }
                            }
                            if r.kind == "textarea" && r.desc != "": Text { text: r.desc; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
                            if r.kind != "section" && r.kind != "textarea": HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    Text { text: r.label; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                                    if r.desc != "": Text { text: r.desc; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    if r.kind == "toggle": Switch {
                                        on: r.on;
                                        toggled => { root.settings-set-toggle(r.key, !r.on); }
                                    }
                                    if r.kind == "select": ComboBox {
                                        width: 220px;
                                        model: r.options;
                                        current-index: r.index;
                                        selected => { root.settings-set-select(r.key, self.current-index); }
                                    }
                                    if r.kind == "text" || r.kind == "password": LineEdit {
                                        width: 220px;
                                        text: r.text;
                                        input-type: r.kind == "password" ? InputType.password : InputType.text;
                                        edited(t) => { root.settings-set-text(r.key, t); }
                                    }
                                    if r.kind == "button": Button {
                                        text: r.text;
                                        clicked => { root.settings-button(r.key); }
                                    }
                                    if r.kind == "value": Text { text: r.text; color: Theme.dim; horizontal-alignment: right; width: 240px; overflow: elide; }
                                }
                            }
                            if r.kind != "section": Rectangle { height: 1px; background: Theme.line; }
                        }
                    }
                }
            }
        }
    }
}
