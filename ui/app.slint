import { AdminDashboard, DashRow, DashPanel, DashCol, DashBar } from "dashboard.slint";
export { DashRow, DashPanel, DashCol, DashBar }
import { CalPal, CalX, CalTint, CalOverlays, AgendaView, TasksView, CalSidebarExtra, CxAttendee, CxSuggest, CxAlert, CxSlot, CxReminder, CxMissed, CxAgendaRow, CxTask, CxSub } from "calendar_ext.slint";
export { CalX, CxAttendee, CxSuggest, CxAlert, CxSlot, CxReminder, CxMissed, CxAgendaRow, CxTask, CxSub }
import { LineEdit, Button, ListView, ScrollView, TextEdit, ComboBox, CheckBox, Palette } from "std-widgets.slint";

export struct Folder {
    id: string,
    name: string,
    icon: string,
    depth: int,
    unread: int,
    total: int,
    color: color,
    count: string,
    chevron: int,
    muted: bool,
}

export struct Tag {
    id: string,
    name: string,
    color: color,
    count: string,
}

export struct PRow {
    label: string,
    value: string,
    tone: string,
}

export struct CalEvent {
    id: string,
    title: string,
    time: string,
    location: string,
    color: color,
    col: int,
    top: float,
    height: float,
    lane: int,
    lanes: int,
    date: string,
    // month view look of a timed event (calendarMonthTimedEvents): 0 bar, 1 coloured text, 2 dot and text
    style: int,
}

export struct CalCell {
    day: int,
    date: string,
    in-month: bool,
    today: bool,
    events: [CalEvent],
    more: string,
}

export struct CalItem {
    id: string,
    name: string,
    color: color,
    visible: bool,
}

export struct MiniDay {
    day: int,
    in-month: bool,
    today: bool,
    selected: bool,
    date: string,
    busy: bool,
}

export struct ContactRow {
    id: string,
    name: string,
    email: string,
    initials: string,
    color: color,
    header: string,
}

export struct FileRow {
    id: string,
    name: string,
    folder: bool,
    size: string,
    modified: string,
    renaming: bool,
    starred: bool,
    shared: bool,
    cut: bool,
    // an item listed in the Files trash
    trashed: bool,
}

export struct AdminRow {
    id: string,
    c1: string,
    c2: string,
    c3: string,
    c4: string,
}

export struct ThreadMsg {
    id: string,
    sender: string,
    date: string,
    preview: string,
    current: bool,
    unread: bool,
}

export struct TaskRow {
    id: string,
    title: string,
    due: string,
    done: bool,
}

export struct Att {
    name: string,
    size: string,
    index: int,
}

/// A sidebar row (contacts / files navigation). kind "section" is a header-only row.
export struct NavRow {
    kind: string,
    id: string,
    label: string,
    icon: string,
    count: string,
    color: color,
    depth: int,
    header: string, // section title shown above the row
}

export struct CtxItem {
    icon: string,
    label: string,
    hint: string,
    action: string,
    kind: int, // 0 item, 1 separator, 2 header
    sub: bool,
    danger: bool,
    enabled: bool,
    checked: bool,
    color: color, // tag swatch when set
}

/// Row a context menu was opened on (Bulwark highlights it while the menu is up).
export global CtxHl {
    in-out property <string> id;
}

export struct ChatMsg {
    role: string,
    text: string,
}

export struct Mail {
    id: string,
    sender: string,
    initials: string,
    color: color,
    subject: string,
    preview: string,
    time: string,
    unread: bool,
    attach: bool,
    header: string,
    threads: int,
    flagged: bool,
    answered: bool,
    checked: bool,
    draft: bool,
    tags: [color],
    account: string,
    account-color: color,
    code: string,
    row-tint: color,
    files: [string],
}

export global Theme {
    in-out property <bool> dark: true;
    // Settings > Accessibility > Contrast "More" (Bulwark data-contrast="more")
    in-out property <bool> more-contrast: false;
    // Bulwark tokens: dark (--color-*) and light (brand #c8234a, neutral greys)
    out property <color> bg: dark ? #0a0a0a : #ffffff;
    out property <color> rail: dark ? #0f0f0f : #f4f4f5;
    out property <color> side: dark ? #141414 : #fafafa;
    out property <color> line: more-contrast ? (dark ? #9ca3af : #4b5563) : (dark ? #262626 : #e5e5e5);
    out property <color> text: more-contrast ? (dark ? #ffffff : #000000) : (dark ? #fafafa : #0a0a0a);
    out property <color> dim: more-contrast ? (dark ? #e5e7eb : #1f2937) : (dark ? #adadad : #6b6b6b);
    out property <color> accent: more-contrast ? (dark ? #93c5fd : #1d4ed8) : (dark ? #f0577a : #c8234a);
    out property <color> on-accent: more-contrast ? (dark ? #000000 : #ffffff) : (dark ? #16070c : #ffffff);
    // keyboard focus outline (Bulwark --focus-ring-color)
    out property <color> ring: more-contrast ? (dark ? #ffffff : #000000) : (dark ? #f0577a : #c8234a);
    out property <color> sel: dark ? #4a1424 : #fde4ea;
    out property <color> sel-text: dark ? #ffd5df : #8c1733;
    out property <color> hover: dark ? #1a1a1a : #f0f0f0;
    out property <color> popup: dark ? #1c1c1c : #ffffff;
    out property <color> chip: dark ? #262626 : #ececec;
    out property <color> raised: dark ? #181818 : #f4f4f5;
    out property <color> zebra: dark ? #111111 : #fafafa;
    out property <color> bubble: dark ? #1f1f22 : #f1f1f3;
    out property <color> reader: dark ? #0a0a0a : #ffffff;
    out property <color> muted-day: dark ? #5a5a5a : #a3a3a3;
    out property <color> track: dark ? #3a3a3a : #d4d4d4;
    out property <string> icons: "Segoe Fluent Icons";
}

export struct STab {
    id: string,
    label: string,
    icon: string,
    header: string,
    indent: int,
}

export struct SRow {
    kind: string,
    key: string,
    label: string,
    desc: string,
    options: [string],
    index: int,
    on: bool,
    text: string,
}

component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: on ? Theme.accent : Theme.track;
    TouchArea { clicked => { root.toggled(); } }
    Rectangle {
        x: on ? parent.width - 18px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: on ? Theme.on-accent : Theme.dim;
        animate x { duration: Prefs.reduce-motion ? 0ms : 120ms; }
    }
}

component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 15px;
    color: Theme.dim;
    vertical-alignment: center;
    horizontal-alignment: center;
}

component Avatar inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: tint;
    Text {
        text: label;
        color: white;
        font-size: 12px;
        font-weight: 600;
    }
}

component RailButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked;
    width: Prefs.large-targets ? 44px : 34px;
    height: Prefs.large-targets ? 44px : 34px;
    border-radius: 6px;
    background: active ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Icon {
        text: glyph;
        color: active ? Theme.accent : Theme.dim;
    }
}

component FolderRow inherits Rectangle {
    in property <Folder> f;
    in property <bool> selected;
    callback clicked;
    callback chevron-clicked;
    callback context(length, length);
    height: Prefs.large-targets ? 44px : 24px;
    in property <string> hl-id;
    background: selected ? Theme.sel : ta.has-hover || (hl-id != "" && CtxHl.id == hl-id) ? Theme.hover : transparent;
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
    }
    Rectangle {
        x: 0;
        width: 3px;
        background: selected ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 8px + f.depth * 12px;
        padding-right: 8px;
        spacing: 6px;
        Rectangle {
            width: 12px;
            if f.chevron != 0: Icon {
                text: f.chevron == 1 ? "\u{E70D}" : "\u{E76C}";
                font-size: 8px;
            }
            TouchArea { enabled: f.chevron != 0; clicked => { root.chevron-clicked(); } }
        }
        Icon {
            text: f.icon;
            font-size: 13px;
            width: 16px;
            color: f.color;
        }
        Text {
            text: f.name;
            color: selected ? Theme.sel-text : Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            font-weight: selected ? 600 : 400;
        }
        if f.muted: Icon { text: "\u{E7ED}"; font-size: 10px; }
        Text {
            text: f.count;
            color: f.unread > 0 ? Theme.text : Theme.dim;
            font-size: 11px;
            font-weight: f.unread > 0 ? 700 : 400;
            vertical-alignment: center;
        }
    }
}

component TagIcon inherits Path {
    in property <color> tint;
    width: 14px;
    height: 14px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: tint;
    stroke: tint;
    stroke-width: 1px;
    commands: "M12.6 2.6 A2 2 0 0 0 11.2 2 H4 A2 2 0 0 0 2 4 V11.2 A2 2 0 0 0 2.6 12.6 L11.3 21.3 A2.4 2.4 0 0 0 14.7 21.3 L21.3 14.7 A2.4 2.4 0 0 0 21.3 11.3 Z";
}

component TagRow inherits Rectangle {
    in property <Tag> t;
    in property <bool> selected;
    callback clicked;
    callback context(length, length);
    height: Prefs.large-targets ? 44px : 24px;
    in property <string> hl-id;
    background: selected ? Theme.sel : ta.has-hover || (hl-id != "" && CtxHl.id == hl-id) ? Theme.hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
    HorizontalLayout {
        padding-left: 26px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout { alignment: center; width: 16px; TagIcon { tint: t.color; } }
        Text { text: t.name; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: t.count; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: Prefs.large-targets ? 44px : 32px;
    min-width: pl.preferred-width + 28px;
    border-radius: 6px;
    background: !enabled ? #5a2a36 : (pta.pressed ? #d94a6b : (pta.has-hover ? #f46d8c : Theme.accent));
    pta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    pl := Text { text: root.text; color: Theme.on-accent; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}

component HoverAction inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked;
    width: Prefs.large-targets ? 32px : 22px;
    height: Prefs.large-targets ? 32px : 22px;
    border-radius: 4px;
    background: hta.has-hover ? Theme.hover : transparent;
    hta := TouchArea { clicked => { root.clicked(); } }
    Icon { text: glyph; font-size: 12px; color: active ? #facc15 : (hta.has-hover ? Theme.text : Theme.dim); }
}

export global Prefs {
    in-out property <bool> toolbar-labels: true;
    in-out property <bool> tag-chips: true;
    in-out property <length> font-size: 13px;
    in-out property <bool> cal-tinted: false;
    // timeFormat 12h: the hour column reads "2:00 PM"
    in-out property <bool> cal-h12: false;
    // list hover actions, Barbican action names (delete, star, read, archive, spam)
    in-out property <[string]> hover-actions: ["delete", "star", "read", "archive"];
    // reader body gutter (messageSpacing)
    in-out property <length> reader-gutter: 20px;
    // Settings > Accessibility
    in-out property <bool> reduce-motion: false;
    in-out property <bool> large-targets: false;
    // focus outline width (0 = off, Bulwark's default)
    in-out property <length> focus-ring: 0px;
    // a button on each row that opens its actions (showRowActionButton)
    in-out property <bool> row-action: false;
    // hover actions as a floating group in a corner (hoverActionsMode) and which corner
    in-out property <bool> hover-floating: false;
    in-out property <bool> hover-left: false;
    in-out property <bool> hover-bottom: false;
}

component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> show-label: Prefs.toolbar-labels;
    callback clicked;
    height: Prefs.large-targets ? 44px : 28px;
    width: max(lay.preferred-width, Prefs.large-targets ? 44px : 0px);
    border-radius: 6px;
    background: tta.has-hover ? Theme.hover : transparent;
    tta := TouchArea { clicked => { root.clicked(); } }
    lay := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Icon { text: glyph; font-size: 12px; color: Theme.text; }
        if show-label: Text { text: label; color: Theme.text; vertical-alignment: center; }
    }
}

component ContextMenuRow inherits Rectangle {
    in property <CtxItem> it;
    in property <bool> open-sub;
    callback picked(string);
    callback hovered();
    height: it.kind == 1 ? 9px : it.kind == 2 ? 24px : 28px;
    border-radius: 4px;
    background: it.kind == 0 && it.enabled && (cta.has-hover || open-sub) ? (it.danger ? #ef444433 : Theme.hover) : transparent;
    if it.kind == 1: Rectangle { x: 4px; width: parent.width - 8px; height: 1px; background: Theme.line; }
    if it.kind == 2: Text { x: 10px; width: parent.width - 20px; text: it.label; color: Theme.dim; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; }
    cta := TouchArea { enabled: it.kind == 0 && it.enabled; clicked => { if it.sub { root.hovered(); } else { root.picked(it.action); } } changed has-hover => { if self.has-hover { root.hovered(); } } }
    if it.kind == 0: HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;
        if it.color.alpha == 0: Icon { text: it.checked ? "\u{E73E}" : it.icon; font-size: 13px; width: 16px; color: !it.enabled ? Theme.line : it.danger ? #ef4444 : Theme.text; }
        if it.color.alpha > 0: VerticalLayout { alignment: center; width: 16px; TagIcon { tint: it.color; } }
        Text { text: it.label; color: !it.enabled ? Theme.dim : it.danger ? #ef4444 : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; font-size: 13px; }
        if it.hint != "": Text { text: it.hint; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        if it.checked && it.color.alpha > 0: Icon { text: "\u{E73E}"; font-size: 11px; width: 12px; color: Theme.accent; }
        if it.sub: Icon { text: "\u{E76C}"; font-size: 9px; width: 10px; }
    }
}

/// Dark context menu body (Theme.popup, 1px Theme.line border, radius 8).
component ContextMenu inherits Rectangle {
    in property <[CtxItem]> items;
    in property <string> open-sub;
    callback picked(string);
    callback hovered(string, int);
    background: Theme.popup;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000066;
    Flickable {
        content-height: col.preferred-height;
        col := VerticalLayout {
            padding: 4px;
            for it[i] in root.items: ContextMenuRow { it: it; open-sub: it.sub && it.action == root.open-sub; picked(a) => { root.picked(a); } hovered => { root.hovered(it.action, i); } }
        }
    }
}

component MailRow inherits VerticalLayout {
    in property <Mail> m;
    in property <length> row-height: 82px;
    in property <bool> selected;
    callback clicked;
    callback ctrl-clicked;
    callback action(string);
    callback header-clicked;
    callback context(length, length);
    if m.header != "": Rectangle {
        height: 32px;
        TouchArea { clicked => { root.header-clicked(); } }
        HorizontalLayout {
            padding-left: 16px;
            spacing: 8px;
            Icon { text: "\u{E70D}"; font-size: 9px; width: 12px; }
            Text { text: m.header; color: Theme.text; font-weight: 600; vertical-alignment: center; }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    }
    Rectangle {
        height: root.row-height + ((m.code != "" || m.files.length > 0) ? 22px : 0px);
        background: selected || m.checked ? Theme.sel : ta.has-hover || (CtxHl.id != "" && CtxHl.id == "mail:" + m.id) ? Theme.hover : m.row-tint;
        border-width: CtxHl.id != "" && CtxHl.id == "mail:" + m.id ? 1px : 0px;
        border-color: Theme.accent;
        ta := TouchArea {
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left {
                    if ev.modifiers.control || ev.modifiers.shift { root.ctrl-clicked(); } else { root.clicked(); }
                }
                if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            }
        }
        if m.tags.length > 0: Rectangle {
            x: 0; width: 3px; background: m.tags[0];
        }
        HorizontalLayout {
            padding: 10px;
            padding-left: 10px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Avatar { label: m.initials; tint: m.color; }
            }
            VerticalLayout {
                spacing: 3px;
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    if m.account != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: m.account-color;
                        }
                    }
                    Text {
                        text: m.draft ? "Draft" : m.sender;
                        color: m.draft ? #ef4444 : (m.unread ? Theme.text : Theme.dim);
                        font-weight: m.unread ? 700 : 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if m.threads > 1: Rectangle {
                        width: tc.preferred-width + 22px;
                        height: 16px;
                        border-radius: 4px;
                        background: Theme.chip;
                        HorizontalLayout {
                            padding-left: 4px;
                            spacing: 3px;
                            Icon { text: "\u{E8BD}"; font-size: 9px; }
                            tc := Text { text: m.threads; color: Theme.dim; font-size: 10px; vertical-alignment: center; }
                        }
                    }
                    if m.answered: Icon { text: "\u{E97A}"; font-size: 11px; }
                    if m.attach: Icon { text: "\u{E723}"; font-size: 11px; }
                    if !ta.has-hover || Prefs.hover-floating: Text { text: m.time; color: Theme.dim; font-size: 11px; }
                    if Prefs.row-action: HoverAction {
                        glyph: "\u{E712}";
                        clicked => { root.context(self.absolute-position.x, self.absolute-position.y + self.height); }
                    }
                    if ta.has-hover && !Prefs.hover-floating: HorizontalLayout {
                        spacing: 0px;
                        for a in Prefs.hover-actions: HoverAction {
                            glyph: a == "delete" ? "\u{E74D}" : a == "star" ? (m.flagged ? "\u{E735}" : "\u{E734}") : a == "read" ? (m.unread ? "\u{E8C3}" : "\u{E715}") : a == "archive" ? "\u{E7B8}" : a == "spam" ? "\u{E8F8}" : "\u{E8EC}";
                            active: a == "star" && m.flagged;
                            clicked => { root.action(a); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: m.subject;
                        color: Theme.text;
                        font-weight: m.unread ? 700 : 400;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if m.flagged && !ta.has-hover: Icon { text: "\u{E735}"; font-size: 11px; color: #facc15; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: m.preview; color: Theme.dim; overflow: elide; horizontal-stretch: 1; }
                    for c in m.tags: Rectangle { visible: Prefs.tag-chips; width: Prefs.tag-chips ? 8px : 0px; height: 8px; border-radius: 4px; background: c; y: 4px; }
                }
                if m.code != "" || m.files.length > 0: HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    if m.code != "": Rectangle {
                        height: 18px;
                        width: codet.preferred-width + 30px;
                        border-radius: 4px;
                        background: codeta.has-hover ? Theme.hover : Theme.chip;
                        border-width: 1px;
                        border-color: Theme.accent;
                        codeta := TouchArea { clicked => { root.action("copy-code:" + m.code); } }
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 4px;
                            Icon { text: "\u{E8C8}"; font-size: 9px; }
                            codet := Text { text: m.code; color: Theme.text; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                        }
                    }
                    for f in m.files: Rectangle {
                        height: 18px;
                        width: min(ft.preferred-width + 26px, 160px);
                        border-radius: 4px;
                        background: Theme.chip;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            Icon { text: "\u{E723}"; font-size: 9px; }
                            ft := Text { text: f; color: Theme.dim; font-size: 10px; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }
        }
        // Bulwark hoverActionsMode "floating": the actions float in a corner of the row
        if ta.has-hover && Prefs.hover-floating: Rectangle {
            x: Prefs.hover-left ? 8px : parent.width - self.width - 8px;
            y: Prefs.hover-bottom ? parent.height - self.height - 4px : 4px;
            width: fl.preferred-width + 4px;
            height: fl.preferred-height + 4px;
            border-radius: 6px;
            background: Theme.popup;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000040;
            fl := HorizontalLayout {
                x: 2px; y: 2px;
                spacing: 0px;
                for a in Prefs.hover-actions: HoverAction {
                    glyph: a == "delete" ? "\u{E74D}" : a == "star" ? (m.flagged ? "\u{E735}" : "\u{E734}") : a == "read" ? (m.unread ? "\u{E8C3}" : "\u{E715}") : a == "archive" ? "\u{E7B8}" : a == "spam" ? "\u{E8F8}" : "\u{E8EC}";
                    active: a == "star" && m.flagged;
                    clicked => { root.action(a); }
                }
            }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    }
}

// ---- rich-text composer: painted document pushed from Rust (src/rte)
export struct RteText { x: length, y: length, w: length, h: length, text: string, role: int, color: color, size: length, weight: int, italic: bool, font: int, right: bool }
export struct RteBox { x: length, y: length, w: length, h: length, role: int, color: color, border: length, border-role: int, border-color: color, radius: length }
export struct RteImage { x: length, y: length, w: length, h: length, img: image, selected: bool, label: string }
export struct RteState { bold: bool, italic: bool, underline: bool, strike: bool, code: bool, color: string, highlight: bool, size: int, block: string, align: string, in-table: bool, link: string, has-sel: bool, can-undo: bool, can-redo: bool }

// colour roles of painted runs and boxes (resolved here so the theme switches live)
global RteColors {
    public pure function of(role: int, c: color) -> color {
        if role == 1 { return Theme.text; }
        if role == 2 { return Theme.dim; }
        if role == 3 { return Theme.track; }
        if role == 4 { return Theme.dark ? #f0577a55 : #c8234a33; }
        if role == 5 { return Theme.chip; }
        if role == 6 { return Theme.dark ? #7cb1ff : #2563eb; }
        if role == 7 { return Theme.raised; }
        if role == 8 { return Theme.accent; }
        if role == 9 { return transparent; }
        return c;
    }
}

/// A corner handle of the selected image in the composer: drag to resize (aspect kept).
component RteHandle inherits Rectangle {
    in property <string> corner;
    // the handle's top-left in editor content coordinates
    in property <length> ox;
    in property <length> oy;
    callback ev(string, length, length);
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: white;
    border-width: 1.5px;
    border-color: Theme.accent;
    TouchArea {
        x: -3px; y: -3px; width: 16px; height: 16px;
        mouse-cursor: root.corner == "nw" || root.corner == "se" ? MouseCursor.nwse-resize : MouseCursor.nesw-resize;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { root.ev("rs-down-" + root.corner, root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y); }
            else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { root.ev("rs-up", root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y); }
        }
        moved => { if self.pressed { root.ev("rs-drag", root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y); } }
    }
}

component FmtButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    in property <string> tip;
    in property <bool> bold;
    in property <bool> italic;
    in property <bool> underline;
    in property <bool> strike;
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: fta.pressed ? Theme.chip : active ? Theme.sel : fta.has-hover ? Theme.hover : transparent;
    fta := TouchArea { clicked => { root.clicked(); } }
    if glyph != "": Icon { text: glyph; font-size: 13px; color: active ? Theme.sel-text : fta.has-hover ? Theme.text : Theme.dim; }
    if glyph == "": Text {
        text: label;
        color: active ? Theme.sel-text : fta.has-hover ? Theme.text : Theme.dim;
        font-size: 12px;
        font-weight: bold ? 800 : 500;
        font-italic: italic;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if underline: Rectangle { x: 8px; y: 18px; width: 8px; height: 1px; background: active ? Theme.sel-text : fta.has-hover ? Theme.text : Theme.dim; }
    if strike: Rectangle { x: 7px; y: 12px; width: 10px; height: 1px; background: active ? Theme.sel-text : fta.has-hover ? Theme.text : Theme.dim; }
    if tip != "" && fta.has-hover: Rectangle {
        y: parent.height + 4px;
        x: (parent.width - tipt.preferred-width - 12px) / 2;
        width: tipt.preferred-width + 12px;
        height: 22px;
        border-radius: 4px;
        background: Theme.text;
        tipt := Text { text: root.tip; color: Theme.bg; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> checked;
    in property <bool> checkable;
    in property <bool> enabled: true;
    in property <color> swatch: transparent;
    callback clicked;
    height: 30px;
    border-radius: 4px;
    background: mta.has-hover && enabled ? Theme.hover : transparent;
    mta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;
        if checkable: Icon { text: checked ? "\u{E73E}" : ""; font-size: 11px; width: 14px; color: Theme.accent; }
        if glyph != "": Icon { text: glyph; font-size: 12px; width: 14px; }
        if swatch != transparent: VerticalLayout { alignment: center; Rectangle { width: 12px; height: 12px; border-radius: 6px; background: swatch; } }
        Text { text: root.text; color: enabled ? Theme.text : Theme.dim; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
}

component MenuPanel inherits Rectangle {
    background: Theme.popup;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000060;
}

component BarButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> chevron: true;
    callback clicked;
    height: Prefs.large-targets ? 44px : 28px;
    width: bl.preferred-width;
    border-radius: 6px;
    background: bta.has-hover ? Theme.hover : transparent;
    bta := TouchArea { clicked => { root.clicked(); } }
    bl := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Icon { text: glyph; font-size: 12px; color: Theme.text; }
        Text { text: label; color: Theme.text; font-weight: 600; vertical-alignment: center; }
        if chevron: Icon { text: "\u{E70D}"; font-size: 8px; color: Theme.dim; }
    }
}

component BareField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    height: 20px;
    border-width: ti.has-focus ? Prefs.focus-ring : 0px;
    border-color: Theme.ring;
    border-radius: 2px;
    if text == "": Text { x: 0; text: placeholder; color: Theme.dim; vertical-alignment: center; height: parent.height; }
    ti := TextInput {
        text <=> root.text;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
    }
}


