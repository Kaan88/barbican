// Composer extras (p2-composer): the draft save state in the composer header, the Schedule
// send dialog (Bulwark schedule-send-dialog.tsx, shared with Reschedule) and the banner of a
// message in the Scheduled view. Logic: src/compose.rs, src/autosave.rs, src/schedule.rs.
import { CTheme } from "ctheme.slint";

export struct SPreset {
    label: string,
    when: string,
}

// One {{placeholder}} of a template being inserted (src/tplflow.rs).
export struct TplField {
    label: string,
    hint: string,
    value: string,
}

export global CompX {
    // "Saving…", "Draft saved 09:51", "Draft not saved"
    in-out property <string> saved;
    // template placeholder dialog (Bulwark placeholder-fill-modal.tsx)
    in-out property <bool> tpl-fill-open;
    in-out property <string> tpl-fill-name;
    in-out property <[TplField]> tpl-fields;
    in-out property <string> tpl-preview;
    callback tpl-fill-edit(int, string);
    // true: insert with the values, false: insert as written
    callback tpl-fill-confirm(bool);
    callback tpl-fill-cancel();
    // save the draft as a template (Bulwark quick-save-template-dialog.tsx)
    in-out property <bool> tpl-save-open;
    in-out property <string> tpl-save-name;
    in-out property <string> tpl-save-error;
    callback tpl-save-open-compose();
    callback tpl-save-confirm();
    callback tpl-save-cancel();
    // schedule dialog
    in-out property <bool> sched-open;
    in-out property <string> sched-title: "Schedule send";
    in-out property <string> sched-confirm: "Schedule send";
    in-out property <[SPreset]> sched-presets;
    in-out property <string> sched-date;
    in-out property <string> sched-time;
    in-out property <string> sched-error;
    in-out property <bool> sched-busy;
    // "Scheduled to send at …" for the message open in the Scheduled view
    in-out property <string> sched-banner;
    // a preset (index) or the typed date and time (-1)
    callback sched-choose(int);
    callback sched-cancel();
    // the composer's Schedule send (menu, Ctrl+Shift+Enter)
    callback sched-open-compose();
    // banner and menu actions on the open scheduled message: reschedule, edit, cancel
    callback sched-action(string);
}

export component SaveState inherits Text {
    text: CompX.saved;
    color: CTheme.dim;
    font-size: 12px;
    vertical-alignment: center;
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <color> fg: CTheme.text;
    callback clicked();
    height: 32px;
    min-width: lbl.preferred-width + 28px;
    border-radius: 12px;
    background: primary ? (ta.has-hover ? CTheme.accent.darker(0.1) : CTheme.accent) : (ta.has-hover ? CTheme.hover : transparent);
    border-width: primary ? 0px : 1px;
    border-color: CTheme.line;
    ta := TouchArea { clicked => { root.clicked(); } }
    lbl := Text {
        text: root.text;
        color: primary ? CTheme.on-accent : root.fg;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component DialogField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> invalid;
    callback accepted();
    callback edited(string);
    height: 36px;
    border-radius: 12px;
    background: CTheme.raised;
    border-width: ti.has-focus || invalid ? 1.5px : 1px;
    border-color: invalid ? CTheme.amber-fg : ti.has-focus ? CTheme.ring : CTheme.line;
    public function focus-input() { ti.focus(); }
    if root.text == "": Text {
        x: 12px;
        text: root.placeholder;
        color: CTheme.dim;
        vertical-alignment: center;
        height: parent.height;
    }
    ti := TextInput {
        x: 12px;
        width: parent.width - 24px;
        text <=> root.text;
        color: CTheme.text;
        single-line: true;
        vertical-alignment: center;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
    }
}

// Modal: fill in a template's placeholders, or insert it as written.
export component TplFillDialog inherits Rectangle {
    background: CTheme.scrim;
    TouchArea { clicked => { CompX.tpl-fill-cancel(); } }
    FocusScope {
        capture-key-pressed(e) => {
            if e.text == Key.Escape { CompX.tpl-fill-cancel(); return accept; }
            reject
        }
        Rectangle {
            width: min(460px, root.width - 32px);
            height: min(lay.preferred-height, root.height - 32px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: CTheme.popup;
            border-radius: 24px;
            border-width: 1px;
            border-color: CTheme.line;
            drop-shadow-blur: 30px;
            drop-shadow-color: CTheme.shadow;
            drop-shadow-offset-y: 12px;
            TouchArea { }
            lay := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Fill in placeholders"; color: CTheme.text; font-size: 17px; font-weight: 700; }
                Text { text: CompX.tpl-fill-name; color: CTheme.dim; font-size: 12.5px; overflow: elide; }
                Flickable {
                    content-height: fields.preferred-height;
                    height: min(fields.preferred-height, 260px);
                    fields := VerticalLayout {
                        spacing: 10px;
                        for f[i] in CompX.tpl-fields: VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: f.label; color: CTheme.accent; font-size: 12px; font-weight: 600; }
                                Text { text: f.hint; color: CTheme.dim; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                            }
                            DialogField {
                                placeholder: "Enter a value";
                                text: f.value;
                                edited(t) => { CompX.tpl-fill-edit(i, t); }
                                accepted => { CompX.tpl-fill-confirm(true); }
                            }
                        }
                    }
                }
                if CompX.tpl-preview != "": VerticalLayout {
                    spacing: 4px;
                    Rectangle { height: 1px; background: CTheme.line; }
                    Text { text: "Preview"; color: CTheme.dim; font-size: 12px; }
                    Text { text: CompX.tpl-preview; color: CTheme.text; font-size: 12.5px; wrap: word-wrap; max-height: 96px; overflow: elide; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton { text: "Insert as written"; clicked => { CompX.tpl-fill-confirm(false); } }
                    PillButton { text: "Insert with values"; primary: true; clicked => { CompX.tpl-fill-confirm(true); } }
                }
            }
        }
    }
}

// Modal: a name for the draft saved as a template.
export component TplSaveDialog inherits Rectangle {
    background: CTheme.scrim;
    TouchArea { clicked => { CompX.tpl-save-cancel(); } }
    FocusScope {
        capture-key-pressed(e) => {
            if e.text == Key.Escape { CompX.tpl-save-cancel(); return accept; }
            reject
        }
        Rectangle {
            width: min(400px, root.width - 32px);
            height: lay.preferred-height;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: CTheme.popup;
            border-radius: 24px;
            border-width: 1px;
            border-color: CTheme.line;
            drop-shadow-blur: 30px;
            drop-shadow-color: CTheme.shadow;
            drop-shadow-offset-y: 12px;
            TouchArea { }
            lay := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Save as template"; color: CTheme.text; font-size: 17px; font-weight: 700; }
                Text { text: "The subject and message become a template you can insert from any new message. Category, recipients and more can be set in Settings."; color: CTheme.dim; font-size: 12.5px; wrap: word-wrap; }
                name-field := DialogField {
                    placeholder: "Template name";
                    text <=> CompX.tpl-save-name;
                    invalid: CompX.tpl-save-error != "";
                    accepted => { CompX.tpl-save-confirm(); }
                }
                if CompX.tpl-save-error != "": Text { text: CompX.tpl-save-error; color: CTheme.amber-fg; font-size: 12.5px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton { text: "Cancel"; clicked => { CompX.tpl-save-cancel(); } }
                    PillButton { text: "Save"; primary: true; clicked => { CompX.tpl-save-confirm(); } }
                }
            }
        }
    }
    init => { name-field.focus-input(); }
}

// Modal: one click for the usual times, or any date and time typed below.
export component ScheduleDialog inherits Rectangle {
    background: CTheme.scrim;
    TouchArea { clicked => { CompX.sched-cancel(); } }
    FocusScope {
        capture-key-pressed(e) => {
            if e.text == Key.Escape { CompX.sched-cancel(); return accept; }
            reject
        }
        tile := Rectangle {
            width: min(400px, root.width - 32px);
            height: lay.preferred-height;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: CTheme.popup;
            border-radius: 24px;
            border-width: 1px;
            border-color: CTheme.line;
            drop-shadow-blur: 30px;
            drop-shadow-color: CTheme.shadow;
            drop-shadow-offset-y: 12px;
            TouchArea { }
            lay := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 12px;
                            background: CTheme.mint-bg;
                            Text { text: "\u{E823}"; font-family: CTheme.icons; font-size: 16px; color: CTheme.mint-fg; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: CompX.sched-title; color: CTheme.text; font-size: 17px; font-weight: 700; }
                        Text { text: "Pick when to send it."; color: CTheme.dim; font-size: 12.5px; }
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    for p[i] in CompX.sched-presets: Rectangle {
                        height: 40px;
                        border-radius: 12px;
                        background: pa.has-hover ? CTheme.hover : transparent;
                        pa := TouchArea { enabled: !CompX.sched-busy; clicked => { CompX.sched-choose(i); } }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text { text: p.label; color: CTheme.text; font-size: 13.5px; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: p.when; color: CTheme.dim; font-size: 12.5px; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { height: 1px; background: CTheme.line; }
                Text { text: "Or choose a date and time"; color: CTheme.dim; font-size: 12px; }
                HorizontalLayout {
                    spacing: 8px;
                    date := DialogField {
                        horizontal-stretch: 3;
                        placeholder: "YYYY-MM-DD";
                        text <=> CompX.sched-date;
                        invalid: CompX.sched-error != "";
                        accepted => { CompX.sched-choose(-1); }
                    }
                    DialogField {
                        horizontal-stretch: 2;
                        placeholder: "HH:MM";
                        text <=> CompX.sched-time;
                        invalid: CompX.sched-error != "";
                        accepted => { CompX.sched-choose(-1); }
                    }
                }
                if CompX.sched-error != "": Text {
                    text: CompX.sched-error;
                    color: CTheme.amber-fg;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton { text: "Cancel"; clicked => { CompX.sched-cancel(); } }
                    PillButton { text: CompX.sched-confirm; primary: true; clicked => { if !CompX.sched-busy { CompX.sched-choose(-1); } } }
                }
            }
        }
    }
    init => { date.focus-input(); }
}

// Above the open message in the Scheduled view: when it goes out, and what can be done.
export component ScheduledBar inherits Rectangle {
    height: 52px;
    Rectangle {
        x: 12px;
        y: 6px;
        width: parent.width - 24px;
        height: 40px;
        border-radius: 14px;
        background: CTheme.mint-bg;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 4px;
            spacing: 8px;
            Text { text: "\u{E823}"; font-family: CTheme.icons; font-size: 14px; color: CTheme.mint-fg; vertical-alignment: center; }
            Text { text: CompX.sched-banner; color: CTheme.mint-fg; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            VerticalLayout { alignment: center; PillButton { text: "Reschedule"; fg: CTheme.mint-fg; clicked => { CompX.sched-action("reschedule"); } } }
            VerticalLayout { alignment: center; PillButton { text: "Cancel and edit"; fg: CTheme.mint-fg; clicked => { CompX.sched-action("edit"); } } }
            VerticalLayout { alignment: center; PillButton { text: "Cancel send"; fg: CTheme.mint-fg; clicked => { CompX.sched-action("cancel"); } } }
        }
    }
}
