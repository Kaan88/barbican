    out property <string> print: "M6 9V2h12v7 M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2 M6 14h12v8H6z";
    out property <string> unread: "M4 4h16v16H4z M22 6l-10 7L2 6";
