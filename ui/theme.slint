// Barbican design tokens (design/mockups, design/README.md): palette, tints, shape and type
// per style, the line-icon set and the stroke icon. Imported by app.slint and dashboard.slint.

export global Theme {
    in-out property <bool> dark: true;
    // Settings > Accessibility > Contrast "More" (Bulwark data-contrast="more")
    in-out property <bool> more-contrast: false;
    // Settings > Appearance > Style: 0 Bento (every panel its own tile), 1 Nordic (one surface, pills and circles)
    in-out property <int> style: 0;
    out property <bool> bento: style != 1;
    out property <bool> nordic: style == 1;

    // ---- palette (design/mockups BNTokens: one palette, dark first) ----
    out property <color> ground: dark ? #0a0a0a : #f4f4f5;
    out property <color> tile: dark ? #141414 : #ffffff;
    out property <color> tile2: dark ? #1a1a1a : (nordic ? #f7f7f8 : #fafafa);
    out property <color> line: more-contrast ? (dark ? #9ca3af : #4b5563) : (dark ? #262626 : #e5e5e5);
    out property <color> track: dark ? #2e2e2e : #ececec;
    out property <color> text: more-contrast ? (dark ? #ffffff : #000000) : (dark ? #fafafa : #0a0a0a);
    out property <color> body: more-contrast ? (dark ? #ffffff : #000000) : (dark ? #d4d4d4 : #2b2b2b);
    out property <color> dim: more-contrast ? (dark ? #e5e7eb : #1f2937) : (dark ? #a3a3a3 : #6b6b6b);
    out property <color> faint: more-contrast ? (dark ? #d1d5db : #374151) : (dark ? #737373 : #8a8a8a);
    out property <color> accent: more-contrast ? (dark ? #93c5fd : #1d4ed8) : (dark ? #f0577a : #c8234a);
    out property <color> on-accent: more-contrast ? (dark ? #000000 : #ffffff) : (dark ? #16070c : #ffffff);
    out property <color> sel: dark ? #4a1424 : #fde4ea;
    out property <color> sel-text: dark ? #ffd5df : #8c1733;
    out property <color> popup: dark ? #1c1c1c : #ffffff;
    // meaning tints (bg/fg pairs): rose today, mint waiting/done, sky travel/work, amber attention
    out property <color> rose-bg: dark ? #f0577a24 : #fde4ea;
    out property <color> rose-fg: dark ? #ffb3c4 : #8c1733;
    out property <color> mint-bg: dark ? #34d39921 : #dcf5e8;
    out property <color> mint-fg: dark ? #86efc4 : #17603f;
    out property <color> sky-bg: dark ? #60a5fa24 : #dfeafd;
    out property <color> sky-fg: dark ? #a8cbff : #1e3f8a;
    out property <color> amber-bg: dark ? #fbbf2421 : #fdf1d3;
    out property <color> amber-fg: dark ? #fcd679 : #7a4a06;
    // tint-bg / tint-fg turn a colour into a tile pair: the four tint hues (what mail::tint hands
    // out per sender: rose, sky, mint, amber) map exactly, any other colour (tags) gets the same treatment
    public pure function tint-bg(c: color) -> color {
        if c == #f0577a { return rose-bg; }
        if c == #34d399 { return mint-bg; }
        if c == #60a5fa { return sky-bg; }
        if c == #fbbf24 { return amber-bg; }
        return dark ? c.with-alpha(0.15) : c.mix(#ffffff, 0.16);
    }
    public pure function tint-fg(c: color) -> color {
        if c == #f0577a { return rose-fg; }
        if c == #34d399 { return mint-fg; }
        if c == #60a5fa { return sky-fg; }
        if c == #fbbf24 { return amber-fg; }
        return dark ? c.mix(#ffffff, 0.5) : c.mix(#000000, 0.55);
    }

    // ---- older names, mapped onto the palette so screens not yet restyled keep working ----
    out property <color> bg: ground;
    out property <color> rail: ground;
    out property <color> side: tile;
    out property <color> hover: dark ? #1f1f1f : #f2f2f3;
    out property <color> chip: dark ? #262626 : #ececec;
    out property <color> raised: dark ? #1a1a1a : #f4f4f5;
    out property <color> zebra: dark ? #111111 : #fafafa;
    out property <color> bubble: tile2;
    out property <color> reader: tile;
    out property <color> muted-day: dark ? #5a5a5a : #a3a3a3;
    // keyboard focus outline (Bulwark --focus-ring-color)
    out property <color> ring: more-contrast ? (dark ? #ffffff : #000000) : accent;
    out property <string> icons: "Segoe Fluent Icons";

    // ---- shape and spacing (style dependent) ----
    // window ground padding and the gap between tiles (Nordic: rail and folders sit on the ground)
    out property <length> pad: nordic ? 0px : 14px;
    out property <length> gap: nordic ? 0px : 12px;
    // rail column width, and where an app's content starts (x of everything right of the rail)
    out property <length> rail-w: nordic ? 76px : 64px;
    out property <length> shell-x: nordic ? 76px : 14px + 64px + 12px;
    // tiles: side panels (rail, folders), panes (list, reader, context; the Nordic surface), summary tiles
    out property <length> r-tile: 24px;
    out property <length> r-pane: nordic ? 28px : 26px;
    out property <length> r-summary: 22px;
    // controls (Nordic: every control is a pill, so use min(height / 2, r-…))
    out property <length> r-button: nordic ? 999px : 12px;
    out property <length> r-field: nordic ? 999px : 14px;
    out property <length> r-row: nordic ? 0px : 18px;
    out property <length> r-nav: nordic ? 22px : 14px;
    out property <length> r-chip: 99px;
    out property <length> r-popup: nordic ? 16px : 14px;
    // squircle (Bento) or circle (Nordic) for an avatar or icon button of this size
    public pure function round(size: length) -> length {
        return nordic ? size / 2 : size * 0.37;
    }

    // ---- type scale (BNTokens): title 28/800, section 19/700, body 14.5/400 (line 1.7), meta 12/600 ----
    out property <length> fs-title: 28px;
    out property <length> fs-section: 19px;
    out property <length> fs-body: 14.5px;
    out property <length> fs-meta: 12px;
}

