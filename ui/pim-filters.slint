// Filter rules (Bulwark components/filters/filter-rule-modal.tsx and filter-settings.tsx):
// the rule row on Settings > Filters with edit / reorder / run on existing mail / delete,
// and the rule editor with several conditions (all / any), several actions, header, size,
// regex and attachment conditions, reject / keep / stop, active period, spam option.
import { LineEdit, ComboBox, ScrollView, CheckBox, TextEdit } from "std-widgets.slint";
import { PimTheme, PimIcon, PimButton, PimIconButton, PimChip, PimCaption } from "pim-theme.slint";

// One condition. `cmps` are the comparators the field allows; `value-kind`: "" none,
// "text", "size" (e.g. 1M), "types" (attachment extensions).
export struct FCond { field: int, cmp: int, cmps: [string], value: string, header: string, value-kind: string, is-header: bool }
// One action. `needs`: "" none, "folder", "tag", "address", "text". `types`: the action types this
// row offers (the server's Sieve extensions decide, e.g. reject); `kind` is an index into it.
export struct FAct { kind: int, value: string, folder: int, keep-copy: bool, needs: string, types: [string] }

export global FilterX {
    // ---- editor ----
    in-out property <bool> open;
    in property <string> title;
    in-out property <string> name;
    in-out property <int> match-type;
    in property <[FCond]> conds;
    in property <[FAct]> acts;
    in property <[string]> fields;
    in property <[string]> folders;
    in-out property <bool> stop;
    in-out property <bool> include-spam;
    in-out property <string> from;
    in-out property <string> until;
    in property <string> status;
    in property <bool> busy;
    callback add-cond();
    callback remove-cond(int);
    callback set-cond(int, string, string);
    callback set-cond-field(int, int);
    callback set-cond-cmp(int, int);
    callback add-act();
    callback remove-act(int);
    callback set-act-kind(int, int);
    callback set-act-value(int, string);
    callback set-act-folder(int, int);
    callback set-act-keep(int, bool);
    callback save();
    // ---- rule list ----
    in property <string> confirm;
    callback new-rule();
    callback edit(string);
    callback move(string, int);
    callback run(string);
    callback delete(string);
    // ---- run on existing mail ----
    in-out property <bool> retro-open;
    in property <string> retro-title;
    in property <string> retro-text;
    in property <bool> retro-can-apply;
    in property <bool> retro-busy;
    callback retro-apply();
}

// A rule on Settings > Filters: name, summary, on/off, and its actions.
export component FilterRuleRow inherits Rectangle {
    in property <string> key;
    in property <string> label;
    in property <string> desc;
    in property <bool> on;
    callback toggled(bool);
    min-height: lay.preferred-height;
    border-radius: 14px;
    background: ta.has-hover ? PimTheme.tile2 : transparent;
    ta := TouchArea { }
    lay := HorizontalLayout {
        padding: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.label; color: root.on ? PimTheme.text : PimTheme.dim; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                if !root.on: PimChip { text: "Off"; }
            }
            Text { text: root.desc; color: PimTheme.dim; font-size: 11px; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px; height: 20px; border-radius: 10px;
                background: root.on ? PimTheme.accent : PimTheme.chip;
                Rectangle { x: root.on ? parent.width - 18px : 2px; y: 2px; width: 16px; height: 16px; border-radius: 8px; background: root.on ? PimTheme.on-accent : PimTheme.dim; }
                TouchArea { clicked => { root.toggled(!root.on); } }
            }
        }
        VerticalLayout { alignment: center; PimIconButton { icon: "\u{E70F}"; clicked => { FilterX.edit(root.key); } } }
        VerticalLayout { alignment: center; PimIconButton { icon: "\u{E70E}"; clicked => { FilterX.move(root.key, -1); } } }
        VerticalLayout { alignment: center; PimIconButton { icon: "\u{E70D}"; clicked => { FilterX.move(root.key, 1); } } }
        VerticalLayout { alignment: center; PimIconButton { icon: "\u{E768}"; clicked => { FilterX.run(root.key); } } }
        VerticalLayout {
            alignment: center;
            if FilterX.confirm == root.key: PimButton { text: "Delete?"; danger: true; height: 26px; clicked => { FilterX.delete(root.key); } }
            if FilterX.confirm != root.key: PimIconButton { icon: "\u{E74D}"; clicked => { FilterX.delete(root.key); } }
        }
    }
}

component Caption inherits PimCaption { }

component CondRow inherits HorizontalLayout {
    in property <FCond> c;
    in property <int> i;
    spacing: 6px;
    ComboBox { width: 140px; model: FilterX.fields; current-index: c.field; selected => { FilterX.set-cond-field(root.i, self.current-index); } }
    if c.is-header: LineEdit { width: 130px; placeholder-text: "Header name"; text: c.header; edited(t) => { FilterX.set-cond(root.i, "header", t); } }
    if c.cmps.length > 0: ComboBox { width: 160px; model: c.cmps; current-index: c.cmp; selected => { FilterX.set-cond-cmp(root.i, self.current-index); } }
    if c.value-kind != "": LineEdit {
        horizontal-stretch: 1;
        placeholder-text: c.value-kind == "size" ? "Size, e.g. 500K or 10M" : c.value-kind == "types" ? "pdf, docx" : "Value (separate several with commas)";
        text: c.value;
        edited(t) => { FilterX.set-cond(root.i, "value", t); }
    }
    if c.value-kind == "": Rectangle { horizontal-stretch: 1; }
    PimIconButton { icon: "\u{E711}"; enabled: FilterX.conds.length > 1; clicked => { FilterX.remove-cond(root.i); } }
}

component ActRow inherits HorizontalLayout {
    in property <FAct> a;
    in property <int> i;
    spacing: 6px;
    ComboBox { width: 190px; model: a.types; current-index: a.kind; selected => { FilterX.set-act-kind(root.i, self.current-index); } }
    if a.needs == "folder": ComboBox { horizontal-stretch: 1; model: FilterX.folders; current-index: a.folder; selected => { FilterX.set-act-folder(root.i, self.current-index); } }
    if a.needs == "tag" || a.needs == "address" || a.needs == "text": LineEdit {
        horizontal-stretch: 1;
        placeholder-text: a.needs == "tag" ? "Tag name" : a.needs == "address" ? "name@example.com" : "Reason sent back to the sender";
        text: a.value;
        edited(t) => { FilterX.set-act-value(root.i, t); }
    }
    if a.needs == "address": CheckBox { text: "Keep a copy"; checked: a.keep-copy; toggled => { FilterX.set-act-keep(root.i, self.checked); } }
    if a.needs == "": Rectangle { horizontal-stretch: 1; }
    PimIconButton { icon: "\u{E711}"; enabled: FilterX.acts.length > 1; clicked => { FilterX.remove-act(root.i); } }
}

export component FilterRuleEditor inherits Rectangle {
    background: PimTheme.scrim;
    TouchArea { }
    Rectangle {
        width: min(760px, root.width - 48px);
        height: min(lay.preferred-height + 2px, root.height - 48px);
        background: PimTheme.popup;
        border-radius: 22px;
        border-width: 1px;
        border-color: PimTheme.line;
        clip: true;
        ScrollView {
            lay := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text { text: FilterX.title; color: PimTheme.text; font-size: 18px; font-weight: 700; }
                LineEdit { placeholder-text: "Rule name"; text <=> FilterX.name; }
                HorizontalLayout {
                    spacing: 8px;
                    Caption { text: "CONDITIONS"; vertical-alignment: center; }
                    ComboBox { width: 220px; model: ["All conditions must match", "Any condition matches"]; current-index <=> FilterX.match-type; }
                    Rectangle { horizontal-stretch: 1; }
                    PimButton { text: "Add condition"; icon: "\u{E710}"; height: 28px; clicked => { FilterX.add-cond(); } }
                }
                for c[i] in FilterX.conds: CondRow { c: c; i: i; }
                HorizontalLayout {
                    spacing: 8px;
                    Caption { text: "ACTIONS"; vertical-alignment: center; horizontal-stretch: 1; }
                    PimButton { text: "Add action"; icon: "\u{E710}"; height: 28px; clicked => { FilterX.add-act(); } }
                }
                for a[i] in FilterX.acts: ActRow { a: a; i: i; }
                Caption { text: "OPTIONS"; }
                CheckBox { text: "Don't apply later rules"; checked <=> FilterX.stop; }
                CheckBox { text: "Also move messages marked as spam"; checked <=> FilterX.include-spam; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Active from"; color: PimTheme.dim; vertical-alignment: center; }
                    LineEdit { width: 150px; placeholder-text: "YYYY-MM-DD"; text <=> FilterX.from; }
                    Text { text: "until"; color: PimTheme.dim; vertical-alignment: center; }
                    LineEdit { width: 150px; placeholder-text: "YYYY-MM-DD"; text <=> FilterX.until; }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: FilterX.status; color: PimTheme.accent; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                    PimButton { text: "Cancel"; enabled: !FilterX.busy; clicked => { FilterX.open = false; } }
                    PimButton { text: FilterX.busy ? "Saving…" : "Save rule"; primary: true; enabled: !FilterX.busy; clicked => { FilterX.save(); } }
                }
            }
        }
    }
}

// "Run on existing mail" confirmation (Bulwark retroactive run).
export component FilterRetroDialog inherits Rectangle {
    background: PimTheme.scrim;
    TouchArea { clicked => { if !FilterX.retro-busy { FilterX.retro-open = false; } } }
    Rectangle {
        width: 440px;
        height: lay.preferred-height;
        background: PimTheme.popup;
        border-radius: 22px;
        border-width: 1px;
        border-color: PimTheme.line;
        TouchArea { }
        lay := VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text { text: FilterX.retro-title; color: PimTheme.text; font-size: 18px; font-weight: 700; wrap: word-wrap; }
            Text { text: FilterX.retro-text; color: PimTheme.dim; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                PimButton { text: FilterX.retro-can-apply ? "Cancel" : "Close"; enabled: !FilterX.retro-busy; clicked => { FilterX.retro-open = false; } }
                if FilterX.retro-can-apply: PimButton { text: FilterX.retro-busy ? "Applying…" : "Apply"; primary: true; enabled: !FilterX.retro-busy; clicked => { FilterX.retro-apply(); } }
            }
        }
    }
}
