// Mail extras (stream p2-mailextras): the From override row, attachment preview cards,
// sender pictures, the tag tree and the import dialog. Colours come in as `MxTok`, filled from
// the app's Theme tokens in app.slint, so these pieces follow light, dark and more-contrast
// without importing app.slint. Shapes follow design/README.md: rounded tiles, 1px lines,
// 1.6-1.8px stroke icons, the rose / mint / sky / amber tints by meaning.

export struct MxTok {
    dark: bool,
    text: color,
    dim: color,
    line: color,
    accent: color,
    on-accent: color,
    hover: color,
    chip: color,
    popup: color,
    surface: color,
    sel: color,
    sel-text: color,
    ring: color,
    focus: length,
    big: bool,
}

/// An attachment tile: name split into stem and extension, size, and the thumbnail of an image.
export struct AttCard {
    index: int,
    stem: string,
    ext: string,
    size: string,
    thumb: image,
    has-thumb: bool,
}

// meaning tints (design tokens; rose today, mint done, sky work, amber attention)
global MxTint {
    public pure function sky-bg(dark: bool) -> color { return dark ? #60a5fa24 : #dfeafd; }
    public pure function sky-fg(dark: bool) -> color { return dark ? #a8cbff : #1e3f8a; }
    public pure function amber-bg(dark: bool) -> color { return dark ? #fbbf2421 : #fdf1d3; }
    public pure function amber-fg(dark: bool) -> color { return dark ? #fcd679 : #7a4a06; }
}

/// A line icon (24 x 24 box, stroke), as the mockups draw them.
export component MxIcon inherits Path {
    in property <string> d;
    in property <color> tint;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: d;
    stroke: tint;
    stroke-width: 1.7px;
    fill: transparent;
}

global MxPaths {
    out property <string> download: "M12 3v12 M7 10l5 5 5-5 M5 21h14";
    out property <string> file: "M14 2H6v20h12V8z M14 2v6h6";
    out property <string> image: "M3 3h18v18H3z M8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z M21 15l-5-5L5 21";
    out property <string> clip: "M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48";
    out property <string> close: "M18 6 6 18 M6 6l12 12";
    out property <string> chevron-down: "M6 9l6 6 6-6";
    out property <string> chevron-right: "M9 18l6-6-6-6";
    out property <string> chevron-up: "M18 15l-6-6-6 6";
    out property <string> tag: "M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z M7 7h.01";
    out property <string> upload: "M12 21V9 M7 14l5-5 5 5 M5 3h14";
    out property <string> pen: "M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z";
}

component MxField inherits Rectangle {
    in property <MxTok> tok;
    in property <string> placeholder;
    in-out property <string> text;
    callback edited(string);
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: ti.has-focus ? tok.accent : tok.line;
    background: tok.surface;
    if text == "": Text { x: 10px; text: placeholder; color: tok.dim; vertical-alignment: center; height: parent.height; font-size: 12.5px; }
    ti := TextInput {
        x: 10px;
        width: parent.width - 20px;
        text <=> root.text;
        color: tok.text;
        font-size: 12.5px;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
    }
}

/// Bulwark's From override: a name and an address to type in place of the identity picker,
/// and a pill back to the identities.
export component FromOverride inherits HorizontalLayout {
    in property <MxTok> tok;
    in-out property <string> name;
    in-out property <string> email;
    callback use-identity();
    spacing: 6px;
    alignment: stretch;
    VerticalLayout { alignment: center; width: 150px; MxField { tok: tok; placeholder: "Name"; text <=> root.name; } }
    VerticalLayout { alignment: center; horizontal-stretch: 1; MxField { tok: tok; placeholder: "sender@example.com"; text <=> root.email; } }
    VerticalLayout {
        alignment: center;
        Rectangle {
            height: 24px;
            width: ul.preferred-width + 20px;
            border-radius: 12px;
            background: uta.has-hover ? tok.hover : tok.chip;
            uta := TouchArea { clicked => { root.use-identity(); } }
            ul := Text { text: "Use an identity"; color: tok.text; font-size: 11.5px; font-weight: 600; }
        }
    }
}

/// One attachment tile (Bulwark reader-attachments): the picture of an image, or its kind,
/// the name and size; a click opens it, the arrow saves it.
component AttTile inherits Rectangle {
    in property <MxTok> tok;
    in property <AttCard> a;
    callback open(int);
    callback save(int);
    callback context(int, length, length);
    width: 216px;
    height: 56px;
    border-radius: 14px;
    border-width: 1px;
    border-color: tok.line;
    background: ta.has-hover ? tok.hover : tok.surface;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(a.index); }
        pointer-event(ev) => { if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up { root.context(a.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                clip: true;
                background: a.has-thumb ? tok.chip : MxTint.sky-bg(tok.dark);
                if a.has-thumb: Image { width: 40px; height: 40px; source: a.thumb; image-fit: cover; }
                if !a.has-thumb: VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    HorizontalLayout { alignment: center; MxIcon { d: MxPaths.file; tint: MxTint.sky-fg(tok.dark); width: 15px; height: 15px; } }
                    if a.ext != "" && a.ext.character-count <= 5: Text { text: a.ext; color: MxTint.sky-fg(tok.dark); font-size: 8.5px; font-weight: 700; horizontal-alignment: center; }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                alignment: start;
                // the extension stays in sight when a long name is cut
                Text { text: a.stem; color: tok.text; font-size: 12.5px; overflow: elide; max-width: 118px; }
                if a.ext != "": Text { text: "." + a.ext.to-lowercase(); color: tok.text; font-size: 12.5px; }
            }
            Text { text: a.size; color: tok.dim; font-size: 11px; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: sta.has-hover ? tok.chip : transparent;
                sta := TouchArea { clicked => { root.save(a.index); } }
                MxIcon { d: MxPaths.download; tint: sta.has-hover ? tok.text : tok.dim; }
            }
        }
    }
}

/// The attachment row as preview cards (attachmentImagePreviewsEnabled): a header with the
/// count and total size, then the tiles in one row that scrolls sideways.
export component AttCards inherits VerticalLayout {
    in property <MxTok> tok;
    in property <[AttCard]> cards;
    in property <string> summary;
    callback open(int);
    callback save(int);
    callback context(int, length, length);
    spacing: 6px;
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: 6px;
        height: 18px;
        VerticalLayout { alignment: center; MxIcon { d: MxPaths.clip; tint: tok.dim; width: 14px; height: 14px; } }
        Text { text: root.summary; color: tok.dim; font-size: 12px; vertical-alignment: center; }
    }
    fl := Flickable {
        height: 58px;
        content-width: max(self.width, root.cards.length * 224px);
        interactive: true;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for c in root.cards: AttTile {
                tok: root.tok;
                a: c;
                open(i) => { root.open(i); }
                save(i) => { root.save(i); }
                context(i, x, y) => { root.context(i, x, y); }
            }
        }
    }
}

/// The bar over a reply that takes the whole reading pane (a short window): it folds the reply
/// away to show the message, and back (Bulwark reply-dock "Show the message").
export component ReplyDockBar inherits Rectangle {
    in property <MxTok> tok;
    in property <bool> folded;
    in property <string> subject;
    callback toggled();
    height: 34px;
    background: bta.has-hover ? tok.hover : tok.surface;
    bta := TouchArea { clicked => { root.toggled(); } }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        VerticalLayout { alignment: center; MxIcon { d: root.folded ? MxPaths.chevron-up : MxPaths.chevron-down; tint: tok.dim; width: 14px; height: 14px; } }
        Text { text: root.folded ? "Back to the reply" : "Show the message"; color: tok.dim; font-size: 12.5px; vertical-alignment: center; }
        if !root.folded && root.subject != "": Text { text: root.subject; color: tok.text; font-size: 12.5px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: tok.line; }
}

/// The divider above a reply that shares the pane with its message: drag it to give the reply
/// more or less room, double-click for the default share (Bulwark reply-dock ResizeHandle).
export component ReplyDockHandle inherits Rectangle {
    in property <MxTok> tok;
    // the reply's height now, and its bounds
    in property <length> current;
    in property <length> min-h;
    in property <length> max-h;
    callback resized(length);
    callback done();
    callback reset();
    height: 9px;
    property <length> start;
    Rectangle { y: 0; height: 1px; background: tok.line; }
    Rectangle {
        x: (parent.width - 44px) / 2;
        y: 2px;
        width: 44px;
        height: 5px;
        border-radius: 3px;
        background: hta.has-hover || hta.pressed ? tok.dim : tok.line;
    }
    hta := TouchArea {
        mouse-cursor: row-resize;
        property <length> press-y;
        double-clicked => { root.reset(); }
        pointer-event(ev) => {
            // window coordinates: the handle itself moves while the reply grows
            if ev.kind == PointerEventKind.down { self.press-y = self.absolute-position.y + self.mouse-y; root.start = root.current; }
            if ev.kind == PointerEventKind.up { root.done(); }
        }
        moved => {
            if self.pressed {
                root.resized(max(root.min-h, min(root.max-h, root.start - (self.absolute-position.y + self.mouse-y - self.press-y))));
            }
        }
    }
}
