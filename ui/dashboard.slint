// Admin dashboard modelled on Stalwart's WebUI dashboard: pill tabs, stat cards with
// sparklines and natively drawn charts. Chart geometry comes from Rust as SVG path
// commands in a 1000 x 100 viewbox (y = 0 at the top).
import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, SIcon } from "theme.slint";

export struct DashBar {
    label: string,
    value: string,
    frac: float,
    color: color,
    share: string,
}

// one hover point: time label, formatted value per series, y (0 top .. 1 bottom) per series
export struct DashTip {
    time: string,
    vals: [string],
    ys: [float],
}

export struct DashPanel {
    // 0 stat card, 1 area/line chart, 2 bar chart, 3 horizontal bar list, 4 highlight
    kind: int,
    title: string,
    icon: string,
    info: string,
    value: string,
    change: string,
    good: bool,
    // change rounds to 0%: neutral grey badge
    flat: bool,
    spark: string,
    tone: int,
    height: int,
    names: [string],
    colors: [color],
    areas: [string],
    lines: [string],
    ylabels: [string],
    xlabels: [string],
    bars: [DashBar],
    note: string,
    // hover data, series in legend order
    tips: [DashTip],
    tip-names: [string],
    tip-colors: [color],
    spark-tips: [DashTip],
    fill-alpha: float,
    xstep: int,
}

export struct DashCol {
    weight: float,
    panels: [DashPanel],
}

export struct DashRow {
    cols: [DashCol],
}

component Glyph inherits Text {
    font-family: "Segoe Fluent Icons";
    font-size: 14px;
    vertical-alignment: center;
    horizontal-alignment: center;
}

component PanelView inherits Rectangle {
    in property <DashPanel> p;
    in property <bool> dark;
    // the first stat card of a page leads in the rose tint (BNDashboard "Received")
    in property <bool> lead;
    // Nordic: panels are regions of one surface split by hairlines (top / left edge)
    in property <bool> top-line;
    in property <bool> left-line;
    // BNDashboard tile language: stat cards radius 22, panels 24; a leading card is rose,
    // a card that moved the wrong way is amber, the highlight card is rose. Nordic: no tints.
    property <int> tint: Theme.nordic ? 0 : p.kind == 4 ? 1 : p.kind == 0 && lead ? 1 : p.kind == 0 && !p.good && !p.flat ? 2 : 0;
    property <color> fg: tint == 1 ? Theme.rose-fg : tint == 2 ? Theme.amber-fg : Theme.text;
    property <color> dim: tint == 1 ? Theme.rose-fg : tint == 2 ? Theme.amber-fg : Theme.dim;
    property <color> grid: Theme.line;
    // sparkline follows the card (BNDashboard s.line): rose card accent, amber card amber,
    // neutral cards mint or sky, never the accent
    property <color> accent: tint == 1 ? Theme.accent : tint == 2 ? Theme.amber-fg : p.kind != 0 ? Theme.accent : p.tone == 2 ? Theme.sky-fg : Theme.mint-fg;
    property <color> track: tint != 0 ? #00000026 : Theme.track;
    property <color> pop: Theme.popup;
    // BNDashboard rejections: accent, mint, amber, then sky
    pure function bar-color(i: int) -> color { i == 0 ? Theme.accent : i == 1 ? Theme.mint-fg : i == 2 ? Theme.amber-fg : Theme.sky-fg }
    property <color> pop-line: Theme.line;
    // stat cards keep their height; charts, lists and the highlight grow to fill the board
    property <bool> grows: p.kind != 0;
    min-height: p.height * 1px;
    preferred-height: p.height * 1px;
    max-height: grows ? 100000px : p.height * 1px;
    vertical-stretch: grows ? p.height : 0;
    border-radius: Theme.nordic ? 0px : p.kind == 0 || p.kind == 4 ? Theme.r-summary : Theme.r-tile;
    background: tint == 1 ? Theme.rose-bg : tint == 2 ? Theme.amber-bg : Theme.nordic ? transparent : Theme.tile;
    border-width: tint != 0 || Theme.nordic ? 0px : 1px;
    border-color: Theme.line;
    clip: true;
    if Theme.nordic && root.top-line: Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: Theme.line; }
    if Theme.nordic && root.left-line: Rectangle { x: 0; y: 0; width: 1px; height: parent.height; background: Theme.line; }

    // header shared by every kind
    hdr := HorizontalLayout {
        x: 16px;
        y: 12px;
        width: parent.width - 32px;
        height: 28px;
        spacing: 8px;
        Text {
            text: p.title;
            color: p.kind == 0 ? dim : fg;
            opacity: p.kind == 0 && tint != 0 ? 0.85 : 1;
            font-size: p.kind == 0 ? 12px : 15px;
            font-weight: p.kind == 0 ? 600 : 700;
            vertical-alignment: center;
            overflow: elide;
        }
        if p.info != "": Rectangle {
            width: 14px;
            ita := TouchArea { }
            Glyph { text: "\u{E946}"; font-size: 11px; color: dim; }
            if ita.has-hover: Rectangle {
                x: 18px;
                y: -4px;
                width: tip.preferred-width + 16px;
                height: 24px;
                border-radius: 6px;
                background: Theme.text;
                tip := Text { text: p.info; color: Theme.ground; font-size: 11px; }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        for n[i] in (p.kind == 1 || p.kind == 2) ? p.names : []: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 5px;
            Rectangle { width: 8px; height: 8px; y: 10px; border-radius: 4px; background: p.colors[i]; }
            Text { text: n; color: dim; font-size: 12px; vertical-alignment: center; horizontal-stretch: 0; }
        }
    }

    // stat card
    if p.kind == 0: Rectangle {
        // the sparkline only when there is room beside the value (BNDashboard: value flex 1, svg 96x30)
        property <bool> spark-room: p.spark != "" && root.width >= 190px;
        property <length> text-w: root.width - 32px - (spark-room ? 104px : 0px);
        Text {
            x: 16px;
            y: 38px;
            width: text-w;
            overflow: elide;
            text: p.value;
            color: fg;
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.56px;
        }
        if p.change != "": Rectangle {
            x: 16px;
            y: parent.height - 32px;
            height: 20px;
            width: min(chg.preferred-width, text-w);
            chg := Text { width: parent.width; horizontal-alignment: left; overflow: elide; text: p.change; color: p.flat ? dim : p.good ? (Theme.dark ? #6ee7b7 : #15803d) : (Theme.dark ? #fca5a5 : #b91c1c); font-size: 11.5px; font-weight: 700; }
        }
        if spark-room: Path {
            x: parent.width - 112px;
            y: parent.height - 44px;
            width: 96px;
            height: 30px;
            viewbox-width: 1000;
            viewbox-height: 100;
            fit: fill;
            commands: p.spark;
            stroke: accent;
            stroke-width: 2px;
            fill: transparent;
        }
        if spark-room && p.spark-tips.length > 0: Rectangle {
            x: parent.width - 112px;
            y: parent.height - 44px;
            width: 96px;
            height: 30px;
            property <int> n: p.spark-tips.length;
            property <int> idx: max(0, min(n - 1, round(sta.mouse-x / self.width * (n - 1))));
            property <length> px: self.width * idx / max(1, n - 1);
            sta := TouchArea { }
            if sta.has-hover: Rectangle {
                x: px - 3px;
                y: self.height * p.spark-tips[idx].ys[0] - 3px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: accent;
                border-width: 1px;
                border-color: pop;
            }
            if sta.has-hover: Rectangle {
                x: min(px - stl.preferred-width / 2 - 8px, parent.width + 6px - stl.preferred-width - 16px);
                y: -30px;
                width: stl.preferred-width + 16px;
                height: 24px;
                border-radius: 6px;
                background: pop;
                border-width: 1px;
                border-color: pop-line;
                drop-shadow-blur: 6px;
                drop-shadow-color: #00000026;
                stl := Text { text: p.spark-tips[idx].vals[0] + "  ·  " + p.spark-tips[idx].time; color: fg; font-size: 10px; }
            }
        }
    }

    // area / bar chart
    if p.kind == 1 || p.kind == 2: Rectangle {
        property <length> left: 52px;
        property <length> top: 50px;
        property <length> bottom: 26px;
        property <length> cw: self.width - left - 18px;
        property <length> ch: self.height - top - bottom;
        for yl[i] in p.ylabels: Rectangle {
            property <length> yy: top + ch * i / max(1, p.ylabels.length - 1);
            Rectangle { x: left; y: yy; width: cw; height: 1px; background: grid; }
            Text {
                x: 0;
                y: yy - 7px;
                width: left - 8px;
                height: 14px;
                text: yl;
                color: dim;
                font-size: 9px;
                horizontal-alignment: right;
            }
        }
        for a[i] in p.areas: Path {
            x: left;
            y: top;
            width: cw;
            height: ch;
            viewbox-width: 1000;
            viewbox-height: 100;
            fit: fill;
            commands: a;
            fill: p.kind == 2 ? p.colors[i] : p.colors[i].transparentize(1 - p.fill-alpha);
            stroke: transparent;
        }
        for l[i] in p.lines: Path {
            x: left;
            y: top;
            width: cw;
            height: ch;
            viewbox-width: 1000;
            viewbox-height: 100;
            fit: fill;
            commands: l;
            fill: transparent;
            stroke: p.colors[i];
            stroke-width: 2px;
        }
        if p.tips.length > 0: Rectangle {
            x: left;
            y: top;
            width: cw;
            height: ch;
            property <int> n: p.tips.length;
            property <bool> barsm: p.kind == 2;
            property <int> idx: barsm ? max(0, min(n - 1, floor(cta.mouse-x / self.width * n)))
                : max(0, min(n - 1, round(cta.mouse-x / self.width * (n - 1))));
            property <length> px: barsm ? self.width * (idx + 0.5) / n : self.width * idx / max(1, n - 1);
            property <DashTip> t: p.tips[idx];
            cta := TouchArea { }
            if cta.has-hover && !barsm: Rectangle { x: px; y: 0; width: 1px; height: parent.height; background: dim.transparentize(0.4); }
            if cta.has-hover && barsm: Rectangle { x: parent.width * idx / n; y: 0; width: parent.width / n; height: parent.height; background: grid.transparentize(0.75); }
            for c[i] in cta.has-hover && !barsm ? p.tip-colors : []: Rectangle {
                visible: t.ys[i] >= 0;
                x: px - 4px;
                y: parent.height * t.ys[i] - 4px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: c;
                border-width: 1.5px;
                border-color: pop;
            }
            if cta.has-hover: Rectangle {
                property <length> tw: max(150px, tl.preferred-width + 24px);
                x: px + 12px + tw > parent.width ? px - 12px - tw : px + 12px;
                y: max(0px, min(cta.mouse-y - 20px, parent.height - self.height));
                width: tw;
                height: 34px + p.tip-names.length * 19px;
                border-radius: 8px;
                background: pop;
                border-width: 1px;
                border-color: pop-line;
                drop-shadow-blur: 10px;
                drop-shadow-color: #0000002e;
                tl := VerticalLayout {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    spacing: 4px;
                    Text { text: t.time; color: dim; font-size: 10px; }
                    for nm[i] in p.tip-names: HorizontalLayout {
                        spacing: 6px;
                        Rectangle { width: 7px; height: 7px; y: 4px; border-radius: 4px; background: p.tip-colors[i]; }
                        Text { text: nm; color: dim; font-size: 11px; horizontal-stretch: 1; }
                        Text { text: t.vals[i]; color: fg; font-size: 11px; font-weight: 600; horizontal-alignment: right; }
                    }
                }
            }
        }
        // thin the ticks further when the chart is too narrow for them (12h labels are wider)
        property <length> xgap: cw * p.xstep / max(1, p.kind == 2 ? p.tips.length : p.tips.length - 1);
        property <length> xlw: p.xlabels.length > 0 ? p.xlabels[0].character-count * 5px + 8px : 0px;
        property <int> xskip: max(1, ceil(xlw / max(1px, xgap)));
        for xl[i] in p.xlabels: Text {
            visible: mod(i, xskip) == 0;
            x: left + (p.kind == 2 ? cw * (i * p.xstep + 0.5) / max(1, p.tips.length) : cw * i * p.xstep / max(1, p.tips.length - 1)) - 30px;
            y: parent.height - bottom + 6px;
            width: 60px;
            text: xl;
            color: dim;
            font-size: 9px;
            horizontal-alignment: center;
        }
    }

    // horizontal bar list
    if p.kind == 3: VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 44px;
        padding-bottom: 8px;
        spacing: 1px;
        alignment: start;
        for b[bi] in p.bars: HorizontalLayout {
            height: 21px;
            spacing: 10px;
            Text { text: b.label; color: Theme.body; font-size: 12.5px; width: min(110px, (root.width - 36px) * 0.42); overflow: elide; vertical-alignment: center; }
            Rectangle {
                horizontal-stretch: 1;
                Rectangle {
                    x: 0;
                    height: 8px;
                    width: parent.width;
                    border-radius: 4px;
                    background: track;
                }
                Rectangle {
                    x: 0;
                    height: 8px;
                    width: max(b.frac > 0 ? 4px : 0px, parent.width * b.frac);
                    border-radius: 4px;
                    background: root.bar-color(bi);
                }
            }
            Text { text: b.value; color: fg; font-size: 12.5px; width: 36px; overflow: elide; horizontal-alignment: right; vertical-alignment: center; }
        }
        if p.bars.length == 0: Text { text: "No data for this period."; color: dim; font-size: 11px; }
    }

    // bar list hover: one overlay above every row, so the tooltip sits below the hovered
    // row (above it only when there is no room) and never hides the row above
    if p.kind == 3 && p.bars.length > 0: Rectangle {
        x: 18px;
        y: 44px;
        width: parent.width - 36px;
        height: p.bars.length * 22px - 1px;
        property <int> idx: max(0, min(p.bars.length - 1, floor(lta.mouse-y / 22px)));
        property <DashBar> b: p.bars[idx];
        lta := TouchArea { }
        if lta.has-hover: Rectangle {
            property <length> below: idx * 22px + 25px;
            property <bool> room: 44px + below + self.height <= root.height - 2px;
            // no room under the last rows: sit on the hovered row beside the cursor instead
            x: room ? min(max(0px, lta.mouse-x - self.width / 2), parent.width - self.width)
                : lta.mouse-x + 14px + self.width <= parent.width ? lta.mouse-x + 14px : max(0px, lta.mouse-x - 14px - self.width);
            y: room ? below : idx * 22px - 2.5px;
            width: btl.preferred-width + 34px;
            height: 26px;
            border-radius: 8px;
            background: pop;
            border-width: 1px;
            border-color: pop-line;
            drop-shadow-blur: 8px;
            drop-shadow-color: #0000002e;
            btl := HorizontalLayout {
                x: 10px;
                spacing: 6px;
                Rectangle { width: 7px; height: 7px; y: 9.5px; border-radius: 4px; background: root.bar-color(idx); }
                Text { text: b.label; color: dim; font-size: 11px; vertical-alignment: center; }
                Text { text: b.value; color: fg; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                Text { text: "(" + b.share + ")"; color: dim; font-size: 11px; vertical-alignment: center; }
            }
        }
    }

    // highlight card (BNDashboard "Clean mail"): big value, description, then a meter in the accent
    if p.kind == 4: VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 40px;
        padding-bottom: 18px;
        spacing: 4px;
        Text { text: p.value; color: fg; font-size: root.height >= 150px ? 54px : 36px; font-weight: 800; letter-spacing: root.height >= 150px ? -1.6px : -1px; }
        if p.note != "" && root.height >= 170px: Text { text: p.note; color: fg; font-size: 12.5px; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        if p.bars.length > 0: Rectangle {
            height: 10px;
            border-radius: 5px;
            background: track;
            clip: true;
            Rectangle { x: 0; width: parent.width * p.bars[0].frac; height: 10px; background: Theme.accent; }
        }
    }
}

component PillTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> dark;
    callback clicked;
    height: 28px;
    width: lbl.preferred-width + 22px;
    border-radius: Theme.nordic ? self.height / 2 : 12px;
    background: active ? Theme.sel : ta.has-hover ? Theme.tile2 : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    lbl := Text {
        text: label;
        color: active ? Theme.sel-text : ta.has-hover ? Theme.text : Theme.dim;
        font-size: 12.5px;
        font-weight: 600;
    }
}

export component AdminDashboard inherits Rectangle {
    in property <bool> dark;
    in property <[DashRow]> rows;
    in property <string> status;
    in-out property <int> tab: 0;
    in-out property <int> range: 1;
    callback load(int, int);
    property <[string]> tabs: ["Overview", "Network", "Delivery", "Security", "Message Authentication", "Encryption", "Performance", "Storage", "Search Index", "Tasks", "Cache"];
    property <[string]> ranges: ["Last hour", "Last 24 hours", "Last 7 days", "Last 30 days"];
    property <bool> range-open;
    // padding around the board: 0 in Bento (the shell spaces the tiles), 14 inside Nordic's surface
    in property <length> inset: 0px;
    background: transparent;

    VerticalLayout {
        padding: root.inset;
        padding-bottom: 0px;
        spacing: 12px;
        HorizontalLayout {
            height: 38px;
            spacing: 8px;
            // the tab strip scrolls sideways when the window is too narrow for all eleven tabs
            Rectangle {
                horizontal-stretch: 100;
                min-width: 120px;
                max-width: pills.preferred-width;
                height: 38px;
                border-radius: Theme.nordic ? 19px : 16px;
                background: Theme.nordic ? Theme.tile2 : Theme.tile;
                border-width: 1px;
                border-color: Theme.line;
                clip: true;
                tabs-fl := Flickable {
                    content-width: pills.preferred-width;
                    content-height: 38px;
                    pills := HorizontalLayout {
                        height: 38px;
                        padding: 4px;
                        spacing: 2px;
                        for t[i] in root.tabs: PillTab {
                            label: t;
                            active: root.tab == i;
                            dark: root.dark;
                            clicked => { root.tab = i; root.load(root.tab, root.range); }
                        }
                    }
                }
                if pills.preferred-width + tabs-fl.content-x > self.width + 2px: Rectangle {
                    x: parent.width - 40px;
                    width: 39px;
                    y: 1px;
                    height: parent.height - 2px;
                    background: @linear-gradient(90deg, (Theme.nordic ? Theme.tile2 : Theme.tile).transparentize(1) 0%, Theme.nordic ? Theme.tile2 : Theme.tile 75%);
                    SIcon { x: parent.width - 20px; commands: Icons.chevron-right; size: 13px; weight: 2; tint: Theme.dim; }
                }
            }
            Text {
                text: root.status;
                color: Theme.dim;
                font-size: 11.5px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                overflow: elide;
            }
            rb := Rectangle {
                width: rl.preferred-width;
                height: 36px;
                y: 1px;
                border-radius: Theme.nordic ? 18px : 13px;
                background: rba.has-hover ? Theme.tile2 : (Theme.nordic ? Theme.tile2 : Theme.tile);
                border-width: 1px;
                border-color: Theme.line;
                rba := TouchArea { clicked => { root.range-open = !root.range-open; } }
                rl := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    spacing: 7px;
                    VerticalLayout { alignment: center; SIcon { commands: Icons.clock; size: 14px; weight: 2; tint: Theme.dim; } }
                    Text { text: root.ranges[root.range]; color: Theme.text; font-size: 12.5px; font-weight: 600; vertical-alignment: center; }
                    VerticalLayout { alignment: center; SIcon { commands: Icons.chevron-down; size: 13px; weight: 2; tint: Theme.dim; } }
                }
            }
            Rectangle {
                width: 36px;
                height: 36px;
                y: 1px;
                border-radius: Theme.round(self.height);
                background: rfa.has-hover ? Theme.tile2 : (Theme.nordic ? Theme.tile2 : Theme.tile);
                border-width: 1px;
                border-color: Theme.line;
                rfa := TouchArea { clicked => { root.load(root.tab, root.range); } }
                SIcon { commands: Icons.refresh; size: 15px; weight: 2; tint: Theme.text; }
            }
        }
        sv := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: max(self.visible-height, content.preferred-height);
            content := VerticalLayout {
                // fill the board down to the window padding (BNDashboard grid is flex 1)
                height: max(sv.visible-height, self.preferred-height);
                width: sv.visible-width - (self.preferred-height > sv.visible-height ? 12px : 0px);
                spacing: Theme.nordic ? 0px : 12px;
                for r[ri] in root.rows: HorizontalLayout {
                    spacing: Theme.nordic ? 0px : 12px;
                    for c[ci] in r.cols: VerticalLayout {
                        horizontal-stretch: c.weight;
                        preferred-width: 0px;
                        min-width: 0px;
                        spacing: Theme.nordic ? 0px : 12px;
                        for p[pi] in c.panels: PanelView { p: p; dark: root.dark; lead: ri == 0 && ci == 0 && pi == 0; top-line: ri > 0 || pi > 0; left-line: ci > 0; }
                    }
                }
            }
        }
    }

    if root.range-open: Rectangle {
        TouchArea { clicked => { root.range-open = false; } }
        Rectangle {
            x: root.width - root.inset - 36px - 8px - 170px;
            y: root.inset + 44px;
            width: 170px;
            height: 4 * 30px + 10px;
            border-radius: Theme.r-popup;
            background: Theme.popup;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 5px;
                for r[i] in root.ranges: Rectangle {
                    height: 30px;
                    border-radius: Theme.nordic ? 15px : 9px;
                    background: root.range == i ? Theme.sel : ia.has-hover ? Theme.hover : transparent;
                    ia := TouchArea { clicked => { root.range = i; root.range-open = false; root.load(root.tab, root.range); } }
                    Text { x: 10px; text: r; color: root.range == i ? Theme.sel-text : Theme.text; font-size: 12.5px; font-weight: root.range == i ? 600 : 400; vertical-alignment: center; height: parent.height; }
                }
            }
        }
    }
}
