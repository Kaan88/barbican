// App lock (Bulwark components/app-lock/lock-screen.tsx, pin-fields.tsx and
// components/settings/app-lock-settings.tsx): the lock screen over the whole window, and the
// dialog that sets, changes or removes the PIN. Logic: src/applock.rs.
import { LineEdit } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";

export global AppLock {
    // the lock screen covers everything (app.slint draws it last, and hides the mail view)
    in property <bool> locked;
    // "pin", "hello" (waiting for Windows Hello) or "forgot"
    in property <string> mode: "pin";
    in-out property <string> pin;
    in property <string> message;
    in property <bool> blocked;
    in property <bool> busy;
    in property <bool> hello-ready;
    // bumped to put the keyboard focus back on the lock screen's field
    in-out property <int> focus-tick;
    callback unlock(string);
    callback hello();
    callback use-pin();
    callback forgot();
    callback forgot-confirm();
    callback forgot-cancel();

    // the PIN dialog: "" (closed), "enable", "change", "disable" or "hello"
    in property <string> dlg;
    in property <string> dlg-title;
    in property <string> dlg-body;
    in property <bool> ask-current;
    in property <bool> ask-new;
    in-out property <string> current;
    in-out property <string> new-pin;
    in-out property <string> repeat;
    in property <string> dlg-hint;
    in property <string> dlg-error;
    in property <bool> dlg-ready;
    in property <bool> dlg-busy;
    in property <string> dlg-save-label: "Save";
    callback dlg-edit();
    callback dlg-save();
    callback dlg-cancel();
}

component LockButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: Theme.r-button;
    opacity: enabled ? 1 : 0.5;
    background: primary ? (ta.has-hover && enabled ? Theme.accent.darker(0.1) : Theme.accent) : (ta.has-hover && enabled ? Theme.hover : transparent);
    border-width: primary ? 0px : 1px;
    border-color: Theme.line;
    ta := TouchArea { clicked => { if root.enabled { root.clicked(); } } }
    Text {
        text: root.text;
        color: primary ? Theme.on-accent : Theme.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The card in the middle of the window, as Bulwark's Frame.
component LockCard inherits Rectangle {
    in property <string> title;
    in property <string> body;
    // the window's size (a component can't see its parent's)
    in property <length> area-w;
    in property <length> area-h;
    width: min(380px, area-w - 32px);
    height: lay.preferred-height;
    x: (area-w - self.width) / 2;
    y: (area-h - self.height) / 2;
    background: Theme.tile;
    border-radius: Theme.r-pane;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 30px;
    drop-shadow-color: Theme.dark ? #00000066 : #0000001a;
    lay := VerticalLayout {
        padding: 24px;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Theme.chip;
                Path { width: 22px; height: 22px; commands: Icons.lock; stroke: Theme.text; stroke-width: 1.8px; fill: transparent; viewbox-width: 24; viewbox-height: 24; }
            }
        }
        Text { text: root.title; color: Theme.text; font-size: 18px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
        if root.body != "": Text { text: root.body; color: Theme.dim; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
        @children
    }
}

// Over everything while the app is locked: it takes every click, scroll and key, and nothing of
// the app shows through (an opaque ground, as Bulwark's bg-background overlay).
export component LockScreen inherits Rectangle {
    background: Theme.ground;
    TouchArea {
        scroll-event(e) => { accept }
    }
    fs := FocusScope {
        // Tab would walk on into the app's fields under the lock: the lock's own fields only
        capture-key-pressed(e) => {
            if e.text == Key.Tab || e.text == Key.Backtab {
                root.refocus();
                return accept;
            }
            if e.text == Key.Escape && AppLock.mode == "forgot" { AppLock.forgot-cancel(); return accept; }
            reject
        }
        key-pressed(e) => { accept }
        LockCard {
            visible: AppLock.mode == "forgot";
            area-w: root.width;
            area-h: root.height;
            title: "Sign out to continue?";
            body: "A forgotten PIN can't be recovered. Signing out removes the PIN and signs out every account on this computer, so you can sign in again. Your mail on the server stays.";
            LockButton { text: "Sign out"; primary: true; enabled: !AppLock.busy; clicked => { AppLock.forgot-confirm(); } }
            LockButton { text: "Cancel"; enabled: !AppLock.busy; clicked => { AppLock.forgot-cancel(); } }
        }
        LockCard {
            visible: AppLock.mode == "hello";
            area-w: root.width;
            area-h: root.height;
            title: "Barbican is locked";
            body: AppLock.busy ? "Waiting for Windows Hello…" : "Confirm it's you with Windows Hello.";
            Text { text: AppLock.message; color: Theme.accent; font-size: 12.5px; horizontal-alignment: center; wrap: word-wrap; }
            LockButton { text: "Unlock with Windows Hello"; primary: true; enabled: !AppLock.busy; clicked => { AppLock.hello(); } }
            LockButton { text: "Use PIN instead"; clicked => { AppLock.use-pin(); } }
        }
        LockCard {
            visible: AppLock.mode == "pin";
            area-w: root.width;
            area-h: root.height;
            title: "Barbican is locked";
            body: "Enter your PIN to continue.";
            field := LineEdit {
                placeholder-text: "PIN";
                input-type: password;
                enabled: !AppLock.blocked;
                text <=> AppLock.pin;
                accepted => { if AppLock.pin != "" && !AppLock.busy && !AppLock.blocked { AppLock.unlock(AppLock.pin); } }
            }
            Text { text: AppLock.message; color: Theme.accent; font-size: 12.5px; min-height: 16px; horizontal-alignment: center; wrap: word-wrap; }
            LockButton {
                text: AppLock.busy ? "Unlocking…" : "Unlock";
                primary: true;
                enabled: AppLock.pin != "" && !AppLock.busy && !AppLock.blocked;
                clicked => { AppLock.unlock(AppLock.pin); }
            }
            if AppLock.hello-ready: LockButton { text: "Unlock with Windows Hello"; enabled: !AppLock.busy; clicked => { AppLock.hello(); } }
            Text {
                text: "Forgot your PIN?";
                color: Theme.dim;
                font-size: 12.5px;
                horizontal-alignment: center;
                TouchArea { mouse-cursor: pointer; clicked => { AppLock.forgot(); } }
            }
        }
    }
    function refocus() { if AppLock.mode == "pin" && !AppLock.blocked { field.focus(); } else { fs.focus(); } }
    property <int> tick: AppLock.focus-tick;
    changed tick => { root.refocus(); }
    init => { root.refocus(); }
}

component PinField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    callback edited();
    callback accepted();
    public function focus-input() { le.focus(); }
    spacing: 4px;
    Text { text: root.label; color: Theme.text; font-size: 12.5px; font-weight: 600; }
    le := LineEdit {
        input-type: password;
        text <=> root.text;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
}

// Set, change or turn off the PIN, or confirm it before Windows Hello is turned on
// (Bulwark app-lock-settings.tsx's Dialog).
export component PinDialog inherits Rectangle {
    background: #00000073;
    TouchArea { clicked => { if !AppLock.dlg-busy { AppLock.dlg-cancel(); } } scroll-event(e) => { accept } }
    FocusScope {
        capture-key-pressed(e) => {
            if e.text == Key.Escape && !AppLock.dlg-busy { AppLock.dlg-cancel(); return accept; }
            reject
        }
        Rectangle {
            width: min(400px, root.width - 32px);
            height: lay.preferred-height;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.popup;
            border-radius: 24px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 30px;
            drop-shadow-color: #00000059;
            drop-shadow-offset-y: 12px;
            TouchArea { }
            lay := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: AppLock.dlg-title; color: Theme.text; font-size: 17px; font-weight: 700; }
                if AppLock.dlg-body != "": Text { text: AppLock.dlg-body; color: Theme.dim; font-size: 12.5px; wrap: word-wrap; }
                if AppLock.ask-current: cur := PinField {
                    label: "Current PIN";
                    text <=> AppLock.current;
                    edited => { AppLock.dlg-edit(); }
                    accepted => { if AppLock.dlg-ready && !AppLock.dlg-busy { AppLock.dlg-save(); } }
                    init => { self.focus-input(); }
                }
                if AppLock.ask-new: PinField {
                    label: "New PIN";
                    text <=> AppLock.new-pin;
                    edited => { AppLock.dlg-edit(); }
                    accepted => { if AppLock.dlg-ready && !AppLock.dlg-busy { AppLock.dlg-save(); } }
                    init => { if !AppLock.ask-current { self.focus-input(); } }
                }
                if AppLock.ask-new: Text { text: AppLock.dlg-hint; color: Theme.dim; font-size: 11.5px; wrap: word-wrap; }
                if AppLock.ask-new: PinField {
                    label: "Repeat the PIN";
                    text <=> AppLock.repeat;
                    edited => { AppLock.dlg-edit(); }
                    accepted => { if AppLock.dlg-ready && !AppLock.dlg-busy { AppLock.dlg-save(); } }
                }
                if AppLock.dlg-error != "": Text { text: AppLock.dlg-error; color: Theme.accent; font-size: 12.5px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    LockButton { width: 96px; text: "Cancel"; enabled: !AppLock.dlg-busy; clicked => { AppLock.dlg-cancel(); } }
                    LockButton { width: 120px; text: AppLock.dlg-save-label; primary: true; enabled: AppLock.dlg-ready && !AppLock.dlg-busy; clicked => { AppLock.dlg-save(); } }
                }
            }
        }
    }
}
