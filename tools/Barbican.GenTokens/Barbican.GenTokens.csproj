<Project Sdk="Microsoft.NET.Sdk">
  <!-- gen-tokens: turns the Rust app's ui/theme.slint (copied to design/legacy-slint/theme.slint)
       into src/Barbican.App/Themes/*.xaml and src/Barbican.Presentation/Theme/Tokens.g.cs.
       Run: tools/build.ps1 gen-tokens   (check only: tools/build.ps1 gen-tokens -Check) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Barbican.GenTokens</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Barbican.Presentation.Tests" />
  </ItemGroup>
</Project>
