<Project>
  <!--
    Strictness for every project in the repo (PORT-PLAN.md §4.1). Projects under prototype/ opt out
    with their own Directory.Build.props. Do not weaken a rule here to make a change build: fix the
    code, or suppress one diagnostic locally with a justification comment.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Features>strict</Features>
    <!-- IDE0005 (unused usings) only runs in the build when docs are generated. CS1591 would demand
         XML docs on every public member, which is not the rule here. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Company>Barbican</Company>
    <Product>Barbican</Product>
    <Copyright>Barbican authors</Copyright>
    <RepositoryUrl>https://github.com/Kaan88/barbican</RepositoryUrl>
  </PropertyGroup>

  <!-- The AUTOMATION configuration (M1 stage F1, docs/adr/0007): a Debug build that also defines
       AUTOMATION. Only in this configuration does the App reference src/Barbican.Automation (the
       loopback command server, the UIA client, WGC capture, probes, the popup guard). Release and
       Debug never contain it; tests/Barbican.Build.Tests and tools/build.ps1 publish check that. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Automation'">
    <BarbicanAutomation>true</BarbicanAutomation>
    <DefineConstants>$(DefineConstants);AUTOMATION;DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Which layer a project belongs to, for the banned-API lists (BannedSymbols.txt + eng/). -->
  <PropertyGroup>
    <BarbicanRoot>$(MSBuildThisFileDirectory)</BarbicanRoot>
    <_BarbicanProjectDir>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/'))/</_BarbicanProjectDir>
    <BarbicanLayer Condition="'$(MSBuildProjectName)' == 'Barbican.Core'">Core</BarbicanLayer>
    <BarbicanLayer Condition="'$(MSBuildProjectName)' == 'Barbican.Presentation'">Presentation</BarbicanLayer>
    <BarbicanLayer Condition="$(_BarbicanProjectDir.Contains('/tests/'))">Tests</BarbicanLayer>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(BarbicanRoot)BannedSymbols.txt" />
    <AdditionalFiles Include="$(BarbicanRoot)eng/BannedSymbols.Core.txt" Condition="'$(BarbicanLayer)' == 'Core'" />
    <AdditionalFiles Include="$(BarbicanRoot)eng/BannedSymbols.Presentation.txt" Condition="'$(BarbicanLayer)' == 'Presentation'" />
    <AdditionalFiles Include="$(BarbicanRoot)eng/BannedSymbols.Tests.txt" Condition="'$(BarbicanLayer)' == 'Tests'" />
  </ItemGroup>
</Project>
